<Window x:Class="GraveOps.App.Views.DiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="560" WindowStartupLocation="CenterOwner" Title="GraveOps LAN Discovery">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="LAN discovery" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Scans the current private /24 for a small set of management ports. Nothing is saved automatically." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"><Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Click="Scan_Click">Scan Local /24</Button><TextBlock x:Name="ProgressText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><DataGrid x:Name="ResultsGrid" Grid.Row="2" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="2*"/><DataGridTextColumn Header="Open ports" Binding="{Binding OpenPorts}" Width="2*"/><DataGridTextColumn Header="Likely role" Binding="{Binding Guess}" Width="3*"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="3" Text="Use the discovered address when creating a Server profile, then verify the SSH host-key fingerprint before trusting it." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/></Grid>
</Window>
