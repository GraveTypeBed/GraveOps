<UserControl x:Class="GraveOps.App.Views.DockerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="210" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Docker" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Container state, images, restart controls and recent logs." Foreground="{StaticResource Muted}" />
            </StackPanel>
            <ComboBox x:Name="ServerCombo" Visibility="Collapsed" Grid.Column="1" Width="220" Margin="8" />
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="8" Click="Refresh_Click">Refresh</Button>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <DataGrid x:Name="ContainerGrid" SelectionMode="Single" RowStyle="{StaticResource GoDataGridRow}" CellStyle="{StaticResource GoDataGridCell}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="2*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" />
                    <DataGridTextColumn Header="Ports" Binding="{Binding Ports}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Width="170" Margin="0,0,14,0">
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="Logs_Click">Recent Logs</Button>
                    <Button Style="{StaticResource GoCompactSecondaryButton}" Margin="0,0,0,8" Click="DockerDrilldown_Click">Deep inspect</Button>
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Click="Restart_Click">Restart</Button>
                    <Button Style="{StaticResource DangerButton}" Click="Stop_Click">Stop</Button>
                </StackPanel>
                <TextBox x:Name="OutputBox" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</UserControl>