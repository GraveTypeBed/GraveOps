<Window x:Class="GraveOps.App.Views.RemoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="1080"
        Height="760"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Title="GraveOps - Remote Editor"
        Background="{StaticResource GoCanvas}"
        Foreground="{StaticResource GoText}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource GoCanvas}"
            BorderBrush="{StaticResource GoBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#0B0D0F"
                    BorderBrush="{StaticResource GoBorder}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="24"
                                Height="24"
                                CornerRadius="6"
                                Background="{StaticResource GoAccentTint}"
                                BorderBrush="#654C60"
                                BorderThickness="1">
                            <TextBlock Text="E"
                                       Foreground="{StaticResource GoAccent}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Remote Editor"
                                   Foreground="{StaticResource GoText}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource GoIconButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Close"
                            Click="Close_Click">&#x00D7;</Button>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource GoSurface}"
                    BorderBrush="{StaticResource GoBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="16,11">
                <StackPanel>
                    <TextBlock Text="REMOTE FILE"
                               Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="PathText"
                               Foreground="{StaticResource GoText}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Margin="16"
                    Background="{StaticResource GoCanvas}"
                    BorderBrush="{StaticResource GoBorder}"
                    BorderThickness="1"
                    CornerRadius="6">
                <TextBox x:Name="Editor"
                         Background="{StaticResource GoCanvas}"
                         Foreground="{StaticResource GoText}"
                         CaretBrush="{StaticResource GoText}"
                         SelectionBrush="#654C60"
                         BorderThickness="0"
                         Padding="14"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="13"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </Border>

            <Border Grid.Row="3"
                    Background="{StaticResource GoSurface}"
                    BorderBrush="{StaticResource GoBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="16,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText"
                                   Text="Loading..."
                                   Foreground="{StaticResource GoTextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Rollback copy is created before GraveOps writes the remote file."
                                   Foreground="{StaticResource GoTextDim}"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource GoCompactSecondaryButton}"
                                MinWidth="90"
                                Margin="0,0,8,0"
                                Click="Close_Click">Close</Button>
                        <Button Style="{StaticResource GoCompactPrimaryButton}"
                                MinWidth="126"
                                Click="Save_Click">Backup + Save</Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>