<UserControl x:Class="GraveOps.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="950" HorizontalAlignment="Left"><TextBlock Text="Preferences" Style="{StaticResource SectionHeading}"/><TextBlock Text="Desktop behavior, safety, profiles and server wake settings." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,14"/>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Behavior" Style="{StaticResource SectionHeading}"/><TextBlock Text="Dashboard refresh interval (seconds)" Foreground="{StaticResource Muted}" Margin="0,12,0,3"/><TextBox x:Name="RefreshBox" Width="160" HorizontalAlignment="Left"/><CheckBox x:Name="EmbeddedCheck" Content="Open saved web apps inside GraveOps by default" Margin="0,12,0,0"/><CheckBox x:Name="ConfirmNormalCheck" Content="Confirm normal actions" Margin="0,8,0,0"/><CheckBox x:Name="NotificationsCheck" Content="Show Windows desktop notifications" Margin="0,8,0,0"/><CheckBox x:Name="MaintenanceCheck" Content="Manual Maintenance Mode - suppress expected monitor alert balloons until disabled" Margin="0,8,0,0"/>
<CheckBox x:Name="SafeModeCheck"
          Content="Safe Mode - make operational server controls read-only"
          Margin="0,8,0,0"/><CheckBox x:Name="StartTrayCheck" Content="Start minimized to the system tray" Margin="0,8,0,0"/><CheckBox x:Name="CloseTrayCheck" Content="Close button hides GraveOps to tray instead of exiting" Margin="0,8,0,0"/><CheckBox x:Name="OverviewCheck" Content="Enable Overview drawer" Margin="0,8,0,0"/><CheckBox x:Name="CompactCheck" Content="Compact workspace spacing" Margin="0,8,0,0"/><CheckBox x:Name="QuickModulesCheck" Content="Show Quick Modules on Dashboard" Margin="0,8,0,0"/><CheckBox x:Name="FleetHistoryCheck" Content="Record lightweight fleet health history for incident replay" Margin="0,8,0,0"/><TextBlock Text="Background monitor interval (seconds)" Foreground="{StaticResource Muted}" Margin="0,12,0,3"/><TextBox x:Name="MonitorBox" Width="160" HorizontalAlignment="Left"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Profiles and recovery" Style="{StaticResource SectionHeading}"/><TextBlock x:Name="ConfigPathText" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono, Consolas" Margin="0,10,0,10" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click" Margin="0,0,8,0">Open Config Folder</Button><Button Style="{StaticResource SecondaryButton}" Click="Export_Click" Margin="0,0,8,0">Export Profile</Button><Button Style="{StaticResource SecondaryButton}" Click="Import_Click" Margin="0,0,8,0">Import Profile</Button><Button Style="{StaticResource PrimaryButton}" Click="Setup_Click">Setup Assistant</Button></StackPanel><TextBlock Text="Exports never include SSH passwords or key passphrases. Import automatically snapshots the current config first." Foreground="{StaticResource Dim}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Wake-on-LAN" Style="{StaticResource SectionHeading}"/><TextBlock Text="Save an optional MAC address per server. Wake sends only a LAN magic packet and requires no server credential." Foreground="{StaticResource Muted}" Margin="0,6,0,12" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="WakeServerCombo" SelectionChanged="WakeServer_SelectionChanged"/><TextBox x:Name="WakeMacBox" Grid.Column="1" Margin="8,0" ToolTip="Example: AA:BB:CC:DD:EE:FF"/><Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Click="SaveWake_Click" Margin="0,0,8,0">Save MAC</Button><Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Click="Wake_Click">Wake Server</Button></Grid></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Credential security" Style="{StaticResource SectionHeading}"/><TextBlock Text="SSH passwords and private-key passphrases stay in Windows Credential Manager. Host-key fingerprints remain pinned in the non-secret profile." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
        <Button Style="{StaticResource PrimaryButton}" Width="150" HorizontalAlignment="Left" Click="Save_Click">Save Settings</Button><TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Margin="0,10,0,20" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
</UserControl>