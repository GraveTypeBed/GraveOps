<UserControl x:Class="GraveOps.App.Views.FilesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Files / SFTP" Style="{StaticResource PageHeading}" />
                <TextBlock Text="Browse, preview, safely edit and transfer remote files." Style="{StaticResource PageSubheading}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource GoSurface}" BorderBrush="{StaticResource GoBorder}" BorderThickness="1" CornerRadius="7" Padding="10,6" VerticalAlignment="Center">
                <TextBlock x:Name="TargetText" Foreground="{StaticResource GoTextSecondary}" />
            </Border>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource GoSurface}" BorderBrush="{StaticResource GoBorder}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource GoCompactSecondaryButton}" Click="Up_Click" MinWidth="46">Up</Button>
                <TextBox x:Name="PathBox" Grid.Column="1" Margin="8,0" Text="/" FontFamily="Cascadia Mono, Consolas" VerticalContentAlignment="Center" FontSize="11.5" />
                <Button Grid.Column="2" Style="{StaticResource GoCompactPrimaryButton}" Click="Go_Click" MinWidth="48">Go</Button>
                <Button Grid.Column="3" Style="{StaticResource GoCompactSecondaryButton}" Margin="8,0,0,0" Click="Refresh_Click">Refresh</Button>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" MinWidth="145" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="320" MinWidth="260" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource FlatCard}" Margin="0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Favorites" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="Quick paths" Foreground="{StaticResource GoTextDim}" FontSize="10" Margin="0,3,0,10" />
                    <Button Style="{StaticResource GhostButton}" Tag="/opt" Click="Favorite_Click" HorizontalContentAlignment="Left">/opt</Button>
                    <Button Style="{StaticResource GhostButton}" Tag="/etc/systemd/system" Click="Favorite_Click" HorizontalContentAlignment="Left">/etc/systemd/system</Button>
                    <Button Style="{StaticResource GhostButton}" Tag="/mnt/media" Click="Favorite_Click" HorizontalContentAlignment="Left">/mnt/media</Button>
                    <Button Style="{StaticResource GhostButton}" Tag="/var/lib/media-backup" Click="Favorite_Click" HorizontalContentAlignment="Left">/var/lib/media-backup</Button>
                    <Button Style="{StaticResource GhostButton}" Tag="/home" Click="Favorite_Click" HorizontalContentAlignment="Left">/home</Button>
                </StackPanel>
            </Border>
            <GridSplitter Grid.Column="1" Style="{StaticResource GoSplitter}" Margin="1,8" />
            <Border Grid.Column="2" Style="{StaticResource FlatCard}" Padding="0" Margin="4,0">
                <DataGrid x:Name="FilesGrid" MouseDoubleClick="FilesGrid_MouseDoubleClick" SelectionMode="Single" SelectionChanged="FilesGrid_SelectionChanged" RowHeight="31" ColumnHeaderHeight="34" CanUserResizeRows="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource GoText}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1,0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource GoSurfaceHover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource GoSurfaceSelected}" />
                                    <Setter Property="Foreground" Value="{StaticResource GoText}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource GoAccent}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource GoText}" />
                            <Setter Property="BorderBrush" Value="{StaticResource GoBorder}" />
                            <Setter Property="Padding" Value="7,4" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource GoText}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource GoAccent}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="3*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                        <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="*" />
                        <DataGridTextColumn Header="Modified" Binding="{Binding LastWriteTime}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <GridSplitter Grid.Column="3" Style="{StaticResource GoSplitter}" Margin="1,8" />
            <Border Grid.Column="4" Style="{StaticResource FlatCard}" Padding="12" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Preview" Style="{StaticResource SectionHeading}" />
                        <TextBlock x:Name="PreviewPathText" Text="Select a file" Foreground="{StaticResource GoTextSecondary}" FontFamily="Cascadia Mono, Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="PreviewMetaText" Grid.Row="1" Foreground="{StaticResource GoTextDim}" FontSize="10" Margin="0,9,0,0" />
                    <Border Grid.Row="2" Background="{StaticResource GoCanvas}" BorderBrush="{StaticResource GoBorder}" BorderThickness="1" CornerRadius="6">
                        <TextBox x:Name="PreviewBox" IsReadOnly="True" AcceptsReturn="True" Background="{StaticResource GoCanvas}" Foreground="{StaticResource GoText}" BorderThickness="0" Padding="10" FontFamily="Cascadia Mono, Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource GoSurface}" BorderBrush="{StaticResource GoBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource GoTextSecondary}" VerticalAlignment="Center" Margin="2,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="TerminalHereButton" Style="{StaticResource GoCompactSecondaryButton}" Click="TerminalHere_Click" Margin="0,0,7,0">Terminal Here</Button>
                    <Button x:Name="DownloadButton" Style="{StaticResource GoCompactSecondaryButton}" Click="Download_Click" IsEnabled="False" Margin="0,0,7,0">Download</Button>
                    <Button x:Name="UploadButton" Style="{StaticResource GoCompactSecondaryButton}" Click="Upload_Click" Margin="0,0,7,0">Upload Here</Button>
                    <Button x:Name="EditButton" Style="{StaticResource GoCompactPrimaryButton}" Click="Edit_Click" IsEnabled="False">Edit + Diff</Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>