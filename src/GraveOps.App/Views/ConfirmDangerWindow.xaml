<Window x:Class="GraveOps.App.Views.ConfirmDangerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540" Height="310" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Title="Confirm dangerous action">
    <Border Style="{StaticResource Card}" Margin="18"><StackPanel><TextBlock Text="Dangerous operation" Foreground="{StaticResource Danger}" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="ActionText" Margin="0,10,0,4" FontSize="16"/><TextBlock x:Name="CommandText" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock x:Name="PromptText" Margin="0,16,0,4"/><TextBox x:Name="ConfirmBox"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0">Cancel</Button><Button Style="{StaticResource DangerButton}" Click="Confirm_Click">Run</Button></StackPanel></StackPanel></Border>
</Window>
