<Window x:Class="GraveOps.App.Views.PlexSessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GraveOps - Plex Session Analytics"
        Width="1380"
        Height="850"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource GoCanvas}"
        Foreground="{StaticResource GoText}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Plex session analytics"
                           FontSize="23"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Active viewers, playback decisions, bandwidth and transcoder state."
                           Foreground="{StaticResource GoTextSecondary}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TargetText"
                           Foreground="{StaticResource GoTextSecondary}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <Button x:Name="RefreshButton"
                        Style="{StaticResource GoCompactPrimaryButton}"
                        Click="Refresh_Click">Refresh</Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource GoInsetPanel}"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Secure Plex API access"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TokenStatusText"
                               Text="Checking Windows Credential Manager..."
                               Foreground="{StaticResource GoTextSecondary}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <PasswordBox x:Name="TokenBox"
                             Grid.Column="1"
                             Margin="14,0,8,0"
                             VerticalAlignment="Center"
                             ToolTip="Paste the X-Plex-Token. GraveOps never displays the saved value."/>

                <Button Grid.Column="2"
                        Style="{StaticResource GoCompactPrimaryButton}"
                        Click="SaveToken_Click"
                        Margin="0,0,8,0">Save + test</Button>

                <Button x:Name="ClearTokenButton"
                        Grid.Column="3"
                        Style="{StaticResource GoCompactSecondaryButton}"
                        Click="ClearToken_Click">Clear saved token</Button>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2"
                     Columns="6"
                     Margin="0,0,0,12">
            <Border Style="{StaticResource FlatCard}" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="SESSIONS" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="SessionCountText" Text="--" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FlatCard}" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="DIRECT PLAY" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="DirectPlayText" Text="--" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FlatCard}" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="DIRECT STREAM" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="DirectStreamText" Text="--" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FlatCard}" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="TRANSCODE" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="TranscodeText" Text="--" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FlatCard}" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="BANDWIDTH" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="BandwidthText" Text="--" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FlatCard}" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="SERVER" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="ServerVersionText"
                               Text="--"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource FlatCard}"
                    Padding="0">
                <DataGrid x:Name="SessionsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="SessionsGrid_SelectionChanged"
                          RowStyle="{StaticResource GoDataGridRow}"
                          CellStyle="{StaticResource GoDataGridCell}"
                          RowHeight="32"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="User" Binding="{Binding User}" Width="1*"/>
                        <DataGridTextColumn Header="Media" Binding="{Binding Title}" Width="2.6*"/>
                        <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="1*"/>
                        <DataGridTextColumn Header="Client" Binding="{Binding Player}" Width="1.25*"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="0.7*"/>
                        <DataGridTextColumn Header="Progress" Binding="{Binding ProgressText}" Width="0.75*"/>
                        <DataGridTextColumn Header="Bandwidth" Binding="{Binding BandwidthText}" Width="0.9*"/>
                        <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="1.2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource GoSplitter}"/>

            <Border Grid.Column="2"
                    Style="{StaticResource FlatCard}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Selected session"
                                   Style="{StaticResource SectionHeading}"/>
                        <TextBlock x:Name="SelectedSessionText"
                                   Text="Select a session for client, codec and transcode details."
                                   Foreground="{StaticResource GoTextSecondary}"
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBox x:Name="SessionDetailBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11"
                             Background="{StaticResource GoCanvas}"
                             Foreground="{StaticResource GoText}"
                             BorderBrush="{StaticResource GoBorder}"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="{StaticResource GoSurface}"
                BorderBrush="{StaticResource GoBorder}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="10"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="AutoRefreshCheck"
                          Content="Auto refresh every 15 seconds"
                          IsChecked="True"
                          Checked="AutoRefresh_Changed"
                          Unchecked="AutoRefresh_Changed"
                          VerticalAlignment="Center"/>

                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="Ready."
                           Foreground="{StaticResource GoTextSecondary}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           TextWrapping="Wrap"/>

                <Button Grid.Column="2"
                        Style="{StaticResource GoCompactSecondaryButton}"
                        Click="Close_Click"
                        Margin="12,0,0,0">Close</Button>
            </Grid>
        </Border>
    </Grid>
</Window>