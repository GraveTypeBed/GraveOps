<UserControl x:Class="GraveOps.App.Views.MediaLifecycleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Media lifecycle" Style="{StaticResource PageHeading}" />
                    <TextBlock Text="Follow active media from acquisition through download, import, processing and library availability."
                               Foreground="{StaticResource GoTextSecondary}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TargetText" Text="--" Foreground="{StaticResource GoTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="RefreshButton" Style="{StaticResource GoCompactPrimaryButton}" Click="Refresh_Click">Refresh lifecycle</Button>
                </StackPanel>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource FlatCard}" Margin="0,0,5,0" MinHeight="84">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE ITEMS" Style="{StaticResource Eyebrow}" />
                        <TextBlock x:Name="ActiveText" Text="--" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FlatCard}" Margin="5,0" MinHeight="84">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NEEDS ATTENTION" Style="{StaticResource Eyebrow}" />
                        <TextBlock x:Name="AttentionText" Text="--" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FlatCard}" Margin="5,0" MinHeight="84">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DOWNLOADING" Style="{StaticResource Eyebrow}" />
                        <TextBlock x:Name="DownloadingText" Text="--" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FlatCard}" Margin="5,0,0,0" MinHeight="84">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="IMPORT / RECONCILE" Style="{StaticResource Eyebrow}" />
                        <TextBlock x:Name="ImportText" Text="--" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource FlatCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Workflow" Style="{StaticResource SectionHeading}" />
                    <TextBlock x:Name="WorkflowHintText" Text="Request → Discovery → Arr → Download → Import → Processing → Library"
                               Foreground="{StaticResource GoTextSecondary}" Margin="0,3,0,10" />
                    <UniformGrid Columns="7">
                        <Border Style="{StaticResource GoInsetPanel}" Margin="0,0,3,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="REQUEST" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="RequestStageText" Text="Optional" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource GoInsetPanel}" Margin="3,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="DISCOVERY" Style="{StaticResource Eyebrow}"/><TextBlock Text="Prowlarr / autobrr" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource GoInsetPanel}" Margin="3,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="ARR" Style="{StaticResource Eyebrow}"/><TextBlock Text="Sonarr · Radarr · Lidarr" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource GoInsetPanel}" Margin="3,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="DOWNLOAD" Style="{StaticResource Eyebrow}"/><TextBlock Text="SAB · qBit" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource GoInsetPanel}" Margin="3,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="IMPORT" Style="{StaticResource Eyebrow}"/><TextBlock Text="Arr reconcile" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource GoInsetPanel}" Margin="3,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="PROCESSING" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="ProcessingStageText" Text="Optional" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource GoInsetPanel}" Margin="3,0,0,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="LIBRARY" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="LibraryStageText" Text="Optional" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource FlatCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="14,12,14,8">
                            <TextBlock Text="Active lifecycle items" Style="{StaticResource SectionHeading}" />
                            <TextBlock Text="Correlated from the existing Arr and downloader telemetry owners. Double-click an item to open the owning application."
                                       Foreground="{StaticResource GoTextSecondary}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <DataGrid x:Name="LifecycleGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      MouseDoubleClick="LifecycleGrid_MouseDoubleClick" RowStyle="{StaticResource GoDataGridRow}" CellStyle="{StaticResource GoDataGridCell}"
                                      RowHeight="30" ScrollViewer.HorizontalScrollBarVisibility="Auto" MinHeight="230">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Title}" Width="2.6*" />
                                    <DataGridTextColumn Header="Owner" Binding="{Binding OwnerApp}" Width="0.8*" />
                                    <DataGridTextColumn Header="Stage" Binding="{Binding StageText}" Width="0.9*" />
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="0.8*" />
                                    <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="0.8*" />
                                    <DataGridTextColumn Header="Remaining" Binding="{Binding Remaining}" Width="0.9*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="LifecycleEmptyText" Text="No active Arr or download work is visible right now."
                                       Foreground="{StaticResource GoTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource FlatCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="14,12,14,8">
                            <TextBlock Text="Guided remediation" Style="{StaticResource SectionHeading}" />
                            <TextBlock Text="Upstream-first next steps. GraveOps avoids recommending downstream restarts when an earlier dependency explains the symptom."
                                       Foreground="{StaticResource GoTextSecondary}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ListBox x:Name="RemediationList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="8,0,8,8"
                                 MouseDoubleClick="RemediationList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Order}" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Why}" Foreground="{StaticResource GoTextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding NextAction}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="RemediationEmptyText" Grid.Row="1" Text="No remediation is currently required."
                                   Foreground="{StaticResource Success}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Row="2" Style="{StaticResource GoCompactSecondaryButton}" Click="OpenSelectedRemediation_Click" Margin="12,0,12,12">Open selected step</Button>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource GoStatusStrip}">
                <TextBlock x:Name="StatusText" Text="Lifecycle telemetry pending." Foreground="{StaticResource GoTextSecondary}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
