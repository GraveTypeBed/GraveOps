<UserControl x:Class="GraveOps.App.Views.BackupsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Backup readiness" Style="{StaticResource PageHeading}" />
                    <TextBlock Text="Provider-neutral backup inventory. GraveOps never assumes repository paths, credentials or retention policy." Style="{StaticResource PageSubheading}" Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="Refresh_Click" Padding="18,9">Refresh</Button>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource FlatCard}" Margin="0,0,10,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="READINESS" Style="{StaticResource Eyebrow}" /><TextBlock x:Name="ReadinessText" Text="--" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,2" /><TextBlock x:Name="ReadinessSubtext" Text="Waiting for inventory" Foreground="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Style="{StaticResource FlatCard}" Margin="0,0,10,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="PROVIDER" Style="{StaticResource Eyebrow}" /><TextBlock x:Name="ProviderText" Text="--" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,2" TextWrapping="Wrap" /><TextBlock Text="Detected without reading secrets" Foreground="{StaticResource Muted}" /></StackPanel></Border>
                <Border Style="{StaticResource FlatCard}" Margin="0,0,10,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="SCHEDULES" Style="{StaticResource Eyebrow}" /><TextBlock x:Name="ScheduleCountText" Text="--" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,2" /><TextBlock Text="backup-related timers/tasks" Foreground="{StaticResource Muted}" /></StackPanel></Border>
                <Border Style="{StaticResource FlatCard}"><StackPanel VerticalAlignment="Center"><TextBlock Text="GRAVEOPS ACTIONS" Style="{StaticResource Eyebrow}" /><TextBlock x:Name="ActionCountText" Text="--" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,2" /><TextBlock Text="user-configured protected actions" Foreground="{StaticResource Muted}" /></StackPanel></Border>
            </UniformGrid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource FlatCard}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="Backup inventory" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Scheduled backup/recovery work and provider evidence reported by the selected host." Foreground="{StaticResource Muted}" Margin="0,4,0,10" />
                        <TextBox x:Name="InventoryBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="220" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource FlatCard}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Operations" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Backup mutations belong in protected user-defined actions or a provider integration. GraveOps does not invent backup commands." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14" />
                        <Button Style="{StaticResource PrimaryButton}" Click="Actions_Click" Margin="0,0,0,8">Open Services &amp; Actions</Button>
                        <Button Style="{StaticResource SecondaryButton}" Click="Terminal_Click">Open terminal</Button>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource FlatCard}">
                <StackPanel>
                    <TextBlock Text="Shareable by design" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="No repository path, backup password, host mount or backup schedule is hard-coded into GraveOps. Configure those on the host or through protected actions; this page reports what the provider can safely observe." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
