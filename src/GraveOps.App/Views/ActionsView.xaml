<UserControl x:Class="GraveOps.App.Views.ActionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Operations &amp; troubleshooting" Style="{StaticResource PageHeading}" />
                <TextBlock Text="Health-aware actions, state comparison and one-click root-cause analysis." Style="{StaticResource PageSubheading}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="11,7">
                <TextBlock x:Name="TargetText" Text="Global target" Foreground="{StaticResource Muted}" />
            </Border>
        </Grid>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Action Center">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource FlatCard}" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Action library" Style="{StaticResource SectionHeading}" />
                            <ComboBox x:Name="CategoryCombo" Grid.Row="1" Margin="0,12,0,10" SelectionChanged="CategoryCombo_SelectionChanged" />
                            <ListBox x:Name="ActionList" Grid.Row="2" SelectionChanged="ActionList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Row}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,7">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource Muted}" FontSize="11" />
                                                    <TextBlock Text="  |  " Foreground="{StaticResource Dim}" />
                                                    <TextBlock Text="{Binding RiskLabel}" Foreground="{StaticResource Muted}" FontSize="11" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource FlatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="ActionName" Text="Select an action" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ActionDescription" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Select an action to review its purpose, risk, command and verified result." />
                                    </StackPanel>
                                    <Border Grid.Column="1" x:Name="RiskBadge" Background="{StaticResource Surface2}" CornerRadius="7" Padding="9,5">
                                        <TextBlock x:Name="RiskText" Text="--" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                            <Border Grid.Row="1" Background="{StaticResource Input}" CornerRadius="8" Padding="10" Margin="0,14,0,12">
                                <TextBlock x:Name="CommandText" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                            </Border>
                            <TabControl Grid.Row="2" Background="Transparent">
                                <TabItem Header="Result">
                                    <TextBox x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="180" />
                                </TabItem>
                                <TabItem Header="Before / After">
                                    <TextBox x:Name="CompareBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                </TabItem>
                            </TabControl>
                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Click="Run_Click">Run Action</Button>
                                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0" />
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Click="Snapshot_Click">Capture State</Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Incident / What's Wrong?">
                <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Border Style="{StaticResource FlatCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="ASSESSMENT" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="IncidentSeverityText" Text="READY" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,2" />
                                    <TextBlock Text="Dependency-aware analysis" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FlatCard}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="ROOT CAUSE" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="RootCauseText" Text="Not analyzed" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,2" TextWrapping="Wrap" />
                                    <TextBlock Text="First failing dependency wins" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FlatCard}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="TARGET" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="IncidentTargetText" Text="--" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,2" />
                                    <TextBlock Text="Uses global server context" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="One-click What's Wrong?" Style="{StaticResource SectionHeading}" />
                                        <TextBlock x:Name="IncidentHeadlineText" Text="Run Analyze to evaluate host reachability, storage, Docker, application health and dependency impact." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1">
                                        <Button x:Name="AnalyzeButton" Style="{StaticResource PrimaryButton}" Click="Analyze_Click" Margin="0,0,8,0">Analyze</Button>
                                        <Button Style="{StaticResource SecondaryButton}" Click="ExportIncident_Click">Export diagnostic bundle</Button>
                                    </WrapPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Findings &amp; recommendations" Style="{StaticResource Eyebrow}" Margin="0,16,0,7" />
                                <TextBox x:Name="IncidentOutputBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" MinHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource FlatCard}">
                            <StackPanel>
                                <TextBlock Text="Raw probe" Style="{StaticResource SectionHeading}" />
                                <TextBlock Text="Available for troubleshooting; the summary above is the primary result." Foreground="{StaticResource Muted}" Margin="0,4,0,8" />
                                <TextBox x:Name="IncidentRawBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="11" MinHeight="180" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>