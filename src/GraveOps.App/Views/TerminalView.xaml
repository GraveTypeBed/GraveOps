<UserControl x:Class="GraveOps.App.Views.TerminalView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource FlatCard}" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sessions" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="Single commands or full pasted blocks. Shift+Enter adds a line; Ctrl+Enter runs the entire block." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,12,0" />
                </StackPanel>
                <ComboBox x:Name="ServerCombo" Grid.Column="1" Margin="6,0" />
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Click="Ssh_Click">SSH</Button>
                <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="PowerShell_Click">PowerShell</Button>
                <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="Cmd_Click">CMD</Button>
                <Button Grid.Column="5" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="Clear_Click">Clear</Button>
                <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="Close_Click">Close tab</Button>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <TabControl x:Name="TerminalTabs" Background="Transparent" BorderThickness="0" />
        </Border>
    </Grid>
</UserControl>