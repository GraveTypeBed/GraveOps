<UserControl x:Class="GraveOps.App.Views.LogsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Log Center" Style="{StaticResource PageHeading}" />
                <TextBlock Text="Search, severity filters, repeat detection and live polling without leaving GraveOps." Style="{StaticResource PageSubheading}" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock x:Name="TargetText" Grid.Column="1" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SourceCombo" SelectionChanged="SourceCombo_SelectionChanged" />
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="8,0" Click="Load_Click">Load</Button>
            <ComboBox x:Name="SeverityCombo" Grid.Column="2" SelectionChanged="FilterChanged" />
            <TextBox x:Name="SearchBox" Grid.Column="3" Margin="8,0" ToolTip="Filter loaded lines" TextChanged="SearchBox_TextChanged" />
            <CheckBox x:Name="FollowCheck" Grid.Column="4" Content="Auto refresh" VerticalAlignment="Center" Margin="8,0" Checked="FollowCheck_Changed" Unchecked="FollowCheck_Changed" />
            <Button Grid.Column="5" Style="{StaticResource SecondaryButton}" Margin="8,0" Click="Copy_Click">Copy</Button>
            <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" Click="Export_Click">Export</Button>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource FlatCard}" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RepeatSummaryText" Text="No log loaded." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource Dim}" Margin="12,0,0,0" />
            </Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource FlatCard}" Padding="8">
            <Grid>
                <TextBox x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="320" />
                <TextBlock x:Name="LogsEmptyStateText" Text="Select a log source and press Load. The viewer expands only when there is something to inspect." Style="{StaticResource GoOrganizedEmptyState}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>