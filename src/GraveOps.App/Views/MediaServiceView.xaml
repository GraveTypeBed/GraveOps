<UserControl x:Class="GraveOps.App.Views.MediaServiceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="HeadingText" Text="Media service" Style="{StaticResource PageHeading}" />
                    <TextBlock x:Name="DescriptionText" Text="Direct service operations and telemetry." Foreground="{StaticResource GoTextSecondary}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TargetText" Foreground="{StaticResource GoTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="RefreshButton" Style="{StaticResource GoCompactPrimaryButton}" Click="Refresh_Click">Refresh</Button>
                </StackPanel>
            </Grid>
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource FlatCard}" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock x:Name="PrimaryLabelText" Text="STATE" Style="{StaticResource Eyebrow}" />
                        <TextBlock x:Name="PrimaryStateText" Text="--" FontSize="23" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FlatCard}" Margin="5,0">
                    <StackPanel>
                        <TextBlock x:Name="SecondaryLabelText" Text="VERSION" Style="{StaticResource Eyebrow}" />
                        <TextBlock x:Name="VersionText" Text="--" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FlatCard}" Margin="5,0">
                    <StackPanel>
                        <TextBlock x:Name="QueueLabelText" Text="QUEUE" Style="{StaticResource Eyebrow}" />
                        <TextBlock x:Name="QueueText" Text="--" FontSize="23" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FlatCard}" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="IssuesLabelText" Text="HEALTH ISSUES" Style="{StaticResource Eyebrow}" />
                        <TextBlock x:Name="IssuesText" Text="--" FontSize="23" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource GoInsetPanel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Operations" Style="{StaticResource SectionHeading}" />
                    <TextBlock x:Name="OperationsHintText" Text="The tools that belong to this service are kept here." Foreground="{StaticResource GoTextSecondary}" Margin="0,4,0,10" TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button x:Name="OpenPrimaryButton" Style="{StaticResource GoCompactPrimaryButton}" Click="OpenPrimary_Click" Margin="0,0,8,8">Open service</Button>
                        <Button x:Name="OpenSecondaryButton" Style="{StaticResource GoCompactSecondaryButton}" Click="OpenSecondary_Click" Visibility="Collapsed" Margin="0,0,8,8">Open companion</Button>
                        <Button x:Name="FullQueueButton" Style="{StaticResource GoCompactSecondaryButton}" Click="FullQueue_Click" Margin="0,0,8,8">Full queue drill-down</Button>
                        <Button x:Name="RestartPlexButton" Style="{StaticResource GoCompactSecondaryButton}" Click="RestartPlex_Click" Visibility="Collapsed" Margin="0,0,8,8">Restart Plex</Button>
                        <Button x:Name="DockerInspectButton" Style="{StaticResource GoCompactSecondaryButton}" Click="DockerInspect_Click" Margin="0,0,8,8">Docker / stack</Button>
                        <Button Style="{StaticResource GoCompactSecondaryButton}" Click="Logs_Click" Margin="0,0,8,8">Logs</Button>
                        <Button Style="{StaticResource GoCompactSecondaryButton}" Click="Terminal_Click" Margin="0,0,8,8">SSH terminal</Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Service telemetry" Style="{StaticResource SectionHeading}" />
                    <TextBlock x:Name="TelemetryHintText" Text="Current endpoint state, version, queue and health information." Foreground="{StaticResource GoTextSecondary}" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock x:Name="SampleText" Grid.Column="1" Text="--" Foreground="{StaticResource GoTextSecondary}" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl x:Name="ServiceCards">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding State}" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource GoTextSecondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Healthy">
                                                        <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Busy">
                                                        <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Degraded">
                                                        <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Stale">
                                                        <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Offline">
                                                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="ENDPOINT" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="{Binding HttpText}" />
                                    <TextBlock Text="{Binding LatencyText}" Foreground="{StaticResource GoTextSecondary}" FontSize="10" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="VERSION" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="{Binding VersionText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="WORK" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="{Binding QueueText}" />
                                    <TextBlock Text="{Binding IssuesText}" Foreground="{StaticResource GoTextSecondary}" FontSize="10" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding Detail}" Foreground="{StaticResource GoTextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0" />
                                <Button Grid.Column="5" Style="{StaticResource GoCompactSecondaryButton}" Content="Open" Tag="{Binding}" Click="CardOpen_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="PlexSessionsPanel" Style="{StaticResource FlatCard}" Visibility="Collapsed" Margin="0,2,0,10" Padding="12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Live sessions" Style="{StaticResource SectionHeading}" />
                            <TextBlock Text="Playback decisions, bandwidth and transcoder state are shown here without leaving Plex." Foreground="{StaticResource GoTextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="PlexLiveIndicatorCheck" Grid.Column="1" Content="LIVE - adaptive refresh" IsChecked="True" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
                    </Grid>
                    <Border Style="{StaticResource GoInsetPanel}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Secure Plex API access" FontWeight="SemiBold" />
                                <TextBlock x:Name="PlexTokenStatusText" Text="Checking saved Plex token..." Foreground="{StaticResource GoTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <PasswordBox x:Name="PlexTokenBox" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" ToolTip="Paste an X-Plex-Token. Saved tokens are never displayed." />
                            <Button Grid.Column="2" Style="{StaticResource GoCompactPrimaryButton}" Click="SavePlexToken_Click" Margin="0,0,8,0">Save + test</Button>
                            <Button x:Name="ClearPlexTokenButton" Grid.Column="3" Style="{StaticResource GoCompactSecondaryButton}" Click="ClearPlexToken_Click">Clear token</Button>
                        </Grid>
                    </Border>
                    <UniformGrid Columns="5" Margin="0,0,0,10">
                        <Border Style="{StaticResource GoInsetPanel}" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="SESSIONS" Style="{StaticResource Eyebrow}" />
                                <TextBlock x:Name="PlexSessionCountText" Text="--" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GoInsetPanel}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="DIRECT PLAY" Style="{StaticResource Eyebrow}" />
                                <TextBlock x:Name="PlexDirectPlayText" Text="--" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GoInsetPanel}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="DIRECT STREAM" Style="{StaticResource Eyebrow}" />
                                <TextBlock x:Name="PlexDirectStreamText" Text="--" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GoInsetPanel}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="TRANSCODE" Style="{StaticResource Eyebrow}" />
                                <TextBlock x:Name="PlexTranscodeText" Text="--" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GoInsetPanel}" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="BANDWIDTH" Style="{StaticResource Eyebrow}" />
                                <TextBlock x:Name="PlexBandwidthText" Text="--" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Grid MinHeight="190">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.7*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="PlexSessionsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="PlexSessionsGrid_SelectionChanged" RowStyle="{StaticResource GoDataGridRow}" CellStyle="{StaticResource GoDataGridCell}" RowHeight="30" ScrollViewer.HorizontalScrollBarVisibility="Auto" MinHeight="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="0.9*" />
                                <DataGridTextColumn Header="Media" Binding="{Binding Title}" Width="2.5*" />
                                <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="1*" />
                                <DataGridTextColumn Header="Client" Binding="{Binding Player}" Width="1*" />
                                <DataGridTextColumn Header="Progress" Binding="{Binding ProgressText}" Width="0.7*" />
                                <DataGridTextColumn Header="Bandwidth" Binding="{Binding BandwidthText}" Width="0.85*" />
                                <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="1.1*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Column="1" Style="{StaticResource GoSplitter}" x:Name="PlexSessionSplitter" />
                        <Border Grid.Column="2" Style="{StaticResource GoInsetPanel}" x:Name="PlexSessionDetailPanel">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="PlexSelectedSessionText" Text="Select a session for codec, client and transcode details." Foreground="{StaticResource GoTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBox x:Name="PlexSessionDetailBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Background="{StaticResource GoCanvas}" Foreground="{StaticResource GoText}" BorderBrush="{StaticResource GoBorder}" VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="PlexEmptyStateText" Grid.ColumnSpan="3" Text="No active Plex sessions. Live playback details will appear here automatically." Style="{StaticResource GoOrganizedEmptyState}" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="PlexSessionStatusText" Text="Live session telemetry pending." Foreground="{StaticResource GoTextSecondary}" Margin="0,9,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="QueueInlinePanel" Style="{StaticResource FlatCard}" Visibility="Collapsed" Margin="0,2,0,10" Padding="12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Queue &amp; health" Style="{StaticResource SectionHeading}" />
                            <TextBlock x:Name="QueueInlineHintText" Text="Item-level warnings and health messages for this service." Foreground="{StaticResource GoTextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GoCompactSecondaryButton}" Click="FullQueue_Click" VerticalAlignment="Center">Open full detail</Button>
                    </Grid>
                    <DataGrid x:Name="QueueInlineGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" RowStyle="{StaticResource GoDataGridRow}" CellStyle="{StaticResource GoDataGridCell}" RowHeight="30" MinHeight="150" MaxHeight="320" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="0.85*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="0.65*" />
                            <DataGridTextColumn Header="Item / issue" Binding="{Binding Title}" Width="2.4*" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="0.9*" />
                            <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="0.7*" />
                            <DataGridTextColumn Header="Remaining" Binding="{Binding Remaining}" Width="0.8*" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="QueueEmptyStateText" Text="Live queue detail is loading..." Style="{StaticResource GoOrganizedEmptyState}" Visibility="Collapsed" />
                    <TextBlock x:Name="QueueInlineStatusText" Text="Live queue detail pending." Foreground="{StaticResource GoTextSecondary}" Margin="0,9,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource GoSurface}" BorderBrush="{StaticResource GoBorder}" BorderThickness="1" CornerRadius="7" Padding="10">
                <TextBlock x:Name="StatusText" Text="Live telemetry ready." Foreground="{StaticResource GoTextSecondary}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>