                                            <Path Style="{StaticResource NavIcon}" Data="M3,3 L13,3 L13,13 L3,13 Z M5,6 L11,6 M5,9 L11,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                            <TextBlock Grid.Column="1" Text="Radarr" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        </Grid>
                                    </RadioButton>
