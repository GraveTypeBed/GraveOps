<Window x:Class="GraveOps.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:GraveOps.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="GraveOps" Icon="Assets/graveops-app.ico" Height="920" Width="1500" MinHeight="760" MinWidth="1180" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Backdrop}" SizeChanged="MainWindow_SizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource Bg}" BorderBrush="#2E2E34" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Custom title bar: fully dark, no dependency on icon-font glyphs. -->
            <Border Grid.Row="0" Background="#0B0D0F" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="24" Height="24"
                                CornerRadius="5"
                                Background="#000000"
                                BorderBrush="#34313F"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <Image Source="/GraveOps;component/Assets/graveops-brandmark.png"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="GraveOps" FontWeight="SemiBold" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center" />
                        
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="Minimize">
                            <Path Data="M2,7 L12,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Stretch="None" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="Maximize_Click" ToolTip="Maximize or restore">
                            <Path Data="M2.5,2.5 L11.5,2.5 L11.5,11.5 L2.5,11.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" Fill="Transparent" Stretch="None" />
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButton}" Click="Close_Click" ToolTip="Close">
                            <Path Data="M3,3 L11,11 M11,3 L3,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Round" Stretch="None" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavigationColumn" Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Navigation rail -->
                <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                    <Grid Margin="14,15,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource FlatCard}" Padding="13" Margin="0,0,0,17" Background="{StaticResource Surface}" Effect="{x:Null}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentTint}">
                                        <Path Data="M7,8 L19,8 M7,12 L19,12 M7,16 L15,16" Stroke="{StaticResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="CONTROL PLANE" Style="{StaticResource Eyebrow}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock x:Name="ConnectionText" Text="Ready" FontSize="12" Foreground="{StaticResource Success}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="ACTIVE TARGET" Style="{StaticResource Eyebrow}" Margin="0,13,0,5" />
                                <ComboBox x:Name="GlobalTargetCombo" SelectionChanged="GlobalTargetCombo_SelectionChanged" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="OVERVIEW" Style="{StaticResource Eyebrow}" Margin="10,0,0,6" />
                                <RadioButton x:Name="DashboardNav" GroupName="Navigation" IsChecked="True" Style="{StaticResource NavItem}" Click="Dashboard_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Style="{StaticResource NavIcon}" Data="M1,1 L7,1 L7,7 L1,7 Z M9,1 L15,1 L15,7 L9,7 Z M1,9 L7,9 L7,15 L1,15 Z M9,9 L15,9 L15,15 L9,15 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <TextBlock Grid.Column="1" Text="Dashboard" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </Grid>
                                </RadioButton>
                                <RadioButton x:Name="IntelligenceNav" GroupName="Navigation" Style="{StaticResource NavItem}" Click="IntelligenceNav_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Style="{StaticResource NavIcon}" Data="M8,1 L10,5 L15,6 L11.5,9.5 L12,15 L8,12.5 L4,15 L4.5,9.5 L1,6 L6,5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <TextBlock Grid.Column="1" Text="Intelligence" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </Grid>
                                </RadioButton>
                                <RadioButton x:Name="LifecycleOverviewNav" GroupName="Navigation" Style="{StaticResource NavItem}" Click="LifecycleOverview_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Path Style="{StaticResource NavIcon}" Data="M2,8 L5,8 M6,8 L9,8 M10,8 L14,8 M4,5 L6,8 L4,11 M8,5 L10,8 L8,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <TextBlock Grid.Column="1" Text="Lifecycle" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </Grid>
                                </RadioButton>
                                <RadioButton x:Name="HistoryNav" GroupName="Navigation" Style="{StaticResource NavItem}" Click="HistoryNav_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Path Style="{StaticResource NavIcon}" Data="M8,2 A6,6 0 1 1 3,5 M3,2 L3,6 L7,6 M8,5 L8,8 L11,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
