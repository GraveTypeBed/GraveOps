                                <Button Grid.Column="1" Style="{StaticResource GoIconButton}" Content="X" ToolTip="Close" Click="ActivityClose_Click" Width="36" Height="32" Padding="0" FontSize="16" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,14,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Show" Foreground="{StaticResource GoTextDim}" FontSize="10" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <ComboBox x:Name="ActivityFilterCombo" Grid.Column="1" Width="142" HorizontalAlignment="Left" SelectionChanged="ActivityFilter_SelectionChanged">
                                    <ComboBoxItem Content="All activity" Tag="ALL" IsSelected="True" />
                                    <ComboBoxItem Content="Warnings + errors" Tag="WARNINGS" />
                                    <ComboBoxItem Content="Errors only" Tag="ERRORS" />
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Clear history" Click="ActivityClear_Click" Padding="9,6" />
                            </Grid>
                            <ListBox x:Name="ActivityList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="ActivityList_SelectionChanged" MouseDoubleClick="ActivityList_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="{StaticResource GoText}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,2" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemRoot" Background="{TemplateBinding Background}" BorderBrush="{StaticResource GoBorder}" BorderThickness="0,0,0,1" CornerRadius="5" Padding="7,10">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource GoSurfaceHover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource GoSurfaceSelected}" />
                                                            <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource GoAccent}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource GoTextDim}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Margin="0,2,8,0" />
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource GoTextSecondary}" FontSize="10" TextWrapping="Wrap" MaxHeight="34" ToolTip="{Binding Detail}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <Border CornerRadius="8" Padding="7,2" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource GoSurfaceRaised}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource GoBorder}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusText}" Value="SUCCESS">
                                                                    <Setter Property="Background" Value="{StaticResource GoSuccessBg}" />
                                                                    <Setter Property="BorderBrush" Value="#28583E" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusText}" Value="WARNING">
                                                                    <Setter Property="Background" Value="{StaticResource GoWarningBg}" />
                                                                    <Setter Property="BorderBrush" Value="#6A5733" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusText}" Value="ERROR">
                                                                    <Setter Property="Background" Value="{StaticResource GoDangerBg}" />
                                                                    <Setter Property="BorderBrush" Value="#6D3238" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusText}" Value="INFO">
                                                                    <Setter Property="Background" Value="{StaticResource GoInfoBg}" />
                                                                    <Setter Property="BorderBrush" Value="#65566D" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource GoTextSecondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="SUCCESS">
                                                                        <Setter Property="Foreground" Value="{StaticResource GoSuccess}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="WARNING">
                                                                        <Setter Property="Foreground" Value="{StaticResource GoWarning}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="ERROR">
                                                                        <Setter Property="Foreground" Value="{StaticResource GoDanger}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="INFO">
                                                                        <Setter Property="Foreground" Value="{StaticResource GoInfo}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource GoTextDim}" FontSize="9" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border x:Name="SelectedActivityPanel" Grid.Row="3" Background="{StaticResource GoSurfaceRaised}" BorderBrush="{StaticResource GoBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="SELECTED EVENT" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="SelectedActivityTitleText" FontWeight="SemiBold" FontSize="13" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="SelectedActivityDetailText" Foreground="{StaticResource GoTextSecondary}" FontFamily="Cascadia Mono, Consolas" FontSize="10" TextWrapping="Wrap" MaxHeight="52" Margin="0,4,0,10" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="ActivityOpenRelatedButton" Style="{StaticResource GoCompactPrimaryButton}" Content="Open related" Click="ActivityOpenSelected_Click" IsEnabled="False" Margin="0,0,6,0" />
                                            <Button x:Name="ActivityViewDiffButton" Style="{StaticResource GoCompactSecondaryButton}" Content="View diff" Click="ActivityViewDiff_Click" IsEnabled="False" Margin="0,0,6,0" />
                                            <Button x:Name="ActivityRestorePreviousButton" Style="{StaticResource GoCompactDangerButton}" Content="Restore previous" Click="ActivityRestorePrevious_Click" IsEnabled="False" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0">
                                            <Button x:Name="ActivityCopyDetailsButton" Style="{StaticResource GoCompactSecondaryButton}" Content="Copy details" Click="ActivityCopySelected_Click" IsEnabled="False" Margin="0,0,6,0" />
                                            <Button x:Name="ActivityOpenCopiesButton" Style="{StaticResource GoCompactSecondaryButton}" Content="Open copies" Click="ActivityRollbackFolder_Click" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>