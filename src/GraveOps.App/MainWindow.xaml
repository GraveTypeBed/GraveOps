                                            <Path Style="{StaticResource NavIcon}" Data="M4,3 L12,3 L12,11 C12,13 10,14 8.5,13 C7,12 8,10 10,10 L10,5 L6,6 L6,12 C6,14 4,15 2.5,14 C1,13 2,11 4,11 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                            <TextBlock Grid.Column="1" Text="Lidarr" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
