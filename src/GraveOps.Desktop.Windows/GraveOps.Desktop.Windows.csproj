<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GraveOps.Avalonia.Windows</AssemblyName>
    <RootNamespace>GraveOps.Desktop.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GraveOps.Core\GraveOps.Core.csproj" />
    <ProjectReference Include="..\GraveOps.Presentation.Avalonia\GraveOps.Presentation.Avalonia.csproj" />
    <ProjectReference Include="..\GraveOps.Platform.Windows\GraveOps.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
