<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dashboard="using:GraveOps.Presentation.Avalonia.Dashboard"
    xmlns:shell="using:GraveOps.Presentation.Avalonia.Shell"
    x:Class="GraveOps.Desktop.Windows.MainWindow"
    x:CompileBindings="False"
    Title="GraveOps"
    Icon="/Assets/graveops-brandmark.png"
    Width="1500"
    Height="920"
    MinWidth="1180"
    MinHeight="760"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="38"
    KeyDown="MainWindow_OnKeyDown"
    Background="{DynamicResource BackdropBrush}">

  <Border
      Background="{DynamicResource BackgroundBrush}"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="1">

    <Grid RowDefinitions="38,*">
      <Border
          x:Name="LegacyTitleBar"
          Grid.Row="0"
          Background="{DynamicResource HeaderBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,0,0,1">

        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel
              Orientation="Horizontal"
              VerticalAlignment="Center"
              Margin="14,0,0,0">

            <Image
                x:Name="LegacyBrandImage"
                Width="24"
                Height="24"
                Source="/Assets/graveops-brandmark.png"
                Stretch="Uniform"
                VerticalAlignment="Center" />

            <TextBlock
                Text="GraveOps"
                FontWeight="SemiBold"
                FontSize="12"
                Margin="9,0,0,0"
                VerticalAlignment="Center" />

            <TextBlock
                Text="Control Center"
                Classes="dim"
                FontSize="11"
                Margin="7,0,0,0"
                VerticalAlignment="Center" />
          </StackPanel>

          <Border
              Grid.Column="1"
              Background="Transparent"
              PointerPressed="TitleDragRegion_OnPointerPressed"
              DoubleTapped="TitleDragRegion_OnDoubleTapped" />

          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Classes="titlebar" ToolTip.Tip="Minimize" Click="Minimize_Click">
              <Path
                  Data="M2,7 L12,7"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2"
                  Stretch="None" />
            </Button>

            <Button Classes="titlebar" ToolTip.Tip="Maximize or restore" Click="Maximize_Click">
              <Path
                  Data="M2.5,2.5 L11.5,2.5 L11.5,11.5 L2.5,11.5 Z"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.1"
                  Fill="Transparent"
                  Stretch="None" />
            </Button>

            <Button Classes="titlebar close" ToolTip.Tip="Close" Click="Close_Click">
              <Path
                  Data="M3,3 L11,11 M11,3 L3,11"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2"
                  StrokeLineCap="Round"
                  Stretch="None" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid
          x:Name="LegacyBody"
          Grid.Row="1"
          ColumnDefinitions="260,*">
        <Border
            Grid.Column="0"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">

          <Grid RowDefinitions="Auto,*,Auto" Margin="14,15,14,14">
            <Border Classes="flatCard" Padding="12" Margin="0,0,0,17">
              <StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                  <Border
                      Width="34"
                      Height="34"
                      CornerRadius="9"
                      Background="{DynamicResource AccentTintBrush}">
                    <Path
                        Data="M7,8 L19,8 M7,12 L19,12 M7,16 L15,16"
                        Stroke="{DynamicResource AccentBrush}"
                        StrokeThickness="1.6"
                        StrokeLineCap="Round"
                        Stretch="None"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                  </Border>

                  <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CONTROL PLANE" Classes="eyebrow" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Spacing="7">
                      <TextBlock
                          x:Name="ConnectionDot"
                          Text="o"
                          FontSize="9"
                          Foreground="{DynamicResource WarnBrush}" />
                      <TextBlock
                          x:Name="ConnectionText"
                          Text="CHECKING"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource WarnBrush}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="ConnectionDetailText"
                        Text="Native Windows provider"
                        Classes="dim"
                        FontSize="9"
                        Margin="0,3,0,0"
                        TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="ACTIVE SERVER" Classes="eyebrow" Margin="0,13,0,5" />

                <ComboBox
                    x:Name="ActiveTargetComboBox"
                    MinHeight="50"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="ActiveTargetComboBox_OnSelectionChanged">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <StackPanel Spacing="1">
                        <TextBlock
                            Text="{ReflectionBinding DisplayName}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{ReflectionBinding ConnectionSummary}"
                            Classes="dim"
                            FontSize="9.5"
                            TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel IsVisible="False">
                  <TextBlock x:Name="SidebarHostname" />
                  <TextBlock x:Name="SidebarOperatingSystem" />
                </StackPanel>
              </StackPanel>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                x:Name="SidebarNavigationScrollViewer"
                ClipToBounds="True"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="OVERVIEW" Classes="eyebrow" Margin="10,0,0,6" />

                <Button x:Name="DashboardNav" Classes="nav selected" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M1,1 L7,1 L7,7 L1,7 Z M9,1 L15,1 L15,7 L9,7 Z M1,9 L7,9 L7,15 L1,15 Z M9,9 L15,9 L15,15 L9,15 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Dashboard" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="IntelligenceNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M8,1 L10,5 L15,6 L11.5,9.5 L12,15 L8,12.5 L4,15 L4.5,9.5 L1,6 L6,5 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" StrokeJoin="Round" />
                    <TextBlock Grid.Column="1" Text="Health &amp; Findings" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>



                <Button x:Name="HistoryNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M8,2 A6,6 0 1 1 3,5 M3,2 L3,6 L7,6 M8,5 L8,8 L11,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" StrokeLineCap="Round" StrokeJoin="Round" />
                    <TextBlock Grid.Column="1" Text="Activity &amp; Incidents" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="ServersNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,2 L14,2 L14,7 L2,7 Z M2,9 L14,9 L14,14 L2,14 Z M4,4.5 L5.5,4.5 M4,11.5 L5.5,11.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Hosts &amp; Connections" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <TextBlock Text="MEDIA" Classes="eyebrow" Margin="10,15,0,6" />

                <Button x:Name="MediaHubNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,2 L7,2 L7,7 L2,7 Z M9,2 L14,2 L14,7 L9,7 Z M2,9 L7,9 L7,14 L2,14 Z M9,9 L14,9 L14,14 L9,14 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Media Hub" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

<Button x:Name="LifecycleNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,8 L5,8 M6,8 L9,8 M10,8 L14,8 M4,5 L6,8 L4,11 M8,5 L10,8 L8,11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" StrokeLineCap="Round" />
                    <TextBlock Grid.Column="1" Text="Lifecycle" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="LibraryGroupButton"
                    Classes="navGroup"
                    IsVisible="True"
                    Click="LibraryGroupButton_OnClick">
                  <Grid ColumnDefinitions="18,*">
                    <Path
                        x:Name="LibraryGroupGlyph"
                        Width="12"
                        Height="12"
                        Data="M2,4 L6,8 L10,4"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round"
                        Stretch="Uniform" />
                    <TextBlock Grid.Column="1" Text="LIBRARY" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <StackPanel x:Name="LibraryNavGroup" IsVisible="True">
                  <Button
                      x:Name="PlexNav"
                      Classes="nav sub"
                      IsVisible="True"
                      Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*">
                      <Path
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Data="M3,2 L8.2,2 L13,8 L8.2,14 L3,14 L8.1,8 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stroke="Transparent"
                          StrokeThickness="0" />
                      <TextBlock
                          Grid.Column="1"
                          Text="Plex"
                          VerticalAlignment="Center"
                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Grid>
                  </Button>
                </StackPanel>

                <Button
                    x:Name="AcquisitionGroupButton"
                    Classes="navGroup"
                    IsVisible="True"
                    Click="AcquisitionGroupButton_OnClick">
                  <Grid ColumnDefinitions="18,*">
                    <Path
                        x:Name="AcquisitionGroupGlyph"
                        Width="12"
                        Height="12"
                        Data="M2,4 L6,8 L10,4"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round"
                        Stretch="Uniform" />
                    <TextBlock Grid.Column="1" Text="ACQUISITION" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <StackPanel x:Name="AcquisitionNavGroup" IsVisible="True">

                <Button
                    x:Name="SonarrNav"
                    Classes="nav sub"
                    IsVisible="True"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,2 L14,2 L14,14 L2,14 Z M5,5 L11,5 M5,8 L11,8 M5,11 L9,11"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Sonarr"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="RadarrNav"
                    Classes="nav sub"
                    IsVisible="True"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,3 L14,3 L14,13 L2,13 Z M5,6 L11,6 M5,9 L11,9"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Radarr"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="LidarrNav"
                    Classes="nav sub"
                    IsVisible="True"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M3,3 L13,3 L13,13 L3,13 Z M6,6 A2,2 0 1 0 10,6 A2,2 0 1 0 6,6 M6,11 L10,11"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Lidarr"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="ProwlarrNav"
                    Classes="nav sub"
                    IsVisible="True"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,4 L14,4 M2,8 L14,8 M2,12 L14,12 M5,2 L5,14 M11,2 L11,14"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Prowlarr"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="SABnzbdNav"
                    Classes="nav sub"
                    IsVisible="True"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,3 L14,3 L14,13 L2,13 Z M4,6 L12,6 M4,9 L10,9 M4,11 L8,11"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="SABnzbd"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>


                <Button
                    x:Name="QBittorrentNav"
                    Classes="nav sub"
                    IsVisible="True"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,3 L14,3 L14,13 L2,13 Z M4,6 L7,8 L4,10 M8,10 L11,10"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="qBittorrent"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>
                </StackPanel>

                <TextBlock Text="SYSTEM" Classes="eyebrow" Margin="10,15,0,6" />

                <Button x:Name="ServicesNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,3 L14,3 L14,7 L2,7 Z M2,9 L14,9 L14,13 L2,13 Z M4,5 L5.5,5 M4,11 L5.5,11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Services &amp; Actions" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="DockerNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,7 L5,7 L5,10 L2,10 Z M6,7 L9,7 L9,10 L6,10 Z M10,7 L13,7 L13,10 L10,10 Z M4,3 L7,3 L7,6 L4,6 Z M8,3 L11,3 L11,6 L8,6 Z M1,11 C4,15 11,15 15,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Docker" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="StorageNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,3 C2,1 14,1 14,3 L14,13 C14,15 2,15 2,13 Z M2,3 C2,5 14,5 14,3 M2,8 C2,10 14,10 14,8"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Storage" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="LogsNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,4 L14,4 M2,8 L11,8 M2,12 L13,12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Logs" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="BackupsNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M8,2 A6,6 0 1 1 3,5 M3,2 L3,6 L7,6"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Backups" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <TextBlock Text="OPERATOR" Classes="eyebrow" Margin="10,15,0,6" />

                <Button x:Name="SettingsNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,4 L14,4 M5,2 L5,6 M2,8 L14,8 M10,6 L10,10 M2,12 L14,12 M7,10 L7,14"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="ToolsNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,3 L14,3 L14,13 L2,13 Z M4,6 L7,8 L4,10 M8,10 L11,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Operator Tools" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="IntegrationsNav" IsVisible="False" />
                <Button x:Name="WarningsNav" IsVisible="False" />
              </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="10,12,0,0">
              <TextBlock Text="GRAVEOPS" Classes="eyebrow" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="Native + remote providers" Classes="dim" FontSize="10" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid
            x:Name="LegacyMainShellGrid"
            Grid.Column="1"
            RowDefinitions="72,42,*,26"
            Background="{DynamicResource BackgroundBrush}">

          <Border
              Grid.Row="0"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto" Margin="28,0">
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PageTitleText" Text="Dashboard" FontSize="22" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="PageSubtitleText"
                    Text="Interactive environment health, ownership and active-host operations"
                    Classes="pageSubtitle"
                    Margin="0,3,0,0" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
                <Button x:Name="OverviewButton" Classes="compact headerCommand commandOverview" MinWidth="68"
                        Content="Overview" Click="OverviewButton_OnClick" />
                <Button x:Name="JobsButton" Classes="compact headerCommand commandJobs" MinWidth="52"
                        Content="Jobs" Click="JobsButton_OnClick" />
                <Button x:Name="IntelligenceButton" Classes="compact headerCommand commandIntelligence" MinWidth="84"
                        Content="Findings" Tag="IntelligenceNav"
                        Click="DashboardQuickModuleButton_OnClick" />
                <Button x:Name="ActivityButton" Classes="compact headerCommand commandActivity" MinWidth="72"
                        Content="Activity" Click="ActivityButton_OnClick" />
                <Button Classes="compact headerCommand commandTerminal" MinWidth="88"
                        Content="Terminal" Tag="ToolsNav"
                        Click="DashboardQuickModuleButton_OnClick" />

                <Button
                    x:Name="RefreshButton"
                    IsVisible="False"
                    Classes="primary compact"
                    MinWidth="96"
                    Content="Refresh host"
                    Click="RefreshButton_OnClick" />

                <TextBlock
                    x:Name="LastUpdatedText"
                    IsVisible="False" />
              </StackPanel>
            </Grid>
          </Border>

          <Border
              Grid.Row="1"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="28,0">
              <TextBlock Text="QUICK" Classes="eyebrow" VerticalAlignment="Center" Margin="0,0,12,0" />
              <Button Grid.Column="1" x:Name="MaintenanceButton" Classes="ghost"
                      Content="Maintenance" Padding="10,6" Click="MaintenanceButton_OnClick" />
              <TextBlock Grid.Column="3" Text="Ctrl+K search" Classes="dim" FontSize="10"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Grid.Column="4" x:Name="CommandPaletteButton" Classes="ghost"
                      Content="Search" Padding="8,4" Click="CommandPaletteButton_OnClick" />
              <Button Grid.Column="5" Classes="ghost" Content="Customize" Tag="SettingsNav"
                      Padding="8,4" Click="DashboardQuickModuleButton_OnClick" />

              <TextBlock
                  x:Name="CaptureStatusText"
                  IsVisible="False" />
            </Grid>
          </Border>

          <Grid
              x:Name="LegacyPageHost"
              Grid.Row="2"
              Margin="24">
            <Grid x:Name="DashboardPage" IsVisible="True">
              <dashboard:UnifiedDashboardView
                  x:Name="SharedDashboardView" />
              <ScrollViewer x:Name="LegacyWindowsDashboardScrollViewer" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="System overview" Classes="sectionTitle" />
                      <TextBlock
                          Text="Live host identity, health, workload and Windows discovery."
                          Classes="pageSubtitle"
                          Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        x:Name="DashboardCaptureAgeText"
                        Text="Waiting for capture"
                        Classes="dim"
                        VerticalAlignment="Center" />
                  </Grid>

                  <WrapPanel Orientation="Horizontal">
                    <Border Classes="flatCard" Width="235" MinHeight="96" Margin="0,0,8,8">
                      <StackPanel>
                        <TextBlock Text="CONNECTION" Classes="eyebrow" />
                        <TextBlock x:Name="DashboardConnectionText" Text="CHECKING" Classes="metricValue" Margin="0,9,0,2" />
                        <TextBlock x:Name="DashboardConnectionSummaryText" Text="Waiting for host state"
                                   Classes="dim" FontSize="10.5" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Classes="flatCard" Width="235" MinHeight="96" Margin="0,0,8,8">
                      <StackPanel>
                        <TextBlock Text="HEALTH" Classes="eyebrow" />
                        <TextBlock x:Name="DashboardAttentionCountText" Text="0" Classes="metricValue" Margin="0,9,0,2" />
                        <TextBlock x:Name="DashboardHealthSummaryText" Text="Waiting for health state"
                                   Classes="dim" FontSize="10.5" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Classes="flatCard" Width="235" MinHeight="96" Margin="0,0,8,8">
                      <StackPanel>
                        <TextBlock Text="STORAGE" Classes="eyebrow" />
                        <TextBlock x:Name="DashboardStorageCountText" Text="--" Classes="metricValue" Margin="0,9,0,2" />
                        <TextBlock x:Name="DashboardStorageSummaryText" Text="Waiting for volume state"
                                   Classes="dim" FontSize="10.5" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Classes="flatCard" Width="235" MinHeight="96" Margin="0,0,8,8">
                      <StackPanel>
                        <TextBlock Text="DOCKER" Classes="eyebrow" />
                                                <TextBlock
                            x:Name="DashboardDockerText"
                            Text="CHECKING"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Margin="0,9,0,2"
                            TextWrapping="Wrap"
                            MaxHeight="38" />
                        <TextBlock x:Name="DashboardDockerSummaryText" Text="Selected-host container state"
                                   Classes="dim" FontSize="10.5" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </WrapPanel>

                  <Grid ColumnDefinitions="2.1*,1*" ColumnSpacing="10">
                    <Border Classes="card" MinHeight="205">
                      <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <StackPanel>
                          <TextBlock Text="Recommendations" Classes="sectionTitle" />
                          <TextBlock
                              Text="Prioritized from the latest Windows provider snapshot."
                              Classes="pageSubtitle"
                              Margin="0,3,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                          <ListBox
                              x:Name="DashboardRecommendationsList"
                              Classes="dataList"
                              MinHeight="120"
                              MaxHeight="205">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Border Classes="selectionRow" Margin="0,0,0,5">
                                  <Grid ColumnDefinitions="78,120,*,Auto" ColumnSpacing="10">
                                    <TextBlock
                                        Text="{ReflectionBinding Severity}"
                                        Foreground="{DynamicResource WarnBrush}"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{ReflectionBinding Component}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{ReflectionBinding Message}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{ReflectionBinding Evidence}"
                                        Classes="dim"
                                        FontSize="9.5"
                                        TextTrimming="CharacterEllipsis" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>

                          <Border x:Name="DashboardRecommendationsEmptyPanel" Classes="emptyState" IsVisible="True">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                              <Border
                                  Width="38"
                                  Height="38"
                                  CornerRadius="19"
                                  Background="{DynamicResource SuccessTintBrush}"
                                  BorderBrush="#1C5A32"
                                  BorderThickness="1"
                                  VerticalAlignment="Center">
                                <TextBlock
                                    Text="✓"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="No recommendations" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="The latest read-only snapshot did not produce actionable findings."
                                    Classes="muted"
                                    TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </Grid>
                      </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="card" MinHeight="205">
                      <StackPanel Spacing="10">
                        <StackPanel>
                          <TextBlock Text="Active host" Classes="sectionTitle" />
                          <TextBlock Text="Native Windows provider identity." Classes="pageSubtitle" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Classes="inset">
                          <StackPanel Spacing="4">
                            <TextBlock x:Name="DashboardHostnameText" Text="Loading..." FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="DashboardOsText" Text="--" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock x:Name="DashboardAddressText" Text="--" Classes="mono" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                          <Border Classes="inset">
                            <StackPanel>
                              <TextBlock Text="UPTIME" Classes="eyebrow" />
                              <TextBlock x:Name="DashboardUptimeText" Text="--" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                          </Border>
                          <Border Grid.Column="1" Classes="inset">
                            <StackPanel>
                              <TextBlock Text="MEMORY" Classes="eyebrow" />
                              <TextBlock x:Name="DashboardMemoryText" Text="--" FontSize="11"
                                         FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Border Classes="card">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="Live workload" Classes="sectionTitle" />
                          <TextBlock Text="Shared snapshot counts; no extra repair or destructive probes."
                                     Classes="pageSubtitle" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Latest active-host sample" Classes="dim" VerticalAlignment="Center" />
                      </Grid>

                      <WrapPanel Orientation="Horizontal">
                        <Border Classes="inset" Width="180" Margin="0,0,8,0">
                          <StackPanel>
                            <TextBlock Text="SERVICES" Classes="eyebrow" />
                            <TextBlock x:Name="DashboardServiceCountText" Text="--" FontSize="22" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Classes="inset" Width="180" Margin="0,0,8,0">
                          <StackPanel>
                            <TextBlock Text="CONTAINERS" Classes="eyebrow" />
                            <TextBlock x:Name="DashboardContainerCountText" Text="--" FontSize="22" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Classes="inset" Width="180" Margin="0,0,8,0">
                          <StackPanel>
                            <TextBlock Text="INTEGRATIONS" Classes="eyebrow" />
                            <TextBlock x:Name="DashboardIntegrationCountText" Text="--" FontSize="22" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Classes="inset" Width="180" Margin="0,0,8,0">
                          <StackPanel>
                            <TextBlock Text="WARNINGS" Classes="eyebrow" />
                            <TextBlock x:Name="DashboardWarningCountText" Text="--" FontSize="22" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Classes="inset" Width="230">
                          <StackPanel>
                            <TextBlock Text="SYSTEM STATE" Classes="eyebrow" />
                            <TextBlock x:Name="DashboardSystemStateText" Text="--" FontSize="17"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Grid ColumnDefinitions="2.1*,1*" ColumnSpacing="10">
                    <Border Classes="card" MinHeight="190">
                      <StackPanel Spacing="11">
                        <StackPanel>
                          <TextBlock Text="System health" Classes="sectionTitle" />
                          <TextBlock Text="Canonical read-only health summary from the Windows snapshot."
                                     Classes="pageSubtitle" Margin="0,3,0,0" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="7">
                          <Border Classes="healthPass">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel>
                                <TextBlock Text="PASS" Foreground="{DynamicResource SuccessBrush}"
                                           FontSize="10.5" FontWeight="SemiBold" />
                                <TextBlock Text="Healthy checks" Classes="dim" FontSize="9.5" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" x:Name="DashboardHealthPassText" Text="--"
                                         FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                          </Border>

                          <Border Grid.Column="1" Classes="healthWarn">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel>
                                <TextBlock Text="WARN" Foreground="{DynamicResource WarnBrush}"
                                           FontSize="10.5" FontWeight="SemiBold" />
                                <TextBlock Text="Needs review" Classes="dim" FontSize="9.5" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" x:Name="DashboardHealthWarnText" Text="--"
                                         FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                          </Border>

                          <Border Grid.Column="2" Classes="healthFail">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel>
                                <TextBlock Text="FAIL" Foreground="{DynamicResource DangerBrush}"
                                           FontSize="10.5" FontWeight="SemiBold" />
                                <TextBlock Text="Action required" Classes="dim" FontSize="9.5" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" x:Name="DashboardHealthFailText" Text="--"
                                         FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                          </Border>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card" MinHeight="190">
                      <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <StackPanel>
                          <TextBlock Text="Recent activity" Classes="sectionTitle" />
                          <TextBlock Text="Latest meaningful preview operations." Classes="pageSubtitle" Margin="0,3,0,0" />
                        </StackPanel>
                        <ListBox
                            Grid.Row="1"
                            x:Name="DashboardActivityList"
                            Classes="dataList"
                            MinHeight="110"
                            MaxHeight="180">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                              <Border Classes="selectionRow" Margin="0,0,0,5">
                                <StackPanel Spacing="2">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{ReflectionBinding Title}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{ReflectionBinding Time}" Classes="dim" FontSize="9.5" />
                                  </Grid>
                                  <TextBlock Text="{ReflectionBinding Detail}" Classes="muted" FontSize="10"
                                             TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </Grid>
                    </Border>
                  </Grid>

                  <Border Classes="card" Margin="0,0,0,4">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                      <StackPanel>
                        <TextBlock Text="Storage fleet" Classes="sectionTitle" />
                        <TextBlock Text="All ready Windows volumes reported by the native provider."
                                   Classes="pageSubtitle" Margin="0,3,0,0" />
                      </StackPanel>
                      <ListBox
                          Grid.Row="1"
                          x:Name="DashboardStorageList"
                          Classes="dataList"
                          MinHeight="150"
                          MaxHeight="260">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Border Classes="selectionRow" Margin="0,0,0,5">
                              <Grid ColumnDefinitions="80,90,110,110,110,90,*" ColumnSpacing="10">
                                <TextBlock Text="{ReflectionBinding MountPoint}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{ReflectionBinding FileSystem}" Classes="muted" />
                                <TextBlock Grid.Column="2" Text="{ReflectionBinding Used}" />
                                <TextBlock Grid.Column="3" Text="{ReflectionBinding Size}" Classes="muted" />
                                <TextBlock Grid.Column="4" Text="{ReflectionBinding Available}" Classes="muted" />
                                <TextBlock Grid.Column="5" Text="{ReflectionBinding PercentUsed}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="6" Text="{ReflectionBinding Source}" Classes="dim"
                                           TextTrimming="CharacterEllipsis" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <Grid x:Name="ServicesPage" IsVisible="False">
              <Border Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                  <StackPanel>
                    <TextBlock Text="Windows services" Classes="sectionTitle" />
                    <TextBlock Text="Cataloged GraveOps-related services discovered by the native provider."
                               Classes="pageSubtitle" Margin="0,3,0,0" />
                  </StackPanel>
                  <ListBox Grid.Row="1" x:Name="ServicesList" Classes="dataList">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Classes="selectionRow" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="240,130,130,130,*" ColumnSpacing="12">
                            <TextBlock Text="{ReflectionBinding Unit}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding ActiveState}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding SubState}" Classes="muted" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding UnitFileState}" Classes="muted" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Description}" Classes="dim"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>

            <Grid x:Name="DockerPage" IsVisible="False">
              <Border Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                  <StackPanel>
                    <TextBlock Text="Docker containers" Classes="sectionTitle" />
                    <TextBlock x:Name="DockerPageSummaryText" Text="Container discovery pending."
                               Classes="pageSubtitle" Margin="0,3,0,0" />
                  </StackPanel>
                  <ListBox Grid.Row="1" x:Name="ContainersList" Classes="dataList">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Classes="selectionRow" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="210,120,280,*,180" ColumnSpacing="12">
                            <TextBlock Text="{ReflectionBinding Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding State}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Image}" Classes="muted"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Status}" Classes="dim"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Ports}" Classes="mono"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>

            <Grid x:Name="StoragePage" IsVisible="False">
              <Border Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                  <StackPanel>
                    <TextBlock Text="Windows storage" Classes="sectionTitle" />
                    <TextBlock Text="Ready volumes and capacity evidence. No mount or filesystem actions are available."
                               Classes="pageSubtitle" Margin="0,3,0,0" />
                  </StackPanel>
                  <ListBox Grid.Row="1" x:Name="StorageList" Classes="dataList">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Classes="selectionRow" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="90,100,130,130,130,100,*" ColumnSpacing="12">
                            <TextBlock Text="{ReflectionBinding MountPoint}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding FileSystem}" Classes="muted" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Used}" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Size}" Classes="muted" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Available}" Classes="muted" />
                            <TextBlock Grid.Column="5" Text="{ReflectionBinding PercentUsed}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="6" Text="{ReflectionBinding Source}" Classes="dim"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>

<Grid x:Name="IntegrationsPage" IsVisible="False">
              <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="Media application fleet" Classes="sectionTitle" />
                      <TextBlock
                          Text="Detected Windows media applications and read-only provider evidence."
                          Classes="pageSubtitle"
                          Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                      <Border Classes="statusBadge">
                        <TextBlock
                            x:Name="MediaHubDetectedCountText"
                            Text="0 detected"
                            Foreground="{DynamicResource AccentBrush}" />
                      </Border>
                      <Border Classes="statusBadge">
                        <TextBlock
                            x:Name="MediaHubRunningCountText"
                            Text="0 running"
                            Foreground="{DynamicResource SuccessBrush}" />
                      </Border>
                    </StackPanel>
                  </Grid>

                  <Border
                      Grid.Row="1"
                      x:Name="MediaHubEmptyPanel"
                      Classes="emptyState"
                      IsVisible="True">
                    <StackPanel Spacing="5">
                      <TextBlock
                          Text="No media applications were detected."
                          FontWeight="SemiBold" />
                      <TextBlock
                          Text="Installed applications, Windows processes, services and Docker containers are checked without changing the host."
                          Classes="muted"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <ListBox
                      Grid.Row="2"
                      x:Name="IntegrationsList"
                      Classes="dataList"
                      IsVisible="False">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Classes="selectionRow" Margin="0,0,0,7" Padding="13">
                          <Grid ColumnDefinitions="190,150,130,*" ColumnSpacing="14">
                            <StackPanel Spacing="3">
                              <TextBlock
                                  Text="{ReflectionBinding Name}"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                  Text="Windows media application"
                                  Classes="dim"
                                  FontSize="9.5" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="3">
                              <TextBlock Text="DISCOVERY" Classes="eyebrow" />
                              <TextBlock
                                  Text="{ReflectionBinding Kind}"
                                  Classes="muted"
                                  TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="3">
                              <TextBlock Text="STATE" Classes="eyebrow" />
                              <TextBlock
                                  Text="{ReflectionBinding State}"
                                  Foreground="{DynamicResource SuccessBrush}"
                                  FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="3">
                              <TextBlock Text="EVIDENCE" Classes="eyebrow" />
                              <TextBlock
                                  Text="{ReflectionBinding Evidence}"
                                  Classes="mono"
                                  FontSize="10"
                                  TextWrapping="Wrap"
                                  MaxHeight="42" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>

            <Grid x:Name="PlexPage" IsVisible="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border
                          Width="44"
                          Height="44"
                          CornerRadius="10"
                          Background="{DynamicResource AccentTintBrush}">
                        <Path
                            Width="23"
                            Height="23"
                            Stretch="Uniform"
                            Data="M3,2 L8.2,2 L13,8 L8.2,14 L3,14 L8.1,8 Z"
                            Fill="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                      </Border>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="Plex Media Server" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="PlexTargetText"
                            Text="Local Windows"
                            Classes="pageSubtitle" />
                        <TextBlock
                            x:Name="PlexFreshnessText"
                            Text="CHECKING..."
                            Classes="dim"
                            FontSize="10" />
                      </StackPanel>

                      <StackPanel
                          Grid.Column="2"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                        <Button
                            Classes="compact"
                            Content="Open Plex"
                            Click="PlexOpenButton_OnClick" />
                        <Button
                            Classes="primary compact"
                            Content="Refresh"
                            Click="PlexRefreshButton_OnClick" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Border Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="SERVICE" Classes="eyebrow" />
                        <TextBlock
                            x:Name="PlexServiceText"
                            Text="CHECKING"
                            FontSize="17"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="PlexServiceDetailText"
                            Text="Waiting for API identity"
                            Classes="dim"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="VERSION" Classes="eyebrow" />
                        <TextBlock
                            x:Name="PlexVersionText"
                            Text="--"
                            FontSize="17"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="PlexConnectionText"
                            Text="Waiting for Plex API"
                            Classes="dim"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="ACTIVE SESSIONS" Classes="eyebrow" />
                        <TextBlock
                            x:Name="PlexActiveSessionsText"
                            Text="--"
                            FontSize="20"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="PlexBandwidthText"
                            Text="--"
                            Classes="dim" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="LIBRARIES" Classes="eyebrow" />
                        <TextBlock
                            x:Name="PlexLibrariesText"
                            Text="--"
                            FontSize="20"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Protected API sections" Classes="dim" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="2*,1*" ColumnSpacing="10">
                    <Border Classes="card">
                      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="Live playback" Classes="sectionTitle" />
                            <TextBlock
                                Text="Current viewers, playback decisions, progress and bandwidth."
                                Classes="pageSubtitle"
                                Margin="0,3,0,0" />
                          </StackPanel>

                          <TextBlock
                              Grid.Column="1"
                              x:Name="PlexSessionCountText"
                              Text="--"
                              Classes="dim"
                              VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                          <Border Classes="inset">
                            <StackPanel>
                              <TextBlock Text="DIRECT PLAY" Classes="eyebrow" />
                              <TextBlock
                                  x:Name="PlexDirectPlayText"
                                  Text="--"
                                  FontSize="16"
                                  FontWeight="SemiBold" />
                            </StackPanel>
                          </Border>

                          <Border Grid.Column="1" Classes="inset">
                            <StackPanel>
                              <TextBlock Text="DIRECT STREAM" Classes="eyebrow" />
                              <TextBlock
                                  x:Name="PlexDirectStreamText"
                                  Text="--"
                                  FontSize="16"
                                  FontWeight="SemiBold" />
                            </StackPanel>
                          </Border>

                          <Border Grid.Column="2" Classes="inset">
                            <StackPanel>
                              <TextBlock Text="TRANSCODE" Classes="eyebrow" />
                              <TextBlock
                                  x:Name="PlexTranscodeText"
                                  Text="--"
                                  FontSize="16"
                                  FontWeight="SemiBold" />
                            </StackPanel>
                          </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                          <ListBox
                              x:Name="PlexSessionsList"
                              Classes="dataList"
                              IsVisible="False">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Border Classes="selectionRow" Margin="0,0,0,7" Padding="12">
                                  <Grid ColumnDefinitions="2*,1.1*,1.1*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="3">
                                      <TextBlock
                                          Text="{ReflectionBinding Title}"
                                          FontWeight="SemiBold"
                                          TextWrapping="Wrap" />
                                      <TextBlock
                                          Text="{ReflectionBinding Detail}"
                                          Classes="dim"
                                          FontSize="9.5"
                                          TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="3">
                                      <TextBlock Text="VIEWER / PLAYER" Classes="eyebrow" />
                                      <TextBlock Text="{ReflectionBinding User}" />
                                      <TextBlock
                                          Text="{ReflectionBinding Player}"
                                          Classes="dim"
                                          TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="3">
                                      <TextBlock Text="PLAYBACK" Classes="eyebrow" />
                                      <TextBlock Text="{ReflectionBinding VideoDecision}" />
                                      <TextBlock
                                          Text="{ReflectionBinding AudioDecision}"
                                          Classes="dim" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Spacing="3" HorizontalAlignment="Right">
                                      <TextBlock
                                          Text="{ReflectionBinding State}"
                                          FontWeight="SemiBold"
                                          HorizontalAlignment="Right" />
                                      <TextBlock
                                          Text="{ReflectionBinding Progress}"
                                          Classes="dim"
                                          HorizontalAlignment="Right" />
                                      <TextBlock
                                          Text="{ReflectionBinding Bandwidth}"
                                          Classes="mono"
                                          FontSize="9.5"
                                          HorizontalAlignment="Right" />
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>

                          <Border
                              x:Name="PlexSessionsEmptyState"
                              Classes="emptyState"
                              IsVisible="True">
                            <TextBlock
                                x:Name="PlexSessionsEmptyText"
                                Text="Plex session telemetry is loading."
                                Classes="muted"
                                TextWrapping="Wrap" />
                          </Border>
                        </Grid>
                      </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="10">
                      <Border Classes="card">
                        <StackPanel Spacing="9">
                          <TextBlock Text="Plex API connection" Classes="sectionTitle" />
                          <TextBlock
                              Text="Endpoint settings are stored without secrets. The token is stored only in Windows Credential Manager."
                              Classes="muted"
                              TextWrapping="Wrap" />

                          <TextBlock Text="ENDPOINT" Classes="eyebrow" />
                          <TextBox
                              x:Name="PlexEndpointTextBox"
                              Text="http://127.0.0.1:32400/"
                              PlaceholderText="http://127.0.0.1:32400/" />

                          <TextBlock Text="PLEX TOKEN" Classes="eyebrow" />
                          <TextBox
                              x:Name="PlexTokenTextBox"
                              PasswordChar="*"
                              PlaceholderText="Leave blank to preserve or auto-discover" />

                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button
                                Classes="primary"
                                Content="Save + test"
                                Click="PlexSaveTestButton_OnClick" />
                            <Button
                                Grid.Column="1"
                                Classes="danger"
                                Content="Clear saved token"
                                Click="PlexClearTokenButton_OnClick" />
                          </Grid>
                        </StackPanel>
                      </Border>

                      <Border Classes="card">
                        <StackPanel Spacing="7">
                          <TextBlock Text="Security and evidence" Classes="sectionTitle" />
                          <TextBlock Text="PROVIDER EVIDENCE" Classes="eyebrow" />
                          <TextBlock
                              x:Name="PlexDiscoveryEvidenceText"
                              Text="No Windows provider evidence was reported."
                              Classes="mono"
                              FontSize="10"
                              TextWrapping="Wrap" />

                          <TextBlock Text="TOKEN HANDLING" Classes="eyebrow" Margin="0,5,0,0" />
                          <TextBlock
                              x:Name="PlexSecurityText"
                              Text="Tokens remain protected."
                              Classes="muted"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>

                  <Border Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="Telemetry status" Classes="sectionTitle" />
                      <TextBlock
                          x:Name="PlexStatusText"
                          Text="Waiting for Plex telemetry."
                          Classes="muted"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>
            <Grid x:Name="ArrPage" IsVisible="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border Width="44" Height="44" CornerRadius="10"
                              Background="{DynamicResource AccentTintBrush}">
                        <Path Width="22" Height="22" Stretch="Uniform"
                              Data="M2,2 L14,2 L14,14 L2,14 Z M5,5 L11,5 M5,8 L11,8 M5,11 L9,11"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                      </Border>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock x:Name="ArrProductTitleText"
                                   Text="Sonarr"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="ArrProductSubtitleText"
                                   Text="Series and episode health, queue state and protected API telemetry."
                                   Classes="pageSubtitle"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock x:Name="ArrTargetText"
                                     Text="Local Windows"
                                     Classes="dim"
                                     FontSize="10" />
                          <TextBlock x:Name="ArrFreshnessText"
                                     Text="CHECKING..."
                                     Classes="dim"
                                     FontSize="10" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel Grid.Column="2"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  VerticalAlignment="Center">
                        <Button x:Name="ArrOpenButton"
                                Classes="compact"
                                Content="Open Sonarr"
                                Click="ArrOpenButton_OnClick" />
                        <Button Classes="primary compact"
                                Content="Refresh"
                                Click="ArrRefreshButton_OnClick" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Border Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="STATE" Classes="eyebrow" />
                        <TextBlock x:Name="ArrStateMetricText"
                                   Text="CHECKING"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="ArrInstanceCountText"
                                   Text="Waiting for API status"
                                   Classes="dim"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="VERSION" Classes="eyebrow" />
                        <TextBlock x:Name="ArrVersionMetricText"
                                   Text="--"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Selected API adapter" Classes="dim" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock x:Name="ArrWorkMetricLabelText"
                                   Text="QUEUE"
                                   Classes="eyebrow" />
                        <TextBlock x:Name="ArrWorkMetricText"
                                   Text="--"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="ArrWorkMetricHintText"
                            Text="Current queued work"
                            Classes="dim" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="HEALTH" Classes="eyebrow" />
                        <TextBlock x:Name="ArrHealthMetricText"
                                   Text="--"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Active health messages" Classes="dim" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="2*,1*" ColumnSpacing="10">
                    <StackPanel Spacing="10">
                      <Border Classes="card">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                          <StackPanel>
                            <TextBlock Text="Instances" Classes="sectionTitle" />
                            <TextBlock Text="API identity, version, queue count, health and protected access source."
                                       Classes="pageSubtitle"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                          </StackPanel>

                          <Grid Grid.Row="1">
                            <ListBox x:Name="ArrInstanceTelemetryList"
                                     Classes="dataList"
                                     IsVisible="False">
                              <ListBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                  <Border Classes="selectionRow" Margin="0,0,0,7" Padding="12">
                                    <Grid ColumnDefinitions="1.2*,1.5*,Auto" ColumnSpacing="12">
                                      <StackPanel Spacing="3">
                                        <TextBlock Text="{ReflectionBinding DisplayName}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{ReflectionBinding Endpoint}"
                                                   Classes="mono"
                                                   FontSize="9.5"
                                                   TextWrapping="Wrap" />
                                      </StackPanel>

                                      <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="ACCESS / WORK" Classes="eyebrow" />
                                        <TextBlock Text="{ReflectionBinding Detail}"
                                                   Classes="dim"
                                                   TextWrapping="Wrap" />
                                      </StackPanel>

                                      <StackPanel Grid.Column="2"
                                                  Spacing="3"
                                                  HorizontalAlignment="Right">
                                        <TextBlock Text="{ReflectionBinding State}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{ReflectionBinding Version}"
                                                   Classes="mono"
                                                   FontSize="9.5"
                                                   HorizontalAlignment="Right" />
                                      </StackPanel>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>

                            <Border x:Name="ArrServiceEmptyState"
                                    Classes="emptyState"
                                    IsVisible="True">
                              <TextBlock Text="Arr instance telemetry is loading."
                                         Classes="muted"
                                         TextWrapping="Wrap" />
                            </Border>
                          </Grid>
                        </Grid>
                      </Border>

                      <Border Classes="card">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                          <StackPanel>
                            <TextBlock x:Name="ArrWorkSectionTitleText"
                                       Text="Episode queue &amp; health"
                                       Classes="sectionTitle" />
                            <TextBlock
                                x:Name="ArrWorkSectionSubtitleText"
                                Text="Item-level queue progress and application health messages."
                                Classes="pageSubtitle"
                                Margin="0,3,0,0"
                                TextWrapping="Wrap" />
                          </StackPanel>

                          <Grid Grid.Row="1">
                            <ListBox x:Name="ArrQueueHealthList"
                                     Classes="dataList"
                                     IsVisible="False"
                                     MaxHeight="430">
                              <ListBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                  <Border Classes="selectionRow" Margin="0,0,0,7" Padding="12">
                                    <Grid ColumnDefinitions="Auto,2*,1*,Auto" ColumnSpacing="12">
                                      <StackPanel Spacing="3">
                                        <TextBlock Text="TYPE" Classes="eyebrow" />
                                        <TextBlock Text="{ReflectionBinding Type}"
                                                   FontWeight="SemiBold" />
                                      </StackPanel>

                                      <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{ReflectionBinding ItemIssue}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{ReflectionBinding Detail}"
                                                   Classes="dim"
                                                   FontSize="9.5"
                                                   TextWrapping="Wrap" />
                                      </StackPanel>

                                      <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Text="STATE" Classes="eyebrow" />
                                        <TextBlock Text="{ReflectionBinding State}" />
                                        <TextBlock Text="{ReflectionBinding Progress}"
                                                   Classes="dim" />
                                      </StackPanel>

                                      <StackPanel Grid.Column="3"
                                                  Spacing="3"
                                                  HorizontalAlignment="Right">
                                        <TextBlock Text="REMAINING" Classes="eyebrow" />
                                        <TextBlock Text="{ReflectionBinding Remaining}"
                                                   Classes="mono"
                                                   HorizontalAlignment="Right" />
                                      </StackPanel>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>

                            <Border x:Name="ArrQueueEmptyState"
                                    Classes="emptyState"
                                    IsVisible="True">
                              <TextBlock x:Name="ArrQueueEmptyText"
                                         Text="Arr queue and health telemetry is loading."
                                         Classes="muted"
                                         TextWrapping="Wrap" />
                            </Border>
                          </Grid>
                        </Grid>
                      </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="10">
                      <Border Classes="card">
                        <StackPanel Spacing="9">
                          <TextBlock Text="Arr API connection" Classes="sectionTitle" />
                          <TextBlock Text="Endpoint settings contain no secrets. API keys are stored only in Windows Credential Manager."
                                     Classes="muted"
                                     TextWrapping="Wrap" />

                          <TextBlock Text="ENDPOINT" Classes="eyebrow" />
                          <TextBox x:Name="ArrEndpointTextBox"
                                   Text="http://127.0.0.1:8989/"
                                   PlaceholderText="http://127.0.0.1:8989/" />

                          <TextBlock Text="API KEY" Classes="eyebrow" />
                          <TextBox x:Name="ArrApiKeyTextBox"
                                   PasswordChar="*"
                                   PlaceholderText="Leave blank to preserve or auto-discover" />

                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Classes="primary"
                                    Content="Save + test"
                                    Click="ArrSaveTestButton_OnClick" />
                            <Button Grid.Column="1"
                                    Classes="danger"
                                    Content="Clear saved key"
                                    Click="ArrClearSavedKeyButton_OnClick" />
                          </Grid>
                        </StackPanel>
                      </Border>

                      <Border Classes="card">
                        <StackPanel Spacing="7">
                          <TextBlock Text="Security and evidence" Classes="sectionTitle" />
                          <TextBlock Text="PROVIDER EVIDENCE" Classes="eyebrow" />
                          <TextBlock x:Name="ArrDiscoveryEvidenceText"
                                     Text="No Windows provider evidence was reported."
                                     Classes="mono"
                                     FontSize="10"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="KEY HANDLING"
                                     Classes="eyebrow"
                                     Margin="0,5,0,0" />
                          <TextBlock x:Name="ArrSecurityText"
                                     Text="API keys remain protected."
                                     Classes="muted"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Border Classes="card">
                        <StackPanel Spacing="5">
                          <TextBlock Text="Telemetry status" Classes="sectionTitle" />
                          <TextBlock x:Name="ArrStatusText"
                                     Text="Waiting for Arr API telemetry."
                                     Classes="muted"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </Grid>


            <Grid x:Name="SABnzbdPage" IsVisible="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border
                          Width="44"
                          Height="44"
                          CornerRadius="10"
                          Background="{DynamicResource AccentTintBrush}">
                        <Path
                            Width="22"
                            Height="22"
                            Stretch="Uniform"
                            Data="M2,3 L14,3 L14,13 L2,13 Z M4,6 L12,6 M4,9 L10,9 M4,11 L8,11"
                            Stroke="{DynamicResource AccentBrush}"
                            StrokeThickness="1.5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                      </Border>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="SABnzbd" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Authenticated queue, transfer, disk and recent-history telemetry."
                            Classes="pageSubtitle"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock x:Name="SABnzbdTargetText" Text="Local Windows" Classes="dim" FontSize="10" />
                          <TextBlock x:Name="SABnzbdFreshnessText" Text="CHECKING..." Classes="dim" FontSize="10" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="compact" Content="Open SABnzbd" Click="SABnzbdOpenButton_OnClick" />
                        <Button Classes="primary compact" Content="Refresh" Click="SABnzbdRefreshButton_OnClick" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Border Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="STATE" Classes="eyebrow" />
                        <TextBlock x:Name="SABnzbdStateText" Text="CHECKING" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="SABnzbdConnectionText" Text="--" Classes="dim" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="VERSION" Classes="eyebrow" />
                        <TextBlock x:Name="SABnzbdVersionText" Text="--" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Read-only JSON API" Classes="dim" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="QUEUE" Classes="eyebrow" />
                        <TextBlock x:Name="SABnzbdQueueText" Text="--" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Current queued jobs" Classes="dim" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="ACTIVE" Classes="eyebrow" />
                        <TextBlock x:Name="SABnzbdActiveText" Text="--" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Downloading or processing" Classes="dim" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Border Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="DOWNLOAD" Classes="eyebrow" />
                        <TextBlock x:Name="SABnzbdDownloadSpeedText" Text="--" FontSize="17" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="REMAINING" Classes="eyebrow" />
                        <TextBlock x:Name="SABnzbdRemainingText" Text="--" FontSize="17" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="ETA" Classes="eyebrow" />
                        <TextBlock x:Name="SABnzbdEtaText" Text="--" FontSize="17" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="FAILED RECENT" Classes="eyebrow" />
                        <TextBlock x:Name="SABnzbdFailedRecentText" Text="--" FontSize="17" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="2*,1*" ColumnSpacing="10">
                    <StackPanel Spacing="10">
                      <Border Classes="card">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                              <TextBlock Text="Current downloads" Classes="sectionTitle" />
                              <TextBlock
                                  Text="Queue state, progress, remaining data, ETA, category and processing detail."
                                  Classes="pageSubtitle"
                                  Margin="0,3,0,0"
                                  TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="SABnzbdQueueCountText" Text="--" Classes="dim" VerticalAlignment="Center" />
                          </Grid>

                          <Grid Grid.Row="1">
                            <ListBox x:Name="SABnzbdQueueList" Classes="dataList" IsVisible="False" MaxHeight="500">
                              <ListBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                  <Border Classes="selectionRow" Margin="0,0,0,7" Padding="12">
                                    <Grid ColumnDefinitions="2*,1*,1*,Auto" ColumnSpacing="12">
                                      <StackPanel Spacing="3">
                                        <TextBlock Text="{ReflectionBinding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{ReflectionBinding Category}" Classes="dim" />
                                        <TextBlock Text="{ReflectionBinding Detail}" Classes="dim" FontSize="9.5" TextWrapping="Wrap" />
                                      </StackPanel>
                                      <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="STATE / PROGRESS" Classes="eyebrow" />
                                        <TextBlock Text="{ReflectionBinding State}" />
                                        <TextBlock Text="{ReflectionBinding Progress}" FontWeight="SemiBold" />
                                        <TextBlock Text="{ReflectionBinding Remaining}" Classes="dim" />
                                      </StackPanel>
                                      <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Text="SIZE / SPEED" Classes="eyebrow" />
                                        <TextBlock Text="{ReflectionBinding Size}" />
                                        <TextBlock Text="{ReflectionBinding Downloaded}" />
                                        <TextBlock Text="{ReflectionBinding DownloadSpeed}" Classes="dim" />
                                      </StackPanel>
                                      <StackPanel Grid.Column="3" Spacing="3" HorizontalAlignment="Right">
                                        <TextBlock Text="ETA" Classes="eyebrow" />
                                        <TextBlock Text="{ReflectionBinding Eta}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{ReflectionBinding Added}" Classes="mono" FontSize="9" HorizontalAlignment="Right" />
                                      </StackPanel>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>

                            <Border x:Name="SABnzbdQueueEmptyState" Classes="emptyState" IsVisible="True">
                              <TextBlock
                                  x:Name="SABnzbdQueueEmptyText"
                                  Text="Live SABnzbd queue detail is loading."
                                  Classes="muted"
                                  TextWrapping="Wrap" />
                            </Border>
                          </Grid>
                        </Grid>
                      </Border>

                      <Border Classes="card">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                              <TextBlock Text="Recent history" Classes="sectionTitle" />
                              <TextBlock
                                  Text="Recent completed and failed SABnzbd jobs with privacy-safe processing detail."
                                  Classes="pageSubtitle"
                                  Margin="0,3,0,0"
                                  TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="SABnzbdHistoryCountText" Text="--" Classes="dim" VerticalAlignment="Center" />
                          </Grid>

                          <Grid Grid.Row="1">
                            <ListBox x:Name="SABnzbdHistoryList" Classes="dataList" IsVisible="False" MaxHeight="360">
                              <ListBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                  <Border Classes="selectionRow" Margin="0,0,0,7" Padding="12">
                                    <Grid ColumnDefinitions="2*,1*,Auto" ColumnSpacing="12">
                                      <StackPanel Spacing="3">
                                        <TextBlock Text="{ReflectionBinding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{ReflectionBinding Category}" Classes="dim" />
                                        <TextBlock
                                            Text="{ReflectionBinding Detail}"
                                            Classes="dim"
                                            FontSize="9.5"
                                            TextWrapping="Wrap"
                                            MaxWidth="560" />
                                      </StackPanel>
                                      <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="STATE / SIZE" Classes="eyebrow" />
                                        <TextBlock Text="{ReflectionBinding State}" />
                                        <TextBlock Text="{ReflectionBinding Size}" Classes="dim" />
                                      </StackPanel>
                                      <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                                        <TextBlock Text="COMPLETED" Classes="eyebrow" />
                                        <TextBlock Text="{ReflectionBinding Completed}" Classes="mono" HorizontalAlignment="Right" />
                                        <TextBlock Text="{ReflectionBinding Duration}" Classes="dim" HorizontalAlignment="Right" />
                                      </StackPanel>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>

                            <Border x:Name="SABnzbdHistoryEmptyState" Classes="emptyState" IsVisible="True">
                              <TextBlock
                                  x:Name="SABnzbdHistoryEmptyText"
                                  Text="Recent SABnzbd history is loading."
                                  Classes="muted"
                                  TextWrapping="Wrap" />
                            </Border>
                          </Grid>
                        </Grid>
                      </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="10">
                      <Border Classes="card">
                        <StackPanel Spacing="9">
                          <TextBlock Text="API connection" Classes="sectionTitle" />
                          <TextBlock
                              Text="The endpoint is stored without secrets. The API key is stored only in Windows Credential Manager."
                              Classes="muted"
                              TextWrapping="Wrap" />
                          <TextBlock Text="ENDPOINT" Classes="eyebrow" />
                          <TextBox
                              x:Name="SABnzbdEndpointTextBox"
                              Text="http://127.0.0.1:8080/"
                              PlaceholderText="http://server:8080/" />
                          <TextBlock Text="API KEY" Classes="eyebrow" />
                          <TextBox
                              x:Name="SABnzbdApiKeyTextBox"
                              PasswordChar="*"
                              PlaceholderText="Leave blank to preserve the saved key" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Classes="primary" Content="Save + test" Click="SABnzbdSaveTestButton_OnClick" />
                            <Button Grid.Column="1" Classes="danger" Content="Clear saved key" Click="SABnzbdClearSavedApiKeyButton_OnClick" />
                          </Grid>
                        </StackPanel>
                      </Border>

                      <Border Classes="card">
                        <StackPanel Spacing="7">
                          <TextBlock Text="Transfer analytics" Classes="sectionTitle" />
                          <TextBlock
                              x:Name="SABnzbdTransferAnalyticsText"
                              Text="Waiting for the first authenticated SABnzbd sample."
                              Classes="mono"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Border Classes="card">
                        <StackPanel Spacing="7">
                          <TextBlock Text="History analytics" Classes="sectionTitle" />
                          <TextBlock
                              x:Name="SABnzbdHistoryAnalyticsText"
                              Text="Waiting for the first authenticated SABnzbd sample."
                              Classes="mono"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Border Classes="card">
                        <StackPanel Spacing="7">
                          <TextBlock Text="Security and evidence" Classes="sectionTitle" />
                          <TextBlock Text="PROVIDER EVIDENCE" Classes="eyebrow" />
                          <TextBlock
                              x:Name="SABnzbdDiscoveryEvidenceText"
                              Text="No Windows provider evidence was reported."
                              Classes="mono"
                              FontSize="10"
                              TextWrapping="Wrap" />
                          <TextBlock Text="KEY HANDLING" Classes="eyebrow" Margin="0,5,0,0" />
                          <TextBlock
                              x:Name="SABnzbdSecurityText"
                              Text="The API key stays in Windows Credential Manager."
                              Classes="muted"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Border Classes="card">
                        <StackPanel Spacing="5">
                          <TextBlock Text="Telemetry status" Classes="sectionTitle" />
                          <TextBlock
                              x:Name="SABnzbdStatusText"
                              Text="Waiting for SABnzbd API telemetry."
                              Classes="muted"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <Grid x:Name="QBittorrentPage" IsVisible="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border Width="44" Height="44" CornerRadius="10"
                              Background="{DynamicResource AccentTintBrush}">
                        <Path Width="22" Height="22" Stretch="Uniform"
                              Data="M2,3 L14,3 L14,13 L2,13 Z M4,6 L7,8 L4,10 M8,10 L11,10"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                      </Border>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="qBittorrent"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock
                            Text="Authenticated WebUI transfer analytics, torrent queue, categories and recent history."
                            Classes="pageSubtitle"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock x:Name="QBittorrentTargetText"
                                     Text="Local Windows"
                                     Classes="dim"
                                     FontSize="10" />
                          <TextBlock x:Name="QBittorrentFreshnessText"
                                     Text="CHECKING..."
                                     Classes="dim"
                                     FontSize="10" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel Grid.Column="2"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  VerticalAlignment="Center">
                        <Button Classes="compact"
                                Content="Open qBittorrent"
                                Click="QBittorrentOpenButton_OnClick" />
                        <Button Classes="primary compact"
                                Content="Refresh"
                                Click="QBittorrentRefreshButton_OnClick" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Border Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="STATE" Classes="eyebrow" />
                        <TextBlock x:Name="QBittorrentStateText"
                                   Text="CHECKING"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="QBittorrentConnectionText"
                                   Text="--"
                                   Classes="dim"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="VERSION" Classes="eyebrow" />
                        <TextBlock x:Name="QBittorrentVersionText"
                                   Text="--"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Authenticated WebUI API" Classes="dim" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="TORRENTS" Classes="eyebrow" />
                        <TextBlock x:Name="QBittorrentTotalText"
                                   Text="--"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Current torrent inventory" Classes="dim" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="ACTIVE" Classes="eyebrow" />
                        <TextBlock x:Name="QBittorrentActiveText"
                                   Text="--"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Transferring or processing" Classes="dim" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Border Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="DOWNLOAD" Classes="eyebrow" />
                        <TextBlock x:Name="QBittorrentDownloadSpeedText"
                                   Text="--"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="UPLOAD" Classes="eyebrow" />
                        <TextBlock x:Name="QBittorrentUploadSpeedText"
                                   Text="--"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="REMAINING" Classes="eyebrow" />
                        <TextBlock x:Name="QBittorrentRemainingText"
                                   Text="--"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="NEXT ETA" Classes="eyebrow" />
                        <TextBlock x:Name="QBittorrentEtaText"
                                   Text="--"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="2*,1*" ColumnSpacing="10">
                    <StackPanel Spacing="10">
                      <Border Classes="card">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                              <TextBlock Text="Current torrents" Classes="sectionTitle" />
                              <TextBlock
                                  Text="Progress, transfer rates, remaining work, ETA, ratio, peers and redacted tracker host."
                                  Classes="pageSubtitle"
                                  Margin="0,3,0,0"
                                  TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       x:Name="QBittorrentQueueCountText"
                                       Text="--"
                                       Classes="dim"
                                       VerticalAlignment="Center" />
                          </Grid>

                          <Grid Grid.Row="1">
                            <ListBox x:Name="QBittorrentQueueList"
                                     Classes="dataList"
                                     IsVisible="False"
                                     MaxHeight="520">
                              <ListBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                  <Border Classes="selectionRow" Margin="0,0,0,7" Padding="12">
                                    <Grid ColumnDefinitions="2*,1*,1*,Auto" ColumnSpacing="12">
                                      <StackPanel Spacing="3">
                                        <TextBlock Text="{ReflectionBinding Name}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{ReflectionBinding Category}"
                                                   Classes="dim" />
                                        <TextBlock Text="{ReflectionBinding Tracker}"
                                                   Classes="mono"
                                                   FontSize="9.5"
                                                   TextWrapping="Wrap" />
                                      </StackPanel>

                                      <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="STATE / PROGRESS" Classes="eyebrow" />
                                        <TextBlock Text="{ReflectionBinding State}" />
                                        <TextBlock Text="{ReflectionBinding Progress}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{ReflectionBinding Remaining}"
                                                   Classes="dim" />
                                      </StackPanel>

                                      <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Text="TRANSFER" Classes="eyebrow" />
                                        <TextBlock Text="{ReflectionBinding DownloadSpeed}" />
                                        <TextBlock Text="{ReflectionBinding UploadSpeed}" />
                                        <TextBlock Text="{ReflectionBinding Eta}"
                                                   Classes="dim" />
                                      </StackPanel>

                                      <StackPanel Grid.Column="3"
                                                  Spacing="3"
                                                  HorizontalAlignment="Right">
                                        <TextBlock Text="RATIO" Classes="eyebrow" />
                                        <TextBlock Text="{ReflectionBinding Ratio}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{ReflectionBinding Peers}"
                                                   Classes="dim"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{ReflectionBinding Added}"
                                                   Classes="mono"
                                                   FontSize="9"
                                                   HorizontalAlignment="Right" />
                                      </StackPanel>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>

                            <Border x:Name="QBittorrentQueueEmptyState"
                                    Classes="emptyState"
                                    IsVisible="True">
                              <TextBlock x:Name="QBittorrentQueueEmptyText"
                                         Text="Live torrent detail is loading."
                                         Classes="muted"
                                         TextWrapping="Wrap" />
                            </Border>
                          </Grid>
                        </Grid>
                      </Border>

                      <Border Classes="card">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                              <TextBlock Text="Recently completed" Classes="sectionTitle" />
                              <TextBlock
                                  Text="Most recently completed torrents still present in qBittorrent."
                                  Classes="pageSubtitle"
                                  Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       x:Name="QBittorrentHistoryCountText"
                                       Text="--"
                                       Classes="dim"
                                       VerticalAlignment="Center" />
                          </Grid>

                          <Grid Grid.Row="1">
                            <ListBox x:Name="QBittorrentHistoryList"
                                     Classes="dataList"
                                     IsVisible="False"
                                     MaxHeight="340">
                              <ListBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                  <Border Classes="selectionRow" Margin="0,0,0,7" Padding="12">
                                    <Grid ColumnDefinitions="2*,1*,Auto" ColumnSpacing="12">
                                      <StackPanel Spacing="3">
                                        <TextBlock Text="{ReflectionBinding Name}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{ReflectionBinding Category}"
                                                   Classes="dim" />
                                      </StackPanel>

                                      <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="STATE / SIZE" Classes="eyebrow" />
                                        <TextBlock Text="{ReflectionBinding State}" />
                                        <TextBlock Text="{ReflectionBinding Size}"
                                                   Classes="dim" />
                                      </StackPanel>

                                      <StackPanel Grid.Column="2"
                                                  Spacing="3"
                                                  HorizontalAlignment="Right">
                                        <TextBlock Text="COMPLETED" Classes="eyebrow" />
                                        <TextBlock Text="{ReflectionBinding Completed}"
                                                   Classes="mono"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{ReflectionBinding Duration}"
                                                   Classes="dim"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{ReflectionBinding Detail}"
                                                   Classes="dim"
                                                   FontSize="9.5"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="230"
                                                   HorizontalAlignment="Right" />
                                      </StackPanel>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>

                            <Border x:Name="QBittorrentHistoryEmptyState"
                                    Classes="emptyState"
                                    IsVisible="True">
                              <TextBlock x:Name="QBittorrentHistoryEmptyText"
                                         Text="Recent transfer history is loading."
                                         Classes="muted"
                                         TextWrapping="Wrap" />
                            </Border>
                          </Grid>
                        </Grid>
                      </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="10">
                      <Border Classes="card">
                        <StackPanel Spacing="9">
                          <TextBlock Text="WebUI connection" Classes="sectionTitle" />
                          <TextBlock
                              Text="Endpoint and username are stored without secrets. The password is stored only in Windows Credential Manager."
                              Classes="muted"
                              TextWrapping="Wrap" />

                          <TextBlock Text="ENDPOINT" Classes="eyebrow" />
                          <TextBox x:Name="QBittorrentEndpointTextBox"
                                   Text="http://127.0.0.1:8080/"
                                   PlaceholderText="http://server:8080/" />

                          <TextBlock Text="USERNAME" Classes="eyebrow" />
                          <TextBox x:Name="QBittorrentUsernameTextBox"
                                   PlaceholderText="qBittorrent WebUI username" />

                          <TextBlock Text="PASSWORD" Classes="eyebrow" />
                          <TextBox x:Name="QBittorrentPasswordTextBox"
                                   PasswordChar="*"
                                   PlaceholderText="Leave blank to preserve the saved password" />

                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Classes="primary"
                                    Content="Save + test"
                                    Click="QBittorrentSaveTestButton_OnClick" />
                            <Button Grid.Column="1"
                                    Classes="danger"
                                    Content="Clear saved password"
                                    Click="QBittorrentClearSavedPasswordButton_OnClick" />
                          </Grid>
                        </StackPanel>
                      </Border>

                      <Border Classes="card">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                              <TextBlock Text="Categories" Classes="sectionTitle" />
                              <TextBlock
                                  Text="Category names and torrent counts only; save paths are not exposed."
                                  Classes="pageSubtitle"
                                  Margin="0,3,0,0"
                                  TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       x:Name="QBittorrentCategoryCountText"
                                       Text="--"
                                       Classes="dim"
                                       VerticalAlignment="Center" />
                          </Grid>

                          <Grid Grid.Row="1">
                            <ListBox x:Name="QBittorrentCategoryList"
                                     Classes="dataList"
                                     IsVisible="False"
                                     MaxHeight="220">
                              <ListBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                  <Border Classes="selectionRow" Margin="0,0,0,6" Padding="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBlock Text="{ReflectionBinding Name}"
                                                 FontWeight="SemiBold" />
                                      <TextBlock Grid.Column="1"
                                                 Text="{ReflectionBinding TorrentCount}"
                                                 Classes="mono" />
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>

                            <Border x:Name="QBittorrentCategoryEmptyState"
                                    Classes="emptyState"
                                    IsVisible="True">
                              <TextBlock x:Name="QBittorrentCategoryEmptyText"
                                         Text="Category inventory is loading."
                                         Classes="muted"
                                         TextWrapping="Wrap" />
                            </Border>
                          </Grid>
                        </Grid>
                      </Border>

                      <Border Classes="card">
                        <StackPanel Spacing="7">
                          <TextBlock Text="Transfer analytics" Classes="sectionTitle" />
                          <TextBlock x:Name="QBittorrentTransferAnalyticsText"
                                     Text="Waiting for the first authenticated qBittorrent sample."
                                     Classes="mono"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Border Classes="card">
                        <StackPanel Spacing="7">
                          <TextBlock Text="Workload analytics" Classes="sectionTitle" />
                          <TextBlock x:Name="QBittorrentWorkloadAnalyticsText"
                                     Text="Waiting for the first authenticated qBittorrent sample."
                                     Classes="mono"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Border Classes="card">
                        <StackPanel Spacing="7">
                          <TextBlock Text="Security and evidence" Classes="sectionTitle" />
                          <TextBlock Text="PROVIDER EVIDENCE" Classes="eyebrow" />
                          <TextBlock x:Name="QBittorrentDiscoveryEvidenceText"
                                     Text="No Windows provider evidence was reported."
                                     Classes="mono"
                                     FontSize="10"
                                     TextWrapping="Wrap" />

                          <TextBlock Text="CREDENTIAL HANDLING"
                                     Classes="eyebrow"
                                     Margin="0,5,0,0" />
                          <TextBlock x:Name="QBittorrentSecurityText"
                                     Text="WebUI password stays in Windows Credential Manager; SID cookies are memory-only."
                                     Classes="muted"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Border Classes="card">
                        <StackPanel Spacing="5">
                          <TextBlock Text="Telemetry status" Classes="sectionTitle" />
                          <TextBlock x:Name="QBittorrentStatusText"
                                     Text="Waiting for qBittorrent Web API telemetry."
                                     Classes="muted"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <Grid x:Name="ServersPage" IsVisible="False">
              <Grid ColumnDefinitions="1.05*,1.45*" ColumnSpacing="12">
                <Border Classes="card">
                  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="Windows targets" Classes="sectionTitle" />
                        <TextBlock
                            Text="Local and WinRM HTTPS hosts managed by the target-aware provider registry."
                            Classes="pageSubtitle"
                            Margin="0,3,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>

                      <Button
                          Grid.Column="1"
                          x:Name="ServersAddButton"
                          Classes="primary compact"
                          Content="Add remote"
                          Click="ServersAddButton_OnClick" />
                    </Grid>

                    <Border Grid.Row="1" Classes="inset">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="REGISTRY" Classes="eyebrow" />
                          <TextBlock
                              x:Name="ServersSummaryText"
                              Text="Loading targets..."
                              Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            x:Name="ServersVaultStatusText"
                            Text="Checking Credential Manager"
                            Classes="dim"
                            VerticalAlignment="Center" />
                      </Grid>
                    </Border>

                    <ListBox
                        Grid.Row="2"
                        x:Name="ServersTargetList"
                        Classes="dataList"
                        SelectionChanged="ServersTargetList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Border Classes="selectionRow" Margin="0,0,0,5">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                              <StackPanel Spacing="3">
                                <TextBlock
                                    Text="{ReflectionBinding DisplayName}"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{ReflectionBinding ConnectionSummary}"
                                    Classes="dim"
                                    FontSize="10"
                                    TextWrapping="Wrap" />
                              </StackPanel>

                              <Border
                                  Grid.Column="1"
                                  Classes="badge"
                                  VerticalAlignment="Center">
                                <TextBlock
                                    Text="{ReflectionBinding IsLocal}"
                                    FontSize="9"
                                    Classes="dim" />
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                      <Button
                          x:Name="ServersEditButton"
                          Classes="compact"
                          Content="Edit"
                          Click="ServersEditButton_OnClick" />

                      <Button
                          Grid.Column="1"
                          x:Name="ServersRemoveButton"
                          Classes="danger compact"
                          Content="Remove"
                          Click="ServersRemoveButton_OnClick" />

                      <TextBlock
                          Grid.Column="2"
                          x:Name="ServersStatusText"
                          Text="Select a remote target to edit or remove it."
                          Classes="dim"
                          VerticalAlignment="Center"
                          TextWrapping="Wrap" />
                    </Grid>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Classes="card">
                  <Grid>
                    <Border
                        x:Name="ServersEditorPanel"
                        IsVisible="False">
                      <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                          <StackPanel>
                            <TextBlock Text="Remote Windows target" Classes="sectionTitle" />
                            <TextBlock
                                Text="WinRM must use HTTPS. Credentials are never written to targets.json."
                                Classes="pageSubtitle"
                                Margin="0,3,0,0"
                                TextWrapping="Wrap" />
                          </StackPanel>

                          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel>
                              <TextBlock Text="TARGET ID" Classes="eyebrow" Margin="0,0,0,5" />
                              <TextBox x:Name="ServersTargetIdTextBox" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                              <TextBlock Text="DISPLAY NAME" Classes="eyebrow" Margin="0,0,0,5" />
                              <TextBox x:Name="ServersDisplayNameTextBox" />
                            </StackPanel>
                          </Grid>

                          <Grid ColumnDefinitions="2*,1*" ColumnSpacing="10">
                            <StackPanel>
                              <TextBlock Text="HOST OR DNS NAME" Classes="eyebrow" Margin="0,0,0,5" />
                              <TextBox x:Name="ServersHostTextBox" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                              <TextBlock Text="HTTPS PORT" Classes="eyebrow" Margin="0,0,0,5" />
                              <TextBox x:Name="ServersPortTextBox" Text="5986" />
                            </StackPanel>
                          </Grid>

                          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel>
                              <TextBlock Text="USERNAME" Classes="eyebrow" Margin="0,0,0,5" />
                              <TextBox x:Name="ServersUsernameTextBox" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                              <TextBlock Text="PASSWORD" Classes="eyebrow" Margin="0,0,0,5" />
                              <TextBox
                                  x:Name="ServersPasswordTextBox"
                                  PasswordChar="*" />
                            </StackPanel>
                          </Grid>

                          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel>
                              <TextBlock Text="AUTHENTICATION" Classes="eyebrow" Margin="0,0,0,5" />
                              <ComboBox x:Name="ServersAuthenticationComboBox" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                              <TextBlock Text="TIMEOUT SECONDS" Classes="eyebrow" Margin="0,0,0,5" />
                              <TextBox x:Name="ServersTimeoutTextBox" Text="60" />
                            </StackPanel>
                          </Grid>

                          <StackPanel>
                            <TextBlock
                                Text="OPTIONAL CERTIFICATE SHA-256 PIN"
                                Classes="eyebrow"
                                Margin="0,0,0,5" />
                            <TextBox
                                x:Name="ServersCertificatePinTextBox"
                                PlaceholderText="SHA256:0123..." />
                            <TextBlock
                                Text="System certificate trust and hostname validation remain mandatory even when a pin is supplied."
                                Classes="dim"
                                FontSize="10"
                                Margin="0,5,0,0"
                                TextWrapping="Wrap" />
                          </StackPanel>

                          <Border Classes="inset">
                            <TextBlock
                                x:Name="ServersEditorStatusText"
                                Text="Passwords are stored only in Windows Credential Manager."
                                Classes="muted"
                                TextWrapping="Wrap" />
                          </Border>

                          <StackPanel
                              Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              Spacing="8">
                            <Button
                                x:Name="ServersCancelButton"
                                Classes="ghost compact"
                                Content="Cancel"
                                Click="ServersCancelButton_OnClick" />

                            <Button
                                x:Name="ServersSaveButton"
                                Classes="primary compact"
                                Content="Save target"
                                Click="ServersSaveButton_OnClick" />
                          </StackPanel>
                        </StackPanel>
                      </ScrollViewer>
                    </Border>

                    <Border
                        x:Name="ServersEditorEmptyPanel"
                        Classes="emptyState"
                        VerticalAlignment="Center">
                      <StackPanel Spacing="8">
                        <TextBlock
                            Text="Add or edit a remote Windows target"
                            FontSize="17"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="The local Windows target is protected. Remote targets use WinRM HTTPS, optional certificate pinning, and Credential Manager-backed passwords."
                            Classes="muted"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="No remote connection is attempted until the target is selected from Active Server."
                            Foreground="{DynamicResource SuccessBrush}"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
              </Grid>
            </Grid>

                        <Grid x:Name="WarningsPage" IsVisible="False">
              <Border Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                  <StackPanel>
                    <TextBlock Text="Provider warnings" Classes="sectionTitle" />
                    <TextBlock Text="Capture limitations and read-only operational findings."
                               Classes="pageSubtitle" Margin="0,3,0,0" />
                  </StackPanel>
                  <ListBox Grid.Row="1" x:Name="WarningsList" Classes="dataList">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Classes="healthWarn" Margin="0,0,0,7">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="!" Foreground="{DynamicResource WarnBrush}"
                                       FontWeight="Bold" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>



            <Grid x:Name="LifecyclePage" IsVisible="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border
                          Width="44"
                          Height="44"
                          CornerRadius="10"
                          Background="{DynamicResource AccentTintBrush}">
                        <Path
                            Width="22"
                            Height="22"
                            Stretch="Uniform"
                            Data="M2,8 L5,8 M6,8 L9,8 M10,8 L14,8 M4,5 L6,8 L4,11 M8,5 L10,8 L8,11"
                            Stroke="{DynamicResource AccentBrush}"
                            StrokeThickness="1.5"
                            StrokeLineCap="Round"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                      </Border>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock
                            Text="Media Lifecycle"
                            FontSize="18"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Conservative read-only correlation across Arr, qBittorrent, SABnzbd and Plex."
                            Classes="pageSubtitle"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock
                              x:Name="MediaLifecycleTargetText"
                              Text="Local Windows"
                              Classes="dim"
                              FontSize="10" />
                          <TextBlock
                              x:Name="MediaLifecycleFreshnessText"
                              Text="CHECKING..."
                              Classes="dim"
                              FontSize="10" />
                        </StackPanel>
                      </StackPanel>

                      <Button
                          Grid.Column="2"
                          Classes="primary compact"
                          Content="Refresh lifecycle"
                          VerticalAlignment="Center"
                          Click="MediaLifecycleRefreshButton_OnClick" />
                    </Grid>
                  </Border>

                  <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="8">
                    <Border Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="STATE" Classes="eyebrow" />
                        <TextBlock
                            x:Name="MediaLifecycleStateText"
                            Text="CHECKING"
                            FontSize="17"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Cross-application evidence" Classes="dim" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="ITEMS" Classes="eyebrow" />
                        <TextBlock
                            x:Name="MediaLifecycleTotalText"
                            Text="--"
                            FontSize="20"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Active and recent" Classes="dim" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="TRANSFERS" Classes="eyebrow" />
                        <TextBlock
                            x:Name="MediaLifecycleTransferText"
                            Text="--"
                            FontSize="20"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Downloading or paused" Classes="dim" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="PROCESSING" Classes="eyebrow" />
                        <TextBlock
                            x:Name="MediaLifecycleProcessingText"
                            Text="--"
                            FontSize="20"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Post-process or completed" Classes="dim" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="PLAYING" Classes="eyebrow" />
                        <TextBlock
                            x:Name="MediaLifecyclePlayingText"
                            Text="--"
                            FontSize="20"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Verified Plex sessions" Classes="dim" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="5" Classes="card">
                      <StackPanel Spacing="5">
                        <TextBlock Text="ATTENTION" Classes="eyebrow" />
                        <TextBlock
                            x:Name="MediaLifecycleAttentionText"
                            Text="--"
                            FontSize="20"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Failures or unavailable sources" Classes="dim" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="2.2*,1*" ColumnSpacing="10">
                    <Border Classes="card">
                      <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="Correlated media" Classes="sectionTitle" />
                            <TextBlock
                                Text="Arr work, active transfers, recent completions and Plex playback joined by conservative title evidence."
                                Classes="pageSubtitle"
                                Margin="0,3,0,0"
                                TextWrapping="Wrap" />
                          </StackPanel>

                          <TextBlock
                              Grid.Column="1"
                              x:Name="MediaLifecycleItemCountText"
                              Text="--"
                              Classes="dim"
                              VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1">
                          <ListBox
                              x:Name="MediaLifecycleItemsList"
                              Classes="dataList"
                              IsVisible="False"
                              MaxHeight="620">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Border Classes="selectionRow" Margin="0,0,0,7" Padding="12">
                                  <Grid ColumnDefinitions="2.2*,1*,1*,1.2*" ColumnSpacing="12">
                                    <StackPanel Spacing="3">
                                      <TextBlock
                                          Text="{ReflectionBinding Title}"
                                          FontWeight="SemiBold"
                                          TextWrapping="Wrap" />
                                      <TextBlock
                                          Text="{ReflectionBinding Evidence}"
                                          Classes="dim"
                                          FontSize="9.5"
                                          TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="3">
                                      <TextBlock Text="PIPELINE" Classes="eyebrow" />
                                      <TextBlock
                                          Text="{ReflectionBinding Stage}"
                                          FontWeight="SemiBold" />
                                      <TextBlock
                                          Text="{ReflectionBinding MediaType}"
                                          Classes="dim" />
                                      <TextBlock
                                          Text="{ReflectionBinding ManagedBy}"
                                          Classes="dim"
                                          FontSize="9.5" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="3">
                                      <TextBlock Text="TRANSFER" Classes="eyebrow" />
                                      <TextBlock Text="{ReflectionBinding DownloadClient}" />
                                      <TextBlock
                                          Text="{ReflectionBinding Progress}"
                                          FontWeight="SemiBold" />
                                      <TextBlock
                                          Text="{ReflectionBinding Remaining}"
                                          Classes="dim" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Spacing="3">
                                      <TextBlock Text="PLEX / CONFIDENCE" Classes="eyebrow" />
                                      <TextBlock
                                          Text="{ReflectionBinding Plex}"
                                          TextWrapping="Wrap" />
                                      <TextBlock
                                          Text="{ReflectionBinding Confidence}"
                                          Classes="dim"
                                          TextWrapping="Wrap" />
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>

                          <Border
                              x:Name="MediaLifecycleEmptyState"
                              Classes="emptyState"
                              IsVisible="True">
                            <TextBlock
                                x:Name="MediaLifecycleEmptyText"
                                Text="Lifecycle evidence is loading."
                                Classes="muted"
                                TextWrapping="Wrap" />
                          </Border>
                        </Grid>
                      </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="10">
                      <Border Classes="card">
                        <Grid RowDefinitions="Auto,*" RowSpacing="9">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                              <TextBlock Text="Source health" Classes="sectionTitle" />
                              <TextBlock
                                  x:Name="MediaLifecycleSourceSummaryText"
                                  Text="Waiting for configured application telemetry."
                                  Classes="pageSubtitle"
                                  Margin="0,3,0,0"
                                  TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                x:Name="MediaLifecycleSourceCountText"
                                Text="--"
                                Classes="dim"
                                VerticalAlignment="Center" />
                          </Grid>

                          <ListBox
                              Grid.Row="1"
                              x:Name="MediaLifecycleSourcesList"
                              Classes="dataList"
                              MaxHeight="330">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Border Classes="selectionRow" Margin="0,0,0,6" Padding="10">
                                  <Grid ColumnDefinitions="110,90,*" ColumnSpacing="9">
                                    <TextBlock
                                        Text="{ReflectionBinding Source}"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{ReflectionBinding State}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{ReflectionBinding Summary}"
                                        Classes="dim"
                                        FontSize="9.5"
                                        TextWrapping="Wrap" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </Grid>
                      </Border>

                      <Border Classes="card">
                        <StackPanel Spacing="7">
                          <TextBlock Text="Interpretation boundary" Classes="sectionTitle" />
                          <TextBlock
                              Text="A transfer match requires conservative normalized-title evidence. GraveOps does not inspect storage paths, tracker URLs, credentials or download-client IDs."
                              Classes="muted"
                              TextWrapping="Wrap" />
                          <TextBlock
                              Text="Plex item availability is claimed only when an active session title matches. Otherwise the view reports Plex server readiness and marks the individual item unverified."
                              Classes="muted"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Border Classes="card">
                        <StackPanel Spacing="5">
                          <TextBlock Text="Lifecycle status" Classes="sectionTitle" />
                          <TextBlock
                              x:Name="MediaLifecycleStatusText"
                              Text="Collecting read-only Arr, download-client and Plex evidence."
                              Classes="muted"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </Grid>


            <Grid x:Name="ParityPage" IsVisible="False">
              <Border Classes="card">
                <Border Classes="emptyState" VerticalAlignment="Center">
                  <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="ParityPageTitleText"
                        Text="Linux page destination connected"
                        FontSize="17"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="ParityPageBodyText"
                        Text="The canonical shell destination is active. Windows page data will be ported next."
                        Classes="muted"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="This parity foundation remains read-only."
                        Foreground="{DynamicResource SuccessBrush}" />
                  </StackPanel>
                </Border>
              </Border>
            </Grid>
          </Grid>

          <Border
              Grid.Row="3"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="28,0">
              <TextBlock
                  x:Name="FooterStatusText"
                  Text="Windows Avalonia · read-only"
                  Classes="dim"
                  FontSize="9.5"
                  VerticalAlignment="Center" />
              <TextBlock
                  Grid.Column="1"
                  Text="WPF LEGACY PRESERVED"
                  Foreground="{DynamicResource SuccessBrush}"
                  FontSize="9"
                  FontWeight="SemiBold"
                  VerticalAlignment="Center" />
            </Grid>
          </Border>


          <Border
              x:Name="OverviewDrawer"
              Grid.RowSpan="4"
              Width="420"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1,0,0,0"
              IsVisible="False">

            <Grid RowDefinitions="Auto,*" Margin="20">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Overview" Classes="sectionTitle" />
                  <TextBlock Text="Active-target summary" Classes="pageSubtitle" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost compact"
                        Content="Close" Click="CloseDrawersButton_OnClick" />
              </Grid>

              <StackPanel Grid.Row="1" Margin="0,18,0,0" Spacing="10">
                <Border Classes="inset">
                  <StackPanel Spacing="5">
                    <TextBlock Text="HOST" Classes="eyebrow" />
                    <TextBlock x:Name="OverviewHostText" Text="Loading..."
                               FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="OverviewSystemText" Text="--"
                               Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Border Classes="inset">
                    <StackPanel>
                      <TextBlock Text="STORAGE" Classes="eyebrow" />
                      <TextBlock x:Name="OverviewStorageText" Text="--"
                                 FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="inset">
                    <StackPanel>
                      <TextBlock Text="ATTENTION" Classes="eyebrow" />
                      <TextBlock x:Name="OverviewAttentionText" Text="--"
                                 FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="inset">
                  <StackPanel Spacing="5">
                    <TextBlock Text="LATEST CAPTURE" Classes="eyebrow" />
                    <TextBlock x:Name="OverviewCaptureText" Text="Waiting for capture" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Border>

          <Border
              x:Name="JobsDrawer"
              Grid.RowSpan="4"
              Width="420"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1,0,0,0"
              IsVisible="False">

            <Grid RowDefinitions="Auto,*" Margin="20">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Jobs" Classes="sectionTitle" />
                  <TextBlock Text="Read-only background work" Classes="pageSubtitle" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost compact"
                        Content="Close" Click="CloseDrawersButton_OnClick" />
              </Grid>

              <Border Grid.Row="1" Classes="emptyState" Margin="0,18,0,0"
                      VerticalAlignment="Top">
                <StackPanel Spacing="5">
                  <TextBlock Text="No Windows jobs are running." FontWeight="SemiBold" />
                  <TextBlock
                      Text="Job execution remains disabled until action safety reaches parity."
                      Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <Border
              x:Name="ActivityDrawer"
              Grid.RowSpan="4"
              Width="460"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1,0,0,0"
              IsVisible="False">

            <Grid RowDefinitions="Auto,*" Margin="20">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Activity" Classes="sectionTitle" />
                  <TextBlock Text="Current GraveOps session" Classes="pageSubtitle" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost compact"
                        Content="Close" Click="CloseDrawersButton_OnClick" />
              </Grid>

              <ListBox
                  Grid.Row="1"
                  x:Name="ActivityDrawerList"
                  Classes="dataList passive"
                  Margin="0,18,0,0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{ReflectionBinding Title}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{ReflectionBinding Time}" Classes="dim" />
                      </Grid>
                      <TextBlock Text="{ReflectionBinding Detail}"
                                 Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border
              x:Name="CommandPalette"
              Grid.RowSpan="4"
              Width="640"
              MaxHeight="560"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,70,0,0"
              Classes="card"
              IsVisible="False">

            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Command search" Classes="sectionTitle" />
                  <TextBlock Text="Navigate the shared GraveOps shell" Classes="pageSubtitle" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost compact"
                        Content="Close" Click="CloseCommandPaletteButton_OnClick" />
              </Grid>

              <TextBox
                  Grid.Row="1"
                  x:Name="CommandPaletteSearchText"
                  Classes="filter"
                  TextChanged="CommandPaletteSearchText_OnTextChanged" />

              <ListBox
                  Grid.Row="2"
                  x:Name="CommandPaletteList"
                  Classes="dataList"
                  MaxHeight="400"
                  SelectionChanged="CommandPaletteList_OnSelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{ReflectionBinding Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{ReflectionBinding Subtitle}" Classes="muted" FontSize="10" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <shell:UnifiedShellView
          x:Name="SharedShellView"
          Grid.RowSpan="2"
          ZIndex="200" />
    </Grid>
  </Border>
</Window>
