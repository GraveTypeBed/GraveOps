<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="GraveOps.Desktop.Windows.MainWindow"
    x:CompileBindings="False"
    Title="GraveOps"
    Width="1500"
    Height="920"
    MinWidth="1180"
    MinHeight="760"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="38"
    KeyDown="MainWindow_OnKeyDown"
    Background="{DynamicResource BackdropBrush}">

  <Border
      Background="{DynamicResource BackgroundBrush}"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="1">

    <Grid RowDefinitions="38,*">
      <Border
          Grid.Row="0"
          Background="{DynamicResource HeaderBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,0,0,1">

        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel
              Orientation="Horizontal"
              VerticalAlignment="Center"
              Margin="14,0,0,0">

            <Border
                Width="22"
                Height="22"
                CornerRadius="6"
                Background="{DynamicResource AccentTintBrush}"
                BorderBrush="#5D4B2A"
                BorderThickness="1">
              <Path
                  Data="M5,5 L17,5 L17,8 L5,8 Z M5,10 L17,10 L17,13 L5,13 Z M5,15 L17,15 L17,18 L5,18 Z"
                  Fill="{DynamicResource AccentBrush}"
                  Stretch="None"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
            </Border>

            <TextBlock
                Text="GraveOps"
                FontWeight="SemiBold"
                FontSize="12"
                Margin="9,0,0,0"
                VerticalAlignment="Center" />

            <TextBlock
                Text="Control Center"
                Classes="dim"
                FontSize="11"
                Margin="7,0,0,0"
                VerticalAlignment="Center" />
          </StackPanel>

          <Border
              Grid.Column="1"
              Background="Transparent"
              PointerPressed="TitleDragRegion_OnPointerPressed"
              DoubleTapped="TitleDragRegion_OnDoubleTapped" />

          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Classes="titlebar" ToolTip.Tip="Minimize" Click="Minimize_Click">
              <Path
                  Data="M2,7 L12,7"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2"
                  Stretch="None" />
            </Button>

            <Button Classes="titlebar" ToolTip.Tip="Maximize or restore" Click="Maximize_Click">
              <Path
                  Data="M2.5,2.5 L11.5,2.5 L11.5,11.5 L2.5,11.5 Z"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.1"
                  Fill="Transparent"
                  Stretch="None" />
            </Button>

            <Button Classes="titlebar close" ToolTip.Tip="Close" Click="Close_Click">
              <Path
                  Data="M3,3 L11,11 M11,3 L3,11"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2"
                  StrokeLineCap="Round"
                  Stretch="None" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="260,*">
        <Border
            Grid.Column="0"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">

          <Grid RowDefinitions="Auto,*,Auto" Margin="14,15,14,14">
            <Border Classes="flatCard" Padding="12" Margin="0,0,0,17">
              <StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                  <Border
                      Width="34"
                      Height="34"
                      CornerRadius="9"
                      Background="{DynamicResource AccentTintBrush}">
                    <Path
                        Data="M7,8 L19,8 M7,12 L19,12 M7,16 L15,16"
                        Stroke="{DynamicResource AccentBrush}"
                        StrokeThickness="1.6"
                        StrokeLineCap="Round"
                        Stretch="None"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                  </Border>

                  <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CONTROL PLANE" Classes="eyebrow" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Spacing="7">
                      <TextBlock
                          x:Name="ConnectionDot"
                          Text="o"
                          FontSize="9"
                          Foreground="{DynamicResource WarnBrush}" />
                      <TextBlock
                          x:Name="ConnectionText"
                          Text="CHECKING"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource WarnBrush}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="ConnectionDetailText"
                        Text="Native Windows provider"
                        Classes="dim"
                        FontSize="9"
                        Margin="0,3,0,0"
                        TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="ACTIVE SERVER" Classes="eyebrow" Margin="0,13,0,5" />

                <ComboBox
                    x:Name="ActiveTargetComboBox"
                    MinHeight="50"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="ActiveTargetComboBox_OnSelectionChanged">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <StackPanel Spacing="1">
                        <TextBlock
                            Text="{ReflectionBinding DisplayName}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{ReflectionBinding ConnectionSummary}"
                            Classes="dim"
                            FontSize="9.5"
                            TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel IsVisible="False">
                  <TextBlock x:Name="SidebarHostname" />
                  <TextBlock x:Name="SidebarOperatingSystem" />
                </StackPanel>
              </StackPanel>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                x:Name="SidebarNavigationScrollViewer"
                ClipToBounds="True"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="OVERVIEW" Classes="eyebrow" Margin="10,0,0,6" />

                <Button x:Name="DashboardNav" Classes="nav selected" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M1,1 L7,1 L7,7 L1,7 Z M9,1 L15,1 L15,7 L9,7 Z M1,9 L7,9 L7,15 L1,15 Z M9,9 L15,9 L15,15 L9,15 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Dashboard" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="IntelligenceNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M8,1 L10,5 L15,6 L11.5,9.5 L12,15 L8,12.5 L4,15 L4.5,9.5 L1,6 L6,5 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" StrokeJoin="Round" />
                    <TextBlock Grid.Column="1" Text="Intelligence" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="LifecycleNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,8 L5,8 M6,8 L9,8 M10,8 L14,8 M4,5 L6,8 L4,11 M8,5 L10,8 L8,11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" StrokeLineCap="Round" />
                    <TextBlock Grid.Column="1" Text="Lifecycle" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="HistoryNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M8,2 A6,6 0 1 1 3,5 M3,2 L3,6 L7,6 M8,5 L8,8 L11,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" StrokeLineCap="Round" StrokeJoin="Round" />
                    <TextBlock Grid.Column="1" Text="History &amp; Incidents" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="ServersNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,2 L14,2 L14,7 L2,7 Z M2,9 L14,9 L14,14 L2,14 Z M4,4.5 L5.5,4.5 M4,11.5 L5.5,11.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Servers" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <TextBlock Text="MEDIA" Classes="eyebrow" Margin="10,15,0,6" />

                <Button x:Name="MediaHubNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,2 L7,2 L7,7 L2,7 Z M9,2 L14,2 L14,7 L9,7 Z M2,9 L7,9 L7,14 L2,14 Z M9,9 L14,9 L14,14 L9,14 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Media Hub" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <TextBlock Text="INFRASTRUCTURE" Classes="eyebrow" Margin="10,15,0,6" />

                <Button x:Name="ServicesNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,3 L14,3 L14,7 L2,7 Z M2,9 L14,9 L14,13 L2,13 Z M4,5 L5.5,5 M4,11 L5.5,11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Services &amp; Actions" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="DockerNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,7 L5,7 L5,10 L2,10 Z M6,7 L9,7 L9,10 L6,10 Z M10,7 L13,7 L13,10 L10,10 Z M4,3 L7,3 L7,6 L4,6 Z M8,3 L11,3 L11,6 L8,6 Z M1,11 C4,15 11,15 15,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Docker" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="StorageNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,3 C2,1 14,1 14,3 L14,13 C14,15 2,15 2,13 Z M2,3 C2,5 14,5 14,3 M2,8 C2,10 14,10 14,8"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Storage" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="LogsNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,4 L14,4 M2,8 L11,8 M2,12 L13,12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Logs" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="BackupsNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M8,2 A6,6 0 1 1 3,5 M3,2 L3,6 L7,6"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Backups" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <TextBlock Text="OPERATOR" Classes="eyebrow" Margin="10,15,0,6" />

                <Button x:Name="SettingsNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,4 L14,4 M5,2 L5,6 M2,8 L14,8 M10,6 L10,10 M2,12 L14,12 M7,10 L7,14"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="ToolsNav" Classes="nav" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M2,3 L14,3 L14,13 L2,13 Z M4,6 L7,8 L4,10 M8,10 L11,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" />
                    <TextBlock Grid.Column="1" Text="Operator Tools" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button x:Name="IntegrationsNav" IsVisible="False" />
                <Button x:Name="WarningsNav" IsVisible="False" />
              </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="10,12,0,0">
              <TextBlock Text="GRAVEOPS" Classes="eyebrow" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="Native and remote providers" Classes="dim" FontSize="10" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid
            Grid.Column="1"
            RowDefinitions="72,42,*,26"
            Background="{DynamicResource BackgroundBrush}">

          <Border
              Grid.Row="0"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto" Margin="28,0">
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PageTitleText" Text="Dashboard" FontSize="22" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="PageSubtitleText"
                    Text="Interactive environment health, ownership and active-host operations"
                    Classes="pageSubtitle"
                    Margin="0,3,0,0" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
                <Button x:Name="OverviewButton" Classes="compact headerCommand" MinWidth="68"
                        Content="Overview" Click="OverviewButton_OnClick" />
                <Button x:Name="JobsButton" Classes="compact headerCommand" MinWidth="52"
                        Content="Jobs" Click="JobsButton_OnClick" />
                <Button Classes="compact headerCommand" MinWidth="84"
                        Content="Intelligence" Tag="IntelligenceNav"
                        Click="DashboardQuickModuleButton_OnClick" />
                <Button x:Name="ActivityButton" Classes="compact headerCommand" MinWidth="72"
                        Content="Activity" Click="ActivityButton_OnClick" />
                <Button Classes="compact headerCommand" MinWidth="88"
                        Content="Terminal" Tag="ToolsNav"
                        Click="DashboardQuickModuleButton_OnClick" />

                <Button
                    x:Name="RefreshButton"
                    Classes="primary compact"
                    MinWidth="96"
                    Content="Refresh host"
                    Click="RefreshButton_OnClick" />

                <TextBlock
                    x:Name="LastUpdatedText"
                    IsVisible="False" />
              </StackPanel>
            </Grid>
          </Border>

          <Border
              Grid.Row="1"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="28,0">
              <TextBlock Text="QUICK" Classes="eyebrow" VerticalAlignment="Center" Margin="0,0,12,0" />
              <Button Grid.Column="1" x:Name="MaintenanceButton" Classes="ghost"
                      Content="Maintenance" Padding="10,6" Click="MaintenanceButton_OnClick" />
              <TextBlock Grid.Column="3" Text="Ctrl+K search" Classes="dim" FontSize="10"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Grid.Column="4" x:Name="CommandPaletteButton" Classes="ghost"
                      Content="Search" Padding="8,4" Click="CommandPaletteButton_OnClick" />
              <Button Grid.Column="5" Classes="ghost" Content="Customize" Tag="SettingsNav"
                      Padding="8,4" Click="DashboardQuickModuleButton_OnClick" />

              <TextBlock
                  x:Name="CaptureStatusText"
                  IsVisible="False" />
            </Grid>
          </Border>

          <Grid Grid.Row="2" Margin="24">
            <Grid x:Name="DashboardPage" IsVisible="True">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="System overview" Classes="sectionTitle" />
                      <TextBlock
                          Text="Live host identity, health, workload and Windows discovery."
                          Classes="pageSubtitle"
                          Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        x:Name="DashboardCaptureAgeText"
                        Text="Waiting for capture"
                        Classes="dim"
                        VerticalAlignment="Center" />
                  </Grid>

                  <WrapPanel Orientation="Horizontal">
                    <Border Classes="flatCard" Width="235" MinHeight="96" Margin="0,0,8,8">
                      <StackPanel>
                        <TextBlock Text="CONNECTION" Classes="eyebrow" />
                        <TextBlock x:Name="DashboardConnectionText" Text="CHECKING" Classes="metricValue" Margin="0,9,0,2" />
                        <TextBlock x:Name="DashboardConnectionSummaryText" Text="Waiting for host state"
                                   Classes="dim" FontSize="10.5" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Classes="flatCard" Width="235" MinHeight="96" Margin="0,0,8,8">
                      <StackPanel>
                        <TextBlock Text="HEALTH" Classes="eyebrow" />
                        <TextBlock x:Name="DashboardAttentionCountText" Text="0" Classes="metricValue" Margin="0,9,0,2" />
                        <TextBlock x:Name="DashboardHealthSummaryText" Text="Waiting for health state"
                                   Classes="dim" FontSize="10.5" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Classes="flatCard" Width="235" MinHeight="96" Margin="0,0,8,8">
                      <StackPanel>
                        <TextBlock Text="STORAGE" Classes="eyebrow" />
                        <TextBlock x:Name="DashboardStorageCountText" Text="--" Classes="metricValue" Margin="0,9,0,2" />
                        <TextBlock x:Name="DashboardStorageSummaryText" Text="Waiting for volume state"
                                   Classes="dim" FontSize="10.5" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Classes="flatCard" Width="235" MinHeight="96" Margin="0,0,8,8">
                      <StackPanel>
                        <TextBlock Text="DOCKER" Classes="eyebrow" />
                        <TextBlock x:Name="DashboardDockerText" Text="CHECKING" FontSize="18" FontWeight="SemiBold"
                                   Margin="0,9,0,2" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DashboardDockerSummaryText" Text="Selected-host container state"
                                   Classes="dim" FontSize="10.5" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </WrapPanel>

                  <Grid ColumnDefinitions="2.1*,1*" ColumnSpacing="10">
                    <Border Classes="card" MinHeight="205">
                      <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <StackPanel>
                          <TextBlock Text="Recommendations" Classes="sectionTitle" />
                          <TextBlock
                              Text="Prioritized from the latest Windows provider snapshot."
                              Classes="pageSubtitle"
                              Margin="0,3,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                          <ListBox
                              x:Name="DashboardRecommendationsList"
                              Classes="dataList"
                              MinHeight="120"
                              MaxHeight="205">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Border Classes="selectionRow" Margin="0,0,0,5">
                                  <Grid ColumnDefinitions="78,120,*,Auto" ColumnSpacing="10">
                                    <TextBlock
                                        Text="{ReflectionBinding Severity}"
                                        Foreground="{DynamicResource WarnBrush}"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{ReflectionBinding Component}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{ReflectionBinding Message}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{ReflectionBinding Evidence}"
                                        Classes="dim"
                                        FontSize="9.5"
                                        TextTrimming="CharacterEllipsis" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>

                          <Border x:Name="DashboardRecommendationsEmptyPanel" Classes="emptyState" IsVisible="True">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                              <Border
                                  Width="38"
                                  Height="38"
                                  CornerRadius="19"
                                  Background="{DynamicResource SuccessTintBrush}"
                                  BorderBrush="#1C5A32"
                                  BorderThickness="1"
                                  VerticalAlignment="Center">
                                <TextBlock
                                    Text="ÃƒÆ’Ã‚Â¢Ãƒâ€¦Ã¢â‚¬Å“ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="No recommendations" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="The latest read-only snapshot did not produce actionable findings."
                                    Classes="muted"
                                    TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </Grid>
                      </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="card" MinHeight="205">
                      <StackPanel Spacing="10">
                        <StackPanel>
                          <TextBlock Text="Active host" Classes="sectionTitle" />
                          <TextBlock Text="Native Windows provider identity." Classes="pageSubtitle" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Classes="inset">
                          <StackPanel Spacing="4">
                            <TextBlock x:Name="DashboardHostnameText" Text="Loading..." FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="DashboardOsText" Text="--" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock x:Name="DashboardAddressText" Text="--" Classes="mono" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                          <Border Classes="inset">
                            <StackPanel>
                              <TextBlock Text="UPTIME" Classes="eyebrow" />
                              <TextBlock x:Name="DashboardUptimeText" Text="--" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                          </Border>
                          <Border Grid.Column="1" Classes="inset">
                            <StackPanel>
                              <TextBlock Text="MEMORY" Classes="eyebrow" />
                              <TextBlock x:Name="DashboardMemoryText" Text="--" FontSize="11"
                                         FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Border Classes="card">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="Live workload" Classes="sectionTitle" />
                          <TextBlock Text="Shared snapshot counts; no extra repair or destructive probes."
                                     Classes="pageSubtitle" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Latest active-host sample" Classes="dim" VerticalAlignment="Center" />
                      </Grid>

                      <WrapPanel Orientation="Horizontal">
                        <Border Classes="inset" Width="180" Margin="0,0,8,0">
                          <StackPanel>
                            <TextBlock Text="SERVICES" Classes="eyebrow" />
                            <TextBlock x:Name="DashboardServiceCountText" Text="--" FontSize="22" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Classes="inset" Width="180" Margin="0,0,8,0">
                          <StackPanel>
                            <TextBlock Text="CONTAINERS" Classes="eyebrow" />
                            <TextBlock x:Name="DashboardContainerCountText" Text="--" FontSize="22" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Classes="inset" Width="180" Margin="0,0,8,0">
                          <StackPanel>
                            <TextBlock Text="INTEGRATIONS" Classes="eyebrow" />
                            <TextBlock x:Name="DashboardIntegrationCountText" Text="--" FontSize="22" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Classes="inset" Width="180" Margin="0,0,8,0">
                          <StackPanel>
                            <TextBlock Text="WARNINGS" Classes="eyebrow" />
                            <TextBlock x:Name="DashboardWarningCountText" Text="--" FontSize="22" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Classes="inset" Width="230">
                          <StackPanel>
                            <TextBlock Text="SYSTEM STATE" Classes="eyebrow" />
                            <TextBlock x:Name="DashboardSystemStateText" Text="--" FontSize="17"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Grid ColumnDefinitions="2.1*,1*" ColumnSpacing="10">
                    <Border Classes="card" MinHeight="190">
                      <StackPanel Spacing="11">
                        <StackPanel>
                          <TextBlock Text="System health" Classes="sectionTitle" />
                          <TextBlock Text="Canonical read-only health summary from the Windows snapshot."
                                     Classes="pageSubtitle" Margin="0,3,0,0" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="7">
                          <Border Classes="healthPass">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel>
                                <TextBlock Text="PASS" Foreground="{DynamicResource SuccessBrush}"
                                           FontSize="10.5" FontWeight="SemiBold" />
                                <TextBlock Text="Healthy checks" Classes="dim" FontSize="9.5" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" x:Name="DashboardHealthPassText" Text="--"
                                         FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                          </Border>

                          <Border Grid.Column="1" Classes="healthWarn">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel>
                                <TextBlock Text="WARN" Foreground="{DynamicResource WarnBrush}"
                                           FontSize="10.5" FontWeight="SemiBold" />
                                <TextBlock Text="Needs review" Classes="dim" FontSize="9.5" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" x:Name="DashboardHealthWarnText" Text="--"
                                         FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                          </Border>

                          <Border Grid.Column="2" Classes="healthFail">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel>
                                <TextBlock Text="FAIL" Foreground="{DynamicResource DangerBrush}"
                                           FontSize="10.5" FontWeight="SemiBold" />
                                <TextBlock Text="Action required" Classes="dim" FontSize="9.5" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" x:Name="DashboardHealthFailText" Text="--"
                                         FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                          </Border>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card" MinHeight="190">
                      <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <StackPanel>
                          <TextBlock Text="Recent activity" Classes="sectionTitle" />
                          <TextBlock Text="Latest meaningful preview operations." Classes="pageSubtitle" Margin="0,3,0,0" />
                        </StackPanel>
                        <ListBox
                            Grid.Row="1"
                            x:Name="DashboardActivityList"
                            Classes="dataList"
                            MinHeight="110"
                            MaxHeight="180">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                              <Border Classes="selectionRow" Margin="0,0,0,5">
                                <StackPanel Spacing="2">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{ReflectionBinding Title}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{ReflectionBinding Time}" Classes="dim" FontSize="9.5" />
                                  </Grid>
                                  <TextBlock Text="{ReflectionBinding Detail}" Classes="muted" FontSize="10"
                                             TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </Grid>
                    </Border>
                  </Grid>

                  <Border Classes="card" Margin="0,0,0,4">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                      <StackPanel>
                        <TextBlock Text="Storage fleet" Classes="sectionTitle" />
                        <TextBlock Text="All ready Windows volumes reported by the native provider."
                                   Classes="pageSubtitle" Margin="0,3,0,0" />
                      </StackPanel>
                      <ListBox
                          Grid.Row="1"
                          x:Name="DashboardStorageList"
                          Classes="dataList"
                          MinHeight="150"
                          MaxHeight="260">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Border Classes="selectionRow" Margin="0,0,0,5">
                              <Grid ColumnDefinitions="80,90,110,110,110,90,*" ColumnSpacing="10">
                                <TextBlock Text="{ReflectionBinding MountPoint}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{ReflectionBinding FileSystem}" Classes="muted" />
                                <TextBlock Grid.Column="2" Text="{ReflectionBinding Used}" />
                                <TextBlock Grid.Column="3" Text="{ReflectionBinding Size}" Classes="muted" />
                                <TextBlock Grid.Column="4" Text="{ReflectionBinding Available}" Classes="muted" />
                                <TextBlock Grid.Column="5" Text="{ReflectionBinding PercentUsed}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="6" Text="{ReflectionBinding Source}" Classes="dim"
                                           TextTrimming="CharacterEllipsis" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <Grid x:Name="ServicesPage" IsVisible="False">
              <Border Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                  <StackPanel>
                    <TextBlock Text="Windows services" Classes="sectionTitle" />
                    <TextBlock Text="Cataloged GraveOps-related services discovered by the native provider."
                               Classes="pageSubtitle" Margin="0,3,0,0" />
                  </StackPanel>
                  <ListBox Grid.Row="1" x:Name="ServicesList" Classes="dataList">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Classes="selectionRow" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="240,130,130,130,*" ColumnSpacing="12">
                            <TextBlock Text="{ReflectionBinding Unit}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding ActiveState}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding SubState}" Classes="muted" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding UnitFileState}" Classes="muted" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Description}" Classes="dim"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>

            <Grid x:Name="DockerPage" IsVisible="False">
              <Border Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                  <StackPanel>
                    <TextBlock Text="Docker containers" Classes="sectionTitle" />
                    <TextBlock x:Name="DockerPageSummaryText" Text="Container discovery pending."
                               Classes="pageSubtitle" Margin="0,3,0,0" />
                  </StackPanel>
                  <ListBox Grid.Row="1" x:Name="ContainersList" Classes="dataList">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Classes="selectionRow" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="210,120,280,*,180" ColumnSpacing="12">
                            <TextBlock Text="{ReflectionBinding Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding State}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Image}" Classes="muted"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Status}" Classes="dim"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Ports}" Classes="mono"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>

            <Grid x:Name="StoragePage" IsVisible="False">
              <Border Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                  <StackPanel>
                    <TextBlock Text="Windows storage" Classes="sectionTitle" />
                    <TextBlock Text="Ready volumes and capacity evidence. No mount or filesystem actions are available."
                               Classes="pageSubtitle" Margin="0,3,0,0" />
                  </StackPanel>
                  <ListBox Grid.Row="1" x:Name="StorageList" Classes="dataList">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Classes="selectionRow" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="90,100,130,130,130,100,*" ColumnSpacing="12">
                            <TextBlock Text="{ReflectionBinding MountPoint}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding FileSystem}" Classes="muted" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Used}" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Size}" Classes="muted" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Available}" Classes="muted" />
                            <TextBlock Grid.Column="5" Text="{ReflectionBinding PercentUsed}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="6" Text="{ReflectionBinding Source}" Classes="dim"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>

            <Grid x:Name="IntegrationsPage" IsVisible="False">
              <Border Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                  <StackPanel>
                    <TextBlock Text="Detected integrations" Classes="sectionTitle" />
                    <TextBlock Text="Read-only application and endpoint evidence from the Windows provider."
                               Classes="pageSubtitle" Margin="0,3,0,0" />
                  </StackPanel>
                  <ListBox Grid.Row="1" x:Name="IntegrationsList" Classes="dataList">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Classes="selectionRow" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="210,180,140,*" ColumnSpacing="12">
                            <TextBlock Text="{ReflectionBinding Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Kind}" Classes="muted" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding State}" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Evidence}" Classes="dim"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>

            <Grid x:Name="WarningsPage" IsVisible="False">
              <Border Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                  <StackPanel>
                    <TextBlock Text="Provider warnings" Classes="sectionTitle" />
                    <TextBlock Text="Capture limitations and read-only operational findings."
                               Classes="pageSubtitle" Margin="0,3,0,0" />
                  </StackPanel>
                  <ListBox Grid.Row="1" x:Name="WarningsList" Classes="dataList">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Classes="healthWarn" Margin="0,0,0,7">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="!" Foreground="{DynamicResource WarnBrush}"
                                       FontWeight="Bold" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>


            <Grid x:Name="ParityPage" IsVisible="False">
              <Border Classes="card">
                <Border Classes="emptyState" VerticalAlignment="Center">
                  <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="ParityPageTitleText"
                        Text="Linux page destination connected"
                        FontSize="17"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="ParityPageBodyText"
                        Text="The canonical shell destination is active. Windows page data will be ported next."
                        Classes="muted"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="This parity foundation remains read-only."
                        Foreground="{DynamicResource SuccessBrush}" />
                  </StackPanel>
                </Border>
              </Border>
            </Grid>
          </Grid>

          <Border
              Grid.Row="3"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="28,0">
              <TextBlock
                  x:Name="FooterStatusText"
                  Text="Windows Avalonia Phase 2 ÃƒÆ’Ã¢â‚¬Å¡| read-only"
                  Classes="dim"
                  FontSize="9.5"
                  VerticalAlignment="Center" />
              <TextBlock
                  Grid.Column="1"
                  Text="WPF LEGACY PRESERVED"
                  Foreground="{DynamicResource SuccessBrush}"
                  FontSize="9"
                  FontWeight="SemiBold"
                  VerticalAlignment="Center" />
            </Grid>
          </Border>


          <Border
              x:Name="OverviewDrawer"
              Grid.RowSpan="4"
              Width="420"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1,0,0,0"
              IsVisible="False">

            <Grid RowDefinitions="Auto,*" Margin="20">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Overview" Classes="sectionTitle" />
                  <TextBlock Text="Active-target summary" Classes="pageSubtitle" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost compact"
                        Content="Close" Click="CloseDrawersButton_OnClick" />
              </Grid>

              <StackPanel Grid.Row="1" Margin="0,18,0,0" Spacing="10">
                <Border Classes="inset">
                  <StackPanel Spacing="5">
                    <TextBlock Text="HOST" Classes="eyebrow" />
                    <TextBlock x:Name="OverviewHostText" Text="Loading..."
                               FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="OverviewSystemText" Text="--"
                               Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Border Classes="inset">
                    <StackPanel>
                      <TextBlock Text="STORAGE" Classes="eyebrow" />
                      <TextBlock x:Name="OverviewStorageText" Text="--"
                                 FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="inset">
                    <StackPanel>
                      <TextBlock Text="ATTENTION" Classes="eyebrow" />
                      <TextBlock x:Name="OverviewAttentionText" Text="--"
                                 FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="inset">
                  <StackPanel Spacing="5">
                    <TextBlock Text="LATEST CAPTURE" Classes="eyebrow" />
                    <TextBlock x:Name="OverviewCaptureText" Text="Waiting for capture" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Border>

          <Border
              x:Name="JobsDrawer"
              Grid.RowSpan="4"
              Width="420"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1,0,0,0"
              IsVisible="False">

            <Grid RowDefinitions="Auto,*" Margin="20">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Jobs" Classes="sectionTitle" />
                  <TextBlock Text="Read-only background work" Classes="pageSubtitle" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost compact"
                        Content="Close" Click="CloseDrawersButton_OnClick" />
              </Grid>

              <Border Grid.Row="1" Classes="emptyState" Margin="0,18,0,0"
                      VerticalAlignment="Top">
                <StackPanel Spacing="5">
                  <TextBlock Text="No Windows jobs are running." FontWeight="SemiBold" />
                  <TextBlock
                      Text="Job execution remains disabled until action safety reaches parity."
                      Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <Border
              x:Name="ActivityDrawer"
              Grid.RowSpan="4"
              Width="460"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1,0,0,0"
              IsVisible="False">

            <Grid RowDefinitions="Auto,*" Margin="20">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Activity" Classes="sectionTitle" />
                  <TextBlock Text="Current GraveOps session" Classes="pageSubtitle" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost compact"
                        Content="Close" Click="CloseDrawersButton_OnClick" />
              </Grid>

              <ListBox
                  Grid.Row="1"
                  x:Name="ActivityDrawerList"
                  Classes="dataList passive"
                  Margin="0,18,0,0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{ReflectionBinding Title}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{ReflectionBinding Time}" Classes="dim" />
                      </Grid>
                      <TextBlock Text="{ReflectionBinding Detail}"
                                 Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border
              x:Name="CommandPalette"
              Grid.RowSpan="4"
              Width="640"
              MaxHeight="560"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,70,0,0"
              Classes="card"
              IsVisible="False">

            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Command search" Classes="sectionTitle" />
                  <TextBlock Text="Navigate the shared GraveOps shell" Classes="pageSubtitle" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost compact"
                        Content="Close" Click="CloseCommandPaletteButton_OnClick" />
              </Grid>

              <TextBox
                  Grid.Row="1"
                  x:Name="CommandPaletteSearchText"
                  Classes="filter"
                  TextChanged="CommandPaletteSearchText_OnTextChanged" />

              <ListBox
                  Grid.Row="2"
                  x:Name="CommandPaletteList"
                  Classes="dataList"
                  MaxHeight="400"
                  SelectionChanged="CommandPaletteList_OnSelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{ReflectionBinding Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{ReflectionBinding Subtitle}" Classes="muted" FontSize="10" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
