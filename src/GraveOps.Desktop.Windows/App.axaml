<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="GraveOps.Desktop.Windows.App"
    RequestedThemeVariant="Dark">

  <Application.Resources>
    <SolidColorBrush x:Key="BackdropBrush" Color="#090A0C" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#101214" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0C0E10" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#0F1113" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171A1E" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#1C2025" />
    <SolidColorBrush x:Key="InputBrush" Color="#121519" />
    <SolidColorBrush x:Key="ConsoleBrush" Color="#0C0F12" />
    <SolidColorBrush x:Key="BorderBrush" Color="#292E35" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A414A" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F1EE" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA1A9" />
    <SolidColorBrush x:Key="DimBrush" Color="#69717A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#D4AA5C" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E3B967" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#2B2418" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#63CC8B" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E0B24F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E16B75" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource BackdropBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Inter, sans-serif" />
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
    </Style>

    <Style Selector="TextBlock.metric">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="#101214" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    </Style>

    <Style Selector="TextBox.output">
      <Setter Property="Background" Value="{DynamicResource ConsoleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="12" />
    </Style>
  </Application.Styles>
</Application>
