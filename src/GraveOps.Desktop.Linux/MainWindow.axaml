<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="GraveOps.Desktop.Linux.MainWindow"
    x:CompileBindings="False"
    Title="GraveOps"
    Icon="/Assets/graveops-brandmark.png"
    Width="1500"
    Height="920"
    MinWidth="1180"
    MinHeight="760"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="38"
    Background="{DynamicResource BackdropBrush}">

  <Border
      Background="{DynamicResource BackgroundBrush}"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="1">

    <Grid RowDefinitions="38,*">
      <!-- Custom GraveOps title bar -->
      <Border
          Grid.Row="0"
          Background="{DynamicResource HeaderBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,0,0,1">

        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel
              Orientation="Horizontal"
              VerticalAlignment="Center"
              Margin="14,0,0,0"
              Spacing="9">

            <Image
                Width="24"
                Height="24"
                Source="/Assets/graveops-brandmark.png"
                Stretch="Uniform" />

            <TextBlock
                Text="GraveOps"
                FontSize="12"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />

            <Border
                Background="{DynamicResource AccentTintBrush}"
                CornerRadius="5"
                Padding="7,2"
                Margin="4,0,0,0">

              <TextBlock
                  Text="LINUX"
                  Classes="eyebrow"
                  Foreground="{DynamicResource AccentBrush}" />
            </Border>
          </StackPanel>

          <Border
              Grid.Column="1"
              Background="Transparent"
              PointerPressed="TitleDragRegion_OnPointerPressed"
              DoubleTapped="TitleDragRegion_OnDoubleTapped" />

          <StackPanel
              Grid.Column="2"
              Orientation="Horizontal">

            <Button
                Classes="titlebar"
                Content="—"
                Click="Minimize_Click" />

            <Button
                Classes="titlebar"
                Content="□"
                Click="Maximize_Click" />

            <Button
                Classes="titlebar close"
                Content="×"
                Click="Close_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid
          Grid.Row="1"
          ColumnDefinitions="260,*">

        <!-- Navigation rail -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">

          <Grid
              RowDefinitions="Auto,*,Auto"
              Margin="14,15,14,14">

            <Border
                Classes="card"
                Padding="13"
                Margin="0,0,0,17">

              <StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                  <Border
                      Width="34"
                      Height="34"
                      CornerRadius="9"
                      Background="{DynamicResource AccentTintBrush}">

                    <Path
                        Data="M7,8 L19,8 M7,12 L19,12 M7,16 L15,16"
                        Stroke="{DynamicResource AccentBrush}"
                        StrokeThickness="1.6"
                        StrokeLineCap="Round"
                        Stretch="None"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                  </Border>

                  <StackPanel
                      Grid.Column="1"
                      Margin="11,0,0,0"
                      VerticalAlignment="Center">

                    <TextBlock
                        Text="CONTROL PLANE"
                        Classes="eyebrow" />

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,5,0,0"
                        Spacing="7">

                      <TextBlock
                          x:Name="ConnectionDot"
                          Text="●"
                          FontSize="10"
                          Foreground="{DynamicResource SuccessBrush}" />

                      <TextBlock
                          x:Name="ConnectionText"
                          Text="Ready"
                          FontSize="12"
                          Foreground="{DynamicResource SuccessBrush}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>

                <TextBlock
                    Text="ACTIVE TARGET"
                    Classes="eyebrow"
                    Margin="0,13,0,5" />

                <Border
                    Classes="inset"
                    Padding="10,8">

                  <StackPanel>
                    <TextBlock
                        x:Name="SidebarHostname"
                        Text="Loading..."
                        FontSize="12"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        x:Name="SidebarOperatingSystem"
                        Text="Linux"
                        Classes="dim"
                        FontSize="10"
                        Margin="0,3,0,0"
                        TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

              <StackPanel>
                <TextBlock
                    Text="OVERVIEW"
                    Classes="eyebrow"
                    Margin="10,0,0,6" />

                <Button
                    x:Name="DashboardNav"
                    Classes="nav selected"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M1,1 L7,1 L7,7 L1,7 Z M9,1 L15,1 L15,7 L9,7 Z M1,9 L7,9 L7,15 L1,15 Z M9,9 L15,9 L15,15 L9,15 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Dashboard"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="IntelligenceNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M8,1 L10,5 L15,6 L11.5,9.5 L12,15 L8,12.5 L4,15 L4.5,9.5 L1,6 L6,5 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Intelligence"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="LifecycleNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,8 L5,8 M6,8 L9,8 M10,8 L14,8 M4,5 L6,8 L4,11 M8,5 L10,8 L8,11"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Lifecycle"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="HistoryNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M8,2 A6,6 0 1 1 3,5 M3,2 L3,6 L7,6 M8,5 L8,8 L11,10"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="History &amp; Incidents"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="ServersNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,2 L14,2 L14,7 L2,7 Z M2,9 L14,9 L14,14 L2,14 Z M4,4.5 L5.5,4.5 M4,11.5 L5.5,11.5"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Servers"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <TextBlock
                    Text="MEDIA"
                    Classes="eyebrow"
                    Margin="10,15,0,6" />

                <Button
                    x:Name="MediaHubNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,2 L7,2 L7,7 L2,7 Z M9,2 L14,2 L14,7 L9,7 Z M2,9 L7,9 L7,14 L2,14 Z M9,9 L14,9 L14,14 L9,14 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Media Hub"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <TextBlock
                    Text="SYSTEM"
                    Classes="eyebrow"
                    Margin="10,15,0,6" />

                <Button
                    x:Name="ServicesNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,4 L14,4 M2,8 L14,8 M2,12 L14,12 M4,2 L4,6 M10,6 L10,10 M6,10 L6,14"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Services &amp; Actions"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="DockerNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,5 L6,5 L6,9 L2,9 Z M7,5 L11,5 L11,9 L7,9 Z M12,5 L15,5 L15,9 L12,9 Z M4,1 L8,1 L8,4 L4,4 Z M9,1 L13,1 L13,4 L9,4 Z M1,10 C3,14 12,15 15,9"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.1" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Docker"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="StorageNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,3 C2,1.5 14,1.5 14,3 L14,13 C14,14.5 2,14.5 2,13 Z M2,3 C2,5 14,5 14,3 M2,8 C2,10 14,10 14,8"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Storage"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="LogsNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,2 L14,2 L14,14 L2,14 Z M4,5 L12,5 M4,8 L12,8 M4,11 L9,11"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Logs"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="BackupsNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M3,2 L13,2 L13,14 L3,14 Z M5,2 L5,6 L11,6 L11,2 M5,10 L11,10 L11,14 L5,14 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Backups"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>
              </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Margin="10,12,0,0">
              <TextBlock
                  Text="GRAVEOPS LINUX"
                  Classes="eyebrow"
                  Foreground="{DynamicResource AccentBrush}" />
              <TextBlock
                  Text="Parity shell · native provider"
                  Classes="dim"
                  FontSize="10"
                  Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Main workspace -->
        <Grid
            Grid.Column="1"
            RowDefinitions="Auto,Auto,*"
            Background="{DynamicResource BackgroundBrush}">

          <Grid
              Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="28,24,28,0">

            <StackPanel>
              <TextBlock
                  x:Name="PageTitleText"
                  Text="Dashboard"
                  Classes="pageTitle" />

              <TextBlock
                  x:Name="PageSubtitleText"
                  Text="Fleet-aware local Linux operations"
                  Classes="pageSubtitle"
                  Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="10">

              <TextBlock
                  x:Name="LastUpdatedText"
                  Text="Waiting for first capture"
                  Classes="dim"
                  FontSize="11"
                  VerticalAlignment="Center" />

              <Button
                  x:Name="RefreshButton"
                  Classes="primary"
                  Content="Refresh environment"
                  Click="RefreshButton_OnClick" />
            </StackPanel>
          </Grid>

          <Border
              Grid.Row="1"
              Margin="28,18,28,0"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="9"
              Padding="13,9">

            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock
                  x:Name="StatusStripDot"
                  Text="●"
                  FontSize="10"
                  Foreground="{DynamicResource SuccessBrush}"
                  VerticalAlignment="Center" />

              <TextBlock
                  Grid.Column="1"
                  x:Name="StatusStripText"
                  Text="Local Linux provider ready"
                  FontSize="11"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center" />

              <TextBlock
                  Grid.Column="2"
                  Text="Native systemd · Docker · storage · journal"
                  Classes="dim"
                  FontSize="10"
                  VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Grid
              Grid.Row="2"
              Margin="28,20,28,28">

            <!-- Dashboard -->
            <ScrollViewer
                x:Name="DashboardPage"
                IsVisible="True">

              <StackPanel Spacing="18">
                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="14">

                  <Border Classes="card">
                    <StackPanel Spacing="8">
                      <TextBlock Text="HOST" Classes="eyebrow" />
                      <TextBlock
                          x:Name="DashboardHostnameText"
                          Text="Loading..."
                          FontSize="18"
                          FontWeight="SemiBold"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock
                          x:Name="DashboardOsText"
                          Text="--"
                          Classes="muted"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border
                      Grid.Column="1"
                      Classes="card">
                    <StackPanel Spacing="8">
                      <TextBlock Text="SYSTEM" Classes="eyebrow" />
                      <TextBlock
                          x:Name="DashboardSystemText"
                          Text="Loading..."
                          FontSize="18"
                          FontWeight="SemiBold" />
                      <TextBlock
                          x:Name="DashboardKernelText"
                          Text="--"
                          Classes="muted" />
                    </StackPanel>
                  </Border>

                  <Border
                      Grid.Column="2"
                      Classes="card">
                    <StackPanel Spacing="8">
                      <TextBlock Text="DOCKER" Classes="eyebrow" />
                      <TextBlock
                          x:Name="DashboardDockerText"
                          Text="Loading..."
                          FontSize="18"
                          FontWeight="SemiBold"
                          TextWrapping="Wrap" />
                      <TextBlock
                          x:Name="DashboardUptimeText"
                          Text="--"
                          Classes="muted" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid
                    ColumnDefinitions="1.25*,0.75*"
                    ColumnSpacing="14">

                  <Border Classes="card">
                    <StackPanel Spacing="14">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="Environment snapshot"
                              Classes="sectionTitle" />
                          <TextBlock
                              Text="Current native Linux telemetry for the selected host."
                              Classes="pageSubtitle"
                              Margin="0,4,0,0" />
                        </StackPanel>

                        <Border
                            x:Name="DashboardHealthBadgeBorder"
                            Grid.Column="1"
                            Background="{DynamicResource SuccessTintBrush}"
                            CornerRadius="7"
                            Padding="10,5">

                          <TextBlock
                              x:Name="DashboardHealthBadge"
                              Text="HEALTHY"
                              Classes="eyebrow"
                              Foreground="{DynamicResource SuccessBrush}" />
                        </Border>
                      </Grid>

                      <Grid
                          ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="14"
                          RowSpacing="12">

                        <Border Classes="inset">
                          <StackPanel Spacing="5">
                            <TextBlock Text="CPU" Classes="eyebrow" />
                            <TextBlock
                                x:Name="DashboardCpuText"
                                Text="--"
                                FontSize="12"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="DashboardLoadText"
                                Text="--"
                                Classes="dim"
                                FontSize="10" />
                          </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Classes="inset">
                          <StackPanel Spacing="5">
                            <TextBlock Text="MEMORY" Classes="eyebrow" />
                            <TextBlock
                                x:Name="DashboardMemoryText"
                                Text="--"
                                FontSize="12"
                                TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Classes="inset">
                          <StackPanel Spacing="5">
                            <TextBlock Text="NETWORK" Classes="eyebrow" />
                            <TextBlock
                                x:Name="DashboardIpText"
                                Text="--"
                                FontSize="12"
                                TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Classes="inset">
                          <StackPanel Spacing="5">
                            <TextBlock Text="DISCOVERY" Classes="eyebrow" />
                            <TextBlock
                                x:Name="DashboardDiscoveryText"
                                Text="--"
                                FontSize="12"
                                TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border
                      Grid.Column="1"
                      Classes="card">

                    <StackPanel Spacing="12">
                      <TextBlock
                          Text="Needs attention"
                          Classes="sectionTitle" />

                      <TextBlock
                          Text="Provider warnings and failed systemd services."
                          Classes="pageSubtitle" />

                      <ListBox
                          x:Name="DashboardAttentionList"
                          Classes="dataList"
                          MinHeight="190"
                          MaxHeight="280">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                              <TextBlock Text="{ReflectionBinding Severity}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                              <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{ReflectionBinding Component}" FontWeight="SemiBold" />
                                <TextBlock Text="{ReflectionBinding Problem}" Classes="muted" TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="14">

                  <Border Classes="card">
                    <StackPanel Spacing="8">
                      <TextBlock Text="SERVICES" Classes="eyebrow" />
                      <TextBlock
                          x:Name="DashboardServicesModuleText"
                          Text="--"
                          FontSize="20"
                          FontWeight="SemiBold" />
                      <TextBlock
                          Text="Known host services discovered through systemd."
                          Classes="pageSubtitle" />
                    </StackPanel>
                  </Border>

                  <Border
                      Grid.Column="1"
                      Classes="card">
                    <StackPanel Spacing="8">
                      <TextBlock Text="STORAGE" Classes="eyebrow" />
                      <TextBlock
                          x:Name="DashboardStorageModuleText"
                          Text="--"
                          FontSize="20"
                          FontWeight="SemiBold" />
                      <TextBlock
                          Text="Operational filesystems after pseudo-filesystem filtering."
                          Classes="pageSubtitle" />
                    </StackPanel>
                  </Border>

                  <Border
                      Grid.Column="2"
                      Classes="card">
                    <StackPanel Spacing="8">
                      <TextBlock Text="MEDIA HUB" Classes="eyebrow" />
                      <TextBlock
                          x:Name="DashboardMediaModuleText"
                          Text="--"
                          FontSize="20"
                          FontWeight="SemiBold" />
                      <TextBlock
                          Text="Verified integrations detected from service and container identity."
                          Classes="pageSubtitle" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </ScrollViewer>

            <!-- Servers -->
            <ScrollViewer
                x:Name="ServersPage"
                IsVisible="False">

              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Selected host" Classes="sectionTitle" />
                      <TextBlock
                          x:Name="ServerIdentityText"
                          Text="--"
                          FontSize="18"
                          FontWeight="SemiBold" />
                      <TextBlock
                          x:Name="ServerOperatingSystemText"
                          Text="--"
                          Classes="muted" />
                      <TextBlock
                          x:Name="ServerKernelText"
                          Text="--"
                          Classes="muted" />
                      <TextBlock
                          x:Name="ServerUptimeText"
                          Text="--"
                          Classes="muted" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Runtime" Classes="sectionTitle" />
                      <TextBlock
                          x:Name="ServerCpuText"
                          Text="--"
                          TextWrapping="Wrap" />
                      <TextBlock
                          x:Name="ServerMemoryText"
                          Text="--"
                          TextWrapping="Wrap" />
                      <TextBlock
                          x:Name="ServerNetworkText"
                          Text="--"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock
                        Text="Provider capability"
                        Classes="sectionTitle" />
                    <TextBlock
                        Text="This Linux client is reading the local machine directly. It does not SSH back into itself. Remote-host routing will reuse the shared host-provider model."
                        Classes="muted"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

<!-- Media Hub -->
            <ScrollViewer x:Name="MediaHubPage" IsVisible="False">
              <StackPanel Spacing="18">
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,320">
                      <StackPanel>
                        <TextBlock Text="Verified integrations" Classes="sectionTitle" />
                        <TextBlock Text="Docker identity, systemd units and DUMB published ports are correlated." Classes="pageSubtitle" Margin="0,4,0,0" />
                      </StackPanel>
                      <TextBox Grid.Column="1" x:Name="MediaFilterText" Classes="filter" PlaceholderText="Filter integrations" TextChanged="MediaFilterText_OnTextChanged" />
                    </Grid>
                    <ListBox x:Name="IntegrationsList" Classes="dataList" MinHeight="460">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="160,150,180,220,*,90" ColumnSpacing="12">
                            <TextBlock Text="{ReflectionBinding Name}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Kind}" Classes="muted" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding State}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding State}" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Evidence}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Evidence}" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Endpoint}" Classes="dim" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="5" Text="{ReflectionBinding Severity}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

<!-- Services -->
            <ScrollViewer x:Name="ServicesPage" IsVisible="False">
              <StackPanel Spacing="18">
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="Native systemd services" Classes="sectionTitle" />
                        <TextBlock Text="Select a service. Safe Mode blocks stop and restart by default." Classes="pageSubtitle" Margin="0,4,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" x:Name="ServicesSummaryText" Text="--" Classes="muted" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="300,Auto,Auto,Auto,*,Auto" ColumnSpacing="9">
                      <TextBox x:Name="ServicesFilterText" Classes="filter" PlaceholderText="Filter services" TextChanged="ServicesFilterText_OnTextChanged" />
                      <Button Grid.Column="1" x:Name="ServiceStartButton" Content="Start" IsEnabled="False" Click="ServiceStartButton_OnClick" />
                      <Button Grid.Column="2" x:Name="ServiceStopButton" Content="Stop" Classes="danger" IsEnabled="False" Click="ServiceStopButton_OnClick" />
                      <Button Grid.Column="3" x:Name="ServiceRestartButton" Content="Restart" IsEnabled="False" Click="ServiceRestartButton_OnClick" />
                      <TextBlock Grid.Column="4" x:Name="ServiceActionStatusText" Text="Select a service." Classes="dim" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <CheckBox Grid.Column="5" x:Name="SafeModeCheckBox" Content="Safe Mode" IsChecked="True" VerticalAlignment="Center" Click="SafeModeCheckBox_OnClick" />
                    </Grid>
                    <ListBox x:Name="ServicesList" Classes="dataList" MinHeight="430" SelectionChanged="ServicesList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="230,100,110,120,*,90" ColumnSpacing="12">
                            <TextBlock Text="{ReflectionBinding Unit}" FontFamily="DejaVu Sans Mono, monospace" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding ActiveState}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding SubState}" Classes="muted" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding UnitFileState}" Classes="muted" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Description}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Description}" />
                            <TextBlock Grid.Column="5" Text="status" Classes="dim" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

<!-- Docker -->
            <ScrollViewer x:Name="DockerPage" IsVisible="False">
              <StackPanel Spacing="18">
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="Docker containers" Classes="sectionTitle" />
                        <TextBlock Text="Exited (0) one-shot containers are informational; non-zero exits are findings." Classes="pageSubtitle" Margin="0,4,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" x:Name="DockerSummaryText" Text="--" Classes="muted" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="300,Auto,Auto,Auto,*" ColumnSpacing="9">
                      <TextBox x:Name="DockerFilterText" Classes="filter" PlaceholderText="Filter containers" TextChanged="DockerFilterText_OnTextChanged" />
                      <Button Grid.Column="1" x:Name="DockerStartButton" Content="Start" IsEnabled="False" Click="DockerStartButton_OnClick" />
                      <Button Grid.Column="2" x:Name="DockerStopButton" Content="Stop" Classes="danger" IsEnabled="False" Click="DockerStopButton_OnClick" />
                      <Button Grid.Column="3" x:Name="DockerRestartButton" Content="Restart" IsEnabled="False" Click="DockerRestartButton_OnClick" />
                      <TextBlock Grid.Column="4" x:Name="DockerActionStatusText" Text="Select a container. Safe Mode is controlled on Services &amp; Actions." Classes="dim" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ListBox x:Name="DockerList" Classes="dataList" MinHeight="430" SelectionChanged="DockerList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="170,90,260,220,*" ColumnSpacing="12">
                            <TextBlock Text="{ReflectionBinding Name}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding State}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Image}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Image}" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Status}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Status}" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Ports}" Classes="dim" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Ports}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

<!-- Storage -->
            <ScrollViewer x:Name="StoragePage" IsVisible="False">
              <StackPanel Spacing="18">
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,320">
                      <StackPanel>
                        <TextBlock Text="Local storage" Classes="sectionTitle" />
                        <TextBlock Text="Warning at 85%, error at 90%, critical at 95%. efivarfs is removed from the operational view." Classes="pageSubtitle" Margin="0,4,0,0" />
                      </StackPanel>
                      <TextBox Grid.Column="1" x:Name="StorageFilterText" Classes="filter" PlaceholderText="Filter mounts" TextChanged="StorageFilterText_OnTextChanged" />
                    </Grid>
                    <TextBlock x:Name="StorageSummaryText" Text="--" Classes="muted" />
                    <ListBox x:Name="StorageList" Classes="dataList" MinHeight="450">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="200,90,90,90,90,90,*" ColumnSpacing="12">
                            <TextBlock Text="{ReflectionBinding Source}" FontFamily="DejaVu Sans Mono, monospace" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Source}" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding FileSystem}" Classes="muted" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Size}" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Used}" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Available}" />
                            <TextBlock Grid.Column="5" Text="{ReflectionBinding PercentUsed}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="6" Text="{ReflectionBinding MountPoint}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding MountPoint}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

<!-- Logs -->
            <Grid x:Name="LogsPage" IsVisible="False" RowDefinitions="1.2*,0.8*" RowSpacing="14">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="Grouped warning journal" Classes="sectionTitle" />
                      <TextBlock Text="Repeated messages are collapsed so unique incidents and crashes remain visible." Classes="pageSubtitle" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="LogsSummaryText" Text="--" Classes="muted" VerticalAlignment="Center" />
                  </Grid>
                  <ListBox x:Name="LogsList" Classes="dataList" SelectionChanged="LogsList_OnSelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Grid ColumnDefinitions="90,170,160,70,*" ColumnSpacing="12">
                          <TextBlock Text="{ReflectionBinding Severity}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                          <TextBlock Grid.Column="1" Text="{ReflectionBinding Source}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{ReflectionBinding LastSeen, StringFormat='{}{0:g}'}" Classes="dim" />
                          <TextBlock Grid.Column="3" Text="{ReflectionBinding Count, StringFormat='{}{0}x'}" />
                          <TextBlock Grid.Column="4" Text="{ReflectionBinding Message}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Message}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Selected event detail" Classes="sectionTitle" />
                  <TextBox x:Name="LogDetailText" Classes="console" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
              </Border>
            </Grid>

<!-- Intelligence -->
            <ScrollViewer x:Name="IntelligencePage" IsVisible="False">
              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="0.75*,1.25*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="12">
                      <TextBlock Text="Control Plane Intelligence" Classes="sectionTitle" />
                      <Border x:Name="IntelligenceSeverityBorder" Classes="badge" HorizontalAlignment="Left">
                        <TextBlock x:Name="IntelligenceSeverityText" Text="WAITING" Classes="eyebrow" />
                      </Border>
                      <TextBlock x:Name="IntelligenceRootCauseText" Text="No analysis yet" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock x:Name="IntelligenceHeadlineText" Text="Refresh the environment to run analysis." Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Dependency order" Classes="sectionTitle" />
                      <TextBlock Text="Host → Storage → Docker → Discovery → Downloads → Arr → Processing → Library" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="Findings are ranked upstream-first so downstream symptoms do not trigger unnecessary restarts." Classes="pageSubtitle" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Ranked findings" Classes="sectionTitle" />
                      <TextBlock Grid.Column="1" x:Name="IntelligenceCountText" Text="0 findings" Classes="muted" VerticalAlignment="Center" />
                    </Grid>
                    <ListBox x:Name="IntelligenceFindingsList" Classes="dataList" MinHeight="430">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="90,150,1.1*,1.1*,1.1*" ColumnSpacing="12">
                            <TextBlock Text="{ReflectionBinding Severity}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Component}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Problem}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Impact}" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding NextStep}" Classes="muted" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

<!-- Lifecycle -->
            <ScrollViewer x:Name="LifecyclePage" IsVisible="False">
              <StackPanel Spacing="18">
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="Media lifecycle" Classes="sectionTitle" />
                        <TextBlock Text="Readiness from the host through final library availability." Classes="pageSubtitle" Margin="0,4,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" x:Name="LifecycleSummaryText" Text="Waiting for capture" Classes="muted" VerticalAlignment="Center" />
                    </Grid>
                    <ListBox x:Name="LifecycleStagesList" Classes="dataList" MinHeight="500">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="50,130,110,1.2*,1.2*,1.2*" ColumnSpacing="12">
                            <TextBlock Text="{ReflectionBinding Order}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource DimBrush}" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Stage}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding State}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Evidence}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Impact}" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="5" Text="{ReflectionBinding NextStep}" Classes="muted" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

<!-- History -->
            <ScrollViewer x:Name="HistoryPage" IsVisible="False">
              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="0.9*,1.1*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="12">
                      <TextBlock Text="Current incident signals" Classes="sectionTitle" />
                      <TextBlock Text="Current ranked findings are shown alongside persisted state transitions." Classes="pageSubtitle" />
                      <ListBox x:Name="CurrentIncidentsList" Classes="dataList" MinHeight="300">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <StackPanel Spacing="4">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{ReflectionBinding Severity}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{ReflectionBinding Component}" FontWeight="SemiBold" />
                              </StackPanel>
                              <TextBlock Text="{ReflectionBinding Problem}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="Transition history" Classes="sectionTitle" />
                          <TextBlock Text="Meaningful changes and guarded actions are persisted locally." Classes="pageSubtitle" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Clear history" Classes="danger" Click="ClearHistoryButton_OnClick" />
                      </Grid>
                      <ListBox x:Name="HistoryList" Classes="dataList" MinHeight="360">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="150,100,150,150,*" ColumnSpacing="10">
                              <TextBlock Text="{ReflectionBinding Timestamp, StringFormat='{}{0:g}'}" Classes="dim" />
                              <TextBlock Grid.Column="1" Text="{ReflectionBinding Severity}" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="2" Text="{ReflectionBinding Component}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="3" Text="{ReflectionBinding FromState, StringFormat='{}{0} →'}" Classes="muted" />
                              <StackPanel Grid.Column="4" Spacing="3">
                                <TextBlock Text="{ReflectionBinding ToState}" FontWeight="SemiBold" />
                                <TextBlock Text="{ReflectionBinding Detail}" Classes="muted" TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </ScrollViewer>

<!-- Backups -->
            <ScrollViewer x:Name="BackupsPage" IsVisible="False">
              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="0.75*,1.25*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Backup readiness" Classes="sectionTitle" />
                      <Border x:Name="BackupStateBorder" Classes="badge" HorizontalAlignment="Left">
                        <TextBlock x:Name="BackupStateText" Text="WAITING" Classes="eyebrow" />
                      </Border>
                      <TextBlock x:Name="BackupProviderText" Text="No provider captured" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock x:Name="BackupSummaryText" Text="Refresh the environment." Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Readiness evidence" Classes="sectionTitle" />
                      <ListBox x:Name="BackupEvidenceList" Classes="dataList" MinHeight="140" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Backup schedules and units" Classes="sectionTitle" />
                    <ListBox x:Name="BackupUnitsList" Classes="dataList" MinHeight="230">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="260,100,100,120,180,180,*" ColumnSpacing="10">
                            <TextBlock Text="{ReflectionBinding Unit}" FontFamily="DejaVu Sans Mono, monospace" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Active}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding SubState}" Classes="muted" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Enabled}" Classes="muted" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding LastRun}" Classes="dim" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="5" Text="{ReflectionBinding NextRun}" Classes="dim" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="6" Text="{ReflectionBinding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Path}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Recent backup artifacts" Classes="sectionTitle" />
                    <ListBox x:Name="BackupArtifactsList" Classes="dataList" MinHeight="200">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="*,110,180" ColumnSpacing="12">
                            <TextBlock Text="{ReflectionBinding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Path}" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Size}" Classes="muted" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding LocalModifiedAt, StringFormat='{}{0:g}'}" Classes="dim" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
