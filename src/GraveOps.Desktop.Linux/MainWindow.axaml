<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="GraveOps.Desktop.Linux.MainWindow"
    x:CompileBindings="False"
    Title="GraveOps"
    Icon="/Assets/graveops-brandmark.png"
    Width="1500"
    Height="920"
    MinWidth="1180"
    MinHeight="760"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="38"
    KeyDown="MainWindow_OnKeyDown"
    Background="{DynamicResource BackdropBrush}">

  <Border
      Background="{DynamicResource BackgroundBrush}"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="1">

    <Grid RowDefinitions="38,*">
      <!-- Custom GraveOps title bar -->
      <Border
          Grid.Row="0"
          Background="{DynamicResource HeaderBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,0,0,1">

        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel
              Orientation="Horizontal"
              VerticalAlignment="Center"
              Margin="14,0,0,0"
              Spacing="9">

            <Image
                Width="24"
                Height="24"
                Source="/Assets/graveops-brandmark.png"
                Stretch="Uniform" />

            <TextBlock
                Text="GraveOps"
                FontSize="12"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />

            <Border
                Background="{DynamicResource AccentTintBrush}"
                CornerRadius="5"
                Padding="7,2"
                Margin="4,0,0,0">

              <TextBlock
                  Text="LINUX"
                  Classes="eyebrow"
                  Foreground="{DynamicResource AccentBrush}" />
            </Border>
          </StackPanel>

          <Border
              Grid.Column="1"
              Background="Transparent"
              PointerPressed="TitleDragRegion_OnPointerPressed"
              DoubleTapped="TitleDragRegion_OnDoubleTapped" />

          <StackPanel
              Grid.Column="2"
              Orientation="Horizontal">

            <Button
                Classes="titlebar"
                Content="—"
                Click="Minimize_Click" />

            <Button
                Classes="titlebar"
                Content="□"
                Click="Maximize_Click" />

            <Button
                Classes="titlebar close"
                Content="×"
                Click="Close_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid
          Grid.Row="1"
          ColumnDefinitions="260,*">

        <!-- Navigation rail -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">

          <Grid
              RowDefinitions="Auto,*,Auto"
              Margin="14,15,14,14">

            <Border
                Classes="card"
                Padding="13"
                Margin="0,0,0,17">

              <StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                  <Border
                      Width="34"
                      Height="34"
                      CornerRadius="9"
                      Background="{DynamicResource AccentTintBrush}">

                    <Path
                        Data="M7,8 L19,8 M7,12 L19,12 M7,16 L15,16"
                        Stroke="{DynamicResource AccentBrush}"
                        StrokeThickness="1.6"
                        StrokeLineCap="Round"
                        Stretch="None"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                  </Border>

                  <StackPanel
                      Grid.Column="1"
                      Margin="11,0,0,0"
                      VerticalAlignment="Center">

                    <TextBlock
                        Text="CONTROL PLANE"
                        Classes="eyebrow" />

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,5,0,0"
                        Spacing="7">

                      <TextBlock
                          x:Name="ConnectionDot"
                          Text="●"
                          FontSize="10"
                          Foreground="{DynamicResource SuccessBrush}" />

                      <TextBlock
                          x:Name="ConnectionText"
                          Text="ONLINE"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource SuccessBrush}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="ConnectionDetailText"
                        Text="Native Linux provider"
                        Classes="dim"
                        FontSize="10"
                        Margin="0,4,0,0"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>

                <TextBlock
                    Text="ACTIVE TARGET"
                    Classes="eyebrow"
                    Margin="0,13,0,5" />

                <Border
                    Classes="inset"
                    Padding="8">
                  <StackPanel Spacing="7">
                    <ComboBox
                        x:Name="ActiveTargetComboBox"
                        MinWidth="200"
                        SelectionChanged="ActiveTargetComboBox_OnSelectionChanged">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <StackPanel Spacing="2">
                            <TextBlock
                                Text="{ReflectionBinding DisplayName}"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{ReflectionBinding ConnectionSummary}"
                                Classes="dim"
                                FontSize="9"
                                TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock
                        x:Name="SidebarHostname"
                        Text="Loading..."
                        FontSize="11"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        x:Name="SidebarOperatingSystem"
                        Text="Linux"
                        Classes="dim"
                        FontSize="9"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

              <StackPanel>
                <TextBlock
                    Text="OVERVIEW"
                    Classes="eyebrow"
                    Margin="10,0,0,6" />

                <Button
                    x:Name="DashboardNav"
                    Classes="nav selected"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M1,1 L7,1 L7,7 L1,7 Z M9,1 L15,1 L15,7 L9,7 Z M1,9 L7,9 L7,15 L1,15 Z M9,9 L15,9 L15,15 L9,15 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Dashboard"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="IntelligenceNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M8,1 L10,5 L15,6 L11.5,9.5 L12,15 L8,12.5 L4,15 L4.5,9.5 L1,6 L6,5 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Intelligence"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="LifecycleNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,8 L5,8 M6,8 L9,8 M10,8 L14,8 M4,5 L6,8 L4,11 M8,5 L10,8 L8,11"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Lifecycle"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="HistoryNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M8,2 A6,6 0 1 1 3,5 M3,2 L3,6 L7,6 M8,5 L8,8 L11,10"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="History"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="ServersNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,2 L14,2 L14,7 L2,7 Z M2,9 L14,9 L14,14 L2,14 Z M4,4.5 L5.5,4.5 M4,11.5 L5.5,11.5"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Servers"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <TextBlock
                    Text="MEDIA"
                    Classes="eyebrow"
                    Margin="10,15,0,6" />

                <Button
                    x:Name="MediaHubNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,2 L7,2 L7,7 L2,7 Z M9,2 L14,2 L14,7 L9,7 Z M2,9 L7,9 L7,14 L2,14 Z M9,9 L14,9 L14,14 L9,14 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Media Hub"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>


                <Button
                    x:Name="DumbNav"
                    Classes="nav sub"
                    IsVisible="False"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <TextBlock Text="◆" FontSize="9" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="DUMB stack" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <Button
                    x:Name="LibraryGroupButton"
                    Classes="navGroup"
                    IsVisible="False"
                    Click="LibraryGroupButton_OnClick">
                  <Grid ColumnDefinitions="18,*">
                    <TextBlock x:Name="LibraryGroupGlyph" Text="▾" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="LIBRARY" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <StackPanel x:Name="LibraryNavGroup" IsVisible="False">
                  <Button x:Name="PlexNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="▶" FontSize="9" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Plex" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="TautulliNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="▥" FontSize="10" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Tautulli" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="KometaNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="◇" FontSize="10" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Kometa" VerticalAlignment="Center" /></Grid>
                  </Button>
                </StackPanel>

                <Button
                    x:Name="AcquisitionGroupButton"
                    Classes="navGroup"
                    IsVisible="False"
                    Click="AcquisitionGroupButton_OnClick">
                  <Grid ColumnDefinitions="18,*">
                    <TextBlock x:Name="AcquisitionGroupGlyph" Text="▾" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="ACQUISITION" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <StackPanel x:Name="AcquisitionNavGroup" IsVisible="False">
                  <Button x:Name="SonarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Sonarr" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="RadarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Radarr" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="LidarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Lidarr" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="ProwlarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Prowlarr" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="ReadarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" /><TextBlock Grid.Column="1" Text="Readarr" /></Grid>
                  </Button>
                  <Button x:Name="WhisparrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" /><TextBlock Grid.Column="1" Text="Whisparr" /></Grid>
                  </Button>
                  <Button x:Name="Mylar3Nav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" /><TextBlock Grid.Column="1" Text="Mylar3" /></Grid>
                  </Button>

                  <Button x:Name="SabnzbdNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="SABnzbd" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="QBittorrentNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="qBittorrent" VerticalAlignment="Center" /></Grid>
                  </Button>
                </StackPanel>

                <Button
                    x:Name="ProcessingGroupButton"
                    Classes="navGroup"
                    IsVisible="False"
                    Click="ProcessingGroupButton_OnClick">
                  <Grid ColumnDefinitions="18,*">
                    <TextBlock x:Name="ProcessingGroupGlyph" Text="▾" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="PROCESSING" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <StackPanel x:Name="ProcessingNavGroup" IsVisible="False">
                  <Button x:Name="DecypharrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Decypharr" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="RecyclarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Recyclarr" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="BazarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" /><TextBlock Grid.Column="1" Text="Bazarr" /></Grid>
                  </Button>

                  <Button x:Name="ZurgNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Zurg" VerticalAlignment="Center" /></Grid>
                  </Button>
                </StackPanel>

                <TextBlock
                    Text="SYSTEM"
                    Classes="eyebrow"
                    Margin="10,15,0,6" />

                <Button
                    x:Name="ServicesNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,4 L14,4 M2,8 L14,8 M2,12 L14,12 M4,2 L4,6 M10,6 L10,10 M6,10 L6,14"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Services &amp; Actions"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="DockerNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,5 L6,5 L6,9 L2,9 Z M7,5 L11,5 L11,9 L7,9 Z M12,5 L15,5 L15,9 L12,9 Z M4,1 L8,1 L8,4 L4,4 Z M9,1 L13,1 L13,4 L9,4 Z M1,10 C3,14 12,15 15,9"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.1" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Docker"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="StorageNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,3 C2,1.5 14,1.5 14,3 L14,13 C14,14.5 2,14.5 2,13 Z M2,3 C2,5 14,5 14,3 M2,8 C2,10 14,10 14,8"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Storage"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="LogsNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,2 L14,2 L14,14 L2,14 Z M4,5 L12,5 M4,8 L12,8 M4,11 L9,11"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Logs"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="BackupsNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M3,2 L13,2 L13,14 L3,14 Z M5,2 L5,6 L11,6 L11,2 M5,10 L11,10 L11,14 L5,14 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Backups"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>
                <TextBlock
                    Text="OPERATOR"
                    Classes="eyebrow"
                    Margin="10,15,0,6" />

                <Button
                    x:Name="SettingsNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M8,2 A2,2 0 1 1 8,6 A2,2 0 1 1 8,2 M8,7 L8,14 M3,10 L13,10"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Settings"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="ToolsNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M3,3 L13,3 L13,13 L3,13 Z M5,6 L11,6 M5,9 L9,9"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Operator Tools"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

              </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Margin="10,12,0,0">
              <TextBlock
                  Text="GRAVEOPS LINUX"
                  Classes="eyebrow"
                  Foreground="{DynamicResource AccentBrush}" />
              <TextBlock
                  Text="Native client · shared control plane"
                  Classes="dim"
                  FontSize="10"
                  Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Main workspace -->
        <Grid
            Grid.Column="1"
            RowDefinitions="Auto,*,30"
            Background="{DynamicResource BackgroundBrush}">

          <Grid
              Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="28,24,28,0">

            <StackPanel>
              <TextBlock
                  x:Name="PageTitleText"
                  Text="Dashboard"
                  Classes="pageTitle" />

              <TextBlock
                  x:Name="PageSubtitleText"
                  Text="Fleet-aware local Linux operations"
                  Classes="pageSubtitle"
                  Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="10">

              <TextBlock
                  x:Name="LastUpdatedText"
                  Text="Waiting for first capture"
                  Classes="dim"
                  FontSize="11"
                  VerticalAlignment="Center" />


              <Button
                  x:Name="JobsButton"
                  Content="Jobs"
                  Click="JobsButton_OnClick" />

              <Button
                  x:Name="ActivityButton"
                  Content="Activity"
                  Click="ActivityButton_OnClick" />

              <Button
                  x:Name="MaintenanceButton"
                  Content="Maintenance"
                  Click="MaintenanceButton_OnClick" />


              <Button
                  x:Name="CommandPaletteButton"
                  Content="Search · Ctrl+K"
                  MinWidth="122"
                  Click="CommandPaletteButton_OnClick" />

              <Button
                  x:Name="OverviewButton"
                  Content="Overview"
                  Click="OverviewButton_OnClick" />

              <Button
                  x:Name="RefreshButton"
                  Classes="primary"
                  Content="Refresh environment"
                  Click="RefreshButton_OnClick" />
            </StackPanel>
          </Grid>

          <Grid
              Grid.Row="1"
              Margin="28,20,28,28">
            <!-- Dashboard -->
            <ScrollViewer
                x:Name="DashboardPage"
                IsVisible="True">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                  <Border Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="ENVIRONMENT" Classes="eyebrow" />
                      <TextBlock
                          x:Name="DashboardFleetStateText"
                          Text="WAITING"
                          FontSize="21"
                          FontWeight="SemiBold" />
                      <TextBlock
                          Text="Highest fleet state"
                          Classes="dim" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="HOSTS" Classes="eyebrow" />
                      <TextBlock
                          x:Name="DashboardFleetHostCountText"
                          Text="0"
                          FontSize="21"
                          FontWeight="SemiBold" />
                      <TextBlock
                          Text="Saved control-plane targets"
                          Classes="dim" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="VERIFIED APPS" Classes="eyebrow" />
                      <TextBlock
                          x:Name="DashboardFleetApplicationCountText"
                          Text="0"
                          FontSize="21"
                          FontWeight="SemiBold" />
                      <TextBlock
                          Text="Stored application ownership"
                          Classes="dim" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="3" Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="ATTENTION" Classes="eyebrow" />
                      <TextBlock
                          x:Name="DashboardFleetAttentionCountText"
                          Text="0"
                          FontSize="21"
                          FontWeight="SemiBold" />
                      <TextBlock
                          Text="Warning-or-higher fleet findings"
                          Classes="dim" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="0.92*,1.08*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="11">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="Environment topology"
                              Classes="sectionTitle" />
                          <TextBlock
                              Text="Saved hosts with their most recent successful capture. Switching targets refreshes and updates this fleet cache."
                              Classes="pageSubtitle"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            x:Name="DashboardEnvironmentSummaryText"
                            Text="Waiting for captures"
                            Classes="muted"
                            VerticalAlignment="Center" />
                      </Grid>

                      <ListBox
                          x:Name="DashboardEnvironmentList"
                          Classes="dataList"
                          MinHeight="245"
                          MaxHeight="340"
                          SelectionChanged="DashboardEnvironmentList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Grid
                                ColumnDefinitions="1.1*,130,100,90,90"
                                ColumnSpacing="10">
                              <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <TextBlock
                                      Text="{ReflectionBinding HostName}"
                                      FontWeight="SemiBold"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Text="{ReflectionBinding ActiveLabel}"
                                      Foreground="{DynamicResource AccentBrush}"
                                      FontSize="9"
                                      FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock
                                    Text="{ReflectionBinding Connection}"
                                    Classes="dim"
                                    FontSize="9"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip.Tip="{ReflectionBinding Connection}" />
                              </StackPanel>

                              <TextBlock
                                  Grid.Column="1"
                                  Text="{ReflectionBinding Role}"
                                  Classes="muted"
                                  TextTrimming="CharacterEllipsis" />

                              <TextBlock
                                  Grid.Column="2"
                                  Text="{ReflectionBinding ApplicationSummary}" />

                              <TextBlock
                                  Grid.Column="3"
                                  Text="{ReflectionBinding AttentionSummary}"
                                  TextTrimming="CharacterEllipsis" />

                              <TextBlock
                                  Grid.Column="4"
                                  Text="{ReflectionBinding SeverityLabel}"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="11">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="Selected host"
                              Classes="eyebrow" />
                          <TextBlock
                              x:Name="DashboardSelectedHostText"
                              Text="No target selected"
                              FontSize="22"
                              FontWeight="SemiBold"
                              Margin="0,5,0,0" />
                          <TextBlock
                              x:Name="DashboardSelectedConnectionText"
                              Text="--"
                              Classes="muted"
                              Margin="0,3,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            x:Name="DashboardFocusHostButton"
                            Content="Focus host"
                            IsEnabled="False"
                            Click="DashboardFocusHostButton_OnClick" />
                      </Grid>

                      <Grid
                          ColumnDefinitions="*,*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="9"
                          RowSpacing="9">
                        <Border Classes="inset">
                          <StackPanel Spacing="3">
                            <TextBlock Text="APPLICATIONS" Classes="eyebrow" />
                            <TextBlock
                                x:Name="DashboardSelectedApplicationsText"
                                Text="--"
                                FontSize="17"
                                FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Classes="inset">
                          <StackPanel Spacing="3">
                            <TextBlock Text="ATTENTION" Classes="eyebrow" />
                            <TextBlock
                                x:Name="DashboardSelectedAttentionText"
                                Text="--"
                                FontSize="17"
                                FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Classes="inset">
                          <StackPanel Spacing="3">
                            <TextBlock Text="QUEUED WORK" Classes="eyebrow" />
                            <TextBlock
                                x:Name="DashboardSelectedQueueText"
                                Text="--"
                                FontSize="17"
                                FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Classes="inset">
                          <StackPanel Spacing="3">
                            <TextBlock Text="DOCKER" Classes="eyebrow" />
                            <TextBlock
                                x:Name="DashboardSelectedDockerText"
                                Text="--"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="inset">
                          <StackPanel Spacing="3">
                            <TextBlock Text="FRESHNESS" Classes="eyebrow" />
                            <TextBlock
                                x:Name="DashboardSelectedCapturedText"
                                Text="--"
                                Classes="muted"
                                TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ListBox
                            x:Name="DashboardApplicationList"
                            Classes="dataList"
                            MinHeight="135"
                            MaxHeight="210"
                            SelectionChanged="DashboardApplicationList_OnSelectionChanged">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                              <Grid ColumnDefinitions="150,130,*,90" ColumnSpacing="9">
                                <TextBlock
                                    Text="{ReflectionBinding Application}"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{ReflectionBinding Runtime}"
                                    Classes="muted"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{ReflectionBinding State}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{ReflectionBinding SeverityLabel}"
                                    Foreground="{DynamicResource AccentBrush}"
                                    FontWeight="SemiBold" />
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>

                        <Button
                            Grid.Column="1"
                            x:Name="DashboardOpenApplicationButton"
                            Content="Open application"
                            IsEnabled="False"
                            VerticalAlignment="Top"
                            Click="DashboardOpenApplicationButton_OnClick" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="1.08*,0.92*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="11">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="Fleet impact"
                              Classes="sectionTitle" />
                          <TextBlock
                              Text="Cross-target issues retain host, component, state, impact and owning-page context."
                              Classes="pageSubtitle"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            x:Name="DashboardOpenAttentionButton"
                            Content="Open related"
                            IsEnabled="False"
                            Click="DashboardOpenAttentionButton_OnClick" />
                      </Grid>

                      <ListBox
                          x:Name="DashboardFleetAttentionList"
                          Classes="dataList"
                          MinHeight="230"
                          MaxHeight="330"
                          SelectionChanged="DashboardFleetAttentionList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="125,135,90,1.2*,1.2*" ColumnSpacing="9">
                              <TextBlock
                                  Text="{ReflectionBinding HostName}"
                                  FontWeight="SemiBold"
                                  TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                  Grid.Column="1"
                                  Text="{ReflectionBinding Component}"
                                  TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                  Grid.Column="2"
                                  Text="{ReflectionBinding SeverityLabel}"
                                  Foreground="{DynamicResource AccentBrush}"
                                  FontWeight="SemiBold" />
                              <TextBlock
                                  Grid.Column="3"
                                  Text="{ReflectionBinding Issue}"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{ReflectionBinding Issue}" />
                              <TextBlock
                                  Grid.Column="4"
                                  Text="{ReflectionBinding Impact}"
                                  Classes="muted"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{ReflectionBinding Impact}" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <Border Classes="inset">
                        <TextBlock
                            x:Name="DashboardFleetAttentionDetailText"
                            Text="No fleet-wide attention item is selected."
                            Classes="muted"
                            TextWrapping="Wrap" />
                      </Border>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="11">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="Active-target findings"
                              Classes="sectionTitle" />
                          <TextBlock
                              Text="Acknowledgement, snooze, ignore and threshold policies remain attached to the active host."
                              Classes="pageSubtitle"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                          <TextBlock
                              x:Name="DashboardFindingsSummaryText"
                              Text="0 active"
                              Classes="muted"
                              HorizontalAlignment="Right" />
                          <TextBlock
                              x:Name="DashboardPolicySummaryText"
                              Text="Default monitoring"
                              Classes="dim"
                              FontSize="9"
                              Margin="0,3,0,0"
                              HorizontalAlignment="Right" />
                        </StackPanel>
                      </Grid>

                      <ListBox
                          x:Name="DashboardAttentionList"
                          Classes="dataList"
                          MinHeight="210"
                          MaxHeight="300"
                          SelectionChanged="DashboardAttentionList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <StackPanel Spacing="4">
                              <Grid ColumnDefinitions="85,130,*" ColumnSpacing="9">
                                <TextBlock
                                    Text="{ReflectionBinding Severity}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{ReflectionBinding Component}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{ReflectionBinding Resource}"
                                    Classes="dim"
                                    HorizontalAlignment="Right"
                                    TextTrimming="CharacterEllipsis" />
                              </Grid>
                              <TextBlock
                                  Text="{ReflectionBinding Problem}"
                                  TextWrapping="Wrap" />
                              <TextBlock
                                  Text="{ReflectionBinding Evidence}"
                                  Classes="muted"
                                  FontSize="10"
                                  TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <WrapPanel>
                        <Button
                            x:Name="AcknowledgeFindingButton"
                            Content="Acknowledge"
                            IsEnabled="False"
                            Margin="0,0,8,8"
                            Click="AcknowledgeFindingButton_OnClick" />
                        <Button
                            x:Name="SnoozeFindingButton"
                            Content="Snooze..."
                            IsEnabled="False"
                            Margin="0,0,8,8"
                            Click="SnoozeFindingButton_OnClick" />
                        <Button
                            x:Name="IgnoreFindingButton"
                            Content="Ignore"
                            IsEnabled="False"
                            Margin="0,0,8,8"
                            Click="IgnoreFindingButton_OnClick" />
                        <Button
                            x:Name="FindingThresholdButton"
                            Content="Thresholds..."
                            IsEnabled="False"
                            Margin="0,0,8,8"
                            Click="FindingThresholdButton_OnClick" />
                      </WrapPanel>

                      <TextBlock
                          x:Name="DashboardPolicyStatusText"
                          Text="Select a finding to manage it."
                          Classes="dim"
                          TextWrapping="Wrap" />

                      <Border
                          x:Name="MutedFindingsPanel"
                          Classes="inset"
                          IsVisible="False">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Text="Muted findings"
                                Classes="sectionTitle" />
                            <TextBlock
                                Grid.Column="1"
                                x:Name="MutedFindingsSummaryText"
                                Text="0 muted"
                                Classes="muted" />
                          </Grid>

                          <ListBox
                              x:Name="MutedFindingsList"
                              Classes="dataList"
                              MaxHeight="180"
                              SelectionChanged="MutedFindingsList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="95,140,*,150" ColumnSpacing="8">
                                  <TextBlock
                                      Text="{ReflectionBinding Severity}"
                                      FontWeight="SemiBold" />
                                  <TextBlock
                                      Grid.Column="1"
                                      Text="{ReflectionBinding Component}"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="2"
                                      Text="{ReflectionBinding Reason}"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="3"
                                      Text="{ReflectionBinding UntilText}"
                                      Classes="muted"
                                      TextTrimming="CharacterEllipsis" />
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>

                          <Button
                              x:Name="RestoreMutedFindingButton"
                              Content="Restore selected"
                              HorizontalAlignment="Left"
                              IsEnabled="False"
                              Click="RestoreMutedFindingButton_OnClick" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="card">
                  <StackPanel Spacing="11">
                    <TextBlock
                        Text="Quick modules"
                        Classes="sectionTitle" />
                    <TextBlock
                        Text="Open the owning workspace without losing fleet context."
                        Classes="pageSubtitle"
                        TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                      <Button
                          Tag="IntelligenceNav"
                          HorizontalContentAlignment="Stretch"
                          Click="DashboardQuickModuleButton_OnClick">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Intelligence" FontWeight="SemiBold" />
                          <TextBlock
                              x:Name="DashboardQuickIntelligenceText"
                              Text="--"
                              Classes="muted"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>

                      <Button
                          Grid.Column="1"
                          Tag="LifecycleNav"
                          HorizontalContentAlignment="Stretch"
                          Click="DashboardQuickModuleButton_OnClick">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Lifecycle" FontWeight="SemiBold" />
                          <TextBlock
                              x:Name="DashboardQuickLifecycleText"
                              Text="--"
                              Classes="muted"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>

                      <Button
                          Grid.Column="2"
                          Tag="MediaHubNav"
                          HorizontalContentAlignment="Stretch"
                          Click="DashboardQuickModuleButton_OnClick">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Media Hub" FontWeight="SemiBold" />
                          <TextBlock
                              x:Name="DashboardQuickMediaText"
                              Text="--"
                              Classes="muted"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>

                      <Button
                          Grid.Row="1"
                          Tag="StorageNav"
                          HorizontalContentAlignment="Stretch"
                          Click="DashboardQuickModuleButton_OnClick">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Storage" FontWeight="SemiBold" />
                          <TextBlock
                              x:Name="DashboardQuickStorageText"
                              Text="--"
                              Classes="muted"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>

                      <Button
                          Grid.Row="1"
                          Grid.Column="1"
                          Tag="BackupsNav"
                          HorizontalContentAlignment="Stretch"
                          Click="DashboardQuickModuleButton_OnClick">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Backups" FontWeight="SemiBold" />
                          <TextBlock
                              x:Name="DashboardQuickBackupsText"
                              Text="--"
                              Classes="muted"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>

                      <Button
                          Grid.Row="1"
                          Grid.Column="2"
                          Tag="HistoryNav"
                          HorizontalContentAlignment="Stretch"
                          Click="DashboardQuickModuleButton_OnClick">
                        <StackPanel Spacing="4">
                          <TextBlock Text="History" FontWeight="SemiBold" />
                          <TextBlock
                              x:Name="DashboardQuickHistoryText"
                              Text="--"
                              Classes="muted"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- Servers -->
            <ScrollViewer
                x:Name="ServersPage"
                IsVisible="False">

              <StackPanel Spacing="18">
                <Grid
                    ColumnDefinitions="0.72*,1.28*"
                    ColumnSpacing="14">

                  <Border Classes="card">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="Saved targets"
                              Classes="sectionTitle" />
                          <TextBlock
                              x:Name="ServerProfilesSummaryText"
                              Text="Loading host profiles"
                              Classes="pageSubtitle"
                              Margin="0,4,0,0" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="Discover LAN"
                            Click="DiscoverLanButton_OnClick" />
                      </Grid>

                      <ListBox
                          x:Name="ServerProfilesList"
                          Classes="dataList"
                          MinHeight="310"
                          SelectionChanged="ServerProfilesList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <StackPanel Spacing="4">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Text="{ReflectionBinding DisplayName}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{ReflectionBinding KindLabel}"
                                    Classes="dim"
                                    FontSize="9" />
                              </Grid>
                              <TextBlock
                                  Text="{ReflectionBinding ConnectionSummary}"
                                  Classes="muted"
                                  FontSize="10"
                                  TextWrapping="Wrap" />
                              <TextBlock
                                  Text="{ReflectionBinding AuthenticationLabel}"
                                  Classes="dim"
                                  FontSize="9" />
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <Grid
                          ColumnDefinitions="Auto,Auto,Auto,*"
                          ColumnSpacing="8">
                        <Button
                            Content="New"
                            Click="NewServerButton_OnClick" />
                        <Button
                            Grid.Column="1"
                            x:Name="DeleteServerButton"
                            Content="Delete"
                            IsEnabled="False"
                            Click="DeleteServerButton_OnClick" />
                        <Button
                            Grid.Column="2"
                            x:Name="SetActiveServerButton"
                            Content="Set active"
                            IsEnabled="False"
                            Click="SetActiveServerButton_OnClick" />
                      </Grid>

                      <TextBlock
                          Text="LAN candidates"
                          Classes="sectionTitle"
                          Margin="0,8,0,0" />

                      <ListBox
                          x:Name="ServerLanCandidatesList"
                          Classes="dataList"
                          MinHeight="125"
                          MaxHeight="190"
                          SelectionChanged="ServerLanCandidatesList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <TextBlock
                                Text="{ReflectionBinding Summary}"
                                TextWrapping="Wrap" />
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>

                  <Border
                      Grid.Column="1"
                      Classes="card">
                    <StackPanel Spacing="13">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="Host profile"
                              Classes="sectionTitle" />
                          <TextBlock
                              Text="Remote Linux uses fingerprint-pinned OpenSSH. Passwords and key passphrases can be stored only through Secret Service."
                              Classes="pageSubtitle"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            x:Name="ServerKeyringStatusText"
                            Text="Checking keyring"
                            Classes="muted"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                      </Grid>

                      <TextBlock
                          x:Name="ServerEditingIdText"
                          IsVisible="False" />

                      <Grid
                          ColumnDefinitions="145,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="11"
                          RowSpacing="9">

                        <TextBlock
                            Text="Display name"
                            VerticalAlignment="Center" />
                        <TextBox
                            Grid.Column="1"
                            x:Name="ServerNameTextBox"
                            PlaceholderText="Media server" />

                        <TextBlock
                            Grid.Row="1"
                            Text="Role"
                            VerticalAlignment="Center" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            x:Name="ServerRoleTextBox"
                            PlaceholderText="Primary, backup, remote, lab..." />

                        <TextBlock
                            Grid.Row="2"
                            Text="Connection"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Row="2"
                            Grid.Column="1"
                            x:Name="ServerConnectionTypeComboBox"
                            SelectionChanged="ServerConnectionTypeComboBox_OnSelectionChanged" />

                        <TextBlock
                            Grid.Row="3"
                            Text="Host / IP"
                            VerticalAlignment="Center" />
                        <Grid
                            Grid.Row="3"
                            Grid.Column="1"
                            ColumnDefinitions="*,90"
                            ColumnSpacing="8">
                          <TextBox
                              x:Name="ServerHostTextBox"
                              PlaceholderText="192.168.1.50 or host name" />
                          <TextBox
                              Grid.Column="1"
                              x:Name="ServerPortTextBox"
                              Text="22"
                              PlaceholderText="Port" />
                        </Grid>

                        <TextBlock
                            Grid.Row="4"
                            Text="Username"
                            VerticalAlignment="Center" />
                        <TextBox
                            Grid.Row="4"
                            Grid.Column="1"
                            x:Name="ServerUsernameTextBox" />

                        <TextBlock
                            Grid.Row="5"
                            Text="Authentication"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Row="5"
                            Grid.Column="1"
                            x:Name="ServerAuthenticationComboBox"
                            SelectionChanged="ServerAuthenticationComboBox_OnSelectionChanged" />

                        <TextBlock
                            Grid.Row="6"
                            Text="Private key"
                            VerticalAlignment="Center" />
                        <Grid
                            Grid.Row="6"
                            Grid.Column="1"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8">
                          <TextBox
                              x:Name="ServerPrivateKeyPathTextBox"
                              FontFamily="DejaVu Sans Mono, monospace"
                              PlaceholderText="Optional key path" />
                          <Button
                              Grid.Column="1"
                              x:Name="BrowsePrivateKeyButton"
                              Content="Browse"
                              Click="BrowsePrivateKeyButton_OnClick" />
                        </Grid>

                        <TextBlock
                            Grid.Row="7"
                            Text="Pinned fingerprint"
                            VerticalAlignment="Center" />
                        <Grid
                            Grid.Row="7"
                            Grid.Column="1"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8">
                          <TextBox
                              x:Name="ServerFingerprintTextBox"
                              FontFamily="DejaVu Sans Mono, monospace"
                              PlaceholderText="SHA256:..." />
                          <Button
                              Grid.Column="1"
                              x:Name="ScanFingerprintButton"
                              Content="Scan"
                              Click="ScanFingerprintButton_OnClick" />
                        </Grid>

                        <TextBlock
                            Grid.Row="8"
                            Text="Password / passphrase"
                            VerticalAlignment="Center" />
                        <Grid
                            Grid.Row="8"
                            Grid.Column="1"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8">
                          <TextBox
                              x:Name="ServerSecretTextBox"
                              PasswordChar="●"
                              PlaceholderText="Never redisplayed" />
                          <CheckBox
                              Grid.Column="1"
                              x:Name="ServerSaveSecretCheckBox"
                              Content="Save in keyring"
                              VerticalAlignment="Center" />
                        </Grid>
                      </Grid>

                      <WrapPanel>
                        <Button
                            Content="Save profile"
                            Classes="primary"
                            Margin="0,0,8,8"
                            Click="SaveServerButton_OnClick" />
                        <Button
                            Content="Test connection"
                            Margin="0,0,8,8"
                            Click="TestServerButton_OnClick" />
                        <Button
                            Content="Detect integrations"
                            Margin="0,0,8,8"
                            Click="DetectServerButton_OnClick" />
                      </WrapPanel>

                      <TextBlock
                          x:Name="ServerProfileStatusText"
                          Text="Select or create a host profile."
                          Classes="muted"
                          TextWrapping="Wrap" />

                      <TextBlock
                          Text="Detected integrations"
                          Classes="sectionTitle"
                          Margin="0,4,0,0" />

                      <ListBox
                          x:Name="ServerDetectedIntegrationsList"
                          Classes="dataList passive"
                          MinHeight="120"
                          MaxHeight="220" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="10">
                      <TextBlock
                          Text="Active target identity"
                          Classes="sectionTitle" />
                      <TextBlock
                          x:Name="ServerIdentityText"
                          Text="--"
                          FontSize="18"
                          FontWeight="SemiBold" />
                      <TextBlock
                          x:Name="ServerOperatingSystemText"
                          Text="--"
                          Classes="muted" />
                      <TextBlock
                          x:Name="ServerKernelText"
                          Text="--"
                          Classes="muted" />
                      <TextBlock
                          x:Name="ServerUptimeText"
                          Text="--"
                          Classes="muted" />
                    </StackPanel>
                  </Border>

                  <Border
                      Grid.Column="1"
                      Classes="card">
                    <StackPanel Spacing="10">
                      <TextBlock
                          Text="Active target runtime"
                          Classes="sectionTitle" />
                      <TextBlock
                          x:Name="ServerCpuText"
                          Text="--"
                          TextWrapping="Wrap" />
                      <TextBlock
                          x:Name="ServerMemoryText"
                          Text="--"
                          TextWrapping="Wrap" />
                      <TextBlock
                          x:Name="ServerNetworkText"
                          Text="--"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="card">
                  <StackPanel Spacing="8">
                    <TextBlock
                        Text="Provider boundary"
                        Classes="sectionTitle" />
                    <TextBlock
                        Text="Local targets use the native provider. Remote Linux targets use fingerprint-pinned OpenSSH for read-only capture. Service, Docker and backup mutations remain disabled while a remote target is active."
                        Classes="muted"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

<!-- Media Hub -->
            <ScrollViewer x:Name="MediaHubPage" IsVisible="False">
              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="0.92*,1.08*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,260">
                        <StackPanel>
                          <TextBlock
                              Text="Detected applications"
                              Classes="sectionTitle" />
                          <TextBlock
                              Text="Only applications verified through systemd, Docker identity or published ports are shown."
                              Classes="pageSubtitle"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBox
                            Grid.Column="1"
                            x:Name="MediaFilterText"
                            Classes="filter"
                            PlaceholderText="Filter applications"
                            TextChanged="MediaFilterText_OnTextChanged" />
                      </Grid>

                      <TextBlock
                          x:Name="MediaHubSummaryText"
                          Text="Waiting for capture"
                          Classes="muted" />

                      <ListBox
                          x:Name="IntegrationsList"
                          Classes="dataList"
                          MinHeight="510"
                          SelectionChanged="IntegrationsList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="150,150,*,90" ColumnSpacing="12">
                              <TextBlock
                                  Text="{ReflectionBinding Name}"
                                  FontWeight="SemiBold" />

                              <TextBlock
                                  Grid.Column="1"
                                  Text="{ReflectionBinding Kind}"
                                  Classes="muted"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{ReflectionBinding Kind}" />

                              <TextBlock
                                  Grid.Column="2"
                                  Text="{ReflectionBinding State}"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{ReflectionBinding State}" />

                              <TextBlock
                                  Grid.Column="3"
                                  Text="{ReflectionBinding Severity}"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="14">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="Application workspace"
                              Classes="eyebrow" />

                          <TextBlock
                              x:Name="IntegrationNameText"
                              Text="Select an application"
                              FontSize="24"
                              FontWeight="SemiBold"
                              Margin="0,6,0,0"
                              TextWrapping="Wrap" />

                          <TextBlock
                              x:Name="IntegrationRuntimeText"
                              Text="--"
                              Classes="muted"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <Border
                            x:Name="IntegrationStateBorder"
                            Grid.Column="1"
                            Classes="badge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">

                          <TextBlock
                              x:Name="IntegrationStateText"
                              Text="WAITING"
                              Classes="eyebrow" />
                        </Border>
                      </Grid>

                      <Grid
                          ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="12">

                        <Border Classes="inset">
                          <StackPanel Spacing="5">
                            <TextBlock Text="DETECTION" Classes="eyebrow" />
                            <TextBlock
                                x:Name="IntegrationKindText"
                                Text="--"
                                TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Classes="inset">
                          <StackPanel Spacing="5">
                            <TextBlock Text="ENDPOINT" Classes="eyebrow" />
                            <TextBlock
                                x:Name="IntegrationEndpointText"
                                Text="--"
                                TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Classes="inset">
                          <StackPanel Spacing="5">
                            <TextBlock Text="LIFECYCLE ROLE" Classes="eyebrow" />
                            <TextBlock
                                x:Name="IntegrationRoleText"
                                Text="--"
                                TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Classes="inset">
                          <StackPanel Spacing="5">
                            <TextBlock Text="ACTIVE FINDINGS" Classes="eyebrow" />
                            <TextBlock
                                x:Name="IntegrationFindingsSummaryText"
                                Text="--"
                                TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </Grid>

                      <Border Classes="inset">
                        <StackPanel Spacing="7">
                          <TextBlock Text="Evidence" Classes="sectionTitle" />
                          <TextBlock
                              x:Name="IntegrationEvidenceText"
                              Text="Select a detected application to inspect its evidence."
                              Classes="muted"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Border Classes="inset">
                        <StackPanel Spacing="7">
                          <TextBlock Text="Related operational context" Classes="sectionTitle" />
                          <TextBlock
                              x:Name="IntegrationFindingsText"
                              Text="No application selected."
                              Classes="muted"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                        <Button
                            x:Name="OpenIntegrationButton"
                            Content="Open web interface"
                            IsEnabled="False"
                            Click="OpenIntegrationButton_OnClick" />

                        <Button
                            Grid.Column="1"
                            x:Name="IntegrationFindingsButton"
                            Content="View Intelligence"
                            IsEnabled="False"
                            Click="IntegrationFindingsButton_OnClick" />

                        <TextBlock
                            Grid.Column="2"
                            x:Name="IntegrationActionStatusText"
                            Text="Select an application."
                            Classes="dim"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </ScrollViewer>

            <!-- First-class Arr application page -->
            <ScrollViewer x:Name="ArrWorkspacePage" IsVisible="False">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock x:Name="ArrApplicationTitleText"
                               Text="Arr application"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ArrApplicationSubtitleText"
                               Text="Application-specific health, work and operational tools."
                               Classes="pageSubtitle"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                  </StackPanel>

                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              VerticalAlignment="Center"
                              Spacing="8">
                    <TextBlock x:Name="ArrLiveUpdatedText"
                               Text="Waiting for live telemetry"
                               Classes="dim"
                               VerticalAlignment="Center" />
                    <Button x:Name="ArrCustomizeButton"
                            Content="Customize"
                            Click="ArrCustomizeButton_OnClick" />
                    <Button x:Name="ArrRefreshTelemetryButton"
                            Content="Refresh"
                            Classes="primary"
                            Click="ArrRefreshTelemetryButton_OnClick" />
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                  <Border Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="STATE" Classes="eyebrow" />
                      <TextBlock x:Name="ArrStateMetricText"
                                 Text="--"
                                 FontSize="20"
                                 FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="VERSION" Classes="eyebrow" />
                      <TextBlock x:Name="ArrVersionMetricText"
                                 Text="--"
                                 FontSize="20"
                                 FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock x:Name="ArrWorkMetricLabelText"
                                 Text="QUEUE"
                                 Classes="eyebrow" />
                      <TextBlock x:Name="ArrWorkMetricText"
                                 Text="--"
                                 FontSize="20"
                                 FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="3" Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="HEALTH ISSUES" Classes="eyebrow" />
                      <TextBlock x:Name="ArrHealthMetricText"
                                 Text="--"
                                 FontSize="20"
                                 FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="card">
                  <StackPanel Spacing="9">
                    <TextBlock Text="Operations" Classes="sectionTitle" />
                    <TextBlock x:Name="ArrOperationsSubtitleText"
                               Text="Application instances and operational tools stay together here."
                               Classes="pageSubtitle"
                               TextWrapping="Wrap" />

                    <WrapPanel x:Name="ArrOpenButtonsPanel" />

                    <WrapPanel>
                      <Button Content="Docker / stack"
                              Margin="0,0,8,0"
                              Click="ArrDockerButton_OnClick" />
                      <Button Content="Logs"
                              Margin="0,0,8,0"
                              Click="ArrLogsButton_OnClick" />
                      <Button Content="Intelligence"
                              Click="ArrWorkspaceIntelligenceButton_OnClick" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <Border Classes="card">
                  <StackPanel Spacing="11">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="Service telemetry" Classes="sectionTitle" />
                        <TextBlock Text="Current endpoint state, version, work and health for every detected instance of this application."
                                   Classes="pageSubtitle"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 x:Name="ArrInstanceCountText"
                                 Text="0 instances"
                                 Classes="muted"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <ListBox x:Name="ArrInstanceTelemetryList"
                             Classes="dataList passive"
                             MinHeight="110"
                             MaxHeight="245">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="145,150,95,105,85,*,85"
                                ColumnSpacing="10">
                            <TextBlock Text="{ReflectionBinding Service}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{ReflectionBinding Endpoint}"
                                       Classes="dim"
                                       FontFamily="DejaVu Sans Mono, monospace"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Text="{ReflectionBinding Version}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3"
                                       Text="{ReflectionBinding Work}" />
                            <TextBlock Grid.Column="4"
                                       Text="{ReflectionBinding Health}" />
                            <TextBlock Grid.Column="5"
                                       Text="{ReflectionBinding Access}"
                                       Classes="muted"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{ReflectionBinding Access}" />
                            <TextBlock Grid.Column="6"
                                       Text="{ReflectionBinding State}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>

                <Border Classes="card">
                  <StackPanel Spacing="11">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock x:Name="ArrWorkSectionTitleText"
                                   Text="Queue &amp; health"
                                   Classes="sectionTitle" />
                        <TextBlock x:Name="ArrWorkSectionSubtitleText"
                                   Text="Item-level work and health messages for this application."
                                   Classes="pageSubtitle"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Content="Open full detail"
                              Click="ArrOpenNativeDetailButton_OnClick" />
                    </Grid>

                    <ListBox x:Name="ArrQueueHealthList"
                             Classes="dataList passive"
                             MinHeight="230"
                             MaxHeight="430">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="120,80,1.4*,105,80,90,1.2*"
                                ColumnSpacing="9">
                            <TextBlock Text="{ReflectionBinding Service}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{ReflectionBinding Type}"
                                       Classes="muted" />
                            <TextBlock Grid.Column="2"
                                       Text="{ReflectionBinding ItemIssue}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="3"
                                       Text="{ReflectionBinding State}" />
                            <TextBlock Grid.Column="4"
                                       Text="{ReflectionBinding Progress}" />
                            <TextBlock Grid.Column="5"
                                       Text="{ReflectionBinding Remaining}" />
                            <TextBlock Grid.Column="6"
                                       Text="{ReflectionBinding Detail}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="ArrQueueFooterText"
                               Text="No live application probe has run."
                               Classes="dim" />
                  </StackPanel>
                </Border>

                <Border x:Name="ArrCustomizationPanel"
                        Classes="card"
                        IsVisible="False">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="Customize this instance" Classes="sectionTitle" />
                        <TextBlock Text="Presentation and module choices are local to GraveOps. They do not rewrite the application."
                                   Classes="pageSubtitle"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Content="Close"
                              Click="ArrCustomizeCloseButton_OnClick" />
                    </Grid>

                    <Grid ColumnDefinitions="150,*"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8">
                      <TextBlock Text="Instance" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1"
                                x:Name="ArrCustomizeInstanceComboBox"
                                SelectionChanged="ArrCustomizeInstanceComboBox_OnSelectionChanged">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <TextBlock Text="{ReflectionBinding DisplayName}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>

                      <TextBlock Grid.Row="1"
                                 Text="Display name"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Row="1"
                               Grid.Column="1"
                               x:Name="ArrFriendlyNameTextBox"
                               PlaceholderText="Use detected application name" />

                      <TextBlock Grid.Row="2"
                                 Text="Role"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Row="2"
                               Grid.Column="1"
                               x:Name="ArrRoleTextBox"
                               PlaceholderText="Describe this instance's purpose" />

                      <TextBlock Grid.Row="3"
                                 Text="Config.xml path"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Row="3"
                               Grid.Column="1"
                               x:Name="ArrConfigPathTextBox"
                               PlaceholderText="Optional; used only to discover the local API key"
                               FontFamily="DejaVu Sans Mono, monospace" />
                    </Grid>

                    <CheckBox x:Name="ArrPrivacyModeCheckBox"
                              Content="Mask the custom instance name in this workspace" />

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <StackPanel>
                        <TextBlock Text="Enabled modules" Classes="sectionTitle" />
                        <TextBlock Text="These become the capability plan for later application-specific panels."
                                   Classes="pageSubtitle"
                                   Margin="0,4,0,0" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Content="Enable all"
                              Click="EnableAllArrModulesButton_OnClick" />
                      <Button Grid.Column="2"
                              Content="Disable all"
                              Click="DisableAllArrModulesButton_OnClick" />
                    </Grid>

                    <ScrollViewer MaxHeight="260"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel x:Name="ArrWorkspaceModulesPanel"
                                  Spacing="7" />
                    </ScrollViewer>

                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                      <Button x:Name="SaveArrWorkspaceButton"
                              Content="Save profile"
                              Classes="primary"
                              IsEnabled="False"
                              Click="SaveArrWorkspaceButton_OnClick" />
                      <Button Grid.Column="1"
                              x:Name="ResetArrWorkspaceButton"
                              Content="Restore defaults"
                              IsEnabled="False"
                              Click="ResetArrWorkspaceButton_OnClick" />
                      <TextBlock Grid.Column="2"
                                 x:Name="ArrWorkspaceProfileStatusText"
                                 Text="No instance selected."
                                 Classes="dim"
                                 VerticalAlignment="Center"
                                 TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock x:Name="ArrWorkspaceConfigPathText"
                               Text="--"
                               Classes="dim"
                               FontFamily="DejaVu Sans Mono, monospace"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>


<!-- Services -->
            <ScrollViewer x:Name="ServicesPage" IsVisible="False">
              <StackPanel Spacing="18">
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="Native systemd services" Classes="sectionTitle" />
                        <TextBlock Text="Select a service. Safe Mode blocks stop and restart by default." Classes="pageSubtitle" Margin="0,4,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" x:Name="ServicesSummaryText" Text="--" Classes="muted" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="300,Auto,Auto,Auto,*,Auto" ColumnSpacing="9">
                      <TextBox x:Name="ServicesFilterText" Classes="filter" PlaceholderText="Filter services" TextChanged="ServicesFilterText_OnTextChanged" />
                      <Button Grid.Column="1" x:Name="ServiceStartButton" Content="Start" IsEnabled="False" Click="ServiceStartButton_OnClick" />
                      <Button Grid.Column="2" x:Name="ServiceStopButton" Content="Stop" Classes="danger" IsEnabled="False" Click="ServiceStopButton_OnClick" />
                      <Button Grid.Column="3" x:Name="ServiceRestartButton" Content="Restart" IsEnabled="False" Click="ServiceRestartButton_OnClick" />
                      <TextBlock Grid.Column="4" x:Name="ServiceActionStatusText" Text="Select a service." Classes="dim" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <CheckBox Grid.Column="5" x:Name="SafeModeCheckBox" Content="Safe Mode" IsChecked="True" VerticalAlignment="Center" Click="SafeModeCheckBox_OnClick" />
                    </Grid>
                    <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="12">
                      <ListBox x:Name="ServicesList" Classes="dataList" MinHeight="430" SelectionChanged="ServicesList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="220,95,105,115,*" ColumnSpacing="12">
                              <TextBlock Text="{ReflectionBinding Unit}" FontFamily="DejaVu Sans Mono, monospace" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Unit}" />
                              <TextBlock Grid.Column="1" Text="{ReflectionBinding ActiveState}" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="2" Text="{ReflectionBinding SubState}" Classes="muted" />
                              <TextBlock Grid.Column="3" Text="{ReflectionBinding UnitFileState}" Classes="muted" />
                              <TextBlock Grid.Column="4" Text="{ReflectionBinding Description}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Description}" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <Border Grid.Column="1" Classes="inset">
                        <StackPanel Spacing="10">
                          <TextBlock Text="Selected service" Classes="eyebrow" />
                          <TextBlock x:Name="ServiceSelectedNameText" Text="No service selected" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock x:Name="ServiceSelectedStateText" Text="--" Classes="muted" TextWrapping="Wrap" />
                          <Border Height="1" Background="{DynamicResource BorderBrush}" />
                          <TextBlock x:Name="ServiceSelectedDescriptionText" Text="Select a service to inspect its current state and unit-file policy." Classes="muted" TextWrapping="Wrap" />
                          <TextBlock x:Name="ServiceSelectedPolicyText" Text="--" Classes="dim" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

<!-- Docker -->
            <ScrollViewer x:Name="DockerPage" IsVisible="False">
              <StackPanel Spacing="18">
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="Docker containers" Classes="sectionTitle" />
                        <TextBlock Text="Running and actionable containers are shown by default. Harmless Exited (0) one-shot containers remain available as background entries." Classes="pageSubtitle" Margin="0,4,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock x:Name="DockerSummaryText" Text="--" Classes="muted" HorizontalAlignment="Right" />
                        <CheckBox x:Name="ShowInformationalContainersCheckBox" Content="Show informational exited containers" IsChecked="False" Margin="0,6,0,0" Click="ShowInformationalContainersCheckBox_OnClick" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="300,Auto,Auto,Auto,*" ColumnSpacing="9">
                      <TextBox x:Name="DockerFilterText" Classes="filter" PlaceholderText="Filter containers" TextChanged="DockerFilterText_OnTextChanged" />
                      <Button Grid.Column="1" x:Name="DockerStartButton" Content="Start" IsEnabled="False" Click="DockerStartButton_OnClick" />
                      <Button Grid.Column="2" x:Name="DockerStopButton" Content="Stop" Classes="danger" IsEnabled="False" Click="DockerStopButton_OnClick" />
                      <Button Grid.Column="3" x:Name="DockerRestartButton" Content="Restart" IsEnabled="False" Click="DockerRestartButton_OnClick" />
                      <TextBlock Grid.Column="4" x:Name="DockerActionStatusText" Text="Select a container. Safe Mode is controlled on Services &amp; Actions." Classes="dim" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid ColumnDefinitions="1.12*,0.88*" ColumnSpacing="12">
                      <ListBox x:Name="DockerList" Classes="dataList" MinHeight="430" SelectionChanged="DockerList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="170,90,*,210" ColumnSpacing="12">
                              <TextBlock Text="{ReflectionBinding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Name}" />
                              <TextBlock Grid.Column="1" Text="{ReflectionBinding State}" />
                              <TextBlock Grid.Column="2" Text="{ReflectionBinding Image}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Image}" />
                              <TextBlock Grid.Column="3" Text="{ReflectionBinding Status}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Status}" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <Border Grid.Column="1" Classes="inset">
                        <StackPanel Spacing="10">
                          <TextBlock Text="Selected container" Classes="eyebrow" />
                          <TextBlock x:Name="DockerSelectedNameText" Text="No container selected" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock x:Name="DockerSelectedStateText" Text="--" Classes="muted" TextWrapping="Wrap" />
                          <Border Height="1" Background="{DynamicResource BorderBrush}" />
                          <TextBlock Text="IMAGE" Classes="eyebrow" />
                          <TextBlock x:Name="DockerSelectedImageText" Text="--" Classes="muted" TextWrapping="Wrap" />
                          <TextBlock Text="PORTS" Classes="eyebrow" Margin="0,4,0,0" />
                          <TextBlock x:Name="DockerSelectedPortsText" Text="--" Classes="dim" FontFamily="DejaVu Sans Mono, monospace" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

<!-- Storage -->
            <ScrollViewer x:Name="StoragePage" IsVisible="False">
              <StackPanel Spacing="18">
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,320">
                      <StackPanel>
                        <TextBlock Text="Local storage" Classes="sectionTitle" />
                        <TextBlock Text="Default capacity policy is 85/90/95%. Exact-mount percentage and remaining-space thresholds can override it." Classes="pageSubtitle" Margin="0,4,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBox Grid.Column="1" x:Name="StorageFilterText" Classes="filter" PlaceholderText="Filter mounts" TextChanged="StorageFilterText_OnTextChanged" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock x:Name="StorageSummaryText" Text="--" Classes="muted" VerticalAlignment="Center" />
                      <Button Grid.Column="1" x:Name="StorageThresholdButton" Content="Thresholds..." IsEnabled="False" Click="StorageThresholdButton_OnClick" />
                      <Button Grid.Column="2" x:Name="RestoreStorageThresholdButton" Content="Restore defaults" IsEnabled="False" Click="RestoreStorageThresholdButton_OnClick" />
                    </Grid>
                    <Border Classes="inset">
                      <StackPanel Spacing="5">
                        <TextBlock
                            x:Name="StorageSelectedPolicyTitleText"
                            Text="No mount selected"
                            FontWeight="SemiBold" />

                        <TextBlock
                            x:Name="StoragePolicyStatusText"
                            Text="Select a mount to inspect or customize its policy."
                            Classes="dim"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <ListBox x:Name="StorageList" Classes="dataList" MinHeight="390" SelectionChanged="StorageList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="170,70,70,70,70,60,80,90,*" ColumnSpacing="10">
                            <TextBlock Text="{ReflectionBinding Source}" FontFamily="DejaVu Sans Mono, monospace" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Source}" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding FileSystem}" Classes="muted" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Size}" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Used}" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Available}" />
                            <TextBlock Grid.Column="5" Text="{ReflectionBinding PercentUsed}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="6" Text="{ReflectionBinding PolicyLabel}" Classes="muted" />
                            <TextBlock Grid.Column="7" Text="{ReflectionBinding StatusLabel}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Column="8" Text="{ReflectionBinding MountPoint}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding MountPoint}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

<!-- Logs -->
            <Grid x:Name="LogsPage" IsVisible="False" RowDefinitions="1.15*,0.85*" RowSpacing="14">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="Journal events" Classes="sectionTitle" />
                      <TextBlock Text="Actionable warning and crash families are shown by default. Desktop-session and hardening observations remain available without affecting environment health." Classes="pageSubtitle" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                      <TextBlock x:Name="LogsSummaryText" Text="--" Classes="muted" HorizontalAlignment="Right" />
                      <CheckBox x:Name="ShowInformationalLogsCheckBox" Content="Show informational observations" IsChecked="False" Margin="0,6,0,0" Click="ShowInformationalLogsCheckBox_OnClick" />
                    </StackPanel>
                  </Grid>
                  <ListBox x:Name="LogsList" Classes="dataList" SelectionChanged="LogsList_OnSelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Grid ColumnDefinitions="90,190,160,70,*" ColumnSpacing="12">
                          <TextBlock Text="{ReflectionBinding Severity}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                          <TextBlock Grid.Column="1" Text="{ReflectionBinding Source}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Source}" />
                          <TextBlock Grid.Column="2" Text="{ReflectionBinding LastSeen, StringFormat='{}{0:g}'}" Classes="dim" />
                          <TextBlock Grid.Column="3" Text="{ReflectionBinding Count, StringFormat='{}{0}x'}" />
                          <TextBlock Grid.Column="4" Text="{ReflectionBinding Message}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Message}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Selected event detail" Classes="sectionTitle" />
                  <TextBox x:Name="LogDetailText" Classes="console" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
              </Border>
            </Grid>
            <!-- Intelligence -->
            <ScrollViewer x:Name="IntelligencePage" IsVisible="False">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                  <Border Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="OVERALL" Classes="eyebrow" />
                      <TextBlock
                          x:Name="IntelligenceOverallMetricText"
                          Text="WAITING"
                          FontSize="21"
                          FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="BLOCKERS" Classes="eyebrow" />
                      <TextBlock
                          x:Name="IntelligenceBlockersMetricText"
                          Text="0"
                          FontSize="21"
                          FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="WARNINGS" Classes="eyebrow" />
                      <TextBlock
                          x:Name="IntelligenceWarningsMetricText"
                          Text="0"
                          FontSize="21"
                          FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="3" Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="ROOT CAUSE" Classes="eyebrow" />
                      <TextBlock
                          x:Name="IntelligenceRootCauseMetricText"
                          Text="--"
                          FontSize="15"
                          FontWeight="SemiBold"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="0.72*,1.28*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="11">
                      <TextBlock
                          Text="Control Plane Intelligence"
                          Classes="sectionTitle" />

                      <Border
                          x:Name="IntelligenceSeverityBorder"
                          Classes="badge"
                          HorizontalAlignment="Left">
                        <TextBlock
                            x:Name="IntelligenceSeverityText"
                            Text="WAITING"
                            Classes="eyebrow" />
                      </Border>

                      <TextBlock
                          x:Name="IntelligenceRootCauseText"
                          Text="No analysis yet"
                          FontSize="19"
                          FontWeight="SemiBold"
                          TextWrapping="Wrap" />

                      <TextBlock
                          x:Name="IntelligenceHeadlineText"
                          Text="Refresh the environment to run analysis."
                          Classes="muted"
                          TextWrapping="Wrap" />

                      <WrapPanel>
                        <Button
                            Content="Copy report"
                            Margin="0,0,8,8"
                            Click="IntelligenceCopyReportButton_OnClick" />
                        <Button
                            Content="State history"
                            Margin="0,0,8,8"
                            Click="IntelligenceOpenHistoryButton_OnClick" />
                      </WrapPanel>

                      <TextBlock
                          x:Name="IntelligenceCopyStatusText"
                          Text="No report copied."
                          Classes="dim"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="11">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="Fleet impact"
                              Classes="sectionTitle" />
                          <TextBlock
                              Text="Host and component ownership make downstream impact explicit."
                              Classes="pageSubtitle"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            Text="HOST → COMPONENT → IMPACT"
                            Classes="eyebrow"
                            VerticalAlignment="Center" />
                      </Grid>

                      <ListBox
                          x:Name="IntelligenceImpactList"
                          Classes="dataList"
                          MinHeight="210"
                          MaxHeight="315"
                          SelectionChanged="IntelligenceImpactList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="120,135,90,1.2*,1.2*" ColumnSpacing="9">
                              <TextBlock
                                  Text="{ReflectionBinding HostName}"
                                  FontWeight="SemiBold"
                                  TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                  Grid.Column="1"
                                  Text="{ReflectionBinding Component}"
                                  TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                  Grid.Column="2"
                                  Text="{ReflectionBinding SeverityLabel}"
                                  Foreground="{DynamicResource AccentBrush}"
                                  FontWeight="SemiBold" />
                              <TextBlock
                                  Grid.Column="3"
                                  Text="{ReflectionBinding Issue}"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{ReflectionBinding Issue}" />
                              <TextBlock
                                  Grid.Column="4"
                                  Text="{ReflectionBinding Impact}"
                                  Classes="muted"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{ReflectionBinding Impact}" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="0.86*,1.14*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="11">
                      <TextBlock
                          Text="Dependency state"
                          Classes="sectionTitle" />
                      <TextBlock
                          Text="Upstream order is preserved so downstream symptoms do not trigger unnecessary restarts."
                          Classes="pageSubtitle"
                          TextWrapping="Wrap" />

                      <ListBox
                          x:Name="IntelligenceDependencyList"
                          Classes="dataList"
                          MinHeight="315"
                          MaxHeight="430"
                          SelectionChanged="IntelligenceDependencyList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="42,120,95,*" RowDefinitions="Auto,Auto" ColumnSpacing="9" RowSpacing="4">
                              <TextBlock
                                  Text="{ReflectionBinding Order}"
                                  FontSize="17"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource DimBrush}" />
                              <TextBlock
                                  Grid.Column="1"
                                  Text="{ReflectionBinding Component}"
                                  FontWeight="SemiBold" />
                              <TextBlock
                                  Grid.Column="2"
                                  Text="{ReflectionBinding State}"
                                  Foreground="{DynamicResource AccentBrush}"
                                  FontWeight="SemiBold" />
                              <TextBlock
                                  Grid.Column="3"
                                  Text="{ReflectionBinding Evidence}"
                                  TextWrapping="Wrap" />
                              <TextBlock
                                  Grid.Row="1"
                                  Grid.Column="3"
                                  Text="{ReflectionBinding Impact}"
                                  Classes="muted"
                                  TextWrapping="Wrap" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="11">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Text="Ranked priority findings"
                            Classes="sectionTitle" />
                        <TextBlock
                            Grid.Column="1"
                            x:Name="IntelligenceCountText"
                            Text="0 findings"
                            Classes="muted"
                            VerticalAlignment="Center" />
                      </Grid>

                      <ListBox
                          x:Name="IntelligenceFindingsList"
                          Classes="dataList"
                          MinHeight="315"
                          MaxHeight="430"
                          SelectionChanged="IntelligenceFindingsList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <StackPanel Spacing="5">
                              <StackPanel Orientation="Horizontal" Spacing="9">
                                <TextBlock
                                    Text="{ReflectionBinding Severity}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock
                                    Text="{ReflectionBinding Component}"
                                    FontWeight="SemiBold" />
                              </StackPanel>
                              <TextBlock
                                  Text="{ReflectionBinding Problem}"
                                  TextWrapping="Wrap" />
                              <TextBlock
                                  Text="{ReflectionBinding Impact, StringFormat='Impact · {0}'}"
                                  Classes="muted"
                                  FontSize="10"
                                  TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="1.05*,0.95*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="11">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="Guided remediation"
                              Classes="sectionTitle" />
                          <TextBlock
                              Text="Ordered upstream-first. Staging a step opens its owning page without running an unreviewed command."
                              Classes="pageSubtitle"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            x:Name="IntelligenceStageActionButton"
                            Content="Stage suggested action"
                            IsEnabled="False"
                            Click="IntelligenceStageActionButton_OnClick" />
                      </Grid>

                      <ListBox
                          x:Name="IntelligenceRemediationList"
                          Classes="dataList"
                          MinHeight="240"
                          MaxHeight="350"
                          SelectionChanged="IntelligenceRemediationList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="45,90,145,1.2*,1.2*" ColumnSpacing="9">
                              <TextBlock
                                  Text="{ReflectionBinding Step}"
                                  FontSize="17"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource DimBrush}" />
                              <TextBlock
                                  Grid.Column="1"
                                  Text="{ReflectionBinding SeverityLabel}"
                                  Foreground="{DynamicResource AccentBrush}"
                                  FontWeight="SemiBold" />
                              <TextBlock
                                  Grid.Column="2"
                                  Text="{ReflectionBinding Component}"
                                  FontWeight="SemiBold"
                                  TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                  Grid.Column="3"
                                  Text="{ReflectionBinding Why}"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{ReflectionBinding Why}" />
                              <TextBlock
                                  Grid.Column="4"
                                  Text="{ReflectionBinding NextStep}"
                                  Classes="muted"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{ReflectionBinding NextStep}" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="11">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="Selected intelligence"
                              Classes="sectionTitle" />
                          <TextBlock
                              x:Name="IntelligenceSelectedTitleText"
                              Text="Select a finding, dependency or remediation step"
                              Classes="pageSubtitle"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            x:Name="IntelligenceOpenRelatedButton"
                            Content="Open related"
                            IsEnabled="False"
                            Click="IntelligenceOpenRelatedButton_OnClick" />
                      </Grid>

                      <TextBox
                          x:Name="IntelligenceSelectedDetailText"
                          Classes="console"
                          IsReadOnly="True"
                          AcceptsReturn="True"
                          TextWrapping="Wrap"
                          MinHeight="235"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </ScrollViewer>
            <!-- Lifecycle -->
            <ScrollViewer x:Name="LifecyclePage" IsVisible="False">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                  <Border Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="ACTIVE ITEMS" Classes="eyebrow" />
                      <TextBlock
                          x:Name="LifecycleActiveMetricText"
                          Text="0"
                          FontSize="21"
                          FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="NEEDS ATTENTION" Classes="eyebrow" />
                      <TextBlock
                          x:Name="LifecycleAttentionMetricText"
                          Text="0"
                          FontSize="21"
                          FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="DOWNLOADING" Classes="eyebrow" />
                      <TextBlock
                          x:Name="LifecycleDownloadingMetricText"
                          Text="0"
                          FontSize="21"
                          FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="3" Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="IMPORT / RECONCILE" Classes="eyebrow" />
                      <TextBlock
                          x:Name="LifecycleImportMetricText"
                          Text="0"
                          FontSize="21"
                          FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="card">
                  <StackPanel Spacing="11">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock
                            Text="Media lifecycle"
                            Classes="sectionTitle" />
                        <TextBlock
                            Text="Request → Discovery → Arr → Download → Import → Processing → Library"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="Current stage readiness remains visible even when no item-level queue telemetry is available."
                            Classes="pageSubtitle"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>

                      <TextBlock
                          Grid.Column="1"
                          x:Name="LifecycleSummaryText"
                          Text="Waiting for capture"
                          Classes="muted"
                          VerticalAlignment="Center" />
                    </Grid>

                    <ListBox
                        x:Name="LifecycleStagesList"
                        Classes="dataList passive"
                        MinHeight="190"
                        MaxHeight="290">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="42,120,105,1.2*,1.1*" ColumnSpacing="9">
                            <TextBlock
                                Text="{ReflectionBinding Order}"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource DimBrush}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{ReflectionBinding Stage}"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{ReflectionBinding State}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock
                                Grid.Column="3"
                                Text="{ReflectionBinding Evidence}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{ReflectionBinding Evidence}" />
                            <TextBlock
                                Grid.Column="4"
                                Text="{ReflectionBinding Impact}"
                                Classes="muted"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{ReflectionBinding Impact}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="1.16*,0.84*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="11">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="Correlated work"
                              Classes="sectionTitle" />
                          <TextBlock
                              Text="Live Arr queue rows are correlated when available; otherwise GraveOps retains explicit stage-readiness rows."
                              Classes="pageSubtitle"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            x:Name="LifecycleOpenOwnerButton"
                            Content="Open owner"
                            IsEnabled="False"
                            Click="LifecycleOpenOwnerButton_OnClick" />
                      </Grid>

                      <ListBox
                          x:Name="LifecycleItemsList"
                          Classes="dataList"
                          MinHeight="360"
                          MaxHeight="520"
                          SelectionChanged="LifecycleItemsList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="1.25*,125,100,105,75,85,1.15*" ColumnSpacing="9">
                              <TextBlock
                                  Text="{ReflectionBinding Item}"
                                  FontWeight="SemiBold"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{ReflectionBinding Item}" />
                              <TextBlock
                                  Grid.Column="1"
                                  Text="{ReflectionBinding Owner}"
                                  TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                  Grid.Column="2"
                                  Text="{ReflectionBinding Stage}"
                                  Classes="muted" />
                              <TextBlock
                                  Grid.Column="3"
                                  Text="{ReflectionBinding State}"
                                  Foreground="{DynamicResource AccentBrush}"
                                  FontWeight="SemiBold"
                                  TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                  Grid.Column="4"
                                  Text="{ReflectionBinding Progress}" />
                              <TextBlock
                                  Grid.Column="5"
                                  Text="{ReflectionBinding Remaining}" />
                              <TextBlock
                                  Grid.Column="6"
                                  Text="{ReflectionBinding Detail}"
                                  Classes="muted"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{ReflectionBinding Detail}" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="11">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="Selected item"
                              Classes="sectionTitle" />
                          <TextBlock
                              x:Name="LifecycleSelectedTitleText"
                              Text="No lifecycle item selected"
                              Classes="pageSubtitle"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="Intelligence"
                            Click="LifecycleOpenIntelligenceButton_OnClick" />
                      </Grid>

                      <TextBox
                          x:Name="LifecycleSelectedDetailText"
                          Classes="console"
                          IsReadOnly="True"
                          AcceptsReturn="True"
                          TextWrapping="Wrap"
                          MinHeight="330"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="card">
                  <StackPanel Spacing="11">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock
                            Text="Upstream-first guided remediation"
                            Classes="sectionTitle" />
                        <TextBlock
                            Text="The earliest meaningful blocker is shown first so downstream services are not restarted before their dependency is corrected."
                            Classes="pageSubtitle"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>

                    <ListBox
                        x:Name="LifecycleRemediationList"
                        Classes="dataList"
                        MinHeight="180"
                        MaxHeight="300"
                        SelectionChanged="LifecycleRemediationList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="45,90,145,1.2*,1.2*" ColumnSpacing="9">
                            <TextBlock
                                Text="{ReflectionBinding Step}"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource DimBrush}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{ReflectionBinding SeverityLabel}"
                                Foreground="{DynamicResource AccentBrush}"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{ReflectionBinding Component}"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="3"
                                Text="{ReflectionBinding Why}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{ReflectionBinding Why}" />
                            <TextBlock
                                Grid.Column="4"
                                Text="{ReflectionBinding NextStep}"
                                Classes="muted"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{ReflectionBinding NextStep}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <!-- History -->
            <ScrollViewer x:Name="HistoryPage" IsVisible="False">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                  <Border Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="TRANSITIONS · 24H" Classes="eyebrow" />
                      <TextBlock
                          x:Name="HistoryTransitionMetricText"
                          Text="0"
                          FontSize="21"
                          FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="ACTIVITY · 24H" Classes="eyebrow" />
                      <TextBlock
                          x:Name="HistoryActivityMetricText"
                          Text="0"
                          FontSize="21"
                          FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="INCIDENTS" Classes="eyebrow" />
                      <TextBlock
                          x:Name="HistoryIncidentMetricText"
                          Text="0"
                          FontSize="21"
                          FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="3" Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Text="RETENTION" Classes="eyebrow" />
                      <TextBlock
                          x:Name="HistoryRetentionMetricText"
                          Text="0/750 · 0/300"
                          FontSize="16"
                          FontWeight="SemiBold"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="11">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="Health transitions"
                              Classes="sectionTitle" />
                          <TextBlock
                              Text="Changes only: repeated identical samples are not recorded."
                              Classes="pageSubtitle"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>

                      <ListBox
                          x:Name="HistoryTransitionsList"
                          Classes="dataList"
                          MinHeight="300"
                          MaxHeight="430"
                          SelectionChanged="HistoryTransitionsList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="130,90,145,*,1.2*" ColumnSpacing="9">
                              <TextBlock
                                  Text="{ReflectionBinding DisplayTime}"
                                  Classes="dim" />
                              <TextBlock
                                  Grid.Column="1"
                                  Text="{ReflectionBinding SeverityLabel}"
                                  Foreground="{DynamicResource AccentBrush}"
                                  FontWeight="SemiBold" />
                              <TextBlock
                                  Grid.Column="2"
                                  Text="{ReflectionBinding Component}"
                                  FontWeight="SemiBold"
                                  TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                  Grid.Column="3"
                                  Text="{ReflectionBinding Transition}"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{ReflectionBinding Transition}" />
                              <TextBlock
                                  Grid.Column="4"
                                  Text="{ReflectionBinding Detail}"
                                  Classes="muted"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{ReflectionBinding Detail}" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="11">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="GraveOps activity"
                              Classes="sectionTitle" />
                          <TextBlock
                              Text="Navigation, captures, targets, notifications, actions and failures."
                              Classes="pageSubtitle"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>

                      <ListBox
                          x:Name="HistoryActivityList"
                          Classes="dataList"
                          MinHeight="300"
                          MaxHeight="430"
                          SelectionChanged="HistoryActivityList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="130,120,130,*,1.1*" ColumnSpacing="9">
                              <TextBlock
                                  Text="{ReflectionBinding DisplayTime}"
                                  Classes="dim" />
                              <TextBlock
                                  Grid.Column="1"
                                  Text="{ReflectionBinding Stream}"
                                  FontWeight="SemiBold" />
                              <TextBlock
                                  Grid.Column="2"
                                  Text="{ReflectionBinding Target}"
                                  TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                  Grid.Column="3"
                                  Text="{ReflectionBinding Transition}"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{ReflectionBinding Transition}" />
                              <TextBlock
                                  Grid.Column="4"
                                  Text="{ReflectionBinding Detail}"
                                  Classes="muted"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{ReflectionBinding Detail}" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="1.02*,0.98*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="11">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              Text="Incident replay"
                              Classes="sectionTitle" />
                          <TextBlock
                              Text="Warning-or-higher events are prioritized. When no incident is active, recent history remains available."
                              Classes="pageSubtitle"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="Replay selected"
                            Click="HistoryReplaySelectedButton_OnClick" />
                      </Grid>

                      <ListBox
                          x:Name="HistoryIncidentList"
                          Classes="dataList"
                          MinHeight="250"
                          MaxHeight="360"
                          SelectionChanged="HistoryIncidentList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="130,90,130,150,*" ColumnSpacing="9">
                              <TextBlock
                                  Text="{ReflectionBinding DisplayTime}"
                                  Classes="dim" />
                              <TextBlock
                                  Grid.Column="1"
                                  Text="{ReflectionBinding SeverityLabel}"
                                  Foreground="{DynamicResource AccentBrush}"
                                  FontWeight="SemiBold" />
                              <TextBlock
                                  Grid.Column="2"
                                  Text="{ReflectionBinding Target}"
                                  TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                  Grid.Column="3"
                                  Text="{ReflectionBinding Component}"
                                  FontWeight="SemiBold"
                                  TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                  Grid.Column="4"
                                  Text="{ReflectionBinding Transition}"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{ReflectionBinding Transition}" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                        <Button
                            x:Name="HistoryCopyReplayButton"
                            Content="Copy replay"
                            IsEnabled="False"
                            Click="HistoryCopyReplayButton_OnClick" />
                        <Button
                            Grid.Column="1"
                            x:Name="HistoryOpenRelatedButton"
                            Content="Open related"
                            IsEnabled="False"
                            Click="HistoryOpenRelatedButton_OnClick" />
                        <Button
                            Grid.Column="2"
                            Content="Clear history"
                            Classes="danger"
                            Click="HistoryClearAllButton_OnClick" />
                        <TextBlock
                            Grid.Column="3"
                            x:Name="HistoryCopyStatusText"
                            Text="No replay copied."
                            Classes="dim"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="11">
                      <TextBlock
                          Text="Selected incident"
                          Classes="sectionTitle" />
                      <TextBlock
                          x:Name="HistorySelectedTitleText"
                          Text="No incident selected"
                          Classes="pageSubtitle"
                          TextWrapping="Wrap" />

                      <TextBox
                          x:Name="HistorySelectedDetailText"
                          Classes="console"
                          IsReadOnly="True"
                          AcceptsReturn="True"
                          TextWrapping="Wrap"
                          MinHeight="145"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" />

                      <TextBlock
                          Text="Replay report"
                          Classes="sectionTitle"
                          Margin="0,4,0,0" />

                      <TextBox
                          x:Name="HistoryReplayText"
                          Classes="console"
                          IsReadOnly="True"
                          AcceptsReturn="True"
                          Text="Select a transition or activity row to build an incident replay."
                          TextWrapping="Wrap"
                          MinHeight="215"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="card">
                  <StackPanel Spacing="7">
                    <TextBlock
                        Text="History ownership"
                        Classes="sectionTitle" />
                    <TextBlock
                        Text="Health transitions come from change-only environment recording. GraveOps Activity comes from the shared control plane. Fleet capture summaries remain separate so clearing history does not erase the latest host topology."
                        Classes="muted"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="HistoryCachePathText"
                        Text="Fleet cache is stored in fleet-insight-cache.json."
                        Classes="dim"
                        FontFamily="DejaVu Sans Mono, monospace"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- Backups -->
            <ScrollViewer x:Name="BackupsPage" IsVisible="False">
              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="0.75*,1.25*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Backup readiness" Classes="sectionTitle" />
                      <Border x:Name="BackupStateBorder" Classes="badge" HorizontalAlignment="Left">
                        <TextBlock x:Name="BackupStateText" Text="WAITING" Classes="eyebrow" />
                      </Border>
                      <TextBlock x:Name="BackupProviderText" Text="No provider captured" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock x:Name="BackupSummaryText" Text="Refresh the environment." Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Readiness evidence" Classes="sectionTitle" />
                      <ListBox x:Name="BackupEvidenceList" Classes="dataList passive" MinHeight="140" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Backup schedules and units" Classes="sectionTitle" />
                    <ListBox x:Name="BackupUnitsList" Classes="dataList passive" MinHeight="230">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="260,100,100,120,180,180,*" ColumnSpacing="10">
                            <TextBlock Text="{ReflectionBinding Unit}" FontFamily="DejaVu Sans Mono, monospace" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Active}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding SubState}" Classes="muted" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Enabled}" Classes="muted" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding LastRun}" Classes="dim" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="5" Text="{ReflectionBinding NextRun}" Classes="dim" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="6" Text="{ReflectionBinding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Path}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Recent backup artifacts" Classes="sectionTitle" />
                    <ListBox x:Name="BackupArtifactsList" Classes="dataList passive" MinHeight="200">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="*,110,180" ColumnSpacing="12">
                            <TextBlock Text="{ReflectionBinding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Path}" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Size}" Classes="muted" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding LocalModifiedAt, StringFormat='{}{0:g}'}" Classes="dim" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>


            <!-- Settings -->
            <ScrollViewer x:Name="SettingsPage" IsVisible="False">
              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="1.05*,0.95*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="12">
                      <TextBlock Text="Operator defaults" Classes="sectionTitle" />
                      <TextBlock
                          Text="Stored in operator-settings.json and applied when GraveOps starts."
                          Classes="pageSubtitle"
                          TextWrapping="Wrap" />

                      <CheckBox x:Name="SettingsSafeModeCheckBox" Content="Start in Safe Mode" IsChecked="True" />
                      <CheckBox x:Name="SettingsInformationalLogsCheckBox" Content="Show informational log observations by default" />
                      <CheckBox x:Name="SettingsInformationalContainersCheckBox" Content="Show informational exited containers by default" />
                      <CheckBox x:Name="SettingsOpenOverviewCheckBox" Content="Open Overview after startup" />

                      <Grid ColumnDefinitions="190,*" ColumnSpacing="10">
                        <TextBlock
                            Text="Background refresh seconds"
                            VerticalAlignment="Center" />
                        <TextBox
                            Grid.Column="1"
                            x:Name="SettingsBackgroundRefreshSecondsTextBox"
                            Text="60"
                            Width="110"
                            HorizontalAlignment="Left" />
                      </Grid>

                      <CheckBox
                          x:Name="SettingsDesktopNotificationsCheckBox"
                          Content="Show desktop notifications for new error-level incidents"
                          IsChecked="True" />

                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save settings" Classes="primary" Click="SaveOperatorSettingsButton_OnClick" />
                        <Button Content="Restore defaults" Click="ResetOperatorSettingsButton_OnClick" />
                      </StackPanel>

                      <TextBlock x:Name="SettingsSaveStatusText" Text="Settings loaded." Classes="dim" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Policy management" Classes="sectionTitle" />
                      <TextBlock x:Name="SettingsPolicySummaryText" Text="Waiting for capture" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock
                          Text="Finding suppression stays on Dashboard and storage thresholds stay on Storage so the operational context is preserved."
                          Classes="pageSubtitle"
                          TextWrapping="Wrap" />

                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Dashboard policies" Tag="DashboardNav" Click="SettingsNavigateButton_OnClick" />
                        <Button Content="Storage thresholds" Tag="StorageNav" Click="SettingsNavigateButton_OnClick" />
                      </StackPanel>

                      <TextBlock x:Name="SettingsPolicyPathText" Text="--" Classes="dim" FontFamily="DejaVu Sans Mono, monospace" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Application paths" Classes="sectionTitle" />
                    <TextBlock
                        Text="Open GraveOps-owned locations without guessing Linux paths."
                        Classes="pageSubtitle"
                        TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="150,*,Auto,Auto" ColumnSpacing="10" RowSpacing="9">
                      <TextBlock Text="Configuration" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" x:Name="SettingsConfigPathText" Text="--" Classes="dim" FontFamily="DejaVu Sans Mono, monospace" TextWrapping="Wrap" />
                      <Button Grid.Column="2" Content="Open folder" Tag="config" Click="OpenOperatorPathButton_OnClick" />
                      <Button Grid.Column="3" Content="Terminal" Tag="config" Click="OpenOperatorTerminalButton_OnClick" />

                      <TextBlock Grid.Row="1" Text="Data / history" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SettingsDataPathText" Text="--" Classes="dim" FontFamily="DejaVu Sans Mono, monospace" TextWrapping="Wrap" />
                      <Button Grid.Row="1" Grid.Column="2" Content="Open folder" Tag="data" Click="OpenOperatorPathButton_OnClick" />

                      <TextBlock Grid.Row="2" Text="Repository" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SettingsRepositoryPathText" Text="--" Classes="dim" FontFamily="DejaVu Sans Mono, monospace" TextWrapping="Wrap" />
                      <Button Grid.Row="2" Grid.Column="2" Content="Open folder" Tag="repo" Click="OpenOperatorPathButton_OnClick" />
                      <Button Grid.Row="2" Grid.Column="3" Content="Terminal" Tag="repo" Click="OpenOperatorTerminalButton_OnClick" />

                      <TextBlock Grid.Row="3" Text="Diagnostics" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SettingsDiagnosticsPathText" Text="--" Classes="dim" FontFamily="DejaVu Sans Mono, monospace" TextWrapping="Wrap" />
                      <Button Grid.Row="3" Grid.Column="2" Content="Open folder" Tag="diagnostics" Click="OpenOperatorPathButton_OnClick" />

                      <TextBlock Grid.Row="4" Text="Policy file" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SettingsPolicyFileText" Text="--" Classes="dim" FontFamily="DejaVu Sans Mono, monospace" TextWrapping="Wrap" />
                      <Button Grid.Row="4" Grid.Column="2" Content="Open file" Tag="policy" Click="OpenOperatorPathButton_OnClick" />

                      <TextBlock Grid.Row="5" Text="History file" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SettingsHistoryFileText" Text="--" Classes="dim" FontFamily="DejaVu Sans Mono, monospace" TextWrapping="Wrap" />
                      <Button Grid.Row="5" Grid.Column="2" Content="Open file" Tag="history" Click="OpenOperatorPathButton_OnClick" />
                    </Grid>

                    <TextBlock x:Name="SettingsPathStatusText" Text="No path action run." Classes="dim" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="Version and update state" Classes="sectionTitle" />
                        <TextBlock
                            Text="Local comparison with origin/linux-client; no network fetch is performed."
                            Classes="pageSubtitle"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Refresh version info" Click="RefreshVersionInfoButton_OnClick" />
                    </Grid>

                    <Grid ColumnDefinitions="160,*" RowSpacing="7">
                      <TextBlock Text="Branch" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" x:Name="SettingsBranchText" Text="--" />

                      <TextBlock Grid.Row="1" Text="Commit" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SettingsCommitText" Text="--" TextWrapping="Wrap" />

                      <TextBlock Grid.Row="2" Text="Worktree" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SettingsWorktreeText" Text="--" />

                      <TextBlock Grid.Row="3" Text="Origin comparison" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SettingsOriginText" Text="--" TextWrapping="Wrap" />

                      <TextBlock Grid.Row="4" Text=".NET SDK" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SettingsDotnetText" Text="--" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- Operator Tools -->
            <ScrollViewer x:Name="ToolsPage" IsVisible="False">
              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="1.05*,0.95*" ColumnSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="12">
                      <TextBlock Text="Diagnostics export" Classes="sectionTitle" />
                      <TextBlock
                          Text="Creates a local ZIP containing redacted environment, findings, lifecycle, integrations, grouped journal events, backup readiness and version state."
                          Classes="pageSubtitle"
                          TextWrapping="Wrap" />

                      <Border Classes="inset">
                        <TextBlock
                            Text="Excluded: configuration contents, API keys, passwords, environment variables, browser data and media files. Home paths, IP addresses and common secret patterns are redacted."
                            Classes="muted"
                            TextWrapping="Wrap" />
                      </Border>

                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CreateDiagnosticsButton" Content="Create diagnostics bundle" Classes="primary" IsEnabled="False" Click="CreateDiagnosticsButton_OnClick" />
                        <Button Content="Open diagnostics folder" Tag="diagnostics" Click="OpenOperatorPathButton_OnClick" />
                      </StackPanel>

                      <TextBlock x:Name="DiagnosticsStatusText" Text="Refresh the environment before exporting." Classes="dim" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="12">
                      <TextBlock Text="Safe terminal access" Classes="sectionTitle" />
                      <TextBlock
                          Text="These buttons only open a terminal in a known directory. GraveOps does not inject or execute a shell command."
                          Classes="pageSubtitle"
                          TextWrapping="Wrap" />

                      <Button Content="Terminal in repository" Tag="repo" HorizontalAlignment="Left" Click="OpenOperatorTerminalButton_OnClick" />
                      <Button Content="Terminal in configuration" Tag="config" HorizontalAlignment="Left" Click="OpenOperatorTerminalButton_OnClick" />

                      <TextBlock x:Name="TerminalStatusText" Text="No terminal opened." Classes="dim" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="Read-only validation" Classes="sectionTitle" />
                        <TextBlock
                            Text="Checks paths, JSON stores, repository state, local origin comparison and required launchers without changing services or policies."
                            Classes="pageSubtitle"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" x:Name="RunValidationButton" Content="Run validation" Click="RunValidationButton_OnClick" />
                    </Grid>

                    <TextBox
                        x:Name="ValidationOutputText"
                        Classes="console"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="330"
                        Text="Validation has not been run." />
                  </StackPanel>
                </Border>

                <Border Classes="card">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Scope boundaries" Classes="sectionTitle" />
                    <TextBlock
                        Text="Service and container actions remain on Services and Docker. Findings remain on Dashboard and Intelligence. Raw journal evidence remains on Logs. Operator decisions remain on History."
                        Classes="muted"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

          </Grid>

          <Border
              Grid.Row="2"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="14,0">

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Spacing="7">

                <TextBlock
                    Text="●"
                    FontSize="9"
                    Foreground="{DynamicResource SuccessBrush}" />

                <TextBlock
                    x:Name="FooterTargetText"
                    Text="No target"
                    Classes="muted"
                    FontSize="10" />

                <TextBlock Text="/" Classes="dim" FontSize="10" />

                <TextBlock
                    x:Name="FooterConnectionText"
                    Text="WAITING"
                    Classes="muted"
                    FontSize="10" />
              </StackPanel>

              <StackPanel
                  Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Spacing="7">

                <TextBlock
                    x:Name="FooterModeText"
                    Text="SAFE MODE"
                    Classes="muted"
                    FontSize="10" />

                <TextBlock Text="/" Classes="dim" FontSize="10" />

                <TextBlock
                    x:Name="FooterFindingsText"
                    Text="0 active"
                    Classes="muted"
                    FontSize="10" />

                <TextBlock Text="/" Classes="dim" FontSize="10" />

                <TextBlock
                    x:Name="FooterFreshnessText"
                    Text="waiting"
                    Classes="dim"
                    FontSize="10" />
              </StackPanel>
            </Grid>
          </Border>


          <Border
              x:Name="JobsDrawer"
              Grid.RowSpan="3"
              ZIndex="92"
              Width="500"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1,0,0,0"
              IsVisible="False">

            <Grid
                RowDefinitions="Auto,Auto,*,Auto"
                Margin="18">

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock
                      Text="Background Jobs"
                      FontSize="20"
                      FontWeight="SemiBold" />
                  <TextBlock
                      Text="Long-running and background control-plane work survives page navigation."
                      Classes="muted"
                      FontSize="10"
                      Margin="0,3,0,0"
                      TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="×"
                    Width="36"
                    Height="32"
                    Click="JobsCloseButton_OnClick" />
              </Grid>

              <TextBlock
                  Grid.Row="1"
                  x:Name="JobsSummaryText"
                  Text="0 running"
                  Classes="muted"
                  Margin="0,14,0,8" />

              <ListBox
                  Grid.Row="2"
                  x:Name="JobsList"
                  Classes="dataList passive">
                <ListBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Text="{ReflectionBinding Name}"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{ReflectionBinding State}"
                            Foreground="{DynamicResource AccentBrush}"
                            FontWeight="SemiBold" />
                      </Grid>

                      <TextBlock
                          Text="{ReflectionBinding Target}"
                          Classes="muted"
                          FontSize="10"
                          TextWrapping="Wrap" />

                      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="9">
                        <TextBlock
                            Text="{ReflectionBinding ProgressText}"
                            Classes="dim"
                            FontSize="9" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{ReflectionBinding DurationText}"
                            Classes="dim"
                            FontSize="9" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{ReflectionBinding DisplayTime}"
                            Classes="dim"
                            FontSize="9"
                            HorizontalAlignment="Right" />
                      </Grid>

                      <TextBlock
                          Text="{ReflectionBinding Detail}"
                          Classes="muted"
                          FontSize="10"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Button
                  Grid.Row="3"
                  Content="Clear completed"
                  HorizontalAlignment="Left"
                  Margin="0,12,0,0"
                  Click="ClearCompletedJobsButton_OnClick" />
            </Grid>
          </Border>

          <Border
              x:Name="ActivityDrawer"
              Grid.RowSpan="3"
              ZIndex="93"
              Width="560"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1,0,0,0"
              IsVisible="False">

            <Grid
                RowDefinitions="Auto,Auto,*,Auto"
                Margin="18">

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock
                      Text="Activity &amp; Notifications"
                      FontSize="20"
                      FontWeight="SemiBold" />
                  <TextBlock
                      Text="Targets, actions, failures, notifications and operator decisions."
                      Classes="muted"
                      FontSize="10"
                      Margin="0,3,0,0"
                      TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="×"
                    Width="36"
                    Height="32"
                    Click="ActivityCloseButton_OnClick" />
              </Grid>

              <Grid
                  Grid.Row="1"
                  ColumnDefinitions="220,*,Auto"
                  ColumnSpacing="8"
                  Margin="0,14,0,8">
                <ComboBox
                    x:Name="ActivityFilterComboBox"
                    SelectionChanged="ActivityFilterComboBox_OnSelectionChanged" />
                <TextBlock
                    Grid.Column="1"
                    x:Name="ActivitySummaryText"
                    Text="0 retained"
                    Classes="muted"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="2"
                    Content="Mark read"
                    Click="MarkActivityReadButton_OnClick" />
              </Grid>

              <ListBox
                  Grid.Row="2"
                  x:Name="ActivityList"
                  Classes="dataList"
                  DoubleTapped="ActivityList_OnDoubleTapped">
                <ListBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock
                            Text="{ReflectionBinding ReadState}"
                            Foreground="{DynamicResource AccentBrush}"
                            FontSize="9"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{ReflectionBinding Title}"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{ReflectionBinding Kind}"
                            Classes="dim"
                            FontSize="9" />
                      </Grid>

                      <TextBlock
                          Text="{ReflectionBinding Target}"
                          Classes="muted"
                          FontSize="10"
                          TextWrapping="Wrap" />

                      <TextBlock
                          Text="{ReflectionBinding Detail}"
                          Classes="muted"
                          FontSize="10"
                          TextWrapping="Wrap" />

                      <TextBlock
                          Text="{ReflectionBinding DisplayTime}"
                          Classes="dim"
                          FontSize="9" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Button
                  Grid.Row="3"
                  Content="Clear activity"
                  HorizontalAlignment="Left"
                  Margin="0,12,0,0"
                  Click="ClearActivityButton_OnClick" />
            </Grid>
          </Border>


          <Border
              x:Name="OverviewDrawer"
              Grid.RowSpan="3"
              ZIndex="90"
              Width="430"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1,0,0,0"
              IsVisible="False">

            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto,*"
                Margin="18">

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock
                      Text="Overview"
                      FontSize="20"
                      FontWeight="SemiBold" />

                  <TextBlock
                      Text="Current target, control-plane state and concise environment context."
                      Classes="muted"
                      FontSize="10"
                      Margin="0,3,0,0"
                      TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="×"
                    Width="36"
                    Height="32"
                    Click="OverviewCloseButton_OnClick" />
              </Grid>

              <Grid
                  Grid.Row="1"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="10"
                  Margin="0,16,0,0">

                <Border Classes="inset">
                  <StackPanel Spacing="5">
                    <TextBlock Text="TARGET" Classes="eyebrow" />
                    <TextBlock
                        x:Name="OverviewTargetText"
                        Text="--"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="OverviewOsText"
                        Text="--"
                        Classes="dim"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="inset">
                  <StackPanel Spacing="5">
                    <TextBlock Text="CONTROL PLANE" Classes="eyebrow" />
                    <TextBlock
                        x:Name="OverviewControlPlaneText"
                        Text="WAITING"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="OverviewCapturedText"
                        Text="No capture"
                        Classes="dim"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border
                  Grid.Row="2"
                  Classes="inset"
                  Margin="0,10,0,0">

                <StackPanel Spacing="6">
                  <TextBlock Text="ENVIRONMENT" Classes="eyebrow" />
                  <TextBlock
                      x:Name="OverviewFindingsText"
                      Text="No findings captured"
                      FontWeight="SemiBold"
                      TextWrapping="Wrap" />
                  <TextBlock
                      x:Name="OverviewPolicyText"
                      Text="Default monitoring"
                      Classes="dim"
                      TextWrapping="Wrap" />
                  <TextBlock
                      x:Name="OverviewHighestPriorityText"
                      Text="No active operational finding."
                      Classes="muted"
                      TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border
                  Grid.Row="3"
                  Classes="inset"
                  Margin="0,10,0,0">

                <StackPanel Spacing="5">
                  <TextBlock Text="BACKUPS" Classes="eyebrow" />
                  <TextBlock
                      x:Name="OverviewBackupText"
                      Text="Waiting for backup capture"
                      FontWeight="SemiBold"
                      TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <StackPanel
                  Grid.Row="4"
                  Margin="0,14,0,0"
                  Spacing="8">

                <TextBlock Text="QUICK NAVIGATION" Classes="eyebrow" />

                <WrapPanel>
                  <Button Content="Dashboard" Tag="DashboardNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                  <Button Content="Intelligence" Tag="IntelligenceNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                  <Button Content="Storage" Tag="StorageNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                  <Button Content="Media Hub" Tag="MediaHubNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                  <Button Content="Backups" Tag="BackupsNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                  <Button Content="History" Tag="HistoryNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                </WrapPanel>

                <TextBlock
                    Text="Detailed findings, logs, actions and history remain on their owner pages."
                    Classes="dim"
                    FontSize="10"
                    TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid
              x:Name="CommandPaletteOverlay"
              Grid.RowSpan="3"
              ZIndex="100"
              Background="#B2090A0C"
              IsVisible="False">

            <Border
                Width="720"
                MaxHeight="620"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,88,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">

              <Grid RowDefinitions="Auto,*,Auto">
                <TextBox
                    x:Name="CommandPaletteTextBox"
                    FontSize="17"
                    Padding="14,10"
                    PlaceholderText="Search pages and detected applications"
                    TextChanged="CommandPaletteTextBox_OnTextChanged"
                    KeyDown="CommandPaletteTextBox_OnKeyDown" />

                <ListBox
                    x:Name="CommandPaletteList"
                    Grid.Row="1"
                    Classes="dataList"
                    MinHeight="260"
                    MaxHeight="470"
                    Margin="0,10,0,0"
                    DoubleTapped="CommandPaletteList_OnDoubleTapped">

                  <ListBox.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="3">
                          <TextBlock
                              Text="{ReflectionBinding Title}"
                              FontWeight="SemiBold" />
                          <TextBlock
                              Text="{ReflectionBinding Subtitle}"
                              Classes="muted"
                              FontSize="10"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            Text="{ReflectionBinding Kind}"
                            Classes="dim"
                            FontSize="9"
                            VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock
                    Grid.Row="2"
                    Text="Enter opens · Up/Down selects · Esc closes · Ctrl+K toggles"
                    Classes="dim"
                    FontSize="10"
                    Margin="4,10,0,0" />
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
