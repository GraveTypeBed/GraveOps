<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="GraveOps.Desktop.Linux.MainWindow"
    x:CompileBindings="False"
    Title="GraveOps"
    Icon="/Assets/graveops-brandmark.png"
    Width="1500"
    Height="920"
    MinWidth="1180"
    MinHeight="760"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="38"
    KeyDown="MainWindow_OnKeyDown"
    Background="{DynamicResource BackdropBrush}">

  <Border
      Background="{DynamicResource BackgroundBrush}"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="1">

    <Grid RowDefinitions="38,*">
      <!-- Custom GraveOps title bar -->
      <Border
          Grid.Row="0"
          Background="{DynamicResource HeaderBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,0,0,1">

        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel
              Orientation="Horizontal"
              VerticalAlignment="Center"
              Margin="14,0,0,0"
              Spacing="0">

            <Border
                Width="22"
                Height="22"
                CornerRadius="6"
                Background="{DynamicResource AccentTintBrush}"
                BorderBrush="#5D4B2A"
                BorderThickness="1">

              <Path
                  Data="M5,5 L17,5 L17,8 L5,8 Z M5,10 L17,10 L17,13 L5,13 Z M5,15 L17,15 L17,18 L5,18 Z"
                  Fill="{DynamicResource AccentBrush}"
                  Stretch="None"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
            </Border>

            <TextBlock
                Text="GraveOps"
                FontWeight="SemiBold"
                FontSize="12"
                Margin="9,0,0,0"
                VerticalAlignment="Center" />

            <TextBlock
                Text="Control Center"
                Foreground="{DynamicResource DimBrush}"
                FontSize="11"
                Margin="7,0,0,0"
                VerticalAlignment="Center" />
          </StackPanel>

          <Border
              Grid.Column="1"
              Background="Transparent"
              PointerPressed="TitleDragRegion_OnPointerPressed"
              DoubleTapped="TitleDragRegion_OnDoubleTapped" />

          <StackPanel
              Grid.Column="2"
              Orientation="Horizontal">

            <Button
                Classes="titlebar"
                ToolTip.Tip="Minimize"
                Click="Minimize_Click">
              <Path
                  Data="M2,7 L12,7"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2"
                  Stretch="None" />
            </Button>

            <Button
                Classes="titlebar"
                ToolTip.Tip="Maximize or restore"
                Click="Maximize_Click">
              <Path
                  Data="M2.5,2.5 L11.5,2.5 L11.5,11.5 L2.5,11.5 Z"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.1"
                  Fill="Transparent"
                  Stretch="None" />
            </Button>

            <Button
                Classes="titlebar close"
                ToolTip.Tip="Close"
                Click="Close_Click">
              <Path
                  Data="M3,3 L11,11 M11,3 L3,11"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2"
                  StrokeLineCap="Round"
                  Stretch="None" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid
          Grid.Row="1"
          ColumnDefinitions="260,*">

        <!-- Navigation rail -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">

          <Grid
              RowDefinitions="Auto,*,Auto"
              Margin="14,15,14,14">

            <Border
                Classes="flatCard"
                Padding="12"
                Margin="0,0,0,17">

              <StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                  <Border
                      Width="34"
                      Height="34"
                      CornerRadius="9"
                      Background="{DynamicResource AccentTintBrush}">

                    <Path
                        Data="M7,8 L19,8 M7,12 L19,12 M7,16 L15,16"
                        Stroke="{DynamicResource AccentBrush}"
                        StrokeThickness="1.6"
                        StrokeLineCap="Round"
                        Stretch="None"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                  </Border>

                  <StackPanel
                      Grid.Column="1"
                      Margin="11,0,0,0"
                      VerticalAlignment="Center">

                    <TextBlock
                        Text="CONTROL PLANE"
                        Classes="eyebrow" />

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,5,0,0"
                        Spacing="7">

                      <TextBlock
                          x:Name="ConnectionDot"
                          Text="●"
                          FontSize="9"
                          Foreground="{DynamicResource SuccessBrush}" />

                      <TextBlock
                          x:Name="ConnectionText"
                          Text="READY"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource SuccessBrush}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="ConnectionDetailText"
                        Text="Native Linux provider"
                        Classes="dim"
                        FontSize="9"
                        Margin="0,3,0,0"
                        TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>

                <TextBlock
                    Text="ACTIVE SERVER"
                    Classes="eyebrow"
                    Margin="0,13,0,5" />

                <ComboBox
                    x:Name="ActiveTargetComboBox"
                    MinHeight="50"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="ActiveTargetComboBox_OnSelectionChanged">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <StackPanel Spacing="1">
                        <TextBlock
                            Text="{ReflectionBinding DisplayName}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{ReflectionBinding ConnectionSummary}"
                            Classes="dim"
                            FontSize="9.5"
                            TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Runtime compatibility fields remain wired without duplicating the visible target card. -->
                <StackPanel IsVisible="False">
                  <TextBlock x:Name="SidebarHostname" />
                  <TextBlock x:Name="SidebarOperatingSystem" />
                </StackPanel>
              </StackPanel>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                x:Name="SidebarNavigationScrollViewer"
                ClipToBounds="True"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

              <StackPanel Margin="0,0,10,0">
                <TextBlock
                    Text="OVERVIEW"
                    Classes="eyebrow"
                    Margin="10,0,0,6" />

                <Button
                    x:Name="DashboardNav"
                    Classes="nav selected"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M1,1 L7,1 L7,7 L1,7 Z M9,1 L15,1 L15,7 L9,7 Z M1,9 L7,9 L7,15 L1,15 Z M9,9 L15,9 L15,15 L9,15 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Dashboard"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="IntelligenceNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M8,1 L10,5 L15,6 L11.5,9.5 L12,15 L8,12.5 L4,15 L4.5,9.5 L1,6 L6,5 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Intelligence"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="LifecycleNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,8 L5,8 M6,8 L9,8 M10,8 L14,8 M4,5 L6,8 L4,11 M8,5 L10,8 L8,11"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Lifecycle"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="HistoryNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M8,2 A6,6 0 1 1 3,5 M3,2 L3,6 L7,6 M8,5 L8,8 L11,10"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="History &amp; Incidents"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="ServersNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,2 L14,2 L14,7 L2,7 Z M2,9 L14,9 L14,14 L2,14 Z M4,4.5 L5.5,4.5 M4,11.5 L5.5,11.5"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Servers"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <TextBlock
                    Text="MEDIA"
                    Classes="eyebrow"
                    Margin="10,15,0,6" />

                <Button
                    x:Name="MediaHubNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,2 L7,2 L7,7 L2,7 Z M9,2 L14,2 L14,7 L9,7 Z M2,9 L7,9 L7,14 L2,14 Z M9,9 L14,9 L14,14 L9,14 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Media Hub"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>


                <Button
                    x:Name="DumbNav"
                    Classes="nav sub"
                    IsVisible="False"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,3 L6,3 L6,7 L2,7 Z M7,3 L11,3 L11,7 L7,7 Z M4,8 L8,8 L8,12 L4,12 Z M9,8 L13,8 L13,12 L9,12 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="DUMB stack"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="LibraryGroupButton"
                    Classes="navGroup"
                    IsVisible="False"
                    Click="LibraryGroupButton_OnClick">
                  <Grid ColumnDefinitions="18,*">
                    <Path
                        x:Name="LibraryGroupGlyph"
                        Width="12"
                        Height="12"
                        Data="M2,4 L6,8 L10,4"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round"
                        Stretch="Uniform"
                        VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="LIBRARY" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <StackPanel x:Name="LibraryNavGroup" IsVisible="False">
                  <Button x:Name="PlexNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M3,2 L8.2,2 L13,8 L8.2,14 L3,14 L8.1,8 Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Stroke="Transparent"
                        StrokeThickness="0" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Plex"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>
                  <Button x:Name="TautulliNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,13 L2,8 M6,13 L6,5 M10,13 L10,9 M14,13 L14,2"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Tautulli"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>
                  <Button x:Name="KometaNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M8,1 L10,5 L15,6 L11.5,9.5 L12,15 L8,12.5 L4,15 L4.5,9.5 L1,6 L6,5 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Kometa"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>
                </StackPanel>

                <Button
                    x:Name="AcquisitionGroupButton"
                    Classes="navGroup"
                    IsVisible="False"
                    Click="AcquisitionGroupButton_OnClick">
                  <Grid ColumnDefinitions="18,*">
                    <Path
                        x:Name="AcquisitionGroupGlyph"
                        Width="12"
                        Height="12"
                        Data="M2,4 L6,8 L10,4"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round"
                        Stretch="Uniform"
                        VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="ACQUISITION" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <StackPanel x:Name="AcquisitionNavGroup" IsVisible="False">
                  <Button x:Name="SonarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 M3.4,3.4 L5.8,5.8 M12.6,3.4 L10.2,5.8 M3.4,12.6 L5.8,10.2 M12.6,12.6 L10.2,10.2 M8,6.1 A1.9,1.9 0 1 1 7.99,6.1"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Sonarr"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>
                  <Button x:Name="RadarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M3,13.5 L3,4.5 C3,2.5 4.6,1.6 6.3,2.6 L12.8,6.3 C14.5,7.3 14.5,8.7 12.8,9.7 L6.3,13.4 C4.6,14.4 3,13.5 3,11.5 M6.2,5.1 L11.2,8 L6.2,10.9 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Radarr"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>
                  <Button x:Name="LidarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 M8,5 A3,3 0 1 1 7.99,5 M8,7.2 A0.8,0.8 0 1 1 7.99,7.2 M3.7,11.7 L7,6.2 M9,9.8 L12.3,4.3"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Lidarr"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>
                  <Button x:Name="ProwlarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M3,5 L5,2 L7,4 L9,4 L11,2 L13,5 L12.2,11.8 L8,14 L3.8,11.8 Z M5.2,7.4 L7,8.4 M10.8,7.4 L9,8.4 M6,11 C7.2,12 8.8,12 10,11"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Prowlarr"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>
                  <Button x:Name="ReadarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,3 C4.5,2.5 6.2,3.2 8,5 L8,14 C6.1,12.6 4.1,12 2,12.5 Z M14,3 C11.5,2.5 9.8,3.2 8,5 L8,14 C9.9,12.6 11.9,12 14,12.5 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Readarr"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>
                  <Button x:Name="WhisparrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,6 C4,3 8,3 10,5 C11,6 10.5,7.5 9,7.5 L4,7.5 M2,10 L10.5,10 C12.5,10 13.5,11.5 12.5,13 C11.7,14.2 9.8,14.2 9,13"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Whisparr"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>
                  <Button x:Name="Mylar3Nav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,2 L14,2 L14,14 L2,14 Z M8,2 L8,14 M2,8 L14,8 M4,4 L6,6 M10,10 L12,12"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Mylar3"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>

                  <Button x:Name="SabnzbdNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M8,1 L8,10 M4,7 L8,11 L12,7 M3,14 L13,14"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="SABnzbd"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>
                  <Button x:Name="QBittorrentNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M3,6 C4,3 7,2 10,3 M10,3 L9,1 M10,3 L12,4 M13,10 C12,13 9,14 6,13 M6,13 L7,15 M6,13 L4,12 M4,8 L12,8"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="qBittorrent"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>
                </StackPanel>

                <Button
                    x:Name="ProcessingGroupButton"
                    Classes="navGroup"
                    IsVisible="False"
                    Click="ProcessingGroupButton_OnClick">
                  <Grid ColumnDefinitions="18,*">
                    <Path
                        x:Name="ProcessingGroupGlyph"
                        Width="12"
                        Height="12"
                        Data="M2,4 L6,8 L10,4"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round"
                        Stretch="Uniform"
                        VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="PROCESSING" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <StackPanel x:Name="ProcessingNavGroup" IsVisible="False">
                  <Button x:Name="DecypharrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,5 L11,5 M8,2 L11,5 L8,8 M14,11 L5,11 M8,8 L5,11 L8,14"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Decypharr"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>
                  <Button x:Name="RecyclarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M7.5,2 L10,2.2 L9,4 M10,2.2 C12.5,3 14,5.4 13.5,8 M13.5,8 L12,6.2 M13.5,8 L15,7 M12,11.5 C10.2,13.6 7.5,14.1 5.2,12.8 M5.2,12.8 L7.4,12.5 M5.2,12.8 L6,14.8 M2.5,9.5 C1.7,7 2.7,4.4 4.8,3 M4.8,3 L3.8,5 M4.8,3 L2.7,2.6"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Recyclarr"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>
                  <Button x:Name="BazarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,3 L14,3 L14,11 L9,11 L6,14 L6,11 L2,11 Z M4,6 L7,6 M9,6 L12,6 M4,8.5 L10,8.5"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Bazarr"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>

                  <Button x:Name="ZurgNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,3 C2,1 14,1 14,3 L14,13 C14,15 2,15 2,13 Z M2,3 C2,5 14,5 14,3 M2,8 C2,10 14,10 14,8"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Zurg"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  </Button>
                </StackPanel>

                <TextBlock
                    Text="SYSTEM"
                    Classes="eyebrow"
                    Margin="10,15,0,6" />

                <Button
                    x:Name="ServicesNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,4 L14,4 M2,8 L14,8 M2,12 L14,12 M5,2 L5,6 M10,6 L10,10 M7,10 L7,14"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Services &amp; Actions"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="DockerNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,7 L5,7 L5,10 L2,10 Z M6,7 L9,7 L9,10 L6,10 Z M10,7 L13,7 L13,10 L10,10 Z M4,3 L7,3 L7,6 L4,6 Z M8,3 L11,3 L11,6 L8,6 Z M1,11 C4,15 11,15 15,10"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Docker"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="StorageNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,3 C2,1 14,1 14,3 L14,13 C14,15 2,15 2,13 Z M2,3 C2,5 14,5 14,3 M2,8 C2,10 14,10 14,8"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Storage"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="LogsNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,4 L14,4 M2,8 L11,8 M2,12 L13,12"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Logs"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="BackupsNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M8,2 A6,6 0 1 1 3,5 M3,2 L3,6 L7,6"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Backups"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>
                <TextBlock
                    Text="OPERATOR"
                    Classes="eyebrow"
                    Margin="10,15,0,6" />

                <Button
                    x:Name="SettingsNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,4 L14,4 M5,2 L5,6 M2,8 L14,8 M10,6 L10,10 M2,12 L14,12 M7,10 L7,14"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Settings"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="ToolsNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Data="M2,3 L14,3 L14,13 L2,13 Z M4,6 L7,8 L4,10 M8,10 L11,10"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.45"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Operator Tools"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

              </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Margin="10,12,0,0">
              <TextBlock
                  Text="GRAVEOPS"
                  Classes="eyebrow"
                  Foreground="{DynamicResource AccentBrush}" />
              <TextBlock
                  Text="Native + remote providers"
                  Classes="dim"
                  FontSize="10"
                  Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Main workspace -->
        <Grid
            Grid.Column="1"
            RowDefinitions="72,42,*,26"
            Background="{DynamicResource BackgroundBrush}">

          <Border
              Grid.Row="0"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" Margin="28,0">
              <StackPanel VerticalAlignment="Center">
                <TextBlock
                    x:Name="PageTitleText"
                    Text="Dashboard"
                    FontSize="22"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="PageSubtitleText"
                    Text="Interactive environment health, ownership and active-host operations"
                    Classes="pageSubtitle"
                    FontSize="11"
                    Margin="0,3,0,0" />
              </StackPanel>

              <StackPanel
                  Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Spacing="7">
                <Button x:Name="OverviewButton" Classes="compact headerCommand" MinWidth="68" Content="Overview" Click="OverviewButton_OnClick" />
                <Button x:Name="JobsButton" Classes="compact headerCommand" MinWidth="52" Content="Jobs" Click="JobsButton_OnClick" />
                <Button Classes="compact headerCommand" MinWidth="84" Content="Intelligence" Tag="IntelligenceNav" Click="DashboardQuickModuleButton_OnClick" />
                <Button x:Name="ActivityButton" Classes="compact headerCommand" MinWidth="72" Content="Activity" Click="ActivityButton_OnClick" />
                <Button
                    Classes="compact headerCommand"
                    MinWidth="92"
                    Tag="ToolsNav"
                    Click="DashboardQuickModuleButton_OnClick">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path
                        Width="14"
                        Height="14"
                        Stretch="Uniform"
                        Data="M1.5,2.5 L14.5,2.5 L14.5,13.5 L1.5,13.5 Z M4,6 L6.5,8 L4,10 M8,10 L11.5,10"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.25"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                    <TextBlock
                        Text="Terminal"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <Border
              Grid.Row="1"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="28,0">
              <TextBlock Text="QUICK" Classes="eyebrow" VerticalAlignment="Center" Margin="0,0,12,0" />
              <Button Grid.Column="1" x:Name="MaintenanceButton" Classes="ghost" Content="Maintenance" Padding="10,6" Click="MaintenanceButton_OnClick" />
              <TextBlock Grid.Column="3" Text="Ctrl+K search" Classes="dim" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Grid.Column="4" x:Name="CommandPaletteButton" Classes="ghost" Content="Search" Padding="8,4" Click="CommandPaletteButton_OnClick" />
              <Button Grid.Column="5" Classes="ghost" Content="Customize" Tag="SettingsNav" Padding="8,4" Click="DashboardQuickModuleButton_OnClick" />
            </Grid>
          </Border>

          <Grid
              Grid.Row="2"
              Margin="24">
            <!-- Dashboard -->
            <Grid
                x:Name="DashboardPage"
                IsVisible="True">

              <ScrollViewer
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="System overview" Classes="sectionTitle" />
                      <TextBlock
                          Text="Live server state, health, workload and core operations."
                          Classes="pageSubtitle dashboardSubtitle"
                          Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="12">
                      <TextBlock
                          x:Name="LastUpdatedText"
                          Text="Live telemetry pending"
                          Classes="muted"
                          VerticalAlignment="Center" />
                      <Button
                          x:Name="RefreshButton"
                          Classes="compact"
                          Content="Refresh host"
                          Click="RefreshButton_OnClick" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Border Classes="flatCard" MinHeight="92">
                      <StackPanel>
                        <TextBlock Text="CONNECTION" Classes="eyebrow" />
                        <TextBlock
                            x:Name="DashboardFleetStateText"
                            Text="CHECKING"
                            Classes="metricValue"
                            Margin="0,9,0,2" />
                        <TextBlock
                            x:Name="DashboardEnvironmentSummaryText"
                            Text="Waiting for server state"
                            Classes="dim"
                            FontSize="10.5"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="flatCard" MinHeight="92">
                      <StackPanel>
                        <TextBlock Text="HEALTH" Classes="eyebrow" />
                        <TextBlock
                            x:Name="DashboardFleetAttentionCountText"
                            Text="0"
                            Classes="metricValue"
                            Margin="0,9,0,2" />
                        <TextBlock
                            x:Name="DashboardFindingsSummaryText"
                            Text="Waiting for health state"
                            Classes="dim"
                            FontSize="10.5"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="flatCard" MinHeight="92">
                      <StackPanel>
                        <TextBlock Text="BACKUPS" Classes="eyebrow" />
                        <TextBlock
                            x:Name="DashboardQuickBackupsText"
                            Text="NOT RUN"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Margin="0,9,0,2"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="DashboardPolicySummaryText"
                            Text="Validated by the latest capture"
                            Classes="dim"
                            FontSize="10.5"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Classes="flatCard" MinHeight="92">
                      <StackPanel>
                        <TextBlock Text="DOCKER" Classes="eyebrow" />
                        <TextBlock
                            x:Name="DashboardSummaryDockerText"
                            Text="CHECKING"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Margin="0,9,0,2"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="Selected-host container state"
                            Classes="dim"
                            FontSize="10.5"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="2.15*,1*" ColumnSpacing="10">
                    <Border Classes="card" MinHeight="210">
                      <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="Recommendations" Classes="sectionTitle" />
                            <TextBlock
                                Text="Prioritized from the latest Linux capture and shared application telemetry."
                                Classes="pageSubtitle dashboardSubtitle"
                                Margin="0,3,0,0" />
                          </StackPanel>
                          <Button
                              Grid.Column="1"
                              x:Name="DashboardOpenAttentionButton"
                              Classes="ghost compact"
                              Content="Open selected"
                              IsEnabled="False"
                              Click="DashboardOpenAttentionButton_OnClick" />
                        </Grid>

                        <Grid Grid.Row="1" RowDefinitions="*,Auto" RowSpacing="7">
                          <ListBox
                              x:Name="DashboardFleetAttentionList"
                              Classes="dataList dashboardSelection"
                              MinHeight="96"
                              MaxHeight="154"
                              SelectionChanged="DashboardFleetAttentionList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Border Classes="selectionRow" Margin="0,0,0,4">
                                  <Grid ColumnDefinitions="92,120,*,Auto" ColumnSpacing="10">
                                    <TextBlock
                                        Text="{ReflectionBinding SeverityLabel}"
                                        Foreground="{DynamicResource WarnBrush}"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{ReflectionBinding Component}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{ReflectionBinding Issue}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{ReflectionBinding HostName}"
                                        Classes="dim"
                                        TextTrimming="CharacterEllipsis" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>

                          <Border
                              x:Name="DashboardRecommendationsEmptyPanel"
                              Grid.RowSpan="2"
                              Classes="emptyState"
                              IsVisible="True">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                              <Border
                                  Width="38"
                                  Height="38"
                                  CornerRadius="19"
                                  Background="{DynamicResource SuccessTintBrush}"
                                  BorderBrush="#1C5A32"
                                  BorderThickness="1"
                                  VerticalAlignment="Center">
                                <TextBlock
                                    Text="✓"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                              </Border>

                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    Text="No recommendations"
                                    FontSize="14"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="The latest capture found no active fleet-wide issue that requires operator action."
                                    Classes="muted"
                                    FontSize="11"
                                    TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </Border>

                          <TextBlock
                              Grid.Row="1"
                              x:Name="DashboardFleetAttentionDetailText"
                              IsVisible="False"
                              Text="Nothing needs attention right now."
                              Classes="muted"
                              FontSize="10"
                              TextWrapping="Wrap"
                              MaxHeight="42"
                              Margin="6,0" />
                        </Grid>
                      </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="card" MinHeight="210">
                      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="Connectivity chain" Classes="sectionTitle" />
                            <TextBlock
                                Text="Host → storage → Docker → downloads → Arr → Plex"
                                Classes="pageSubtitle dashboardSubtitle"
                                Margin="0,3,0,0" />
                          </StackPanel>

                          <Button
                              Grid.Column="1"
                              x:Name="DashboardFocusHostButton"
                              Classes="ghost compact"
                              Content="Focus"
                              IsEnabled="False"
                              Click="DashboardFocusHostButton_OnClick" />
                        </Grid>

                        <ListBox
                            Grid.Row="1"
                            x:Name="DashboardEnvironmentList"
                            Classes="dataList dashboardSelection"
                            MinHeight="104"
                            MaxHeight="138"
                            SelectionChanged="DashboardEnvironmentList_OnSelectionChanged">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                              <Border Classes="chainRow" Margin="0,0,0,4">
                                <StackPanel Spacing="4">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                      <TextBlock
                                          Text="●"
                                          Foreground="{DynamicResource SuccessBrush}"
                                          FontSize="8"
                                          VerticalAlignment="Center" />
                                      <TextBlock
                                          Text="{ReflectionBinding HostName}"
                                          FontWeight="SemiBold"
                                          TextTrimming="CharacterEllipsis" />
                                      <TextBlock
                                          Text="{ReflectionBinding ActiveLabel}"
                                          Foreground="{DynamicResource AccentBrush}"
                                          FontSize="9" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="1"
                                        Classes="statusBadge">
                                      <TextBlock
                                          Text="{ReflectionBinding SeverityLabel}"
                                          Foreground="{DynamicResource SuccessBrush}"
                                          FontSize="9"
                                          FontWeight="SemiBold" />
                                    </Border>
                                  </Grid>
                                  <TextBlock
                                      Text="{ReflectionBinding Connection}"
                                      Classes="dim"
                                      FontSize="9.5"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Text="{ReflectionBinding ApplicationSummary}"
                                      Classes="muted"
                                      FontSize="10.5"
                                      TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Classes="chainSummary">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                              <TextBlock
                                  x:Name="DashboardSelectedHostText"
                                  Text="No target selected"
                                  FontWeight="SemiBold"
                                  TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                  x:Name="DashboardSelectedConnectionText"
                                  Text="--"
                                  Classes="mono"
                                  FontSize="9.5"
                                  TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                x:Name="DashboardSelectedCapturedText"
                                Text="Waiting for capture"
                                Classes="dim"
                                FontSize="9"
                                VerticalAlignment="Center" />
                          </Grid>
                        </Border>

                        <!-- Existing Linux data contract retained without duplicating visible workload cards. -->
                        <StackPanel IsVisible="False">
                          <TextBlock x:Name="DashboardSelectedApplicationsText" />
                          <TextBlock x:Name="DashboardSelectedAttentionText" />
                          <TextBlock x:Name="DashboardSelectedQueueText" />
                          <TextBlock x:Name="DashboardSelectedDockerText" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Grid>

                  <Border Classes="card">
                    <StackPanel Spacing="9">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="Live workload" Classes="sectionTitle" />
                          <TextBlock
                              Text="Shared snapshots only—no extra repair or destructive probes."
                              Classes="pageSubtitle dashboardSubtitle"
                              Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Text="Latest active-target sample"
                            Classes="dim"
                            VerticalAlignment="Center" />
                      </Grid>

                      <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                        <Border Classes="inset">
                          <StackPanel>
                            <TextBlock Text="HOSTS" Classes="eyebrow" />
                            <TextBlock
                                x:Name="DashboardFleetHostCountText"
                                Text="--"
                                FontSize="22"
                                FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="inset">
                          <StackPanel>
                            <TextBlock Text="ONLINE APPS" Classes="eyebrow" />
                            <TextBlock
                                x:Name="DashboardLiveApplicationCountText"
                                Text="--"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SuccessBrush}" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="inset">
                          <StackPanel>
                            <TextBlock Text="ATTENTION" Classes="eyebrow" />
                            <TextBlock
                                x:Name="DashboardLiveAttentionCountText"
                                Text="--"
                                FontSize="22"
                                FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Classes="inset">
                          <StackPanel>
                            <TextBlock Text="QUEUED" Classes="eyebrow" />
                            <TextBlock
                                x:Name="DashboardLiveQueueText"
                                Text="--"
                                FontSize="22"
                                FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Classes="inset">
                          <StackPanel>
                            <TextBlock Text="DOCKER" Classes="eyebrow" />
                            <TextBlock
                                x:Name="DashboardLiveDockerText"
                                Text="--"
                                FontSize="17"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Grid ColumnDefinitions="2.15*,1*" ColumnSpacing="10">
                    <Border Classes="card" MinHeight="210">
                      <StackPanel Spacing="11">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="System health" Classes="sectionTitle" />
                            <TextBlock
                                Text="Canonical GraveOps health state from the active Linux target."
                                Classes="pageSubtitle dashboardSubtitle"
                                Margin="0,3,0,0" />
                          </StackPanel>
                          <Button
                              Grid.Column="1"
                              Classes="primary compact"
                              Content="Open Intelligence"
                              Tag="IntelligenceNav"
                              Click="DashboardQuickModuleButton_OnClick" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="7">
                          <Border Classes="healthPass">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel>
                                <TextBlock
                                    Text="PASS"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    FontSize="10.5"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Healthy checks"
                                    Classes="dim"
                                    FontSize="9.5"
                                    Margin="0,2,0,0" />
                              </StackPanel>
                              <TextBlock
                                  Grid.Column="1"
                                  x:Name="DashboardHealthPassText"
                                  Text="--"
                                  FontSize="25"
                                  FontWeight="Bold"
                                  VerticalAlignment="Center" />
                            </Grid>
                          </Border>

                          <Border Grid.Column="1" Classes="healthWarn">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel>
                                <TextBlock
                                    Text="WARN"
                                    Foreground="{DynamicResource WarnBrush}"
                                    FontSize="10.5"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Needs review"
                                    Classes="dim"
                                    FontSize="9.5"
                                    Margin="0,2,0,0" />
                              </StackPanel>
                              <TextBlock
                                  Grid.Column="1"
                                  x:Name="DashboardHealthWarnText"
                                  Text="--"
                                  FontSize="25"
                                  FontWeight="Bold"
                                  VerticalAlignment="Center" />
                            </Grid>
                          </Border>

                          <Border Grid.Column="2" Classes="healthFail">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel>
                                <TextBlock
                                    Text="FAIL"
                                    Foreground="{DynamicResource DangerBrush}"
                                    FontSize="10.5"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Action required"
                                    Classes="dim"
                                    FontSize="9.5"
                                    Margin="0,2,0,0" />
                              </StackPanel>
                              <TextBlock
                                  Grid.Column="1"
                                  x:Name="DashboardHealthFailText"
                                  Text="--"
                                  FontSize="25"
                                  FontWeight="Bold"
                                  VerticalAlignment="Center" />
                            </Grid>
                          </Border>
                        </Grid>

                        <Expander Header="Detailed health findings" IsExpanded="False">
                          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8" Margin="0,10,0,0">
                            <ListBox
                                x:Name="DashboardAttentionList"
                                Classes="dataList dashboardSelection"
                                MinHeight="130"
                                MaxHeight="260"
                                SelectionChanged="DashboardAttentionList_OnSelectionChanged" />

                            <WrapPanel Grid.Row="1">
                              <Button
                                  x:Name="AcknowledgeFindingButton"
                                  Classes="compact"
                                  Content="Acknowledge"
                                  Margin="0,0,6,0"
                                  Click="AcknowledgeFindingButton_OnClick" />
                              <Button
                                  x:Name="SnoozeFindingButton"
                                  Classes="compact"
                                  Content="Snooze"
                                  Margin="0,0,6,0"
                                  Click="SnoozeFindingButton_OnClick" />
                              <Button
                                  x:Name="IgnoreFindingButton"
                                  Classes="compact"
                                  Content="Ignore"
                                  Margin="0,0,6,0"
                                  Click="IgnoreFindingButton_OnClick" />
                              <Button
                                  x:Name="FindingThresholdButton"
                                  Classes="compact"
                                  Content="Threshold"
                                  Click="FindingThresholdButton_OnClick" />
                            </WrapPanel>

                            <TextBlock
                                Grid.Row="2"
                                x:Name="DashboardPolicyStatusText"
                                Classes="dim"
                                TextWrapping="Wrap" />
                          </Grid>
                        </Expander>

                        <Border
                            x:Name="MutedFindingsPanel"
                            Classes="inset"
                            IsVisible="False">
                          <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="MutedFindingsSummaryText"
                                Classes="eyebrow" />
                            <ListBox
                                x:Name="MutedFindingsList"
                                Classes="dataList dashboardSelection"
                                MaxHeight="160"
                                SelectionChanged="MutedFindingsList_OnSelectionChanged" />
                            <Button
                                x:Name="RestoreMutedFindingButton"
                                Classes="compact"
                                Content="Restore selected"
                                HorizontalAlignment="Left"
                                Click="RestoreMutedFindingButton_OnClick" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card" MinHeight="210">
                      <StackPanel Spacing="10">
                        <StackPanel>
                          <TextBlock Text="Quick operations" Classes="sectionTitle" />
                          <TextBlock
                              Text="Common destinations without duplicating full page detail."
                              Classes="pageSubtitle dashboardSubtitle"
                              Margin="0,3,0,0" />
                        </StackPanel>

                        <Grid
                            ColumnDefinitions="*,*"
                            RowDefinitions="*,*"
                            ColumnSpacing="8"
                            RowSpacing="8"
                            MinHeight="134">
                          <Button
                              Classes="quickModule"
                              Tag="IntelligenceNav"
                              Click="DashboardQuickModuleButton_OnClick">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="3">
                                <TextBlock Text="Intelligence" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="DashboardQuickIntelligenceText"
                                    Text="--"
                                    Classes="muted"
                                    FontSize="10.5"
                                    TextWrapping="Wrap"
                                    MaxHeight="34" />
                              </StackPanel>
                              <TextBlock
                                  Grid.Column="1"
                                  Text="›"
                                  Foreground="{DynamicResource AccentBrush}"
                                  FontSize="18"
                                  VerticalAlignment="Center" />
                            </Grid>
                          </Button>

                          <Button
                              Grid.Column="1"
                              Classes="quickModule"
                              Tag="MediaHubNav"
                              Click="DashboardQuickModuleButton_OnClick">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="3">
                                <TextBlock Text="Media Hub" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="DashboardQuickMediaText"
                                    Text="--"
                                    Classes="muted"
                                    FontSize="10.5"
                                    TextWrapping="Wrap"
                                    MaxHeight="34" />
                              </StackPanel>
                              <TextBlock
                                  Grid.Column="1"
                                  Text="›"
                                  Foreground="{DynamicResource AccentBrush}"
                                  FontSize="18"
                                  VerticalAlignment="Center" />
                            </Grid>
                          </Button>

                          <Button
                              Grid.Row="1"
                              Classes="quickModule"
                              Tag="StorageNav"
                              Click="DashboardQuickModuleButton_OnClick">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="3">
                                <TextBlock Text="Storage" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="DashboardQuickStorageText"
                                    Text="--"
                                    Classes="muted"
                                    FontSize="10.5"
                                    TextWrapping="Wrap"
                                    MaxHeight="34" />
                              </StackPanel>
                              <TextBlock
                                  Grid.Column="1"
                                  Text="›"
                                  Foreground="{DynamicResource AccentBrush}"
                                  FontSize="18"
                                  VerticalAlignment="Center" />
                            </Grid>
                          </Button>

                          <Button
                              Grid.Row="1"
                              Grid.Column="1"
                              Classes="quickModule"
                              Tag="HistoryNav"
                              Click="DashboardQuickModuleButton_OnClick">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="3">
                                <TextBlock Text="Activity" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="DashboardQuickHistoryText"
                                    Text="--"
                                    Classes="muted"
                                    FontSize="10.5"
                                    TextWrapping="Wrap"
                                    MaxHeight="34" />
                              </StackPanel>
                              <TextBlock
                                  Grid.Column="1"
                                  Text="›"
                                  Foreground="{DynamicResource AccentBrush}"
                                  FontSize="18"
                                  VerticalAlignment="Center" />
                            </Grid>
                          </Button>
                        </Grid>

                        <TextBlock
                            x:Name="DashboardQuickLifecycleText"
                            IsVisible="False" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="2.15*,1*" ColumnSpacing="10" Margin="0,0,0,4">
                    <Border Classes="card">
                      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="Service fleet" Classes="sectionTitle" />
                            <TextBlock
                                Text="The active target's verified media and infrastructure applications."
                                Classes="pageSubtitle dashboardSubtitle"
                                Margin="0,3,0,0" />
                          </StackPanel>
                          <Button
                              Grid.Column="1"
                              x:Name="DashboardOpenApplicationButton"
                              Classes="compact"
                              Content="Open selected"
                              IsEnabled="False"
                              Click="DashboardOpenApplicationButton_OnClick" />
                        </Grid>

                        <ListBox
                            Grid.Row="1"
                            x:Name="DashboardApplicationList"
                            Classes="dataList dashboardSelection"
                            MinHeight="180"
                            MaxHeight="300"
                            SelectionChanged="DashboardApplicationList_OnSelectionChanged">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                              <Border Classes="selectionRow" Margin="0,0,0,4">
                                <Grid ColumnDefinitions="1.35*,0.85*,Auto" ColumnSpacing="10">
                                  <TextBlock
                                      Text="{ReflectionBinding Application}"
                                      FontWeight="SemiBold"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="1"
                                      Text="{ReflectionBinding State}"
                                      Foreground="{DynamicResource SuccessBrush}"
                                      FontWeight="SemiBold"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="2"
                                      Text="Open from GraveOps"
                                      Classes="dim"
                                      FontSize="9.5" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock
                            Grid.Row="2"
                            x:Name="DashboardFleetApplicationCountText"
                            Text="0 verified applications"
                            Classes="dim" />
                      </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="card">
                      <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="Recent activity" Classes="sectionTitle" />
                            <TextBlock
                                Text="Latest meaningful GraveOps operations."
                                Classes="pageSubtitle dashboardSubtitle"
                                Margin="0,3,0,0" />
                          </StackPanel>
                          <TextBlock
                              Grid.Column="1"
                              Text="Latest 7"
                              Classes="dim"
                              VerticalAlignment="Center" />
                        </Grid>

                        <ListBox
                            Grid.Row="1"
                            x:Name="DashboardRecentActivityList"
                            Classes="dataList passive"
                            MinHeight="180"
                            MaxHeight="300">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                              <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                  <TextBlock
                                      Text="{ReflectionBinding Title}"
                                      FontWeight="SemiBold"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="1"
                                      Text="{ReflectionBinding DisplayTime}"
                                      Classes="dim"
                                      FontSize="9" />
                                </Grid>
                                <TextBlock
                                    Text="{ReflectionBinding Detail}"
                                    Classes="muted"
                                    FontSize="10"
                                    TextWrapping="Wrap"
                                    MaxHeight="42" />
                              </StackPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </Grid>
                    </Border>
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </Grid>
            <!-- Servers -->
            <Grid
                x:Name="ServersPage"
                IsVisible="False"
                ColumnDefinitions="250,0.95*,1.05*"
                ColumnSpacing="8">

              <Border Classes="module adaptive">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                  <StackPanel>
                    <TextBlock Text="Saved hosts" Classes="sectionTitle" />
                    <TextBlock
                        Text="Local and remote Linux profiles. Secret values remain in the desktop keyring."
                        Classes="pageSubtitle"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="ServerProfilesSummaryText"
                        Text="0 profiles"
                        Classes="dim"
                        Margin="0,4,0,0" />
                  </StackPanel>

                  <ListBox
                      Grid.Row="1"
                      x:Name="ServerProfilesList"
                      Classes="dataList"
                      MinHeight="220"
                      SelectionChanged="ServerProfilesList_OnSelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <StackPanel Spacing="2">
                          <TextBlock
                              Text="{ReflectionBinding DisplayName}"
                              FontWeight="SemiBold"
                              TextTrimming="CharacterEllipsis" />
                          <TextBlock
                              Text="{ReflectionBinding ConnectionSummary}"
                              Classes="dim"
                              FontSize="8.5"
                              TextTrimming="CharacterEllipsis"
                              ToolTip.Tip="{ReflectionBinding ConnectionSummary}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <WrapPanel Grid.Row="2">
                    <Button
                        Content="Add remote"
                        Classes="primary compact"
                        Margin="0,0,5,5"
                        Click="NewServerButton_OnClick" />
                    <Button
                        x:Name="DeleteServerButton"
                        Content="Delete"
                        Classes="danger compact"
                        Margin="0,0,5,5"
                        Click="DeleteServerButton_OnClick" />
                    <Button
                        Content="Discover LAN"
                        Classes="compact"
                        Margin="0,0,0,5"
                        Click="DiscoverLanButton_OnClick" />
                  </WrapPanel>
                </Grid>
              </Border>

              <Border Grid.Column="1" Classes="module adaptive">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="9" Margin="0,0,4,0">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="Host profile" Classes="sectionTitle" />
                        <TextBlock
                            x:Name="ServerProfileModeText"
                            Text="Select a saved profile or add a remote Linux host."
                            Classes="pageSubtitle"
                            TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock
                          Grid.Column="1"
                          x:Name="ServerEditingIdText"
                          Text="New profile"
                          Classes="dim"
                          MaxWidth="150"
                          TextTrimming="CharacterEllipsis"
                          VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,155" ColumnSpacing="7">
                      <StackPanel>
                        <TextBlock Text="Friendly name" Classes="eyebrow" Margin="0,0,0,3" />
                        <TextBox x:Name="ServerNameTextBox" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Role" Classes="eyebrow" Margin="0,0,0,3" />
                        <TextBox x:Name="ServerRoleTextBox" />
                      </StackPanel>
                    </Grid>

                    <StackPanel>
                      <TextBlock Text="Connection type" Classes="eyebrow" Margin="0,0,0,3" />
                      <ComboBox
                          x:Name="ServerConnectionTypeComboBox"
                          SelectionChanged="ServerConnectionTypeComboBox_OnSelectionChanged" />
                    </StackPanel>

                    <Border
                        x:Name="ServerLocalProviderPanel"
                        Classes="healthPass"
                        IsVisible="False">
                      <StackPanel>
                        <TextBlock Text="Native local provider" FontWeight="SemiBold" />
                        <TextBlock
                            Text="This host is captured directly. SSH host, credential and fingerprint fields are intentionally hidden."
                            Classes="muted"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border
                        x:Name="ServerRemoteConnectionPanel"
                        Classes="inset">
                      <StackPanel Spacing="8">
                        <TextBlock Text="Remote SSH connection" Classes="sectionTitle" />
                        <Grid ColumnDefinitions="*,90" ColumnSpacing="7">
                          <StackPanel>
                            <TextBlock Text="Host / IP" Classes="eyebrow" Margin="0,0,0,3" />
                            <TextBox x:Name="ServerHostTextBox" />
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="SSH port" Classes="eyebrow" Margin="0,0,0,3" />
                            <TextBox x:Name="ServerPortTextBox" />
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                          <StackPanel>
                            <TextBlock Text="Username" Classes="eyebrow" Margin="0,0,0,3" />
                            <TextBox x:Name="ServerUsernameTextBox" />
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="Authentication" Classes="eyebrow" Margin="0,0,0,3" />
                            <ComboBox
                                x:Name="ServerAuthenticationComboBox"
                                SelectionChanged="ServerAuthenticationComboBox_OnSelectionChanged" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border
                        x:Name="ServerPrivateKeyPanel"
                        Classes="inset"
                        IsVisible="False">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                        <StackPanel>
                          <TextBlock Text="Private key path" Classes="eyebrow" Margin="0,0,0,3" />
                          <TextBox x:Name="ServerPrivateKeyPathTextBox" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            x:Name="BrowsePrivateKeyButton"
                            Content="Browse"
                            Classes="compact"
                            VerticalAlignment="Bottom"
                            Click="BrowsePrivateKeyButton_OnClick" />
                      </Grid>
                    </Border>

                    <Border
                        x:Name="ServerFingerprintPanel"
                        Classes="inset">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                        <StackPanel>
                          <TextBlock Text="Pinned host-key SHA-256 fingerprint" Classes="eyebrow" Margin="0,0,0,3" />
                          <TextBox x:Name="ServerFingerprintTextBox" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            x:Name="ScanFingerprintButton"
                            Content="Scan"
                            Classes="compact"
                            VerticalAlignment="Bottom"
                            Click="ScanFingerprintButton_OnClick" />
                      </Grid>
                    </Border>

                    <Border
                        x:Name="ServerSecretPanel"
                        Classes="inset"
                        IsVisible="False">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                        <StackPanel>
                          <TextBlock Text="Password / passphrase" Classes="eyebrow" Margin="0,0,0,3" />
                          <TextBox x:Name="ServerSecretTextBox" PasswordChar="●" />
                        </StackPanel>
                        <CheckBox
                            Grid.Column="1"
                            x:Name="ServerSaveSecretCheckBox"
                            Content="Save securely"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,6" />
                      </Grid>
                    </Border>

                    <WrapPanel>
                      <Button
                          x:Name="ServerSaveButton"
                          Content="Save profile"
                          Classes="primary compact"
                          Margin="0,0,5,5"
                          Click="SaveServerButton_OnClick" />
                      <Button
                          x:Name="ServerTestButton"
                          Content="Test SSH"
                          Classes="compact"
                          Margin="0,0,5,5"
                          Click="TestServerButton_OnClick" />
                      <Button
                          x:Name="ServerDetectButton"
                          Content="Detect integrations"
                          Classes="compact"
                          Margin="0,0,5,5"
                          Click="DetectServerButton_OnClick" />
                      <Button
                          x:Name="SetActiveServerButton"
                          Content="Set active"
                          Classes="compact"
                          Margin="0,0,0,5"
                          Click="SetActiveServerButton_OnClick" />
                    </WrapPanel>

                    <Border Classes="arrStatusBar">
                      <StackPanel>
                        <TextBlock
                            x:Name="ServerProfileStatusText"
                            Text="Select a host or add a remote profile."
                            Classes="muted"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ServerKeyringStatusText"
                            Text="Secret Service status pending."
                            Classes="dim"
                            Margin="0,3,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Border>

              <Border Grid.Column="2" Classes="module adaptive">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="9" Margin="0,0,4,0">
                    <StackPanel>
                      <TextBlock Text="Detected context" Classes="sectionTitle" />
                      <TextBlock
                          Text="Runtime, integration and signal-quality evidence for the active target."
                          Classes="pageSubtitle"
                          TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                      <Border Classes="inset">
                        <StackPanel>
                          <TextBlock Text="IDENTITY" Classes="eyebrow" />
                          <TextBlock x:Name="ServerIdentityText" Text="--" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Classes="inset">
                        <StackPanel>
                          <TextBlock Text="OPERATING SYSTEM" Classes="eyebrow" />
                          <TextBlock x:Name="ServerOperatingSystemText" Text="--" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                      <Border Classes="inset">
                        <StackPanel>
                          <TextBlock Text="KERNEL" Classes="eyebrow" />
                          <TextBlock x:Name="ServerKernelText" Text="--" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Classes="inset">
                        <StackPanel>
                          <TextBlock Text="UPTIME" Classes="eyebrow" />
                          <TextBlock x:Name="ServerUptimeText" Text="--" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                      <Border Classes="inset">
                        <StackPanel>
                          <TextBlock Text="CPU" Classes="eyebrow" />
                          <TextBlock x:Name="ServerCpuText" Text="--" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Classes="inset">
                        <StackPanel>
                          <TextBlock Text="MEMORY" Classes="eyebrow" />
                          <TextBlock x:Name="ServerMemoryText" Text="--" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <Border Classes="inset">
                      <StackPanel>
                        <TextBlock Text="SIGNAL QUALITY" Classes="eyebrow" />
                        <TextBlock
                            x:Name="ServerSignalQualityText"
                            Text="Signal-quality policy will update after capture."
                            Classes="muted"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Classes="inset">
                      <Grid RowDefinitions="Auto,*" RowSpacing="6">
                        <StackPanel>
                          <TextBlock Text="Detected integrations" Classes="sectionTitle" />
                          <TextBlock
                              Text="Save and select a target before running detection."
                              Classes="pageSubtitle"
                              TextWrapping="Wrap" />
                        </StackPanel>
                        <ListBox
                            Grid.Row="1"
                            x:Name="ServerDetectedIntegrationsList"
                            Classes="dataList"
                            MinHeight="100"
                            MaxHeight="230" />
                      </Grid>
                    </Border>

                    <Border Classes="arrStatusBar">
                      <TextBlock
                          x:Name="ServerNetworkText"
                          Text="Addresses unavailable."
                          Classes="dim"
                          TextWrapping="Wrap" />
                    </Border>

                    <ListBox
                        x:Name="ServerLanCandidatesList"
                        IsVisible="False"
                        SelectionChanged="ServerLanCandidatesList_OnSelectionChanged" />
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Grid>
            <!-- Windows-reference Media Hub -->
            <Grid
                x:Name="MediaHubPage"
                IsVisible="False">

              <ScrollViewer
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="12" Margin="0,0,4,4">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,1">
                    <StackPanel>
                      <TextBlock Text="Media operations" Classes="pageTitle" />
                      <TextBlock
                          Text="Live application health and launcher ownership from the active server."
                          Classes="pageSubtitle"
                          Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8">
                      <TextBlock
                          x:Name="MediaHubSampleAgeText"
                          Text="Waiting for environment capture"
                          Classes="dim"
                          VerticalAlignment="Center"
                          Margin="0,0,4,0" />
                      <Button
                          x:Name="MediaModeFleetButton"
                          Classes="mediaMode selected"
                          Content="Fleet overview"
                          Click="MediaModeFleetButton_OnClick" />
                      <Button
                          x:Name="MediaModeLauncherButton"
                          Classes="mediaMode"
                          Content="Identity registry"
                          Click="MediaModeLauncherButton_OnClick" />
                      <Button
                          x:Name="MediaHubRefreshButton"
                          Classes="primary compact"
                          Content="Refresh telemetry"
                          MinWidth="130"
                          Click="MediaHubRefreshButton_OnClick" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Border Classes="flatCard mediaMetric">
                      <StackPanel>
                        <TextBlock Text="HEALTHY" Classes="eyebrow" />
                        <TextBlock
                            x:Name="MediaHealthyMetricText"
                            Text="0"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SuccessBrush}"
                            Margin="0,7,0,0" />
                        <TextBlock
                            Text="Applications operating normally"
                            Classes="muted"
                            FontSize="10"
                            Margin="0,2,0,0" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="flatCard mediaMetric">
                      <StackPanel>
                        <TextBlock Text="DEGRADED / BUSY" Classes="eyebrow" />
                        <TextBlock
                            x:Name="MediaAttentionMetricText"
                            Text="0"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource WarnBrush}"
                            Margin="0,7,0,0" />
                        <TextBlock
                            Text="Reachable but needs attention"
                            Classes="muted"
                            FontSize="10"
                            Margin="0,2,0,0" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="flatCard mediaMetric">
                      <StackPanel>
                        <TextBlock Text="OFFLINE" Classes="eyebrow" />
                        <TextBlock
                            x:Name="MediaOfflineMetricText"
                            Text="0"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource DangerBrush}"
                            Margin="0,7,0,0" />
                        <TextBlock
                            Text="No verified application response"
                            Classes="muted"
                            FontSize="10"
                            Margin="0,2,0,0" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Classes="flatCard mediaMetric">
                      <StackPanel>
                        <TextBlock Text="TARGET" Classes="eyebrow" />
                        <TextBlock
                            x:Name="MediaTargetMetricText"
                            Text="--"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Margin="0,7,0,0"
                            TextWrapping="Wrap"
                            MaxHeight="48" />
                        <TextBlock
                            Text="Uses active control-plane context"
                            Classes="muted"
                            FontSize="10"
                            Margin="0,2,0,0" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid
                      x:Name="MediaFleetOverviewPanel"
                      RowDefinitions="Auto,*"
                      RowSpacing="10">

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <StackPanel>
                        <TextBlock Text="Application health" Classes="sectionTitle" />
                        <TextBlock
                            Text="Applications are grouped by category and product; each verified runtime stays visible as a compact instance row."
                            Classes="pageSubtitle"
                            Margin="0,3,0,0"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="MediaFleetGroupingSummaryText"
                            Text="Waiting for grouped fleet projection."
                            Classes="dim"
                            FontSize="9.5"
                            Margin="0,3,0,0" />
                      </StackPanel>

                      <TextBox
                          Grid.Column="1"
                          x:Name="MediaFilterText"
                          Classes="filter"
                          Width="240"
                          PlaceholderText="Filter applications"
                          TextChanged="MediaFilterText_OnTextChanged" />

                      <Button
                          Grid.Column="2"
                          x:Name="MediaHubShowHiddenButton"
                          Classes="compact"
                          Content="Show hidden"
                          Click="MediaHubShowHiddenButton_OnClick" />
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        x:Name="MediaCategoryGroupsScrollViewer"
                        MaxHeight="520"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl
                          x:Name="MediaCategoryGroupsList"
                          Margin="0,0,4,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <StackPanel Spacing="8" Margin="0,0,0,9">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel>
                                  <TextBlock
                                      Text="{ReflectionBinding Category}"
                                      FontSize="14"
                                      FontWeight="SemiBold" />
                                  <TextBlock
                                      Text="{ReflectionBinding Summary}"
                                      Classes="muted"
                                      FontSize="10"
                                      Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{ReflectionBinding ProductCountText}"
                                    Classes="dim"
                                    FontSize="10"
                                    VerticalAlignment="Center" />
                              </Grid>

                              <ItemsControl
                                  ItemsSource="{ReflectionBinding Products}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:CompileBindings="False">
                                    <Border Classes="mediaProductCard">
                                      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="9">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                          <StackPanel>
                                            <TextBlock
                                                Text="{ReflectionBinding ProductName}"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{ReflectionBinding InstanceCountText}"
                                                Classes="muted"
                                                FontSize="10"
                                                Margin="0,2,0,0" />
                                          </StackPanel>
                                          <Border
                                              Grid.Column="1"
                                              Classes="badge"
                                              Background="{ReflectionBinding StateBackground}">
                                            <TextBlock
                                                Text="{ReflectionBinding StateLabel}"
                                                Foreground="{ReflectionBinding StateForeground}"
                                                FontSize="10"
                                                FontWeight="SemiBold" />
                                          </Border>
                                        </Grid>

                                        <ItemsControl
                                            Grid.Row="1"
                                            ItemsSource="{ReflectionBinding Instances}">
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate x:CompileBindings="False">
                                              <Border Classes="mediaInstanceRow">
                                                <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock
                                                        Text="{ReflectionBinding DisplayName}"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Border
                                                        Grid.Column="1"
                                                        Classes="compactStateBadge"
                                                        Background="{ReflectionBinding StateBackground}">
                                                      <TextBlock
                                                          Text="{ReflectionBinding StateLabel}"
                                                          Foreground="{ReflectionBinding StateForeground}"
                                                          FontSize="9"
                                                          FontWeight="SemiBold" />
                                                    </Border>
                                                  </Grid>
                                                  <Grid
                                                      Grid.Row="1"
                                                      ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="10">
                                                    <TextBlock
                                                        Text="{ReflectionBinding MetaText}"
                                                        Classes="dim"
                                                        FontSize="9.5"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{ReflectionBinding EndpointText}"
                                                        Classes="muted"
                                                        FontSize="9.5"
                                                        HorizontalAlignment="Right"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip.Tip="{ReflectionBinding FullEndpointText}" />
                                                  </Grid>
                                                </Grid>
                                              </Border>
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid
                                            Grid.Row="2"
                                            ColumnDefinitions="*,Auto,Auto"
                                            ColumnSpacing="7">
                                          <TextBlock
                                              Text="{ReflectionBinding SummaryText}"
                                              Classes="dim"
                                              FontSize="9.5"
                                              VerticalAlignment="Center"
                                              TextTrimming="CharacterEllipsis" />
                                          <Button
                                              Grid.Column="1"
                                              Classes="compact mediaGroupAction"
                                              Content="Identity"
                                              Tag="{ReflectionBinding PrimarySourceKey}"
                                              Click="MediaGroupIdentityButton_OnClick" />
                                          <Button
                                              Grid.Column="2"
                                              Classes="compact mediaGroupAction"
                                              Content="{ReflectionBinding OpenLabel}"
                                              Tag="{ReflectionBinding ProductName}"
                                              Click="MediaCardOpenButton_OnClick" />
                                        </Grid>
                                      </Grid>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <!-- Hidden selection contract retained for generic integration detail code. -->
                    <ListBox
                        x:Name="IntegrationsList"
                        IsVisible="False"
                        SelectionChanged="IntegrationsList_OnSelectionChanged" />

                    <Border
                        Grid.Row="1"
                        x:Name="MediaHubEmptyState"
                        Classes="plexEmpty"
                        IsVisible="False"
                        VerticalAlignment="Top">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            Text="✓"
                            Foreground="{DynamicResource SuccessBrush}"
                            FontSize="22"
                            VerticalAlignment="Center" />
                        <StackPanel>
                          <TextBlock Text="No matching applications" FontWeight="SemiBold" />
                          <TextBlock
                              Text="Clear the filter or show hidden launchers to restore the full fleet."
                              Classes="muted"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid
                      x:Name="MediaLauncherSettingsPanel"
                      IsVisible="False"
                      ColumnDefinitions="1.15*,430"
                      ColumnSpacing="10"
                      MinHeight="540">

                    <Border Classes="flatCard mediaLauncherPanel">
                      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="Application identity registry" Classes="sectionTitle" />
                            <TextBlock
                                Text="Logical application type, stable runtime owner, role, endpoint and operator overrides remain separate."
                                Classes="pageSubtitle"
                                Margin="0,3,0,0"
                                TextWrapping="Wrap" />
                          </StackPanel>
                          <TextBlock
                              Grid.Column="1"
                              x:Name="MediaLauncherStorePathText"
                              Text="--"
                              Classes="dim"
                              FontSize="9.5"
                              VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis"
                              MaxWidth="420" />
                        </Grid>

                        <Border Grid.Row="1" Classes="inset">
                          <TextBlock
                              x:Name="IdentityRegistrySummaryText"
                              Text="Waiting for identity resolution."
                              Classes="muted"
                              TextWrapping="Wrap" />
                        </Border>

                        <ListBox
                            Grid.Row="2"
                            x:Name="MediaLauncherSettingsList"
                            Classes="mediaLauncherList"
                            SelectionChanged="MediaLauncherSettingsList_OnSelectionChanged">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                              <Grid ColumnDefinitions="1.05*,0.7*,0.9*,1.45*,Auto" ColumnSpacing="10">
                                <TextBlock
                                    Text="{ReflectionBinding DisplayName}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip.Tip="{ReflectionBinding SourceKey}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{ReflectionBinding Product}"
                                    Classes="muted"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{ReflectionBinding Role}"
                                    Classes="muted"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{ReflectionBinding SourceSummary}"
                                    Classes="dim"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip.Tip="{ReflectionBinding SourceSummary}" />
                                <TextBlock
                                    Grid.Column="4"
                                    Text="{ReflectionBinding VerificationLabel}"
                                    Foreground="{DynamicResource AccentBrush}" />
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="flatCard mediaLauncherPanel">
                      <ScrollViewer
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="9" Margin="0,0,4,0">
                          <StackPanel>
                            <TextBlock Text="Edit identity" Classes="sectionTitle" />
                            <TextBlock
                                x:Name="MediaLauncherSelectedText"
                                Text="Select a detected source."
                                Classes="muted"
                                Margin="0,3,0,0"
                                TextWrapping="Wrap" />
                          </StackPanel>

                          <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                            <StackPanel>
                              <TextBlock Text="Application type" Classes="eyebrow" Margin="0,0,0,4" />
                              <ComboBox x:Name="IdentityProductComboBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="Role" Classes="eyebrow" Margin="0,0,0,4" />
                              <ComboBox x:Name="IdentityRoleComboBox" />
                            </StackPanel>
                          </Grid>

                          <StackPanel>
                            <TextBlock Text="API / protocol" Classes="eyebrow" Margin="0,0,0,4" />
                            <TextBox
                                x:Name="IdentityProtocolTextBox"
                                PlaceholderText="Examples: Native API, qBittorrent-compatible API, supporting dependency" />
                          </StackPanel>

                          <StackPanel>
                            <TextBlock Text="Display name" Classes="eyebrow" Margin="0,0,0,4" />
                            <TextBox x:Name="MediaLauncherDisplayNameTextBox" />
                          </StackPanel>

                          <StackPanel>
                            <TextBlock Text="Parent / owning application" Classes="eyebrow" Margin="0,0,0,4" />
                            <ComboBox x:Name="IdentityParentComboBox" />
                          </StackPanel>

                          <StackPanel>
                            <TextBlock Text="Verified URL override" Classes="eyebrow" Margin="0,0,0,4" />
                            <TextBox
                                x:Name="MediaLauncherUrlTextBox"
                                PlaceholderText="Leave blank to retain detected or suggested endpoint" />
                          </StackPanel>

                          <StackPanel>
                            <TextBlock Text="Category" Classes="eyebrow" Margin="0,0,0,4" />
                            <TextBox x:Name="MediaLauncherCategoryTextBox" />
                          </StackPanel>

                          <Border Classes="inset">
                            <StackPanel Spacing="7">
                              <CheckBox
                                  x:Name="IdentityOwnsHealthCheckBox"
                                  Content="Use this source as an application health owner" />
                              <CheckBox
                                  x:Name="IdentityShowNavigationCheckBox"
                                  Content="Show application in GraveOps navigation" />
                              <CheckBox
                                  x:Name="MediaLauncherVisibleCheckBox"
                                  Content="Show instance in Media Hub"
                                  IsChecked="True" />
                            </StackPanel>
                          </Border>

                          <Border Classes="inset">
                            <StackPanel Spacing="4">
                              <TextBlock Text="DETECTED CONTEXT" Classes="eyebrow" />
                              <TextBlock
                                  x:Name="IdentityVerificationText"
                                  Text="--"
                                  FontWeight="SemiBold"
                                  TextWrapping="Wrap" />
                              <TextBlock
                                  x:Name="MediaLauncherDetectedText"
                                  Text="--"
                                  Classes="muted"
                                  TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>

                          <TextBlock
                              x:Name="MediaLauncherStatusText"
                              Text="Select a source to inspect or override its identity."
                              Classes="dim"
                              TextWrapping="Wrap" />

                          <WrapPanel>
                            <Button
                                x:Name="MediaLauncherSaveButton"
                                Classes="primary compact"
                                Content="Confirm and save"
                                MinWidth="112"
                                Margin="0,0,8,8"
                                Click="MediaLauncherSaveButton_OnClick" />
                            <Button
                                x:Name="MediaLauncherResetButton"
                                Classes="compact"
                                Content="Reset automatic"
                                MinWidth="108"
                                Margin="0,0,8,8"
                                Click="MediaLauncherResetButton_OnClick" />
                            <Button
                                x:Name="MediaLauncherOpenButton"
                                Classes="compact"
                                Content="Open selected"
                                Margin="0,0,0,8"
                                Click="MediaLauncherOpenButton_OnClick" />
                          </WrapPanel>
                        </StackPanel>
                      </ScrollViewer>
                    </Border>
                  </Grid>

                  <!-- Existing integration detail contract remains available to generic code. -->
                  <Border IsVisible="False">
                    <StackPanel>
                      <TextBlock x:Name="MediaHubSummaryText" />
                      <TextBlock x:Name="IntegrationNameText" />
                      <TextBlock x:Name="IntegrationRuntimeText" />
                      <Border x:Name="IntegrationStateBorder"><TextBlock x:Name="IntegrationStateText" /></Border>
                      <TextBlock x:Name="IntegrationKindText" />
                      <TextBlock x:Name="IntegrationEndpointText" />
                      <TextBlock x:Name="IntegrationRoleText" />
                      <TextBlock x:Name="IntegrationFindingsSummaryText" />
                      <TextBlock x:Name="IntegrationEvidenceText" />
                      <TextBlock x:Name="IntegrationFindingsText" />
                      <Button x:Name="OpenIntegrationButton" Click="OpenIntegrationButton_OnClick" />
                      <Button x:Name="IntegrationFindingsButton" Click="IntegrationFindingsButton_OnClick" />
                      <TextBlock x:Name="IntegrationActionStatusText" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- Dedicated Windows-reference Plex workspace -->
            <Grid
                x:Name="PlexWorkspacePage"
                IsVisible="False">

              <ScrollViewer
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="12" Margin="0,0,4,4">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,1">
                    <StackPanel>
                      <TextBlock Text="Plex" Classes="pageTitle" />
                      <TextBlock
                          Text="Library availability, live sessions, playback decisions and guarded operations."
                          Classes="pageSubtitle"
                          Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10">
                      <StackPanel VerticalAlignment="Center" Margin="0,0,3,0">
                        <TextBlock
                            x:Name="PlexTargetText"
                            Text="--"
                            HorizontalAlignment="Right"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="PlexFreshnessText"
                            Text="CHECKING..."
                            Classes="dim"
                            FontSize="10"
                            HorizontalAlignment="Right"
                            Margin="0,2,0,0" />
                      </StackPanel>

                      <Button
                          x:Name="PlexRefreshButton"
                          Classes="primary compact"
                          Content="Refresh"
                          MinWidth="96"
                          Click="PlexRefreshButton_OnClick" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Border Classes="flatCard plexMetric">
                      <StackPanel>
                        <TextBlock Text="SERVICE" Classes="eyebrow" />
                        <TextBlock
                            x:Name="PlexServiceText"
                            Text="CHECKING"
                            FontSize="23"
                            FontWeight="SemiBold"
                            Margin="0,8,0,0"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="PlexServiceDetailText"
                            Text="systemd or container ownership"
                            Classes="dim"
                            FontSize="10"
                            Margin="0,3,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="flatCard plexMetric">
                      <StackPanel>
                        <TextBlock Text="PLEX VERSION" Classes="eyebrow" />
                        <TextBlock
                            x:Name="PlexVersionText"
                            Text="--"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Margin="0,8,0,0"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="From the local Plex identity endpoint"
                            Classes="dim"
                            FontSize="10"
                            Margin="0,3,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="flatCard plexMetric">
                      <StackPanel>
                        <TextBlock Text="ENDPOINT" Classes="eyebrow" />
                        <TextBlock
                            x:Name="PlexEndpointText"
                            Text="--"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Margin="0,8,0,0"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <TextBlock
                            x:Name="PlexConnectionText"
                            Text="Waiting for identity probe"
                            Classes="dim"
                            FontSize="10"
                            Margin="0,3,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Classes="flatCard plexMetric">
                      <StackPanel>
                        <TextBlock Text="DEPENDENCY" Classes="eyebrow" />
                        <TextBlock
                            x:Name="PlexDependencyText"
                            Text="--"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Margin="0,8,0,0"
                            TextWrapping="Wrap"
                            MaxHeight="48" />
                        <TextBlock
                            Text="DUMB and library-path context"
                            Classes="dim"
                            FontSize="10"
                            Margin="0,3,0,0" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Border Classes="inset plexOperations">
                    <StackPanel Spacing="10">
                      <StackPanel>
                        <TextBlock Text="Plex operations" Classes="sectionTitle" />
                        <TextBlock
                            Text="Routine Plex management stays inline. Restart remains confirmation-gated and respects Safe Mode."
                            Classes="pageSubtitle"
                            Margin="0,3,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>

                      <WrapPanel>
                        <Button
                            x:Name="PlexOpenButton"
                            Classes="primary plexAction"
                            Content="Open Plex"
                            Margin="0,0,8,0"
                            Click="PlexOpenButton_OnClick" />
                        <Button
                            x:Name="PlexRestartButton"
                            Classes="plexAction"
                            Content="Restart Plex"
                            Margin="0,0,8,0"
                            Click="PlexRestartButton_OnClick" />
                        <Button
                            Classes="plexAction"
                            Content="Plex logs"
                            Margin="0,0,8,0"
                            Click="PlexLogsButton_OnClick" />
                        <Button
                            Classes="plexAction"
                            Content="SSH terminal"
                            Margin="0,0,8,0"
                            Click="PlexTerminalButton_OnClick" />
                        <Button
                            Classes="plexAction"
                            Content="Intelligence"
                            Click="PlexIntelligenceButton_OnClick" />
                      </WrapPanel>

                      <TextBlock
                          x:Name="PlexOperationsStatusText"
                          Text="Waiting for Plex discovery."
                          Classes="dim"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Border Classes="inset">
                      <StackPanel>
                        <TextBlock Text="ACTIVE SESSIONS" Classes="eyebrow" />
                        <TextBlock
                            x:Name="PlexActiveSessionsText"
                            Text="--"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Margin="0,6,0,0" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="inset">
                      <StackPanel>
                        <TextBlock Text="DIRECT PLAY" Classes="eyebrow" />
                        <TextBlock
                            x:Name="PlexDirectPlayText"
                            Text="--"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SuccessBrush}"
                            Margin="0,6,0,0" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="inset">
                      <StackPanel>
                        <TextBlock Text="TRANSCODING" Classes="eyebrow" />
                        <TextBlock
                            x:Name="PlexTranscodeText"
                            Text="--"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource WarnBrush}"
                            Margin="0,6,0,0" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Classes="inset">
                      <StackPanel>
                        <TextBlock Text="LIBRARIES" Classes="eyebrow" />
                        <TextBlock
                            x:Name="PlexLibrariesText"
                            Text="--"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Margin="0,6,0,0" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Classes="flatCard plexAnalytics">
                      <StackPanel>
                        <TextBlock Text="Playback analytics" Classes="sectionTitle" />
                        <TextBlock
                            x:Name="PlexPlaybackAnalyticsText"
                            Text="Waiting for live session telemetry..."
                            Classes="muted"
                            Margin="0,8,0,0"
                            TextWrapping="Wrap"
                            LineHeight="20" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="flatCard plexAnalytics">
                      <StackPanel>
                        <TextBlock Text="Server context" Classes="sectionTitle" />
                        <TextBlock
                            x:Name="PlexServerContextText"
                            Text="Waiting for Plex identity and library context..."
                            Classes="muted"
                            Margin="0,8,0,0"
                            TextWrapping="Wrap"
                            LineHeight="20" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Border Classes="flatCard plexSessionPanel">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="Session analytics" Classes="sectionTitle" />
                          <TextBlock
                              Text="Current viewers, players, progress, playback decisions, bandwidth and transcode context."
                              Classes="pageSubtitle"
                              Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            x:Name="PlexSessionCountText"
                            Text="--"
                            Classes="dim"
                            VerticalAlignment="Center" />
                      </Grid>

                      <ScrollViewer
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                        <StackPanel MinWidth="1420" Spacing="0">
                          <Border Classes="plexTableHeader">
                            <Grid ColumnDefinitions="330,130,180,90,110,115,115,110,250" ColumnSpacing="10">
                              <TextBlock Text="ITEM" Classes="downloadHeader" />
                              <TextBlock Grid.Column="1" Text="USER" Classes="downloadHeader" />
                              <TextBlock Grid.Column="2" Text="PLAYER" Classes="downloadHeader" />
                              <TextBlock Grid.Column="3" Text="STATE" Classes="downloadHeader" />
                              <TextBlock Grid.Column="4" Text="PROGRESS" Classes="downloadHeader downloadHeaderNumeric" />
                              <TextBlock Grid.Column="5" Text="VIDEO" Classes="downloadHeader" />
                              <TextBlock Grid.Column="6" Text="AUDIO" Classes="downloadHeader" />
                              <TextBlock Grid.Column="7" Text="BANDWIDTH" Classes="downloadHeader downloadHeaderNumeric" />
                              <TextBlock Grid.Column="8" Text="DETAIL" Classes="downloadHeader" />
                            </Grid>
                          </Border>

                          <ListBox
                              x:Name="PlexSessionsList"
                              Classes="plexSessions"
                              MaxHeight="330">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="330,130,180,90,110,115,115,110,250" ColumnSpacing="10">
                                  <TextBlock
                                      Text="{ReflectionBinding Title}"
                                      ToolTip.Tip="{ReflectionBinding Title}"
                                      Classes="downloadNameCell"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="1"
                                      Text="{ReflectionBinding User}"
                                      ToolTip.Tip="{ReflectionBinding User}"
                                      Classes="downloadCell muted"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="2"
                                      Text="{ReflectionBinding Player}"
                                      ToolTip.Tip="{ReflectionBinding Player}"
                                      Classes="downloadCell"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="3"
                                      Text="{ReflectionBinding State}"
                                      Classes="downloadCell"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="4"
                                      Text="{ReflectionBinding Progress}"
                                      Classes="downloadCell downloadNumericCell"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="5"
                                      Text="{ReflectionBinding VideoDecision}"
                                      Classes="downloadCell"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="6"
                                      Text="{ReflectionBinding AudioDecision}"
                                      Classes="downloadCell"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="7"
                                      Text="{ReflectionBinding Bandwidth}"
                                      Classes="downloadCell downloadNumericCell"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="8"
                                      Text="{ReflectionBinding Detail}"
                                      ToolTip.Tip="{ReflectionBinding Detail}"
                                      Classes="downloadCell muted"
                                      TextTrimming="CharacterEllipsis" />
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </StackPanel>
                      </ScrollViewer>

                      <Border
                          x:Name="PlexSessionsEmptyState"
                          Classes="plexEmpty">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock
                              Text="✓"
                              Foreground="{DynamicResource SuccessBrush}"
                              FontSize="22"
                              VerticalAlignment="Center" />
                          <StackPanel>
                            <TextBlock Text="No active Plex sessions" FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="PlexSessionsEmptyText"
                                Text="No viewers are currently streaming from this Plex server."
                                Classes="muted"
                                TextWrapping="Wrap" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>

                  <Border Classes="plexStatus">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock
                            x:Name="PlexSecurityText"
                            Text="Session telemetry uses a token only on the target Linux host; the token is never returned to GraveOps."
                            Classes="muted"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PlexStatusText"
                            Text="Waiting for Plex telemetry."
                            Classes="dim"
                            FontSize="10"
                            Margin="0,3,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock
                          Grid.Column="1"
                          Text="READ-ONLY SESSION DATA"
                          Classes="eyebrow"
                          Foreground="{DynamicResource AccentBrush}"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0" />
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- Dedicated direct application workspace -->
            <Grid
                x:Name="ApplicationWorkspacePage"
                IsVisible="False"
                RowDefinitions="Auto,Auto,Auto,Auto,*"
                RowSpacing="9">

              <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="DirectIntegrationNameText" Text="Application" Classes="sectionTitle" FontSize="18" />
                  <TextBlock x:Name="DirectIntegrationSubtitleText" Text="Verified application state and operational ownership." Classes="pageSubtitle" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="LIVE CONTEXT" Classes="eyebrow" VerticalAlignment="Center" />
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Classes="metric">
                  <StackPanel Spacing="3"><TextBlock Text="STATE" Classes="eyebrow" /><Border x:Name="DirectIntegrationStateBorder" Classes="badge" HorizontalAlignment="Left"><TextBlock x:Name="DirectIntegrationStateText" Text="WAITING" FontWeight="SemiBold" /></Border></StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="metric">
                  <StackPanel Spacing="3"><TextBlock Text="RUNTIME" Classes="eyebrow" /><TextBlock x:Name="DirectIntegrationRuntimeText" Text="--" FontSize="14" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="metric">
                  <StackPanel Spacing="3"><TextBlock Text="ROLE" Classes="eyebrow" /><TextBlock x:Name="DirectIntegrationRoleText" Text="--" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="metric">
                  <StackPanel Spacing="3"><TextBlock Text="ACTIVE FINDINGS" Classes="eyebrow" /><TextBlock x:Name="DirectIntegrationFindingsText" Text="0" Classes="metricValue" /></StackPanel>
                </Border>
              </Grid>

              <Border Grid.Row="2" Classes="module">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                  <StackPanel>
                    <TextBlock Text="Operations" Classes="sectionTitle" />
                    <TextBlock Text="Common work stays on this page; Docker, logs and Intelligence remain one click away." Classes="pageSubtitle" />
                  </StackPanel>
                  <WrapPanel Grid.Row="1">
                    <Button x:Name="DirectIntegrationOpenButton" Content="Open application" Classes="primary" Margin="0,0,5,0" Click="DirectIntegrationOpenButton_OnClick" />
                    <Button Content="Docker / dependencies" Margin="0,0,5,0" Click="DirectIntegrationDockerButton_OnClick" />
                    <Button Content="Logs" Margin="0,0,5,0" Click="DirectIntegrationLogsButton_OnClick" />
                    <Button x:Name="DirectIntegrationIntelligenceButton" Content="Intelligence" Click="DirectIntegrationIntelligenceButton_OnClick" />
                  </WrapPanel>
                </Grid>
              </Border>

              <Border Grid.Row="3" Classes="module">
                <Grid ColumnDefinitions="1.1*,1.1*,1.3*,Auto" ColumnSpacing="10">
                  <StackPanel><TextBlock Text="APPLICATION" Classes="eyebrow" /><TextBlock x:Name="DirectIntegrationPrimaryTitleText" Text="Application readiness" FontWeight="SemiBold" /></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="ENDPOINT" Classes="eyebrow" /><TextBlock x:Name="DirectIntegrationEndpointText" Text="--" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="OWNERSHIP" Classes="eyebrow" /><TextBlock x:Name="DirectIntegrationSecondaryTitleText" Text="Dependencies" FontWeight="SemiBold" /><TextBlock x:Name="DirectIntegrationOwnerText" Text="--" Classes="dim" TextTrimming="CharacterEllipsis" /></StackPanel>
                  <TextBlock Grid.Column="3" Text="Verified" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Grid Grid.Row="4" ColumnDefinitions="1.25*,0.75*" ColumnSpacing="8">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="6">
                    <StackPanel>
                      <TextBlock Text="Evidence" Classes="sectionTitle" />
                      <TextBlock Text="Runtime, endpoint and provider evidence for the selected application." Classes="pageSubtitle" />
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="DirectIntegrationEvidenceText" Classes="console" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
                  </Grid>
                </Border>
                <Border Grid.Column="1" Classes="module">
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                    <StackPanel>
                      <TextBlock Text="Related context" Classes="sectionTitle" />
                      <TextBlock Text="Findings and safe next-page handoff." Classes="pageSubtitle" />
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="DirectIntegrationRelatedText" Classes="console" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" x:Name="DirectIntegrationOperationsText" Text="Waiting for application selection." Classes="dim" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </Grid>
            </Grid>
            <!-- Windows-reference download client workspace -->
            <Grid
                x:Name="DownloadClientWorkspacePage"
                IsVisible="False">

              <ScrollViewer
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="12" Margin="0,0,4,4">
                  <!-- DownloadClientView heading -->
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,1">
                    <StackPanel>
                      <TextBlock
                          x:Name="DownloadClientHeadingText"
                          Text="Download client"
                          Classes="pageTitle" />
                      <TextBlock
                          x:Name="DownloadClientDescriptionText"
                          Text="Live download analytics and current work."
                          Classes="pageSubtitle"
                          Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10">

                      <StackPanel VerticalAlignment="Center" Margin="0,0,3,0">
                        <TextBlock
                            x:Name="DownloadClientTargetText"
                            Text="--"
                            HorizontalAlignment="Right"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="DownloadClientFreshnessText"
                            Text="CHECKING..."
                            Classes="dim"
                            FontSize="10"
                            HorizontalAlignment="Right"
                            Margin="0,2,0,0" />
                      </StackPanel>

                      <Button
                          x:Name="DownloadClientRefreshButton"
                          Classes="primary compact"
                          Content="Refresh"
                          MinWidth="96"
                          Click="DownloadClientRefreshButton_OnClick" />
                    </StackPanel>
                  </Grid>

                  <!-- Windows four-card client summary -->
                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Border Classes="flatCard downloadMetric">
                      <StackPanel>
                        <TextBlock Text="STATE" Classes="eyebrow" />
                        <TextBlock
                            x:Name="DownloadClientStateText"
                            Text="CHECKING"
                            FontSize="23"
                            FontWeight="SemiBold"
                            Margin="0,8,0,0"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="DownloadClientSecurityText"
                            Text="Protected local telemetry"
                            Classes="dim"
                            FontSize="10"
                            Margin="0,3,0,0"
                            TextWrapping="Wrap"
                            MaxHeight="36" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="flatCard downloadMetric">
                      <StackPanel>
                        <TextBlock Text="VERSION" Classes="eyebrow" />
                        <TextBlock
                            x:Name="DownloadClientVersionText"
                            Text="--"
                            FontSize="21"
                            FontWeight="SemiBold"
                            Margin="0,8,0,0"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="DownloadClientConnectionText"
                            Text="--"
                            Classes="dim"
                            FontSize="10"
                            Margin="0,3,0,0"
                            TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="flatCard downloadMetric">
                      <StackPanel>
                        <TextBlock Text="ACTIVE" Classes="eyebrow" />
                        <TextBlock
                            x:Name="DownloadClientActiveText"
                            Text="--"
                            FontSize="23"
                            FontWeight="SemiBold"
                            Margin="0,8,0,0" />
                        <TextBlock
                            x:Name="DownloadClientActiveDetailText"
                            Text="Telemetry pending"
                            Classes="dim"
                            FontSize="10"
                            Margin="0,3,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Classes="flatCard downloadMetric">
                      <StackPanel>
                        <TextBlock
                            x:Name="DownloadClientItemsLabelText"
                            Text="ITEMS"
                            Classes="eyebrow" />
                        <TextBlock
                            x:Name="DownloadClientItemsText"
                            Text="--"
                            FontSize="23"
                            FontWeight="SemiBold"
                            Margin="0,8,0,0" />
                        <TextBlock
                            x:Name="DownloadClientItemsDetailText"
                            Text="Telemetry pending"
                            Classes="dim"
                            FontSize="10"
                            Margin="0,3,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <!-- Transfer metric strip -->
                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Border Classes="inset downloadInsetMetric">
                      <StackPanel>
                        <TextBlock
                            x:Name="DownloadClientMetric1LabelText"
                            Text="DOWNLOAD"
                            Classes="eyebrow" />
                        <TextBlock
                            x:Name="DownloadClientMetric1ValueText"
                            Text="--"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Margin="0,6,0,0"
                            TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="inset downloadInsetMetric">
                      <StackPanel>
                        <TextBlock
                            x:Name="DownloadClientMetric2LabelText"
                            Text="UPLOAD"
                            Classes="eyebrow" />
                        <TextBlock
                            x:Name="DownloadClientMetric2ValueText"
                            Text="--"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Margin="0,6,0,0"
                            TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="inset downloadInsetMetric">
                      <StackPanel>
                        <TextBlock
                            x:Name="DownloadClientMetric3LabelText"
                            Text="REMAINING"
                            Classes="eyebrow" />
                        <TextBlock
                            x:Name="DownloadClientMetric3ValueText"
                            Text="--"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Margin="0,6,0,0"
                            TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Classes="inset downloadInsetMetric">
                      <StackPanel>
                        <TextBlock
                            x:Name="DownloadClientMetric4LabelText"
                            Text="TIME"
                            Classes="eyebrow" />
                        <TextBlock
                            x:Name="DownloadClientMetric4ValueText"
                            Text="--"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Margin="0,6,0,0"
                            TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <!-- Explicit operations -->
                  <Border Classes="inset downloadOperations">
                    <StackPanel Spacing="10">
                      <StackPanel>
                        <TextBlock Text="Operations" Classes="sectionTitle" />
                        <TextBlock
                            x:Name="DownloadClientOperationsHintText"
                            Text="Read-only analytics are automatic; operational handoffs stay explicit."
                            Classes="pageSubtitle"
                            Margin="0,3,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>

                      <WrapPanel>
                        <Button
                            x:Name="DownloadClientOpenButton"
                            Classes="primary downloadAction"
                            Content="Open Web UI"
                            Margin="0,0,8,0"
                            Click="DownloadClientOpenButton_OnClick" />
                        <Button
                            x:Name="DownloadClientDockerButton"
                            Classes="downloadAction"
                            Content="Docker / container"
                            Margin="0,0,8,0"
                            Click="DownloadClientDockerButton_OnClick" />
                        <Button
                            Classes="downloadAction"
                            Content="Logs"
                            Margin="0,0,8,0"
                            Click="DownloadClientLogsButton_OnClick" />
                        <Button
                            Classes="downloadAction"
                            Content="SSH terminal"
                            Click="DownloadClientTerminalButton_OnClick" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <!-- Analytics pair -->
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Classes="flatCard downloadAnalytics">
                      <StackPanel>
                        <TextBlock Text="Transfer analytics" Classes="sectionTitle" />
                        <TextBlock
                            x:Name="DownloadClientTransferAnalyticsText"
                            Text="Waiting for live telemetry..."
                            Classes="muted"
                            Margin="0,8,0,0"
                            TextWrapping="Wrap"
                            LineHeight="20" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="flatCard downloadAnalytics">
                      <StackPanel>
                        <TextBlock Text="Workload analytics" Classes="sectionTitle" />
                        <TextBlock
                            x:Name="DownloadClientWorkloadAnalyticsText"
                            Text="Waiting for live telemetry..."
                            Classes="muted"
                            Margin="0,8,0,0"
                            TextWrapping="Wrap"
                            LineHeight="20" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <!-- Current work -->
                  <Border Classes="flatCard downloadTablePanel">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              x:Name="DownloadClientCurrentWorkHeadingText"
                              Text="Current downloads"
                              Classes="sectionTitle" />
                          <TextBlock
                              x:Name="DownloadClientCurrentWorkHintText"
                              Text="Progress, transfer rate, remaining work and ETA from the live client."
                              Classes="pageSubtitle"
                              Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            x:Name="DownloadClientQueueCountText"
                            Text="--"
                            Classes="dim"
                            VerticalAlignment="Center" />
                      </Grid>

                      <ScrollViewer
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                        <Grid>

                          <!-- qBittorrent keeps torrent-specific columns while sharing the table engine. -->
                        <StackPanel
                            x:Name="DownloadClientQbitQueueTable"
                            MinWidth="1640"
                            Spacing="0">

                          <Border Classes="downloadTableHeader">
                            <Grid ColumnDefinitions="390,120,110,140,100,115,100,100,85,75,110,135" ColumnSpacing="10">
                              <TextBlock Text="ITEM" Classes="downloadHeader" />
                              <TextBlock Grid.Column="1" Text="CATEGORY" Classes="downloadHeader" />
                              <TextBlock Grid.Column="2" Text="STATE" Classes="downloadHeader" />
                              <TextBlock Grid.Column="3" Text="PROGRESS" Classes="downloadHeader" />
                              <TextBlock Grid.Column="4" Text="SIZE" Classes="downloadHeader downloadHeaderNumeric" />
                              <TextBlock Grid.Column="5" Text="REMAINING" Classes="downloadHeader downloadHeaderNumeric" />
                              <TextBlock Grid.Column="6" Text="DOWN" Classes="downloadHeader downloadHeaderNumeric" />
                              <TextBlock Grid.Column="7" Text="UP" Classes="downloadHeader downloadHeaderNumeric" />
                              <TextBlock Grid.Column="8" Text="ETA" Classes="downloadHeader downloadHeaderNumeric" />
                              <TextBlock Grid.Column="9" Text="RATIO" Classes="downloadHeader downloadHeaderNumeric" />
                              <TextBlock Grid.Column="10" Text="SEEDS/PEERS" Classes="downloadHeader downloadHeaderNumeric" />
                              <TextBlock Grid.Column="11" Text="ADDED" Classes="downloadHeader" />
                            </Grid>
                          </Border>

                          <ListBox
                              x:Name="DownloadClientQueueList"
                              Classes="downloadTable"
                              MaxHeight="340">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="390,120,110,140,100,115,100,100,85,75,110,135" ColumnSpacing="10">
                                  <TextBlock
                                      Text="{ReflectionBinding Name}"
                                      ToolTip.Tip="{ReflectionBinding Name}"
                                      Classes="downloadNameCell"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="1"
                                      Text="{ReflectionBinding Category}"
                                      ToolTip.Tip="{ReflectionBinding Category}"
                                      Classes="downloadCell muted"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="2"
                                      Text="{ReflectionBinding State}"
                                      ToolTip.Tip="{ReflectionBinding State}"
                                      Classes="downloadCell"
                                      TextTrimming="CharacterEllipsis" />
                                  <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{ReflectionBinding Progress}"
                                        Classes="downloadCell" />
                                    <ProgressBar
                                        Classes="downloadProgress"
                                        Value="{ReflectionBinding ProgressPercent}"
                                        Maximum="100" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="4" Text="{ReflectionBinding Size}" Classes="downloadCell downloadNumericCell" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="5" Text="{ReflectionBinding Remaining}" Classes="downloadCell downloadNumericCell" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="6" Text="{ReflectionBinding DownloadSpeed}" Classes="downloadCell downloadNumericCell" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="7" Text="{ReflectionBinding UploadSpeed}" Classes="downloadCell downloadNumericCell" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="8" Text="{ReflectionBinding Eta}" Classes="downloadCell downloadNumericCell" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="9" Text="{ReflectionBinding Ratio}" Classes="downloadCell downloadNumericCell" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="10" Text="{ReflectionBinding Peers}" Classes="downloadCell downloadNumericCell" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="11" Text="{ReflectionBinding Added}" Classes="downloadCell dim" TextTrimming="CharacterEllipsis" />
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </StackPanel>

                        <!-- SABnzbd uses only queue-owned data; torrent-only columns are removed. -->
                        <StackPanel
                            x:Name="DownloadClientSabQueueTable"
                            MinWidth="1510"
                            Spacing="0"
                            IsVisible="False">

                          <Border Classes="downloadTableHeader">
                            <Grid ColumnDefinitions="430,110,110,140,100,115,100,95,390" ColumnSpacing="10">
                              <TextBlock Text="ITEM" Classes="downloadHeader" />
                              <TextBlock Grid.Column="1" Text="CATEGORY" Classes="downloadHeader" />
                              <TextBlock Grid.Column="2" Text="STATUS" Classes="downloadHeader" />
                              <TextBlock Grid.Column="3" Text="PROGRESS" Classes="downloadHeader" />
                              <TextBlock Grid.Column="4" Text="SIZE" Classes="downloadHeader downloadHeaderNumeric" />
                              <TextBlock Grid.Column="5" Text="REMAINING" Classes="downloadHeader downloadHeaderNumeric" />
                              <TextBlock Grid.Column="6" Text="DOWNLOAD" Classes="downloadHeader downloadHeaderNumeric" />
                              <TextBlock Grid.Column="7" Text="ETA" Classes="downloadHeader downloadHeaderNumeric" />
                              <TextBlock Grid.Column="8" Text="DETAIL" Classes="downloadHeader" />
                            </Grid>
                          </Border>

                          <ListBox
                              x:Name="DownloadClientSabQueueList"
                              Classes="downloadTable"
                              MaxHeight="340">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="430,110,110,140,100,115,100,95,390" ColumnSpacing="10">
                                  <TextBlock
                                      Text="{ReflectionBinding Name}"
                                      ToolTip.Tip="{ReflectionBinding Name}"
                                      Classes="downloadNameCell"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="1" Text="{ReflectionBinding Category}" ToolTip.Tip="{ReflectionBinding Category}" Classes="downloadCell muted" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="2" Text="{ReflectionBinding State}" ToolTip.Tip="{ReflectionBinding State}" Classes="downloadCell" TextTrimming="CharacterEllipsis" />
                                  <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{ReflectionBinding Progress}" Classes="downloadCell" />
                                    <ProgressBar Classes="downloadProgress" Value="{ReflectionBinding ProgressPercent}" Maximum="100" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="4" Text="{ReflectionBinding Size}" Classes="downloadCell downloadNumericCell" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="5" Text="{ReflectionBinding Remaining}" Classes="downloadCell downloadNumericCell" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="6" Text="{ReflectionBinding DownloadSpeed}" Classes="downloadCell downloadNumericCell" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="7" Text="{ReflectionBinding Eta}" Classes="downloadCell downloadNumericCell" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="8" Text="{ReflectionBinding Detail}" ToolTip.Tip="{ReflectionBinding Detail}" Classes="downloadCell muted" TextTrimming="CharacterEllipsis" />
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </StackPanel>
                        </Grid>
                      </ScrollViewer>

                      <Border
                          x:Name="DownloadClientQueueEmptyState"
                          Classes="downloadEmpty">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                          <TextBlock
                              Text="✓"
                              FontSize="24"
                              Foreground="{DynamicResource SuccessBrush}"
                              VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Text="No active download work"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="DownloadClientQueueEmptyText"
                                Text="Live download detail is loading..."
                                Classes="muted"
                                Margin="0,3,0,0"
                                TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>

                  <!-- Recent history -->
                  <Border Classes="flatCard downloadTablePanel">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              x:Name="DownloadClientHistoryHeadingText"
                              Text="Recent history"
                              Classes="sectionTitle" />
                          <TextBlock
                              x:Name="DownloadClientHistoryHintText"
                              Text="Recent completed and failed work."
                              Classes="pageSubtitle"
                              Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            x:Name="DownloadClientHistoryCountText"
                            Text="--"
                            Classes="dim"
                            VerticalAlignment="Center" />
                      </Grid>

                      <ScrollViewer
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                        <StackPanel MinWidth="1515" Spacing="0">
                          <Border Classes="downloadTableHeader">
                            <Grid ColumnDefinitions="430,115,115,105,155,100,430" ColumnSpacing="10">
                              <TextBlock Text="ITEM" Classes="downloadHeader" />
                              <TextBlock Grid.Column="1" Text="CATEGORY" Classes="downloadHeader" />
                              <TextBlock Grid.Column="2" Text="STATUS" Classes="downloadHeader" />
                              <TextBlock Grid.Column="3" Text="SIZE" Classes="downloadHeader downloadHeaderNumeric" />
                              <TextBlock Grid.Column="4" Text="COMPLETED" Classes="downloadHeader" />
                              <TextBlock Grid.Column="5" Text="DURATION" Classes="downloadHeader downloadHeaderNumeric" />
                              <TextBlock
                                  Grid.Column="6"
                                  x:Name="DownloadClientHistoryDetailHeaderText"
                                  Text="SOURCE / DETAIL"
                                  Classes="downloadHeader" />
                            </Grid>
                          </Border>

                          <ListBox
                              x:Name="DownloadClientHistoryList"
                              Classes="downloadTable"
                              MaxHeight="260">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="430,115,115,105,155,100,430" ColumnSpacing="10">
                                  <TextBlock
                                      Text="{ReflectionBinding Name}"
                                      ToolTip.Tip="{ReflectionBinding Name}"
                                      Classes="downloadNameCell"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="1" Text="{ReflectionBinding Category}" ToolTip.Tip="{ReflectionBinding Category}" Classes="downloadCell muted" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="2" Text="{ReflectionBinding State}" ToolTip.Tip="{ReflectionBinding State}" Classes="downloadCell" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="3" Text="{ReflectionBinding Size}" Classes="downloadCell downloadNumericCell" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="4" Text="{ReflectionBinding Completed}" Classes="downloadCell dim" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="5" Text="{ReflectionBinding Duration}" Classes="downloadCell downloadNumericCell" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="6" Text="{ReflectionBinding Detail}" ToolTip.Tip="{ReflectionBinding Detail}" Classes="downloadCell muted" TextTrimming="CharacterEllipsis" />
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </StackPanel>
                      </ScrollViewer>

                      <Border
                          x:Name="DownloadClientHistoryEmptyState"
                          Classes="downloadEmpty">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                          <TextBlock
                              Text="○"
                              FontSize="24"
                              Foreground="{DynamicResource AccentBrush}"
                              VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Text="No recent history"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="DownloadClientHistoryEmptyText"
                                Text="Recent history is loading..."
                                Classes="muted"
                                Margin="0,3,0,0"
                                TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>

                  <Border Classes="downloadStatus" Margin="0,0,0,4">
                    <TextBlock
                        x:Name="DownloadClientStatusText"
                        Text="Live telemetry pending."
                        Classes="muted"
                        TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>
            <!-- Windows-reference Arr application workspace -->
            <Grid
                x:Name="ArrWorkspacePage"
                IsVisible="False">

              <ScrollViewer
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="12" Margin="0,0,4,4">
                  <!-- MediaServiceView heading -->
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,1">
                    <StackPanel>
                      <TextBlock
                          x:Name="ArrApplicationTitleText"
                          Text="Arr application"
                          Classes="pageTitle" />
                      <TextBlock
                          x:Name="ArrApplicationSubtitleText"
                          Text="Application health, queue and operational tools."
                          Classes="pageSubtitle"
                          Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="9">
                      <StackPanel VerticalAlignment="Center" Margin="0,0,3,0">
                        <TextBlock
                            x:Name="ArrInstanceCountText"
                            Text="0 instances"
                            HorizontalAlignment="Right"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="ArrLiveUpdatedText"
                            Text="Waiting for live telemetry"
                            Classes="dim"
                            FontSize="10"
                            HorizontalAlignment="Right"
                            Margin="0,2,0,0" />
                      </StackPanel>
                      <Button
                          x:Name="ArrCustomizeButton"
                          Classes="compact"
                          Content="Customize"
                          Click="ArrCustomizeButton_OnClick" />
                      <Button
                          x:Name="ArrRefreshTelemetryButton"
                          Classes="primary compact"
                          Content="Refresh"
                          MinWidth="96"
                          Click="ArrRefreshTelemetryButton_OnClick" />
                    </StackPanel>
                  </Grid>

                  <!-- Windows four-card metric strip -->
                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Border Classes="flatCard arrMetric">
                      <StackPanel>
                        <TextBlock Text="STATE" Classes="eyebrow" />
                        <TextBlock
                            x:Name="ArrStateMetricText"
                            Text="WAITING"
                            Classes="metricValue"
                            FontSize="23"
                            Margin="0,8,0,0"
                            TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="flatCard arrMetric">
                      <StackPanel>
                        <TextBlock Text="VERSION" Classes="eyebrow" />
                        <TextBlock
                            x:Name="ArrVersionMetricText"
                            Text="--"
                            Classes="metricValue"
                            FontSize="18"
                            Margin="0,8,0,0"
                            TextWrapping="Wrap"
                            MaxHeight="48" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="flatCard arrMetric">
                      <StackPanel>
                        <TextBlock
                            x:Name="ArrWorkMetricLabelText"
                            Text="QUEUE"
                            Classes="eyebrow" />
                        <TextBlock
                            x:Name="ArrWorkMetricText"
                            Text="--"
                            Classes="metricValue"
                            FontSize="23"
                            Margin="0,8,0,0" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Classes="flatCard arrMetric">
                      <StackPanel>
                        <TextBlock Text="HEALTH ISSUES" Classes="eyebrow" />
                        <TextBlock
                            x:Name="ArrHealthMetricText"
                            Text="--"
                            Classes="metricValue"
                            FontSize="23"
                            Margin="0,8,0,0" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <!-- Exact Windows operations ownership strip -->
                  <Border Classes="inset arrOperations">
                    <StackPanel>
                      <TextBlock Text="Operations" Classes="sectionTitle" />
                      <TextBlock
                          x:Name="ArrOperationsSubtitleText"
                          Text="Application and stack tools stay together."
                          Classes="pageSubtitle"
                          Margin="0,4,0,10"
                          TextWrapping="Wrap" />

                      <WrapPanel>
                        <WrapPanel x:Name="ArrOpenButtonsPanel" />
                        <Button
                            Classes="compact arrAction"
                            Content="Full queue drill-down"
                            Margin="0,0,8,8"
                            Click="ArrOpenNativeDetailButton_OnClick" />
                        <Button
                            Classes="compact arrAction"
                            Content="Docker / stack"
                            Margin="0,0,8,8"
                            Click="ArrDockerButton_OnClick" />
                        <Button
                            Classes="compact arrAction"
                            Content="Logs"
                            Margin="0,0,8,8"
                            Click="ArrLogsButton_OnClick" />
                        <Button
                            Classes="compact arrAction"
                            Content="Intelligence"
                            Margin="0,0,8,8"
                            Click="ArrWorkspaceIntelligenceButton_OnClick" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <!-- Windows service telemetry header -->
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,-2">
                    <StackPanel>
                      <TextBlock Text="Service telemetry" Classes="sectionTitle" />
                      <TextBlock
                          Text="Current endpoint state, version, queue and health information."
                          Classes="pageSubtitle"
                          Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Text="Shared live application snapshot"
                        Classes="dim"
                        VerticalAlignment="Center" />
                  </Grid>

                  <!-- MediaServiceView-style telemetry cards -->
                  <Grid>
                    <ListBox
                        x:Name="ArrInstanceTelemetryList"
                        Classes="arrCards passive"
                        MaxHeight="290">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Border Classes="flatCard arrServiceCard" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="1.15*,0.95*,0.8*,0.85*,2.15*,Auto" ColumnSpacing="12">
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    Text="{ReflectionBinding DisplayName}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{ReflectionBinding State}"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    FontWeight="SemiBold"
                                    FontSize="10"
                                    Margin="0,3,0,0"
                                    TextTrimming="CharacterEllipsis" />
                              </StackPanel>

                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ENDPOINT" Classes="eyebrow" />
                                <TextBlock
                                    Text="{ReflectionBinding Endpoint}"
                                    FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace"
                                    FontSize="10.5"
                                    TextTrimming="CharacterEllipsis" />
                              </StackPanel>

                              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="VERSION" Classes="eyebrow" />
                                <TextBlock
                                    Text="{ReflectionBinding Version}"
                                    TextWrapping="Wrap"
                                    MaxHeight="42" />
                              </StackPanel>

                              <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="WORK" Classes="eyebrow" />
                                <TextBlock Text="{ReflectionBinding Work}" />
                                <TextBlock
                                    Text="{ReflectionBinding Health}"
                                    Classes="dim"
                                    FontSize="10" />
                              </StackPanel>

                              <TextBlock
                                  Grid.Column="4"
                                  Text="{ReflectionBinding Detail}"
                                  Classes="muted"
                                  TextWrapping="Wrap"
                                  MaxHeight="48"
                                  VerticalAlignment="Center"
                                  Margin="8,0" />

                              <Border
                                  Grid.Column="5"
                                  Classes="statusBadge"
                                  VerticalAlignment="Center">
                                <TextBlock
                                    Text="{ReflectionBinding State}"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    FontSize="10"
                                    FontWeight="SemiBold" />
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <Border
                        x:Name="ArrServiceEmptyStateText"
                        Classes="emptyState"
                        IsVisible="False">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border
                            Width="32"
                            Height="32"
                            CornerRadius="16"
                            Background="{DynamicResource WarnTintBrush}"
                            BorderBrush="#5B4A18"
                            BorderThickness="1">
                          <TextBlock
                              Text="!"
                              Foreground="{DynamicResource WarnBrush}"
                              FontSize="17"
                              FontWeight="SemiBold"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="No compatible instance detected" FontWeight="SemiBold" />
                          <TextBlock
                              Text="Verify the application service, container identity or published port."
                              Classes="muted"
                              FontSize="10"
                              Margin="0,3,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Grid>

                  <!-- Windows inline queue and health table -->
                  <Border Classes="flatCard arrQueuePanel" Margin="0,2,0,0">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="9">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock
                              x:Name="ArrWorkSectionTitleText"
                              Text="Queue &amp; health"
                              Classes="sectionTitle" />
                          <TextBlock
                              x:Name="ArrWorkSectionSubtitleText"
                              Text="Item-level work and health messages."
                              Classes="pageSubtitle"
                              Margin="0,3,0,0" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Classes="compact"
                            Content="Open full detail"
                            VerticalAlignment="Center"
                            Click="ArrOpenNativeDetailButton_OnClick" />
                      </Grid>

                      <Border Grid.Row="1" Classes="arrTableHeader">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden">
                          <Grid MinWidth="1040" ColumnDefinitions="120,105,1.35*,105,90,100,1.25*" ColumnSpacing="10">
                            <TextBlock Text="SERVICE" Classes="tableHeader" />
                            <TextBlock Grid.Column="1" Text="TYPE" Classes="tableHeader" />
                            <TextBlock Grid.Column="2" Text="ITEM / ISSUE" Classes="tableHeader" />
                            <TextBlock Grid.Column="3" Text="STATE" Classes="tableHeader" />
                            <TextBlock Grid.Column="4" Text="PROGRESS" Classes="tableHeader" />
                            <TextBlock Grid.Column="5" Text="REMAINING" Classes="tableHeader" />
                            <TextBlock Grid.Column="6" Text="DETAIL" Classes="tableHeader" />
                          </Grid>
                        </ScrollViewer>
                      </Border>

                      <Grid Grid.Row="2">
                        <ListBox
                            x:Name="ArrQueueHealthList"
                            Classes="dataList arrTable"
                            MinHeight="160"
                            MaxHeight="330">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                              <ScrollViewer
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                                <Grid MinWidth="1040" ColumnDefinitions="120,105,1.35*,105,90,100,1.25*" ColumnSpacing="10">
                                  <TextBlock
                                      Text="{ReflectionBinding Service}"
                                      FontWeight="SemiBold"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="1"
                                      Text="{ReflectionBinding Type}"
                                      Classes="muted"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="2"
                                      Text="{ReflectionBinding ItemIssue}"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="3"
                                      Text="{ReflectionBinding State}"
                                      FontWeight="SemiBold"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="4"
                                      Text="{ReflectionBinding Progress}"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="5"
                                      Text="{ReflectionBinding Remaining}"
                                      TextTrimming="CharacterEllipsis" />
                                  <TextBlock
                                      Grid.Column="6"
                                      Text="{ReflectionBinding Detail}"
                                      Classes="dim"
                                      TextTrimming="CharacterEllipsis" />
                                </Grid>
                              </ScrollViewer>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>

                        <Border
                            x:Name="ArrQueueEmptyStateText"
                            Classes="emptyState"
                            IsVisible="False">
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock
                                Text="No active queue or health items"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="Live item detail will appear here automatically."
                                Classes="muted"
                                FontSize="10"
                                Margin="0,3,0,0"
                                HorizontalAlignment="Center" />
                          </StackPanel>
                        </Border>
                      </Grid>

                      <Border Grid.Row="3" Classes="arrStatusBar">
                        <TextBlock
                            x:Name="ArrQueueFooterText"
                            Text="Waiting for live telemetry."
                            Classes="muted"
                            TextWrapping="Wrap" />
                      </Border>
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>

              <!-- Windows-style customization slide-over; functionality preserved. -->
              <Border
                  x:Name="ArrCustomizationPanel"
                  Classes="module arrCustomization"
                  Width="430"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource Surface2Brush}"
                  ZIndex="20"
                  IsVisible="False">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="Customize workspace" Classes="sectionTitle" />
                      <TextBlock
                          Text="Instance name, role, config path and enabled modules."
                          Classes="pageSubtitle"
                          Margin="0,3,0,0" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Classes="ghost compact"
                        Content="Close"
                        Click="ArrCustomizeCloseButton_OnClick" />
                  </Grid>

                  <ComboBox
                      Grid.Row="1"
                      x:Name="ArrCustomizeInstanceComboBox"
                      SelectionChanged="ArrCustomizeInstanceComboBox_OnSelectionChanged" />

                  <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel>
                      <TextBlock Text="Friendly name" Classes="eyebrow" Margin="0,0,0,4" />
                      <TextBox x:Name="ArrFriendlyNameTextBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Role" Classes="eyebrow" Margin="0,0,0,4" />
                      <TextBox x:Name="ArrRoleTextBox" />
                    </StackPanel>
                  </Grid>

                  <StackPanel Grid.Row="3">
                    <TextBlock Text="Config path" Classes="eyebrow" Margin="0,0,0,4" />
                    <TextBox x:Name="ArrConfigPathTextBox" />
                  </StackPanel>

                  <CheckBox
                      Grid.Row="4"
                      x:Name="ArrPrivacyModeCheckBox"
                      Content="Privacy mode" />

                  <ScrollViewer
                      Grid.Row="5"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ArrWorkspaceModulesPanel" />
                  </ScrollViewer>

                  <WrapPanel Grid.Row="6">
                    <Button
                        Classes="compact"
                        Content="Enable all"
                        Margin="0,0,8,0"
                        Click="EnableAllArrModulesButton_OnClick" />
                    <Button
                        Classes="compact"
                        Content="Disable all"
                        Click="DisableAllArrModulesButton_OnClick" />
                  </WrapPanel>

                  <Grid Grid.Row="7" RowDefinitions="Auto,Auto" RowSpacing="7">
                    <WrapPanel>
                      <Button
                          x:Name="SaveArrWorkspaceButton"
                          Classes="primary compact"
                          Content="Save"
                          MinWidth="88"
                          Margin="0,0,8,0"
                          Click="SaveArrWorkspaceButton_OnClick" />
                      <Button
                          x:Name="ResetArrWorkspaceButton"
                          Classes="compact"
                          Content="Reset"
                          MinWidth="88"
                          Click="ResetArrWorkspaceButton_OnClick" />
                    </WrapPanel>
                    <StackPanel Grid.Row="1">
                      <TextBlock
                          x:Name="ArrWorkspaceProfileStatusText"
                          Text="No instance selected."
                          Classes="muted"
                          TextWrapping="Wrap" />
                      <TextBlock
                          x:Name="ArrWorkspaceConfigPathText"
                          Text="--"
                          Classes="dim"
                          FontSize="9"
                          Margin="0,3,0,0"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
            <!-- Native Recyclarr container and configuration workspace -->
            <Grid
                x:Name="RecyclarrWorkspacePage"
                IsVisible="False">

              <ScrollViewer
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="12" Margin="0,0,4,4">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="Recyclarr" Classes="pageTitle" />
                      <TextBlock
                          Text="Container runtime, configuration targets, read-only preview and synchronization evidence."
                          Classes="pageSubtitle"
                          Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10">
                      <StackPanel VerticalAlignment="Center" Margin="0,0,3,0">
                        <TextBlock
                            x:Name="RecyclarrTargetText"
                            Text="--"
                            HorizontalAlignment="Right"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="RecyclarrFreshnessText"
                            Text="Capture pending"
                            Classes="dim"
                            FontSize="10"
                            HorizontalAlignment="Right"
                            Margin="0,2,0,0" />
                      </StackPanel>
                      <Button
                          x:Name="RecyclarrRefreshButton"
                          Classes="primary compact"
                          Content="Refresh"
                          MinWidth="96"
                          Click="RecyclarrRefreshButton_OnClick" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Border Classes="flatCard arrMetric">
                      <StackPanel>
                        <TextBlock Text="RUNTIME" Classes="eyebrow" />
                        <TextBlock
                            x:Name="RecyclarrRuntimeMetricText"
                            Text="WAITING"
                            Classes="metricValue"
                            FontSize="22"
                            Margin="0,8,0,0"
                            TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="flatCard arrMetric">
                      <StackPanel>
                        <TextBlock Text="VERSION" Classes="eyebrow" />
                        <TextBlock
                            x:Name="RecyclarrVersionMetricText"
                            Text="--"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Margin="0,8,0,0"
                            TextWrapping="Wrap"
                            MaxHeight="48" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="flatCard arrMetric">
                      <StackPanel>
                        <TextBlock Text="CONFIG FILES" Classes="eyebrow" />
                        <TextBlock
                            x:Name="RecyclarrConfigMetricText"
                            Text="0"
                            Classes="metricValue"
                            FontSize="23"
                            Margin="0,8,0,0" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Classes="flatCard arrMetric">
                      <StackPanel>
                        <TextBlock Text="TARGETS" Classes="eyebrow" />
                        <TextBlock
                            x:Name="RecyclarrTargetMetricText"
                            Text="0"
                            Classes="metricValue"
                            FontSize="23"
                            Margin="0,8,0,0" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Border Classes="inset arrOperations">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel>
                        <TextBlock Text="Operations" Classes="sectionTitle" />
                        <TextBlock
                            Text="Inventory and preview are read-only. Applying a real synchronization remains outside this batch."
                            Classes="pageSubtitle"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap" />
                      </StackPanel>

                      <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button
                            x:Name="RecyclarrOpenConfigButton"
                            Classes="compact"
                            Content="Open config folder"
                            Margin="0,0,8,0"
                            Click="RecyclarrOpenConfigButton_OnClick" />
                        <Button
                            x:Name="RecyclarrPreviewButton"
                            Classes="primary compact"
                            Content="Preview all"
                            Margin="0,0,8,0"
                            Click="RecyclarrPreviewButton_OnClick" />
                        <Button
                            Classes="compact"
                            Content="Docker"
                            Margin="0,0,8,0"
                            Click="RecyclarrDockerButton_OnClick" />
                        <Button
                            Classes="compact"
                            Content="Logs"
                            Click="RecyclarrLogsButton_OnClick" />
                      </WrapPanel>
                    </Grid>
                  </Border>

                  <Grid ColumnDefinitions="1.2*,0.8*" ColumnSpacing="10">
                    <Border Classes="flatCard">
                      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="Configuration targets" Classes="sectionTitle" />
                            <TextBlock
                                Text="Sonarr and Radarr instance names parsed without exposing API keys."
                                Classes="pageSubtitle"
                                Margin="0,3,0,0" />
                          </StackPanel>
                          <TextBlock
                              Grid.Column="1"
                              x:Name="RecyclarrTargetCountText"
                              Text="0 targets"
                              Classes="dim"
                              VerticalAlignment="Center" />
                        </Grid>

                        <Border Grid.Row="1" Classes="tableHeaderBar">
                          <Grid ColumnDefinitions="90,150,1.2*,1.1*" ColumnSpacing="8">
                            <TextBlock Text="SERVICE" Classes="tableColumnHeader" />
                            <TextBlock Grid.Column="1" Text="INSTANCE" Classes="tableColumnHeader" />
                            <TextBlock Grid.Column="2" Text="CONFIG FILE" Classes="tableColumnHeader" />
                            <TextBlock Grid.Column="3" Text="ENDPOINT" Classes="tableColumnHeader" />
                          </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                          <ListBox
                              x:Name="RecyclarrTargetsList"
                              Classes="dataList"
                              MinHeight="128"
                              MaxHeight="260">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="90,150,1.2*,1.1*" ColumnSpacing="8">
                                  <TextBlock
                                      Text="{ReflectionBinding Service}"
                                      FontWeight="SemiBold" />
                                  <TextBlock
                                      Grid.Column="1"
                                      Text="{ReflectionBinding Instance}"
                                      TextTrimming="CharacterEllipsis"
                                      ToolTip.Tip="{ReflectionBinding Instance}" />
                                  <TextBlock
                                      Grid.Column="2"
                                      Text="{ReflectionBinding ConfigFile}"
                                      Classes="muted"
                                      TextTrimming="CharacterEllipsis"
                                      ToolTip.Tip="{ReflectionBinding ConfigFile}" />
                                  <TextBlock
                                      Grid.Column="3"
                                      Text="{ReflectionBinding Endpoint}"
                                      Classes="dim"
                                      TextTrimming="CharacterEllipsis"
                                      ToolTip.Tip="{ReflectionBinding Endpoint}" />
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>

                          <Border
                              x:Name="RecyclarrTargetsEmptyState"
                              Classes="compactEmpty">
                            <StackPanel>
                              <TextBlock Text="No configuration targets parsed" FontWeight="SemiBold" />
                              <TextBlock
                                  Text="The container may have no local config, the mount may be unreadable, or its YAML may not define Sonarr/Radarr instances."
                                  Classes="muted"
                                  FontSize="10"
                                  Margin="0,3,0,0"
                                  TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </Grid>
                      </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="flatCard">
                      <StackPanel Spacing="9">
                        <StackPanel>
                          <TextBlock Text="Container &amp; ownership" Classes="sectionTitle" />
                          <TextBlock
                              Text="Docker identity, Compose ownership, schedule and config mount."
                              Classes="pageSubtitle"
                              Margin="0,3,0,0" />
                        </StackPanel>

                        <Border Classes="inset">
                          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                            <TextBlock Text="CONTAINER" Classes="eyebrow" />
                            <TextBlock Grid.Column="1" x:Name="RecyclarrContainerNameText" Text="--" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Text="IMAGE" Classes="eyebrow" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RecyclarrImageText" Text="--" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" Text="COMPOSE" Classes="eyebrow" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RecyclarrComposeText" Text="--" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" Text="SCHEDULE" Classes="eyebrow" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RecyclarrScheduleText" Text="--" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" Text="CONFIG PATH" Classes="eyebrow" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                x:Name="RecyclarrConfigPathText"
                                Text="--"
                                Classes="mono"
                                TextWrapping="Wrap"
                                ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                            <TextBlock Grid.Row="5" Text="LAST RUN" Classes="eyebrow" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="RecyclarrLastRunText" Text="--" Classes="muted" TextWrapping="Wrap" />
                          </Grid>
                        </Border>

                        <TextBlock
                            x:Name="RecyclarrEvidenceText"
                            Text="Capture pending."
                            Classes="dim"
                            FontSize="10"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Border Classes="flatCard">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="Configuration files" Classes="sectionTitle" />
                          <TextBlock
                              Text="Default recyclarr.yml and files under configs/. File contents and credentials are never displayed."
                              Classes="pageSubtitle"
                              Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            x:Name="RecyclarrConfigCountText"
                            Text="0 files"
                            Classes="dim"
                            VerticalAlignment="Center" />
                      </Grid>

                      <Border Grid.Row="1" Classes="tableHeaderBar">
                        <Grid ColumnDefinitions="170,1.3*,90,150,1.5*" ColumnSpacing="8">
                          <TextBlock Text="FILE" Classes="tableColumnHeader" />
                          <TextBlock Grid.Column="1" Text="RELATIVE PATH" Classes="tableColumnHeader" />
                          <TextBlock Grid.Column="2" Text="SIZE" Classes="tableColumnHeader" />
                          <TextBlock Grid.Column="3" Text="MODIFIED" Classes="tableColumnHeader" />
                          <TextBlock Grid.Column="4" Text="TARGETS" Classes="tableColumnHeader" />
                        </Grid>
                      </Border>

                      <Grid Grid.Row="2">
                        <ListBox
                            x:Name="RecyclarrConfigFilesList"
                            Classes="dataList"
                            MinHeight="110"
                            MaxHeight="220">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                              <Grid ColumnDefinitions="170,1.3*,90,150,1.5*" ColumnSpacing="8">
                                <TextBlock Text="{ReflectionBinding File}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{ReflectionBinding RelativePath}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding RelativePath}" />
                                <TextBlock Grid.Column="2" Text="{ReflectionBinding Size}" />
                                <TextBlock Grid.Column="3" Text="{ReflectionBinding Modified}" Classes="dim" />
                                <TextBlock Grid.Column="4" Text="{ReflectionBinding Targets}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Targets}" />
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>

                        <Border
                            x:Name="RecyclarrConfigFilesEmptyState"
                            Classes="compactEmpty">
                          <StackPanel>
                            <TextBlock Text="No readable Recyclarr configuration files" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Check the container config mount and file permissions. GraveOps does not require an HTTP endpoint for this application."
                                Classes="muted"
                                FontSize="10"
                                Margin="0,3,0,0"
                                TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Grid>
                  </Border>

                  <Border Classes="flatCard">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="Read-only preview" Classes="sectionTitle" />
                          <TextBlock
                              Text="Runs recyclarr sync --preview with log output. Recyclarr may read Sonarr and Radarr, but preview mode does not apply changes."
                              Classes="pageSubtitle"
                              Margin="0,3,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            x:Name="RecyclarrPreviewStatusText"
                            Text="Not run"
                            Classes="dim"
                            VerticalAlignment="Center" />
                      </Grid>

                      <TextBox
                          Grid.Row="2"
                          x:Name="RecyclarrOutputText"
                          Classes="console workspaceOutput"
                          MinHeight="190"
                          MaxHeight="330"
                          IsReadOnly="True"
                          AcceptsReturn="True"
                          TextWrapping="Wrap"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                  </Border>

                  <Border Classes="arrStatusBar" Margin="0,0,0,4">
                    <TextBlock
                        x:Name="RecyclarrStatusText"
                        Text="Native Recyclarr capture pending."
                        Classes="muted"
                        TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- Services -->
            <Grid
                x:Name="ServicesPage"
                IsVisible="False"
                RowDefinitions="Auto,*"
                RowSpacing="8">

              <Grid Grid.Row="0" ColumnDefinitions="*,210,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <StackPanel>
                  <TextBlock Text="Operations &amp; troubleshooting" Classes="sectionTitle" FontSize="18" />
                  <TextBlock Text="Native services, guarded actions and selected-state comparison." Classes="pageSubtitle" />
                </StackPanel>
                <TextBox Grid.Column="1" x:Name="ServicesFilterText" Classes="filter" PlaceholderText="Filter services" TextChanged="ServicesFilterText_OnTextChanged" />
                <Button Grid.Column="2" x:Name="ServiceStartButton" Content="Start" Click="ServiceStartButton_OnClick" />
                <Button Grid.Column="3" x:Name="ServiceStopButton" Content="Stop" Classes="danger" Click="ServiceStopButton_OnClick" />
                <Button Grid.Column="4" x:Name="ServiceRestartButton" Content="Restart" Classes="primary" Click="ServiceRestartButton_OnClick" />
                <CheckBox Grid.Column="5" x:Name="SafeModeCheckBox" Content="Safe Mode" VerticalAlignment="Center" Click="SafeModeCheckBox_OnClick" />
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="260,*" ColumnSpacing="8">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                    <StackPanel>
                      <TextBlock Text="Action library" Classes="sectionTitle" />
                      <TextBlock x:Name="ServicesSummaryText" Text="0 services" Classes="dim" />
                    </StackPanel>
                    <Border Grid.Row="1" Classes="inset">
                      <StackPanel><TextBlock Text="HOST SUMMARY" Classes="eyebrow" /><TextBlock Text="Read-only inventory and health-aware service actions." Classes="muted" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                    <ListBox Grid.Row="2" x:Name="ServicesList" Classes="dataList" SelectionChanged="ServicesList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{ReflectionBinding Unit}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{ReflectionBinding Description}" Classes="dim" FontSize="8.5" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Classes="module">
                  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock x:Name="ServiceSelectedNameText" Text="Select an action" Classes="sectionTitle" />
                        <TextBlock x:Name="ServiceSelectedDescriptionText" Text="Select a service to review state, policy and guarded controls." Classes="pageSubtitle" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" x:Name="ServiceSelectedStateText" Text="--" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    </Grid>

                    <Border Grid.Row="1" Classes="inset">
                      <TextBlock x:Name="ServiceSelectedPolicyText" Text="No service selected." Classes="muted" TextWrapping="Wrap" />
                    </Border>

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                      <TextBlock Text="Result / before &amp; after" Classes="eyebrow" />
                      <TextBlock Grid.Column="1" x:Name="ServiceActionStatusText" Text="No action run." Classes="dim" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBox Grid.Row="3" Classes="console" IsReadOnly="True" AcceptsReturn="True" Text="Select a service from the action library to review its state and safe controls." TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </Grid>
            </Grid>

            <!-- Docker operational drilldown -->
            <Grid
                x:Name="DockerPage"
                IsVisible="False">

              <ScrollViewer
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="10" Margin="0,0,4,4">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel>
                      <TextBlock Text="Docker" Classes="sectionTitle" FontSize="18" />
                      <TextBlock
                          Text="Compose-aware fleet health, selected-container inspection, bounded logs and guarded verified actions."
                          Classes="pageSubtitle"
                          Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                      <TextBlock
                          x:Name="DockerDaemonText"
                          Text="Capture pending"
                          Classes="dim"
                          VerticalAlignment="Center" />
                      <Button
                          x:Name="DockerRefreshButton"
                          Classes="primary compact"
                          Content="Refresh"
                          MinWidth="96"
                          Click="DockerRefreshButton_OnClick" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Border Classes="metric">
                      <StackPanel>
                        <TextBlock Text="CONTAINERS" Classes="eyebrow" />
                        <TextBlock x:Name="DockerTotalMetricText" Text="0" Classes="metricValue" FontSize="23" Margin="0,7,0,0" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="metric">
                      <StackPanel>
                        <TextBlock Text="RUNNING" Classes="eyebrow" />
                        <TextBlock x:Name="DockerRunningMetricText" Text="0" Classes="metricValue" FontSize="23" Margin="0,7,0,0" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="metric">
                      <StackPanel>
                        <TextBlock Text="NEEDS ATTENTION" Classes="eyebrow" />
                        <TextBlock x:Name="DockerAttentionMetricText" Text="0" Classes="metricValue" FontSize="23" Margin="0,7,0,0" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="metric">
                      <StackPanel>
                        <TextBlock Text="COMPOSE PROJECTS" Classes="eyebrow" />
                        <TextBlock x:Name="DockerProjectMetricText" Text="0" Classes="metricValue" FontSize="23" Margin="0,7,0,0" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Border Classes="inset">
                    <Grid ColumnDefinitions="260,Auto,*" ColumnSpacing="10">
                      <TextBox
                          x:Name="DockerFilterText"
                          Classes="filter"
                          PlaceholderText="Filter group, container, image, state or port"
                          TextChanged="DockerFilterText_OnTextChanged" />
                      <CheckBox
                          Grid.Column="1"
                          x:Name="ShowInformationalContainersCheckBox"
                          Content="Show exited"
                          VerticalAlignment="Center"
                          Click="ShowInformationalContainersCheckBox_OnClick" />
                      <TextBlock
                          Grid.Column="2"
                          x:Name="DockerSummaryText"
                          Text="0 shown"
                          Classes="dim"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center" />
                    </Grid>
                  </Border>

                  <Border Classes="module adaptive">
                    <Grid RowDefinitions="Auto,*" RowSpacing="6">
                      <Border Classes="tableHeaderBar">
                        <Grid ColumnDefinitions="95,150,1.2*,105,100,105,145,1.1*" ColumnSpacing="7">
                          <TextBlock Text="GROUP" Classes="tableColumnHeader" />
                          <TextBlock Grid.Column="1" Text="CONTAINER" Classes="tableColumnHeader" />
                          <TextBlock Grid.Column="2" Text="IMAGE" Classes="tableColumnHeader" />
                          <TextBlock Grid.Column="3" Text="STATE" Classes="tableColumnHeader" />
                          <TextBlock Grid.Column="4" Text="HEALTH" Classes="tableColumnHeader" />
                          <TextBlock Grid.Column="5" Text="RESTARTS" Classes="tableColumnHeader" />
                          <TextBlock Grid.Column="6" Text="RESOURCES" Classes="tableColumnHeader" />
                          <TextBlock Grid.Column="7" Text="PUBLISHED PORTS" Classes="tableColumnHeader" />
                        </Grid>
                      </Border>

                      <Grid Grid.Row="1">
                        <ListBox
                            x:Name="DockerList"
                            Classes="dataList"
                            MinHeight="180"
                            MaxHeight="250"
                            SelectionChanged="DockerList_OnSelectionChanged">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                              <Grid ColumnDefinitions="95,150,1.2*,105,100,105,145,1.1*" ColumnSpacing="7">
                                <TextBlock Text="{ReflectionBinding Group}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Group}" />
                                <TextBlock Grid.Column="1" Text="{ReflectionBinding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Name}" />
                                <TextBlock Grid.Column="2" Text="{ReflectionBinding Image}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Image}" />
                                <TextBlock Grid.Column="3" Text="{ReflectionBinding StateLabel}" />
                                <TextBlock Grid.Column="4" Text="{ReflectionBinding HealthLabel}" Classes="muted" />
                                <TextBlock Grid.Column="5" Text="{ReflectionBinding RestartSummary}" />
                                <TextBlock Grid.Column="6" Text="{ReflectionBinding Resources}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Resources}" />
                                <TextBlock Grid.Column="7" Text="{ReflectionBinding Ports}" Classes="dim" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding Ports}" />
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="DockerEmptyState" Classes="compactEmpty">
                          <StackPanel>
                            <TextBlock Text="No containers match the current view" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Refresh Docker, clear the filter or enable Show exited."
                                Classes="muted"
                                FontSize="10"
                                Margin="0,3,0,0" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Grid>
                  </Border>

                  <!-- Compact selected-container workspace -->
                  <Border Classes="module adaptive">
                    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                      <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <StackPanel>
                            <TextBlock x:Name="DockerSelectedNameText" Text="No container selected" Classes="sectionTitle" />
                            <TextBlock x:Name="DockerSelectedStateText" Text="--" Classes="pageSubtitle" Margin="0,3,0,0" />
                          </StackPanel>
                          <Button Grid.Column="1" x:Name="DockerRefreshDetailButton" Classes="compact" Content="Refresh detail" Click="DockerRefreshDetailButton_OnClick" />
                        </Grid>
                        <TextBlock
                            x:Name="DockerDetailStatusText"
                            Text="Select a container to inspect."
                            Classes="dim"
                            Margin="0,5,0,0"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                      </StackPanel>

                      <WrapPanel Grid.Row="1">
                        <Button x:Name="DockerStartButton" Classes="compact" Content="Start" Margin="0,0,6,6" Click="DockerStartButton_OnClick" />
                        <Button x:Name="DockerRestartButton" Classes="primary compact" Content="Restart" Margin="0,0,6,6" Click="DockerRestartButton_OnClick" />
                        <Button x:Name="DockerStopButton" Classes="danger compact" Content="Stop" Margin="0,0,6,6" Click="DockerStopButton_OnClick" />
                        <Button x:Name="DockerRestartDumbButton" Classes="danger compact" Content="Restart DUMB project" Margin="0,0,6,6" Click="DockerRestartDumbButton_OnClick" />
                      </WrapPanel>

                      <Border Grid.Row="2" Classes="inset" Padding="6">
                        <WrapPanel>
                          <Button x:Name="DockerDetailOverviewButton" Classes="segment compact" Content="Overview" Margin="0,0,6,0" Click="DockerDetailOverviewButton_OnClick" />
                          <Button x:Name="DockerDetailPortsButton" Classes="segment compact" Content="Ports" Margin="0,0,6,0" Click="DockerDetailPortsButton_OnClick" />
                          <Button x:Name="DockerDetailMountsButton" Classes="segment compact" Content="Mounts" Margin="0,0,6,0" Click="DockerDetailMountsButton_OnClick" />
                          <Button x:Name="DockerDetailEnvironmentButton" Classes="segment compact" Content="Environment" Click="DockerDetailEnvironmentButton_OnClick" />
                        </WrapPanel>
                      </Border>

                      <Grid Grid.Row="3">
                        <Border x:Name="DockerOverviewPanel" Classes="inset" MinHeight="130" MaxHeight="190">
                          <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                              <Border Classes="flatCard compact"><StackPanel><TextBlock Text="IMAGE" Classes="eyebrow" /><TextBlock x:Name="DockerSelectedImageText" Text="--" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="44" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" /></StackPanel></Border>
                              <Border Grid.Column="1" Classes="flatCard compact"><StackPanel><TextBlock Text="COMPOSE" Classes="eyebrow" /><TextBlock x:Name="DockerSelectedComposeText" Text="--" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="44" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" /></StackPanel></Border>
                              <Border Grid.Column="2" Classes="flatCard compact"><StackPanel><TextBlock Text="LIFECYCLE" Classes="eyebrow" /><TextBlock x:Name="DockerSelectedLifecycleText" Text="--" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="44" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" /></StackPanel></Border>
                              <Border Grid.Column="3" Classes="flatCard compact"><StackPanel><TextBlock Text="RESOURCES" Classes="eyebrow" /><TextBlock x:Name="DockerSelectedResourcesText" Text="--" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="44" /></StackPanel></Border>
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="0.75*,1.05*,1.1*,1.5*" ColumnSpacing="8">
                              <StackPanel><TextBlock Text="CONTAINER ID" Classes="eyebrow" /><TextBlock x:Name="DockerSelectedIdText" Text="--" Classes="mono" TextTrimming="CharacterEllipsis" /></StackPanel>
                              <StackPanel Grid.Column="1"><TextBlock Text="RESTART POLICY" Classes="eyebrow" /><TextBlock x:Name="DockerSelectedRestartText" Text="--" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" /></StackPanel>
                              <StackPanel Grid.Column="2"><TextBlock Text="NETWORKS" Classes="eyebrow" /><TextBlock x:Name="DockerSelectedNetworksText" Text="--" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" /></StackPanel>
                              <StackPanel Grid.Column="3"><TextBlock Text="ACTION RESULT" Classes="eyebrow" /><TextBlock x:Name="DockerActionStatusText" Text="No container action run." TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" /></StackPanel>
                            </Grid>
                          </Grid>
                        </Border>

                        <Border x:Name="DockerPortsPanel" Classes="inset" IsVisible="False" MinHeight="130" MaxHeight="200">
                          <Grid RowDefinitions="Auto,*" RowSpacing="6">
                            <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Published ports" Classes="sectionTitle" /><TextBlock Text="Container ports and host bindings." Classes="pageSubtitle" Margin="0,2,0,0" /></StackPanel><TextBlock Grid.Column="1" x:Name="DockerPortCountText" Text="0 ports" Classes="dim" VerticalAlignment="Center" /></Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="150"><TextBlock x:Name="DockerSelectedPortsText" Text="--" Classes="mono" TextWrapping="NoWrap" /></ScrollViewer>
                          </Grid>
                        </Border>

                        <Border x:Name="DockerMountsPanel" Classes="inset" IsVisible="False" MinHeight="130" MaxHeight="200">
                          <Grid RowDefinitions="Auto,*" RowSpacing="6">
                            <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Mounts" Classes="sectionTitle" /><TextBlock Text="Source, destination and access mode." Classes="pageSubtitle" Margin="0,2,0,0" /></StackPanel><TextBlock Grid.Column="1" x:Name="DockerMountCountText" Text="0 mounts" Classes="dim" VerticalAlignment="Center" /></Grid>
                            <TextBox Grid.Row="1" x:Name="DockerSelectedMountsText" Classes="console workspaceOutput" MinHeight="90" MaxHeight="150" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                          </Grid>
                        </Border>

                        <Border x:Name="DockerEnvironmentPanel" Classes="inset" IsVisible="False" MinHeight="130" MaxHeight="200">
                          <Grid RowDefinitions="Auto,*" RowSpacing="6">
                            <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Environment-variable names" Classes="sectionTitle" /><TextBlock Text="Names only. Values never enter the view model." Classes="pageSubtitle" Margin="0,2,0,0" /></StackPanel><TextBlock Grid.Column="1" x:Name="DockerEnvironmentCountText" Text="0 names" Classes="dim" VerticalAlignment="Center" /></Grid>
                            <TextBox Grid.Row="1" x:Name="DockerSelectedEnvironmentText" Classes="console workspaceOutput" MinHeight="90" MaxHeight="150" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                          </Grid>
                        </Border>
                      </Grid>
                    </Grid>
                  </Border>

                  <Border Classes="module adaptive">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel>
                          <TextBlock Text="Recent container logs" Classes="sectionTitle" />
                          <TextBlock
                              x:Name="DockerLogsStatusText"
                              Text="Not captured"
                              Classes="pageSubtitle"
                              Margin="0,3,0,0"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                          <Button
                              x:Name="DockerCleanedLogsButton"
                              Classes="segment compact"
                              Content="Cleaned"
                              Margin="0,0,6,0"
                              Click="DockerCleanedLogsButton_OnClick" />
                          <Button
                              x:Name="DockerRawLogsButton"
                              Classes="segment compact"
                              Content="Raw"
                              Margin="0,0,8,0"
                              Click="DockerRawLogsButton_OnClick" />
                          <TextBox
                              x:Name="DockerLogFilterText"
                              Classes="filter"
                              Width="220"
                              PlaceholderText="Filter source, file or message"
                              Margin="0,0,8,0"
                              TextChanged="DockerLogFilterText_OnTextChanged" />
                          <Button
                              x:Name="DockerRefreshLogsButton"
                              Classes="compact"
                              Content="Refresh logs"
                              Margin="0,0,8,0"
                              Click="DockerRefreshLogsButton_OnClick" />
                          <Button
                              x:Name="DockerCopyCleanedLogsButton"
                              Classes="compact"
                              Content="Copy cleaned"
                              Margin="0,0,6,0"
                              Click="DockerCopyCleanedLogsButton_OnClick" />
                          <Button
                              x:Name="DockerCopyRawLogsButton"
                              Classes="compact"
                              Content="Copy raw"
                              Click="DockerCopyRawLogsButton_OnClick" />
                        </WrapPanel>
                      </Grid>

                      <TextBox
                          Grid.Row="1"
                          x:Name="DockerLogsText"
                          Classes="console workspaceOutput"
                          MinHeight="190"
                          MaxHeight="500"
                          IsReadOnly="True"
                          AcceptsReturn="True"
                          TextWrapping="Wrap"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                  </Border>

                  <Border Classes="arrStatusBar" Margin="0,0,0,4">
                    <TextBlock
                        x:Name="DockerWorkspaceStatusText"
                        Text="Docker workspace capture pending."
                        Classes="muted"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- Storage -->
            <Grid
                x:Name="StoragePage"
                IsVisible="False"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="8">

              <Grid Grid.Row="0" ColumnDefinitions="*,220,Auto,Auto" ColumnSpacing="6">
                <StackPanel>
                  <TextBlock Text="Storage &amp; capacity" Classes="sectionTitle" FontSize="18" />
                  <TextBlock Text="Mount identity, free space, capacity policy and dependency ownership." Classes="pageSubtitle" />
                </StackPanel>
                <TextBox Grid.Column="1" x:Name="StorageFilterText" Classes="filter" PlaceholderText="Filter mounts" TextChanged="StorageFilterText_OnTextChanged" />
                <Button Grid.Column="2" x:Name="StorageThresholdButton" Content="Thresholds..." Click="StorageThresholdButton_OnClick" />
                <Button Grid.Column="3" x:Name="RestoreStorageThresholdButton" Content="Restore defaults" Click="RestoreStorageThresholdButton_OnClick" />
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Classes="metric"><StackPanel><TextBlock Text="STORAGE ROOTS" Classes="eyebrow" /><TextBlock x:Name="StorageSummaryText" Text="0 mounts" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Grid.Column="1" Classes="metric"><StackPanel><TextBlock Text="SMART HEALTH" Classes="eyebrow" /><TextBlock Text="ON DEMAND" FontSize="14" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Column="2" Classes="metric"><StackPanel><TextBlock Text="HOTTEST DRIVE" Classes="eyebrow" /><TextBlock Text="ON DEMAND" FontSize="14" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Column="3" Classes="metric"><StackPanel><TextBlock Text="POLICY" Classes="eyebrow" /><TextBlock x:Name="StorageSelectedPolicyTitleText" Text="Select a mount" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
              </Grid>

              <ListBox
                  Grid.Row="2"
                  x:Name="StorageList"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="0"
                  SelectionChanged="StorageList_OnSelectionChanged">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <Border Classes="module" Width="345" Height="155" Margin="0,0,7,7">
                      <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="{ReflectionBinding Source}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{ReflectionBinding MountPoint}" Classes="dim" FontSize="8.5" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{ReflectionBinding StatusLabel}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                          <TextBlock Text="CAPACITY" Classes="eyebrow" />
                          <TextBlock Grid.Column="1" Text="{ReflectionBinding PercentUsed}" FontSize="16" FontWeight="SemiBold" />
                        </Grid>
                        <Border Grid.Row="2" Height="5" Background="{DynamicResource Surface3Brush}" CornerRadius="3" />
                        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                          <StackPanel><TextBlock Text="USED" Classes="eyebrow" /><TextBlock Text="{ReflectionBinding Used}" /></StackPanel>
                          <StackPanel Grid.Column="1"><TextBlock Text="FREE" Classes="eyebrow" /><TextBlock Text="{ReflectionBinding Available}" /></StackPanel>
                          <StackPanel Grid.Column="2"><TextBlock Text="FILESYSTEM" Classes="eyebrow" /><TextBlock Text="{ReflectionBinding FileSystem}" /></StackPanel>
                          <StackPanel Grid.Row="1"><TextBlock Text="POLICY" Classes="eyebrow" /><TextBlock Text="{ReflectionBinding PolicyLabel}" /></StackPanel>
                          <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"><TextBlock Text="SIZE" Classes="eyebrow" /><TextBlock Text="{ReflectionBinding Size}" /></StackPanel>
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Grid Grid.Row="3" ColumnDefinitions="1.3*,0.7*" ColumnSpacing="8" VerticalAlignment="Top">
                <Border Classes="module">
                  <StackPanel>
                    <TextBlock Text="Capacity policy" Classes="sectionTitle" />
                    <TextBlock x:Name="StoragePolicyStatusText" Text="Select a mount to inspect its policy." Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="module">
                  <StackPanel>
                    <TextBlock Text="Dependency map" Classes="sectionTitle" />
                    <TextBlock Text="Host → storage roots&#10;Storage → Docker / container data&#10;Storage → media applications&#10;Applications → workflow / library availability" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>

            <!-- Logs -->
            <Grid
                x:Name="LogsPage"
                IsVisible="False">

              <ScrollViewer
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="10" Margin="0,0,4,4">
                  <StackPanel>
                    <TextBlock Text="Log Center" Classes="sectionTitle" FontSize="18" />
                    <TextBlock
                        Text="Grouped system-journal evidence with explicit filters, empty-state reasons and selected-event detail."
                        Classes="pageSubtitle"
                        Margin="0,3,0,0" />
                  </StackPanel>

                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Border Classes="metric">
                      <StackPanel>
                        <TextBlock Text="WARNING / ERROR" Classes="eyebrow" />
                        <TextBlock x:Name="LogsActiveMetricText" Text="0" Classes="metricValue" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="metric">
                      <StackPanel>
                        <TextBlock Text="INFORMATIONAL" Classes="eyebrow" />
                        <TextBlock x:Name="LogsBackgroundMetricText" Text="0" Classes="metricValue" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="metric">
                      <StackPanel>
                        <TextBlock Text="VISIBLE" Classes="eyebrow" />
                        <TextBlock x:Name="LogsVisibleMetricText" Text="0" Classes="metricValue" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="metric">
                      <StackPanel>
                        <TextBlock Text="VISIBLE SOURCES" Classes="eyebrow" />
                        <TextBlock x:Name="LogsSourceMetricText" Text="0" Classes="metricValue" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Border Classes="module adaptive">
                    <StackPanel Spacing="8">
                      <WrapPanel>
                        <ComboBox
                            x:Name="LogsSeverityFilterComboBox"
                            Width="150"
                            Margin="0,0,7,7"
                            SelectionChanged="LogsReliabilityFilter_OnChanged" />
                        <ComboBox
                            x:Name="LogsTimeFilterComboBox"
                            Width="135"
                            Margin="0,0,7,7"
                            SelectionChanged="LogsReliabilityFilter_OnChanged" />
                        <TextBox
                            x:Name="LogsSourceFilterText"
                            Classes="filter"
                            Width="175"
                            PlaceholderText="Filter source"
                            Margin="0,0,7,7"
                            TextChanged="LogsSourceFilterText_OnTextChanged" />
                        <TextBox
                            x:Name="LogsTextFilterText"
                            Classes="filter"
                            Width="240"
                            PlaceholderText="Filter message"
                            Margin="0,0,7,7"
                            TextChanged="LogsTextFilterText_OnTextChanged" />
                        <CheckBox
                            x:Name="ShowInformationalLogsCheckBox"
                            Content="Include informational"
                            VerticalAlignment="Center"
                            Margin="0,0,10,7"
                            Click="ShowInformationalLogsCheckBox_OnClick" />
                        <Button
                            Classes="compact"
                            Content="Reset filters"
                            Margin="0,0,0,7"
                            Click="LogsResetFiltersButton_OnClick" />
                      </WrapPanel>
                      <TextBlock
                          x:Name="LogsFilterStatusText"
                          Text="Journal filters are ready."
                          Classes="dim"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Classes="module adaptive" MinHeight="270" MaxHeight="430">
                    <Grid RowDefinitions="Auto,*" RowSpacing="6">
                      <Border Classes="tableHeaderBar">
                        <Grid ColumnDefinitions="95,150,135,70,*" ColumnSpacing="8">
                          <TextBlock Text="SEVERITY" Classes="tableColumnHeader" />
                          <TextBlock Grid.Column="1" Text="SOURCE" Classes="tableColumnHeader" />
                          <TextBlock Grid.Column="2" Text="LAST SEEN" Classes="tableColumnHeader" />
                          <TextBlock Grid.Column="3" Text="COUNT" Classes="tableColumnHeader" />
                          <TextBlock Grid.Column="4" Text="MESSAGE" Classes="tableColumnHeader" />
                        </Grid>
                      </Border>

                      <Grid Grid.Row="1">
                        <ListBox
                            x:Name="LogsList"
                            Classes="dataList"
                            SelectionChanged="LogsList_OnSelectionChanged">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                              <Grid ColumnDefinitions="95,150,135,70,*" ColumnSpacing="8">
                                <TextBlock
                                    Text="{ReflectionBinding SeverityLabel}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{ReflectionBinding Source}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{ReflectionBinding DisplayTime}"
                                    Classes="dim" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{ReflectionBinding Count}" />
                                <TextBlock
                                    Grid.Column="4"
                                    Text="{ReflectionBinding Message}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip.Tip="{ReflectionBinding Message}" />
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>

                        <Border
                            x:Name="LogsEmptyState"
                            Classes="emptyState"
                            IsVisible="False"
                            VerticalAlignment="Top">
                          <StackPanel>
                            <TextBlock
                                x:Name="LogsEmptyTitleText"
                                Text="No visible journal evidence"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="LogsEmptyDetailText"
                                Text="No journal group matches the current filters."
                                Classes="muted"
                                Margin="0,3,0,0"
                                TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Grid>
                  </Border>

                  <Border Classes="module adaptive" MinHeight="180" MaxHeight="270">
                    <Grid RowDefinitions="Auto,*" RowSpacing="6">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel>
                          <TextBlock Text="Selected event detail" Classes="sectionTitle" />
                          <TextBlock
                              x:Name="LogsSelectedTitleText"
                              Text="No journal group selected"
                              Classes="pageSubtitle"
                              Margin="0,3,0,0" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            x:Name="LogsCopyDetailButton"
                            Classes="compact"
                            Content="Copy detail"
                            IsEnabled="False"
                            Margin="0,0,6,0"
                            Click="LogsCopyDetailButton_OnClick" />
                        <Button
                            Grid.Column="2"
                            Classes="compact"
                            Content="Intelligence"
                            Click="LogsOpenIntelligenceButton_OnClick" />
                      </Grid>
                      <TextBox
                          Grid.Row="1"
                          x:Name="LogDetailText"
                          Classes="console workspaceOutput"
                          MinHeight="120"
                          IsReadOnly="True"
                          AcceptsReturn="True"
                          TextWrapping="Wrap"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                  </Border>

                  <Border Classes="arrStatusBar">
                    <TextBlock
                        x:Name="LogsSummaryText"
                        Text="0 shown · 0 warning/error · 0 informational"
                        Classes="muted"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>
            <!-- Intelligence -->
            <Grid
                x:Name="IntelligencePage"
                IsVisible="False"
                RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                RowSpacing="8">

              <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                <StackPanel>
                  <TextBlock Text="Control plane intelligence" Classes="sectionTitle" FontSize="18" />
                  <TextBlock Text="Root cause, dependency impact and the safest next control from live GraveOps telemetry." Classes="pageSubtitle" />
                </StackPanel>
                <Button Grid.Column="1" Content="State history" Margin="0,0,5,0" Click="IntelligenceOpenHistoryButton_OnClick" />
                <Button Grid.Column="2" Content="Analyze now" Classes="primary" Click="IntelligenceCopyReportButton_OnClick" />
              </Grid>

              <Border Grid.Row="1" Classes="module adaptive" MinHeight="108">
                <Grid RowDefinitions="Auto,*" RowSpacing="5">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="Environment context" Classes="sectionTitle" />
                      <TextBlock Text="Fleet-wide impact before selected-host root-cause analysis." Classes="pageSubtitle" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Environment dashboard" Tag="DashboardNav" Click="DashboardQuickModuleButton_OnClick" />
                  </Grid>
                  <Grid Grid.Row="1" ColumnDefinitions="170,*,Auto" ColumnSpacing="8">
                    <Border Classes="inset">
                      <StackPanel><TextBlock Text="ENVIRONMENT" Classes="eyebrow" /><Border x:Name="IntelligenceSeverityBorder" Classes="badge" HorizontalAlignment="Left"><TextBlock x:Name="IntelligenceSeverityText" Text="WAITING" FontWeight="SemiBold" /></Border></StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Name="IntelligenceHeadlineText" Text="Refresh the environment to run analysis." FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock x:Name="IntelligenceCopyStatusText" Text="No report copied." Classes="dim" FontSize="8.5" />
                    </StackPanel>
                    <ListBox Grid.Column="2" x:Name="IntelligenceImpactList" Width="340" MinHeight="54" MaxHeight="112" Classes="dataList" SelectionChanged="IntelligenceImpactList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="100,100,*" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding HostName}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Component}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Issue}" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Grid>
              </Border>

              <Border Grid.Row="2" Classes="module adaptive" MinHeight="94">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Guided remediation" Classes="sectionTitle" />
                    <TextBlock Text="Upstream-first troubleshooting from environment ownership and live telemetry." Classes="pageSubtitle" />
                    <ListBox x:Name="IntelligenceRemediationList" MinHeight="42" MaxHeight="98" Margin="0,6,0,0" Classes="dataList" SelectionChanged="IntelligenceRemediationList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="32,90,135,*,*" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding Step}" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding SeverityLabel}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Component}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Why}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding NextStep}" Classes="dim" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="IntelligenceStageActionButton" Content="Open selected" IsEnabled="False" VerticalAlignment="Bottom" Margin="8,0,0,0" Click="IntelligenceStageActionButton_OnClick" />
                </Grid>
              </Border>

              <Grid Grid.Row="3" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Classes="metric"><StackPanel><TextBlock Text="OVERALL" Classes="eyebrow" /><TextBlock x:Name="IntelligenceOverallMetricText" Text="WAITING" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="1" Classes="metric"><StackPanel><TextBlock Text="BLOCKERS" Classes="eyebrow" /><TextBlock x:Name="IntelligenceBlockersMetricText" Text="0" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="2" Classes="metric"><StackPanel><TextBlock Text="WARNINGS" Classes="eyebrow" /><TextBlock x:Name="IntelligenceWarningsMetricText" Text="0" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="3" Classes="metric"><StackPanel><TextBlock Text="ROOT CAUSE" Classes="eyebrow" /><TextBlock x:Name="IntelligenceRootCauseMetricText" Text="--" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
              </Grid>

              <Grid Grid.Row="4" ColumnDefinitions="0.9*,1.1*" ColumnSpacing="8">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <StackPanel><TextBlock Text="Dependency state" Classes="sectionTitle" /><TextBlock Text="Read upstream to downstream. A higher fault can explain several lower-level symptoms." Classes="pageSubtitle" /></StackPanel>
                    <ListBox Grid.Row="1" x:Name="IntelligenceDependencyList" Classes="dataList" SelectionChanged="IntelligenceDependencyList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="34,120,90,90,*" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding Order}" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Component}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding State}" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding SeverityLabel}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Evidence}" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel><TextBlock Text="Priority findings" Classes="sectionTitle" /><TextBlock Text="Ranked by impact. Healthy context stays compact." Classes="pageSubtitle" /></StackPanel>
                      <TextBlock Grid.Column="1" x:Name="IntelligenceCountText" Text="0 findings" Classes="dim" />
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="IntelligenceFindingsList" Classes="dataList" SelectionChanged="IntelligenceFindingsList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="90,130,*,*" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding Severity}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Component}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Problem}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Impact}" Classes="dim" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </Grid>

              <Border Grid.Row="5" Classes="module adaptive" MinHeight="88">
                <Grid ColumnDefinitions="180,*,Auto,Auto" ColumnSpacing="8">
                  <StackPanel>
                    <TextBlock x:Name="IntelligenceSelectedTitleText" Text="No finding selected" FontWeight="SemiBold" />
                    <TextBlock x:Name="IntelligenceRootCauseText" Text="No active fault detected" Classes="dim" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBox Grid.Column="1" x:Name="IntelligenceSelectedDetailText" Classes="console workspaceOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                  <Button Grid.Column="2" x:Name="IntelligenceOpenRelatedButton" Content="Open related" IsEnabled="False" Click="IntelligenceOpenRelatedButton_OnClick" />
                  <Button Grid.Column="3" Content="Copy report" Click="IntelligenceCopyReportButton_OnClick" />
                </Grid>
              </Border>
            </Grid>
            <!-- Lifecycle -->
            <Grid
                x:Name="LifecyclePage"
                IsVisible="False"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="8">

              <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Classes="metric"><StackPanel><TextBlock Text="ACTIVE ITEMS" Classes="eyebrow" /><TextBlock x:Name="LifecycleActiveMetricText" Text="0" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="1" Classes="metric"><StackPanel><TextBlock Text="NEEDS ATTENTION" Classes="eyebrow" /><TextBlock x:Name="LifecycleAttentionMetricText" Text="0" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="2" Classes="metric"><StackPanel><TextBlock Text="DOWNLOADING" Classes="eyebrow" /><TextBlock x:Name="LifecycleDownloadingMetricText" Text="0" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="3" Classes="metric"><StackPanel><TextBlock Text="IMPORT / RECONCILE" Classes="eyebrow" /><TextBlock x:Name="LifecycleImportMetricText" Text="0" Classes="metricValue" /></StackPanel></Border>
              </Grid>

              <Border Grid.Row="1" Classes="module adaptive" MinHeight="112">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="Workflow" Classes="sectionTitle" />
                      <TextBlock Text="Request → Discovery → Arr → Download → Import → Processing → Library" Classes="pageSubtitle" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="LifecycleSummaryText" Text="Waiting for capture" Classes="dim" VerticalAlignment="Center" />
                  </Grid>
                  <ListBox
                      Grid.Row="1"
                      x:Name="LifecycleStagesList"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Classes="inset" Width="155" Height="60" Margin="0,0,5,0">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{ReflectionBinding Stage}" Classes="eyebrow" />
                            <TextBlock Text="{ReflectionBinding State}" FontWeight="SemiBold" />
                            <TextBlock Text="{ReflectionBinding Evidence}" Classes="dim" FontSize="8" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Grid Grid.Row="2" ColumnDefinitions="1.25*,0.75*" ColumnSpacing="8" MinHeight="290">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <StackPanel>
                      <TextBlock Text="Active lifecycle items" Classes="sectionTitle" />
                      <TextBlock Text="Correlated Arr and downloader work. Select an item to open its owner." Classes="pageSubtitle" />
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="LifecycleItemsList" Classes="dataList" SelectionChanged="LifecycleItemsList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="1.2*,110,90,100,80,80" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding Item}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Owner}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Stage}" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding State}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Progress}" />
                            <TextBlock Grid.Column="5" Text="{ReflectionBinding Remaining}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Classes="module">
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="5">
                    <StackPanel>
                      <TextBlock Text="Guided remediation" Classes="sectionTitle" />
                      <TextBlock Text="Upstream-first next steps. GraveOps avoids downstream restarts when an earlier dependency explains the symptom." Classes="pageSubtitle" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="LifecycleRemediationList" Classes="dataList" SelectionChanged="LifecycleRemediationList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <StackPanel Spacing="3">
                            <Grid ColumnDefinitions="32,*,Auto">
                              <TextBlock Text="{ReflectionBinding Step}" />
                              <TextBlock Grid.Column="1" Text="{ReflectionBinding Component}" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="2" Text="{ReflectionBinding SeverityLabel}" Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                            <TextBlock Text="{ReflectionBinding Why}" TextWrapping="Wrap" />
                            <TextBlock Text="{ReflectionBinding NextStep}" Classes="dim" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" x:Name="LifecycleOpenOwnerButton" Content="Open selected step" IsEnabled="False" Click="LifecycleOpenOwnerButton_OnClick" />
                  </Grid>
                </Border>
              </Grid>

              <Border Grid.Row="3" Classes="module adaptive" MinHeight="88">
                <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="8">
                  <StackPanel>
                    <TextBlock x:Name="LifecycleSelectedTitleText" Text="No lifecycle item selected" FontWeight="SemiBold" />
                    <TextBlock Text="Selected item" Classes="dim" />
                  </StackPanel>
                  <TextBox Grid.Column="1" x:Name="LifecycleSelectedDetailText" Classes="console workspaceOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                  <Button Grid.Column="2" Content="Intelligence" Click="LifecycleOpenIntelligenceButton_OnClick" />
                </Grid>
              </Border>
            </Grid>
            <!-- History -->
            <Grid
                x:Name="HistoryPage"
                IsVisible="False">

              <ScrollViewer
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="10" Margin="0,0,4,4">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel>
                      <TextBlock
                          Text="History &amp; incidents"
                          Classes="sectionTitle"
                          FontSize="18" />
                      <TextBlock
                          Text="Classified transitions, meaningful control-plane activity and replayable evidence."
                          Classes="pageSubtitle"
                          Margin="0,3,0,0" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        x:Name="HistoryCopyReplayButton"
                        Classes="compact"
                        Content="Copy replay"
                        IsEnabled="False"
                        Margin="0,0,6,0"
                        Click="HistoryCopyReplayButton_OnClick" />
                    <Button
                        Grid.Column="2"
                        Classes="danger compact"
                        Content="Clear history"
                        Click="HistoryClearAllButton_OnClick" />
                  </Grid>

                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Border Classes="metric">
                      <StackPanel>
                        <TextBlock Text="VISIBLE TRANSITIONS" Classes="eyebrow" />
                        <TextBlock x:Name="HistoryTransitionMetricText" Text="0" Classes="metricValue" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="metric">
                      <StackPanel>
                        <TextBlock Text="VISIBLE ACTIVITY" Classes="eyebrow" />
                        <TextBlock x:Name="HistoryActivityMetricText" Text="0" Classes="metricValue" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="metric">
                      <StackPanel>
                        <TextBlock Text="VISIBLE INCIDENTS" Classes="eyebrow" />
                        <TextBlock x:Name="HistoryIncidentMetricText" Text="0" Classes="metricValue" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="metric">
                      <StackPanel>
                        <TextBlock Text="VISIBLE / RETAINED" Classes="eyebrow" />
                        <TextBlock x:Name="HistoryRetentionMetricText" Text="0/0" Classes="metricValue" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Border Classes="module adaptive">
                    <StackPanel Spacing="8">
                      <WrapPanel>
                        <ComboBox
                            x:Name="HistoryClassFilterComboBox"
                            Width="165"
                            Margin="0,0,7,7"
                            SelectionChanged="HistoryReliabilityFilter_OnChanged" />
                        <ComboBox
                            x:Name="HistorySeverityFilterComboBox"
                            Width="150"
                            Margin="0,0,7,7"
                            SelectionChanged="HistoryReliabilityFilter_OnChanged" />
                        <ComboBox
                            x:Name="HistoryTimeFilterComboBox"
                            Width="135"
                            Margin="0,0,7,7"
                            SelectionChanged="HistoryReliabilityFilter_OnChanged" />
                        <TextBox
                            x:Name="HistorySourceFilterText"
                            Classes="filter"
                            Width="170"
                            PlaceholderText="Target, source or stream"
                            Margin="0,0,7,7"
                            TextChanged="HistorySourceFilterText_OnTextChanged" />
                        <TextBox
                            x:Name="HistoryFilterText"
                            Classes="filter"
                            Width="225"
                            PlaceholderText="Filter event or evidence"
                            Margin="0,0,7,7"
                            TextChanged="HistoryFilterText_OnTextChanged" />
                        <Button
                            Classes="compact"
                            Content="Reset filters"
                            Margin="0,0,0,7"
                            Click="HistoryResetFiltersButton_OnClick" />
                      </WrapPanel>
                      <TextBlock
                          x:Name="HistoryFilterStatusText"
                          Text="History filters are ready."
                          Classes="dim"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Grid
                      ColumnDefinitions="1.05*,0.95*"
                      ColumnSpacing="8"
                      MinHeight="300"
                      MaxHeight="430">
                    <Border Classes="module">
                      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                        <StackPanel>
                          <TextBlock Text="Health transitions" Classes="sectionTitle" />
                          <TextBlock
                              Text="Repeated identical changes collapse visually while retained source events remain untouched."
                              Classes="pageSubtitle"
                              TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Row="1" Classes="tableHeaderBar">
                          <Grid ColumnDefinitions="120,110,140,*,*" ColumnSpacing="6">
                            <TextBlock Text="TIME" Classes="tableColumnHeader" />
                            <TextBlock Grid.Column="1" Text="TARGET" Classes="tableColumnHeader" />
                            <TextBlock Grid.Column="2" Text="COMPONENT" Classes="tableColumnHeader" />
                            <TextBlock Grid.Column="3" Text="TRANSITION" Classes="tableColumnHeader" />
                            <TextBlock Grid.Column="4" Text="DETAIL" Classes="tableColumnHeader" />
                          </Grid>
                        </Border>
                        <Grid Grid.Row="2">
                          <ListBox
                              x:Name="HistoryTransitionsList"
                              Classes="dataList"
                              SelectionChanged="HistoryTransitionsList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="120,110,140,*,*" ColumnSpacing="6">
                                  <TextBlock Text="{ReflectionBinding DisplayTime}" Classes="dim" />
                                  <TextBlock Grid.Column="1" Text="{ReflectionBinding Target}" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="2" Text="{ReflectionBinding Component}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="3" Text="{ReflectionBinding Transition}" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="4" Text="{ReflectionBinding Detail}" Classes="dim" TextTrimming="CharacterEllipsis" />
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                          <Border
                              x:Name="HistoryTransitionsEmptyState"
                              Classes="emptyState"
                              IsVisible="False"
                              VerticalAlignment="Top">
                            <StackPanel>
                              <TextBlock Text="No visible health transitions" FontWeight="SemiBold" />
                              <TextBlock
                                  x:Name="HistoryTransitionsEmptyText"
                                  Text="No transition matches the current filters."
                                  Classes="muted"
                                  Margin="0,3,0,0"
                                  TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </Grid>
                      </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="module">
                      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                        <StackPanel>
                          <TextBlock Text="Meaningful activity" Classes="sectionTitle" />
                          <TextBlock
                              Text="Navigation noise is hidden by default and remains available through All events or Navigation."
                              Classes="pageSubtitle"
                              TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Row="1" Classes="tableHeaderBar">
                          <Grid ColumnDefinitions="115,125,130,*" ColumnSpacing="6">
                            <TextBlock Text="TIME" Classes="tableColumnHeader" />
                            <TextBlock Grid.Column="1" Text="CLASS" Classes="tableColumnHeader" />
                            <TextBlock Grid.Column="2" Text="TARGET" Classes="tableColumnHeader" />
                            <TextBlock Grid.Column="3" Text="EVENT" Classes="tableColumnHeader" />
                          </Grid>
                        </Border>
                        <Grid Grid.Row="2">
                          <ListBox
                              x:Name="HistoryActivityList"
                              Classes="dataList"
                              SelectionChanged="HistoryActivityList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="115,125,130,*" ColumnSpacing="6">
                                  <TextBlock Text="{ReflectionBinding DisplayTime}" Classes="dim" />
                                  <TextBlock Grid.Column="1" Text="{ReflectionBinding Stream}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="2" Text="{ReflectionBinding Target}" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="3" Text="{ReflectionBinding Transition}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                          <Border
                              x:Name="HistoryActivityEmptyState"
                              Classes="emptyState"
                              IsVisible="False"
                              VerticalAlignment="Top">
                            <StackPanel>
                              <TextBlock Text="No visible activity" FontWeight="SemiBold" />
                              <TextBlock
                                  x:Name="HistoryActivityEmptyText"
                                  Text="No activity row matches the current filters."
                                  Classes="muted"
                                  Margin="0,3,0,0"
                                  TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </Grid>
                      </Grid>
                    </Border>
                  </Grid>

                  <Border Classes="module adaptive" MinHeight="180" MaxHeight="270">
                    <Grid RowDefinitions="Auto,*" RowSpacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="Incident replay" Classes="sectionTitle" />
                          <TextBlock
                              x:Name="HistorySelectedTitleText"
                              Text="Select a transition or activity row."
                              Classes="pageSubtitle" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            x:Name="HistoryOpenRelatedButton"
                            Classes="compact"
                            Content="Open related"
                            IsEnabled="False"
                            Click="HistoryOpenRelatedButton_OnClick" />
                      </Grid>
                      <Grid Grid.Row="1" ColumnDefinitions="0.8*,1.2*" ColumnSpacing="6">
                        <TextBox
                            x:Name="HistorySelectedDetailText"
                            Classes="console workspaceOutput"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <TextBox
                            Grid.Column="1"
                            x:Name="HistoryReplayText"
                            Classes="console workspaceOutput"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                      </Grid>
                    </Grid>
                  </Border>

                  <Border Classes="arrStatusBar">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock
                          x:Name="HistoryCopyStatusText"
                          Text="No replay copied."
                          Classes="muted"
                          TextWrapping="NoWrap"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock
                          Grid.Column="1"
                          x:Name="HistoryCachePathText"
                          Text="Fleet cache"
                          Classes="dim"
                          MaxWidth="520"
                          TextTrimming="CharacterEllipsis"
                          ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Grid>
                  </Border>

                  <ListBox
                      x:Name="HistoryIncidentList"
                      IsVisible="False"
                      SelectionChanged="HistoryIncidentList_OnSelectionChanged" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
            <!-- Backups -->
            <Grid
                x:Name="BackupsPage"
                IsVisible="False"
                RowDefinitions="Auto,Auto,*,Auto"
                RowSpacing="8">

              <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Classes="metric">
                  <StackPanel Spacing="3"><TextBlock Text="READINESS" Classes="eyebrow" /><Border x:Name="BackupStateBorder" Classes="badge" HorizontalAlignment="Left"><TextBlock x:Name="BackupStateText" Text="WAITING" FontWeight="SemiBold" /></Border></StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="metric"><StackPanel Spacing="3"><TextBlock Text="PROVIDER" Classes="eyebrow" /><TextBlock x:Name="BackupProviderText" Text="--" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="2" Classes="metric"><StackPanel Spacing="3"><TextBlock Text="SUMMARY" Classes="eyebrow" /><TextBlock x:Name="BackupSummaryText" Text="Waiting for capture" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Grid.Column="3" Classes="metric"><StackPanel Spacing="3"><TextBlock Text="OPERATIONS" Classes="eyebrow" /><TextBlock Text="PROTECTED" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Mutations remain guarded" Classes="dim" FontSize="8.5" /></StackPanel></Border>
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="1.5*,0.5*" ColumnSpacing="8" Height="170">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <StackPanel>
                      <TextBlock Text="Backup inventory" Classes="sectionTitle" />
                      <TextBlock Text="Schedule, recovery work and provider evidence reported by the active host." Classes="pageSubtitle" />
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="BackupEvidenceList" Classes="dataList" />
                  </Grid>
                </Border>
                <Border Grid.Column="1" Classes="module">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Operations" Classes="sectionTitle" />
                    <TextBlock Text="Backup mutations belong in protected actions or the provider integration." Classes="pageSubtitle" TextWrapping="Wrap" />
                    <Button Content="Services &amp; Actions" Tag="ServicesNav" Click="DashboardQuickModuleButton_OnClick" />
                    <Button Content="Open terminal" Tag="ToolsNav" Click="DashboardQuickModuleButton_OnClick" />
                  </StackPanel>
                </Border>
              </Grid>

              <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <TextBlock Text="Schedules &amp; units" Classes="sectionTitle" />
                    <ListBox Grid.Row="1" x:Name="BackupUnitsList" Classes="dataList">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="170,100,100,*" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding Unit}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Active}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding SubState}" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Enabled}" Classes="dim" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
                <Border Grid.Column="1" Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <TextBlock Text="Recent artifacts" Classes="sectionTitle" />
                    <ListBox Grid.Row="1" x:Name="BackupArtifactsList" Classes="dataList">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="*,110,130" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding Path}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Size}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding LocalModifiedAt}" Classes="dim" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </Grid>

              <Border Grid.Row="3" Classes="module">
                <StackPanel>
                  <TextBlock Text="Shareable by design" Classes="sectionTitle" />
                  <TextBlock Text="No repository path, password, host mount or backup schedule is hard-coded into GraveOps. This page reports what the active provider can safely observe." Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- Settings -->
            <Grid
                x:Name="SettingsPage"
                IsVisible="False"
                ColumnDefinitions="1.05*,0.95*"
                RowDefinitions="Auto,*"
                ColumnSpacing="8"
                RowSpacing="8">

              <StackPanel Grid.ColumnSpan="2">
                <TextBlock Text="Settings" Classes="sectionTitle" FontSize="18" />
                <TextBlock Text="Linux paths, operator defaults, policies and version state in the shared GraveOps visual system." Classes="pageSubtitle" />
              </StackPanel>

              <Border Grid.Row="1" Classes="module">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="7">
                  <StackPanel>
                    <TextBlock Text="Operator defaults" Classes="sectionTitle" />
                    <TextBlock Text="Stored in operator-settings.json and applied when GraveOps starts." Classes="pageSubtitle" />
                  </StackPanel>
                  <CheckBox Grid.Row="1" x:Name="SettingsSafeModeCheckBox" Content="Start in Safe Mode" />
                  <CheckBox Grid.Row="2" x:Name="SettingsInformationalLogsCheckBox" Content="Show informational log observations by default" />
                  <CheckBox Grid.Row="3" x:Name="SettingsInformationalContainersCheckBox" Content="Show informational exited containers by default" />
                  <CheckBox Grid.Row="4" x:Name="SettingsOpenOverviewCheckBox" Content="Open Overview after startup" />
                  <CheckBox Grid.Row="5" x:Name="SettingsDesktopNotificationsCheckBox" Content="Show desktop notifications for new error-level incidents" />
                  <Grid Grid.Row="6" ColumnDefinitions="220,100,*" ColumnSpacing="6">
                    <TextBlock Text="Background refresh seconds" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" x:Name="SettingsBackgroundRefreshSecondsTextBox" />
                    <WrapPanel Grid.Column="2">
                      <Button Content="Save settings" Classes="primary" Margin="0,0,5,0" Click="SaveOperatorSettingsButton_OnClick" />
                      <Button Content="Restore defaults" Click="ResetOperatorSettingsButton_OnClick" />
                    </WrapPanel>
                  </Grid>
                  <TextBlock Grid.Row="7" x:Name="SettingsSaveStatusText" Text="Settings loaded." Classes="dim" />
                </Grid>
              </Border>

              <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                    <TextBlock Text="Policy management" Classes="sectionTitle" />
                    <TextBlock Grid.Row="1" x:Name="SettingsPolicySummaryText" Text="0 active policies" FontWeight="SemiBold" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                      <TextBlock x:Name="SettingsPolicyPathText" Text="--" Classes="dim" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1" Content="Dashboard policies" Tag="DashboardNav" Click="SettingsNavigateButton_OnClick" />
                      <Button Grid.Column="2" Content="Storage thresholds" Tag="StorageNav" Click="SettingsNavigateButton_OnClick" />
                    </Grid>
                  </Grid>
                </Border>

                <Border Grid.Row="1" Classes="module">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                    <TextBlock Text="Application paths" Classes="sectionTitle" />
                    <Grid Grid.Row="1" ColumnDefinitions="115,*,Auto,Auto" ColumnSpacing="5"><TextBlock Text="Config" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsConfigPathText" Text="--" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="Open" Tag="config" Click="OpenOperatorPathButton_OnClick" /><Button Grid.Column="3" Content="Terminal" Tag="config" Click="OpenOperatorTerminalButton_OnClick" /></Grid>
                    <Grid Grid.Row="2" ColumnDefinitions="115,*,Auto,Auto" ColumnSpacing="5"><TextBlock Text="Data" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsDataPathText" Text="--" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="Open" Tag="data" Click="OpenOperatorPathButton_OnClick" /><Button Grid.Column="3" Content="Terminal" Tag="data" Click="OpenOperatorTerminalButton_OnClick" /></Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="115,*,Auto,Auto" ColumnSpacing="5"><TextBlock Text="Repository" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsRepositoryPathText" Text="--" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="Open" Tag="repository" Click="OpenOperatorPathButton_OnClick" /><Button Grid.Column="3" Content="Terminal" Tag="repository" Click="OpenOperatorTerminalButton_OnClick" /></Grid>
                    <Grid Grid.Row="4" ColumnDefinitions="115,*,Auto,Auto" ColumnSpacing="5"><TextBlock Text="Diagnostics" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsDiagnosticsPathText" Text="--" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="Open" Tag="diagnostics" Click="OpenOperatorPathButton_OnClick" /><Button Grid.Column="3" Content="Terminal" Tag="diagnostics" Click="OpenOperatorTerminalButton_OnClick" /></Grid>
                    <TextBlock Grid.Row="5" x:Name="SettingsPathStatusText" Text="No path action run." Classes="dim" />
                    <TextBlock x:Name="SettingsPolicyFileText" IsVisible="False" />
                    <TextBlock x:Name="SettingsHistoryFileText" IsVisible="False" />
                  </Grid>
                </Border>

                <Border Grid.Row="2" Classes="module">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Version and update state" Classes="sectionTitle" /><Button Grid.Column="1" Content="Refresh version info" Click="RefreshVersionInfoButton_OnClick" /></Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="120,*"><TextBlock Text="Branch" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsBranchText" Text="--" /></Grid>
                    <Grid Grid.Row="2" ColumnDefinitions="120,*"><TextBlock Text="Commit" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsCommitText" Text="--" /></Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="120,*"><TextBlock Text="Worktree" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsWorktreeText" Text="--" /></Grid>
                    <Grid Grid.Row="4" ColumnDefinitions="120,*"><TextBlock Text="Origin" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsOriginText" Text="--" /></Grid>
                    <Grid Grid.Row="5" ColumnDefinitions="120,*"><TextBlock Text=".NET SDK" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsDotnetText" Text="--" /></Grid>
                  </Grid>
                </Border>
              </Grid>
            </Grid>

            <!-- Operator Tools -->
            <Grid
                x:Name="ToolsPage"
                IsVisible="False"
                RowDefinitions="Auto,Auto"
                RowSpacing="8">

              <StackPanel>
                <TextBlock Text="Operator tools" Classes="sectionTitle" FontSize="18" />
                <TextBlock Text="Redacted diagnostics, read-only validation and safe terminal handoff." Classes="pageSubtitle" />
              </StackPanel>

              <Grid Grid.Row="1" ColumnDefinitions="1.05*,0.95*" ColumnSpacing="8" VerticalAlignment="Top">
                <Border Classes="module adaptive">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">
                    <StackPanel>
                      <TextBlock Text="Diagnostics export" Classes="sectionTitle" />
                      <TextBlock Text="Creates a redacted local ZIP without configuration contents, API keys or passwords." Classes="pageSubtitle" />
                    </StackPanel>
                    <Border Grid.Row="1" Classes="inset"><TextBlock Text="Home paths, IP addresses and common secret patterns are redacted. Browser data and media files are excluded." Classes="muted" TextWrapping="Wrap" /></Border>
                    <WrapPanel Grid.Row="2">
                      <Button x:Name="CreateDiagnosticsButton" Content="Create diagnostics bundle" Classes="primary" Margin="0,0,5,0" Click="CreateDiagnosticsButton_OnClick" />
                      <Button Content="Open diagnostics folder" Tag="diagnostics" Click="OpenOperatorPathButton_OnClick" />
                    </WrapPanel>
                    <TextBlock Grid.Row="3" x:Name="DiagnosticsStatusText" Text="Ready to export." Classes="dim" />
                  </Grid>
                </Border>

                <Border Grid.Column="1" Classes="module adaptive">
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                    <StackPanel>
                      <TextBlock Text="Read-only validation" Classes="sectionTitle" />
                      <TextBlock Text="Checks paths, JSON stores, repository state and required launchers without changing services or policies." Classes="pageSubtitle" />
                    </StackPanel>
                    <Button Grid.Row="1" x:Name="RunValidationButton" Content="Run validation" HorizontalAlignment="Left" Click="RunValidationButton_OnClick" />
                    <TextBox Grid.Row="2" x:Name="ValidationOutputText" Classes="console workspaceOutput" MinHeight="220" MaxHeight="340" Text="Validation has not been run." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                  </Grid>
                </Border>

                <Border Grid.ColumnSpan="2" IsVisible="False">
                  <TextBlock x:Name="TerminalStatusText" />
                </Border>
              </Grid>
            </Grid>



          </Grid>

          <Border
              Grid.Row="3"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="14,0">

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Spacing="7">

                <TextBlock
                    Text="●"
                    FontSize="9"
                    Foreground="{DynamicResource SuccessBrush}" />

                <TextBlock
                    x:Name="FooterTargetText"
                    Text="No target"
                    Classes="muted"
                    FontSize="10" />

                <TextBlock Text="/" Classes="dim" FontSize="10" />

                <TextBlock
                    x:Name="FooterConnectionText"
                    Text="WAITING"
                    Classes="muted"
                    FontSize="10" />
              </StackPanel>

              <StackPanel
                  Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Spacing="7">

                <TextBlock
                    x:Name="FooterModeText"
                    Text="SAFE MODE"
                    Classes="muted"
                    FontSize="10" />

                <TextBlock Text="/" Classes="dim" FontSize="10" />

                <TextBlock
                    x:Name="FooterFindingsText"
                    Text="0 active"
                    Classes="muted"
                    FontSize="10" />

                <TextBlock Text="/" Classes="dim" FontSize="10" />

                <TextBlock
                    x:Name="FooterFreshnessText"
                    Text="waiting"
                    Classes="dim"
                    FontSize="10" />
              </StackPanel>
            </Grid>
          </Border>


          <Border
              x:Name="JobsDrawer"
              Grid.RowSpan="4"
              ZIndex="92"
              Width="500"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1,0,0,0"
              IsVisible="False">

            <Grid
                RowDefinitions="Auto,Auto,*,Auto"
                Margin="18">

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock
                      Text="Background Jobs"
                      FontSize="20"
                      FontWeight="SemiBold" />
                  <TextBlock
                      Text="Long-running and background control-plane work survives page navigation."
                      Classes="muted"
                      FontSize="10"
                      Margin="0,3,0,0"
                      TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="×"
                    Width="36"
                    Height="32"
                    Click="JobsCloseButton_OnClick" />
              </Grid>

              <TextBlock
                  Grid.Row="1"
                  x:Name="JobsSummaryText"
                  Text="0 running"
                  Classes="muted"
                  Margin="0,14,0,8" />

              <ListBox
                  Grid.Row="2"
                  x:Name="JobsList"
                  Classes="dataList passive">
                <ListBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Text="{ReflectionBinding Name}"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{ReflectionBinding State}"
                            Foreground="{DynamicResource AccentBrush}"
                            FontWeight="SemiBold" />
                      </Grid>

                      <TextBlock
                          Text="{ReflectionBinding Target}"
                          Classes="muted"
                          FontSize="10"
                          TextWrapping="Wrap" />

                      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="9">
                        <TextBlock
                            Text="{ReflectionBinding ProgressText}"
                            Classes="dim"
                            FontSize="9" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{ReflectionBinding DurationText}"
                            Classes="dim"
                            FontSize="9" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{ReflectionBinding DisplayTime}"
                            Classes="dim"
                            FontSize="9"
                            HorizontalAlignment="Right" />
                      </Grid>

                      <TextBlock
                          Text="{ReflectionBinding Detail}"
                          Classes="muted"
                          FontSize="10"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Button
                  Grid.Row="3"
                  Content="Clear completed"
                  HorizontalAlignment="Left"
                  Margin="0,12,0,0"
                  Click="ClearCompletedJobsButton_OnClick" />
            </Grid>
          </Border>

          <Border
              x:Name="ActivityDrawer"
              Grid.RowSpan="4"
              ZIndex="93"
              Width="560"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1,0,0,0"
              IsVisible="False">

            <Grid
                RowDefinitions="Auto,Auto,*,Auto"
                Margin="18">

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock
                      Text="Activity &amp; Notifications"
                      FontSize="20"
                      FontWeight="SemiBold" />
                  <TextBlock
                      Text="Targets, actions, failures, notifications and operator decisions."
                      Classes="muted"
                      FontSize="10"
                      Margin="0,3,0,0"
                      TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="×"
                    Width="36"
                    Height="32"
                    Click="ActivityCloseButton_OnClick" />
              </Grid>

              <Grid
                  Grid.Row="1"
                  ColumnDefinitions="220,*,Auto"
                  ColumnSpacing="8"
                  Margin="0,14,0,8">
                <ComboBox
                    x:Name="ActivityFilterComboBox"
                    SelectionChanged="ActivityFilterComboBox_OnSelectionChanged" />
                <TextBlock
                    Grid.Column="1"
                    x:Name="ActivitySummaryText"
                    Text="0 retained"
                    Classes="muted"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="2"
                    Content="Mark read"
                    Click="MarkActivityReadButton_OnClick" />
              </Grid>

              <ListBox
                  Grid.Row="2"
                  x:Name="ActivityList"
                  Classes="dataList"
                  DoubleTapped="ActivityList_OnDoubleTapped">
                <ListBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock
                            Text="{ReflectionBinding ReadState}"
                            Foreground="{DynamicResource AccentBrush}"
                            FontSize="9"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{ReflectionBinding Title}"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{ReflectionBinding Kind}"
                            Classes="dim"
                            FontSize="9" />
                      </Grid>

                      <TextBlock
                          Text="{ReflectionBinding Target}"
                          Classes="muted"
                          FontSize="10"
                          TextWrapping="Wrap" />

                      <TextBlock
                          Text="{ReflectionBinding Detail}"
                          Classes="muted"
                          FontSize="10"
                          TextWrapping="Wrap" />

                      <TextBlock
                          Text="{ReflectionBinding DisplayTime}"
                          Classes="dim"
                          FontSize="9" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Button
                  Grid.Row="3"
                  Content="Clear activity"
                  HorizontalAlignment="Left"
                  Margin="0,12,0,0"
                  Click="ClearActivityButton_OnClick" />
            </Grid>
          </Border>


          <Border
              x:Name="OverviewDrawer"
              Grid.RowSpan="4"
              ZIndex="90"
              Width="430"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1,0,0,0"
              IsVisible="False">

            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto,*"
                Margin="18">

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock
                      Text="Overview"
                      FontSize="20"
                      FontWeight="SemiBold" />

                  <TextBlock
                      Text="Current target, control-plane state and concise environment context."
                      Classes="muted"
                      FontSize="10"
                      Margin="0,3,0,0"
                      TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="×"
                    Width="36"
                    Height="32"
                    Click="OverviewCloseButton_OnClick" />
              </Grid>

              <Grid
                  Grid.Row="1"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="10"
                  Margin="0,16,0,0">

                <Border Classes="inset">
                  <StackPanel Spacing="5">
                    <TextBlock Text="TARGET" Classes="eyebrow" />
                    <TextBlock
                        x:Name="OverviewTargetText"
                        Text="--"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="OverviewOsText"
                        Text="--"
                        Classes="dim"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="inset">
                  <StackPanel Spacing="5">
                    <TextBlock Text="CONTROL PLANE" Classes="eyebrow" />
                    <TextBlock
                        x:Name="OverviewControlPlaneText"
                        Text="WAITING"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="OverviewCapturedText"
                        Text="No capture"
                        Classes="dim"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border
                  Grid.Row="2"
                  Classes="inset"
                  Margin="0,10,0,0">

                <StackPanel Spacing="6">
                  <TextBlock Text="ENVIRONMENT" Classes="eyebrow" />
                  <TextBlock
                      x:Name="OverviewFindingsText"
                      Text="No findings captured"
                      FontWeight="SemiBold"
                      TextWrapping="Wrap" />
                  <TextBlock
                      x:Name="OverviewPolicyText"
                      Text="Default monitoring"
                      Classes="dim"
                      TextWrapping="Wrap" />
                  <TextBlock
                      x:Name="OverviewHighestPriorityText"
                      Text="No active operational finding."
                      Classes="muted"
                      TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border
                  Grid.Row="3"
                  Classes="inset"
                  Margin="0,10,0,0">

                <StackPanel Spacing="5">
                  <TextBlock Text="BACKUPS" Classes="eyebrow" />
                  <TextBlock
                      x:Name="OverviewBackupText"
                      Text="Waiting for backup capture"
                      FontWeight="SemiBold"
                      TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <StackPanel
                  Grid.Row="4"
                  Margin="0,14,0,0"
                  Spacing="8">

                <TextBlock Text="QUICK NAVIGATION" Classes="eyebrow" />

                <WrapPanel>
                  <Button Content="Dashboard" Tag="DashboardNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                  <Button Content="Intelligence" Tag="IntelligenceNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                  <Button Content="Storage" Tag="StorageNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                  <Button Content="Media Hub" Tag="MediaHubNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                  <Button Content="Backups" Tag="BackupsNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                  <Button Content="History" Tag="HistoryNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                </WrapPanel>

                <TextBlock
                    Text="Detailed findings, logs, actions and history remain on their owner pages."
                    Classes="dim"
                    FontSize="10"
                    TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid
              x:Name="CommandPaletteOverlay"
              Grid.RowSpan="4"
              ZIndex="100"
              Background="#B2090A0C"
              IsVisible="False">

            <Border
                Width="720"
                MaxHeight="620"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,88,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">

              <Grid RowDefinitions="Auto,*,Auto">
                <TextBox
                    x:Name="CommandPaletteTextBox"
                    FontSize="17"
                    Padding="14,10"
                    PlaceholderText="Search pages and detected applications"
                    TextChanged="CommandPaletteTextBox_OnTextChanged"
                    KeyDown="CommandPaletteTextBox_OnKeyDown" />

                <ListBox
                    x:Name="CommandPaletteList"
                    Grid.Row="1"
                    Classes="dataList"
                    MinHeight="260"
                    MaxHeight="470"
                    Margin="0,10,0,0"
                    DoubleTapped="CommandPaletteList_OnDoubleTapped">

                  <ListBox.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="3">
                          <TextBlock
                              Text="{ReflectionBinding Title}"
                              FontWeight="SemiBold" />
                          <TextBlock
                              Text="{ReflectionBinding Subtitle}"
                              Classes="muted"
                              FontSize="10"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            Text="{ReflectionBinding Kind}"
                            Classes="dim"
                            FontSize="9"
                            VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock
                    Grid.Row="2"
                    Text="Enter opens · Up/Down selects · Esc closes · Ctrl+K toggles"
                    Classes="dim"
                    FontSize="10"
                    Margin="4,10,0,0" />
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
