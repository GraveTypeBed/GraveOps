<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="GraveOps.Desktop.Linux.MainWindow"
    x:CompileBindings="False"
    Title="GraveOps"
    Icon="/Assets/graveops-brandmark.png"
    Width="1500"
    Height="920"
    MinWidth="1180"
    MinHeight="760"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="38"
    KeyDown="MainWindow_OnKeyDown"
    Background="{DynamicResource BackdropBrush}">

  <Border
      Background="{DynamicResource BackgroundBrush}"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="1">

    <Grid RowDefinitions="38,*">
      <!-- Custom GraveOps title bar -->
      <Border
          Grid.Row="0"
          Background="{DynamicResource HeaderBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,0,0,1">

        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel
              Orientation="Horizontal"
              VerticalAlignment="Center"
              Margin="14,0,0,0"
              Spacing="9">

            <Image
                Width="24"
                Height="24"
                Source="/Assets/graveops-brandmark.png"
                Stretch="Uniform" />

            <TextBlock
                Text="GraveOps"
                FontSize="12"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />

            <Border
                Background="{DynamicResource AccentTintBrush}"
                CornerRadius="5"
                Padding="7,2"
                Margin="4,0,0,0">

              <TextBlock
                  Text="LINUX"
                  Classes="eyebrow"
                  Foreground="{DynamicResource AccentBrush}" />
            </Border>
          </StackPanel>

          <Border
              Grid.Column="1"
              Background="Transparent"
              PointerPressed="TitleDragRegion_OnPointerPressed"
              DoubleTapped="TitleDragRegion_OnDoubleTapped" />

          <StackPanel
              Grid.Column="2"
              Orientation="Horizontal">

            <Button
                Classes="titlebar"
                Content="—"
                Click="Minimize_Click" />

            <Button
                Classes="titlebar"
                Content="□"
                Click="Maximize_Click" />

            <Button
                Classes="titlebar close"
                Content="×"
                Click="Close_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid
          Grid.Row="1"
          ColumnDefinitions="260,*">

        <!-- Navigation rail -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">

          <Grid
              RowDefinitions="Auto,*,Auto"
              Margin="14,15,14,14">

            <Border
                Classes="card"
                Padding="13"
                Margin="0,0,0,17">

              <StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                  <Border
                      Width="34"
                      Height="34"
                      CornerRadius="9"
                      Background="{DynamicResource AccentTintBrush}">

                    <Path
                        Data="M7,8 L19,8 M7,12 L19,12 M7,16 L15,16"
                        Stroke="{DynamicResource AccentBrush}"
                        StrokeThickness="1.6"
                        StrokeLineCap="Round"
                        Stretch="None"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                  </Border>

                  <StackPanel
                      Grid.Column="1"
                      Margin="11,0,0,0"
                      VerticalAlignment="Center">

                    <TextBlock
                        Text="CONTROL PLANE"
                        Classes="eyebrow" />

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,5,0,0"
                        Spacing="7">

                      <TextBlock
                          x:Name="ConnectionDot"
                          Text="●"
                          FontSize="10"
                          Foreground="{DynamicResource SuccessBrush}" />

                      <TextBlock
                          x:Name="ConnectionText"
                          Text="ONLINE"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource SuccessBrush}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="ConnectionDetailText"
                        Text="Native Linux provider"
                        Classes="dim"
                        FontSize="10"
                        Margin="0,4,0,0"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>

                <TextBlock
                    Text="ACTIVE TARGET"
                    Classes="eyebrow"
                    Margin="0,13,0,5" />

                <Border
                    Classes="inset"
                    Padding="8">
                  <StackPanel Spacing="7">
                    <ComboBox
                        x:Name="ActiveTargetComboBox"
                        MinWidth="200"
                        SelectionChanged="ActiveTargetComboBox_OnSelectionChanged">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <StackPanel Spacing="2">
                            <TextBlock
                                Text="{ReflectionBinding DisplayName}"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{ReflectionBinding ConnectionSummary}"
                                Classes="dim"
                                FontSize="9"
                                TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock
                        x:Name="SidebarHostname"
                        Text="Loading..."
                        FontSize="11"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        x:Name="SidebarOperatingSystem"
                        Text="Linux"
                        Classes="dim"
                        FontSize="9"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

              <StackPanel>
                <TextBlock
                    Text="OVERVIEW"
                    Classes="eyebrow"
                    Margin="10,0,0,6" />

                <Button
                    x:Name="DashboardNav"
                    Classes="nav selected"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M1,1 L7,1 L7,7 L1,7 Z M9,1 L15,1 L15,7 L9,7 Z M1,9 L7,9 L7,15 L1,15 Z M9,9 L15,9 L15,15 L9,15 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Dashboard"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="IntelligenceNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M8,1 L10,5 L15,6 L11.5,9.5 L12,15 L8,12.5 L4,15 L4.5,9.5 L1,6 L6,5 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Intelligence"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="LifecycleNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,8 L5,8 M6,8 L9,8 M10,8 L14,8 M4,5 L6,8 L4,11 M8,5 L10,8 L8,11"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Lifecycle"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="HistoryNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M8,2 A6,6 0 1 1 3,5 M3,2 L3,6 L7,6 M8,5 L8,8 L11,10"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="History &amp; Incidents"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="ServersNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,2 L14,2 L14,7 L2,7 Z M2,9 L14,9 L14,14 L2,14 Z M4,4.5 L5.5,4.5 M4,11.5 L5.5,11.5"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Servers"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <TextBlock
                    Text="MEDIA"
                    Classes="eyebrow"
                    Margin="10,15,0,6" />

                <Button
                    x:Name="MediaHubNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,2 L7,2 L7,7 L2,7 Z M9,2 L14,2 L14,7 L9,7 Z M2,9 L7,9 L7,14 L2,14 Z M9,9 L14,9 L14,14 L9,14 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Media Hub"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>


                <Button
                    x:Name="DumbNav"
                    Classes="nav sub"
                    IsVisible="False"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <TextBlock Text="◆" FontSize="9" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="DUMB stack" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <Button
                    x:Name="LibraryGroupButton"
                    Classes="navGroup"
                    IsVisible="False"
                    Click="LibraryGroupButton_OnClick">
                  <Grid ColumnDefinitions="18,*">
                    <TextBlock x:Name="LibraryGroupGlyph" Text="▾" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="LIBRARY" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <StackPanel x:Name="LibraryNavGroup" IsVisible="False">
                  <Button x:Name="PlexNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="▶" FontSize="9" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Plex" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="TautulliNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="▥" FontSize="10" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Tautulli" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="KometaNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="◇" FontSize="10" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Kometa" VerticalAlignment="Center" /></Grid>
                  </Button>
                </StackPanel>

                <Button
                    x:Name="AcquisitionGroupButton"
                    Classes="navGroup"
                    IsVisible="False"
                    Click="AcquisitionGroupButton_OnClick">
                  <Grid ColumnDefinitions="18,*">
                    <TextBlock x:Name="AcquisitionGroupGlyph" Text="▾" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="ACQUISITION" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <StackPanel x:Name="AcquisitionNavGroup" IsVisible="False">
                  <Button x:Name="SonarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Sonarr" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="RadarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Radarr" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="LidarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Lidarr" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="ProwlarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Prowlarr" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="ReadarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" /><TextBlock Grid.Column="1" Text="Readarr" /></Grid>
                  </Button>
                  <Button x:Name="WhisparrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" /><TextBlock Grid.Column="1" Text="Whisparr" /></Grid>
                  </Button>
                  <Button x:Name="Mylar3Nav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" /><TextBlock Grid.Column="1" Text="Mylar3" /></Grid>
                  </Button>

                  <Button x:Name="SabnzbdNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="SABnzbd" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="QBittorrentNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="qBittorrent" VerticalAlignment="Center" /></Grid>
                  </Button>
                </StackPanel>

                <Button
                    x:Name="ProcessingGroupButton"
                    Classes="navGroup"
                    IsVisible="False"
                    Click="ProcessingGroupButton_OnClick">
                  <Grid ColumnDefinitions="18,*">
                    <TextBlock x:Name="ProcessingGroupGlyph" Text="▾" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="PROCESSING" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <StackPanel x:Name="ProcessingNavGroup" IsVisible="False">
                  <Button x:Name="DecypharrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Decypharr" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="RecyclarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Recyclarr" VerticalAlignment="Center" /></Grid>
                  </Button>
                  <Button x:Name="BazarrNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" /><TextBlock Grid.Column="1" Text="Bazarr" /></Grid>
                  </Button>

                  <Button x:Name="ZurgNav" Classes="nav sub" IsVisible="False" Click="NavigationButton_OnClick">
                    <Grid ColumnDefinitions="24,*"><TextBlock Text="•" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Zurg" VerticalAlignment="Center" /></Grid>
                  </Button>
                </StackPanel>

                <TextBlock
                    Text="SYSTEM"
                    Classes="eyebrow"
                    Margin="10,15,0,6" />

                <Button
                    x:Name="ServicesNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,4 L14,4 M2,8 L14,8 M2,12 L14,12 M4,2 L4,6 M10,6 L10,10 M6,10 L6,14"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Services &amp; Actions"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="DockerNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,5 L6,5 L6,9 L2,9 Z M7,5 L11,5 L11,9 L7,9 Z M12,5 L15,5 L15,9 L12,9 Z M4,1 L8,1 L8,4 L4,4 Z M9,1 L13,1 L13,4 L9,4 Z M1,10 C3,14 12,15 15,9"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.1" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Docker"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="StorageNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,3 C2,1.5 14,1.5 14,3 L14,13 C14,14.5 2,14.5 2,13 Z M2,3 C2,5 14,5 14,3 M2,8 C2,10 14,10 14,8"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Storage"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="LogsNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M2,2 L14,2 L14,14 L2,14 Z M4,5 L12,5 M4,8 L12,8 M4,11 L9,11"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Logs"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="BackupsNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M3,2 L13,2 L13,14 L3,14 Z M5,2 L5,6 L11,6 L11,2 M5,10 L11,10 L11,14 L5,14 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Backups"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>
                <TextBlock
                    Text="OPERATOR"
                    Classes="eyebrow"
                    Margin="10,15,0,6" />

                <Button
                    x:Name="SettingsNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M8,2 A2,2 0 1 1 8,6 A2,2 0 1 1 8,2 M8,7 L8,14 M3,10 L13,10"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Settings"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

                <Button
                    x:Name="ToolsNav"
                    Classes="nav"
                    Click="NavigationButton_OnClick">
                  <Grid ColumnDefinitions="24,*">
                    <Path
                        Width="16"
                        Height="16"
                        Data="M3,3 L13,3 L13,13 L3,13 Z M5,6 L11,6 M5,9 L9,9"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Operator Tools"
                        VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                </Button>

              </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Margin="10,12,0,0">
              <TextBlock
                  Text="GRAVEOPS"
                  Classes="eyebrow"
                  Foreground="{DynamicResource AccentBrush}" />
              <TextBlock
                  Text="Native + remote providers"
                  Classes="dim"
                  FontSize="10"
                  Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Main workspace -->
        <Grid
            Grid.Column="1"
            RowDefinitions="72,42,*,38"
            Background="{DynamicResource BackgroundBrush}">

          <Border
              Grid.Row="0"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" Margin="28,0">
              <StackPanel VerticalAlignment="Center">
                <TextBlock
                    x:Name="PageTitleText"
                    Text="Dashboard"
                    FontSize="21"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="PageSubtitleText"
                    Text="Interactive environment health, ownership and active-host operations"
                    Classes="pageSubtitle"
                    FontSize="11"
                    Margin="0,3,0,0" />
              </StackPanel>

              <StackPanel
                  Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Spacing="8">
                <TextBlock
                    x:Name="LastUpdatedText"
                    Text="Waiting for first capture"
                    Classes="dim"
                    FontSize="10"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0" />
                <Button x:Name="OverviewButton" Content="Overview" Padding="11,6" Click="OverviewButton_OnClick" />
                <Button x:Name="JobsButton" Content="Jobs" Padding="11,6" Click="JobsButton_OnClick" />
                <Button Content="Intelligence" Tag="IntelligenceNav" Padding="11,6" Click="DashboardQuickModuleButton_OnClick" />
                <Button x:Name="ActivityButton" Content="Activity" Padding="11,6" Click="ActivityButton_OnClick" />
                <Button Content="Terminal" Tag="ToolsNav" Padding="11,6" Click="DashboardQuickModuleButton_OnClick" />
                <Button x:Name="RefreshButton" Classes="primary" Content="Refresh" Padding="11,6" Click="RefreshButton_OnClick" />
              </StackPanel>
            </Grid>
          </Border>

          <Border
              Grid.Row="1"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="28,0">
              <TextBlock Text="QUICK" Classes="eyebrow" VerticalAlignment="Center" Margin="0,0,12,0" />
              <Button Grid.Column="1" x:Name="MaintenanceButton" Classes="ghost" Content="Maintenance" Padding="10,6" Click="MaintenanceButton_OnClick" />
              <TextBlock Grid.Column="3" Text="Ctrl+K search" Classes="dim" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Grid.Column="4" x:Name="CommandPaletteButton" Classes="ghost" Content="Search" Padding="8,4" Click="CommandPaletteButton_OnClick" />
              <Button Grid.Column="5" Classes="ghost" Content="Customize" Tag="SettingsNav" Padding="8,4" Click="DashboardQuickModuleButton_OnClick" />
            </Grid>
          </Border>

          <Grid
              Grid.Row="2"
              Margin="24">
            <!-- Dashboard -->
            <Grid
                x:Name="DashboardPage"
                IsVisible="True"
                RowDefinitions="Auto,Auto,Auto,Auto,*"
                RowSpacing="10">

              <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Classes="metric">
                  <StackPanel Spacing="4">
                    <TextBlock Text="ENVIRONMENT" Classes="eyebrow" />
                    <TextBlock x:Name="DashboardFleetStateText" Text="WAITING" Classes="metricValue" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="metric">
                  <StackPanel Spacing="4">
                    <TextBlock Text="HOSTS" Classes="eyebrow" />
                    <TextBlock x:Name="DashboardFleetHostCountText" Text="0" Classes="metricValue" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="metric">
                  <StackPanel Spacing="4">
                    <TextBlock Text="VERIFIED APPS" Classes="eyebrow" />
                    <TextBlock x:Name="DashboardFleetApplicationCountText" Text="0" Classes="metricValue" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="metric">
                  <StackPanel Spacing="4">
                    <TextBlock Text="ATTENTION" Classes="eyebrow" />
                    <TextBlock x:Name="DashboardFleetAttentionCountText" Text="0" Classes="metricValue" />
                  </StackPanel>
                </Border>
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="2.2*,0.9*" ColumnSpacing="8" Height="210">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="Environment map" Classes="sectionTitle" />
                        <TextBlock Text="Hosts and verified applications. Focus a machine or open an app directly from its owner." Classes="pageSubtitle" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" x:Name="DashboardEnvironmentSummaryText" Text="Waiting for captures" Classes="dim" VerticalAlignment="Center" />
                    </Grid>

                    <ListBox
                        Grid.Row="1"
                        x:Name="DashboardEnvironmentList"
                        Classes="dataList"
                        SelectionChanged="DashboardEnvironmentList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Border Classes="inset" Margin="0,0,0,5" Padding="8">
                            <Grid ColumnDefinitions="*,95,72,92,78,Auto" ColumnSpacing="8">
                              <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="●" Foreground="{DynamicResource SuccessBrush}" FontSize="8" />
                                  <TextBlock Text="{ReflectionBinding HostName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{ReflectionBinding ActiveLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="8" />
                                </StackPanel>
                                <TextBlock Text="{ReflectionBinding Connection}" Classes="dim" FontSize="8.5" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{ReflectionBinding Role}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Text="{ReflectionBinding ApplicationSummary}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="3" Text="{ReflectionBinding AttentionSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="4" Text="{ReflectionBinding QueueSummary}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="5" Text="{ReflectionBinding SeverityLabel}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Classes="module">
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="Needs attention" Classes="sectionTitle" />
                        <TextBlock Text="Only actionable findings. Everything else stays out of the way." Classes="pageSubtitle" />
                      </StackPanel>
                      <Button Grid.Column="1" x:Name="DashboardOpenAttentionButton" Content="View all" Classes="ghost" IsEnabled="False" Click="DashboardOpenAttentionButton_OnClick" />
                    </Grid>

                    <ListBox
                        Grid.Row="1"
                        x:Name="DashboardFleetAttentionList"
                        Classes="dataList"
                        SelectionChanged="DashboardFleetAttentionList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <StackPanel Spacing="3">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{ReflectionBinding Component}" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="1" Text="{ReflectionBinding SeverityLabel}" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock Text="{ReflectionBinding HostName}" Classes="dim" FontSize="8.5" />
                            <TextBlock Text="{ReflectionBinding Issue}" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" x:Name="DashboardFleetAttentionDetailText" Text="Nothing needs attention right now." Classes="muted" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </Grid>

              <Border Grid.Row="2" Classes="module" Height="152">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="7">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel>
                      <TextBlock Text="Selected host" Classes="sectionTitle" />
                      <TextBlock Text="Fast operational state for the active target. Deeper detail lives on dedicated pages." Classes="pageSubtitle" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="DashboardSelectedCapturedText" Text="Waiting for capture" Classes="dim" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Grid.Column="2" x:Name="DashboardFocusHostButton" Content="Focus host" IsEnabled="False" Click="DashboardFocusHostButton_OnClick" />
                  </Grid>

                  <Grid Grid.Row="1" ColumnDefinitions="1.3*,*,*,*,*,*" ColumnSpacing="6">
                    <Border Classes="inset">
                      <StackPanel Spacing="2">
                        <TextBlock Text="CONNECTION" Classes="eyebrow" />
                        <TextBlock x:Name="DashboardSelectedHostText" Text="No target selected" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DashboardSelectedConnectionText" Text="--" Classes="dim" FontSize="8.5" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="inset">
                      <StackPanel Spacing="2"><TextBlock Text="ONLINE APPS" Classes="eyebrow" /><TextBlock x:Name="DashboardSelectedApplicationsText" Text="--" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="inset">
                      <StackPanel Spacing="2"><TextBlock Text="ATTENTION" Classes="eyebrow" /><TextBlock x:Name="DashboardSelectedAttentionText" Text="--" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="inset">
                      <StackPanel Spacing="2"><TextBlock Text="QUEUED" Classes="eyebrow" /><TextBlock x:Name="DashboardSelectedQueueText" Text="--" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Classes="inset">
                      <StackPanel Spacing="2"><TextBlock Text="DOCKER" Classes="eyebrow" /><TextBlock x:Name="DashboardSelectedDockerText" Text="--" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></StackPanel>
                    </Border>
                    <Button Grid.Column="5" x:Name="DashboardOpenApplicationButton" Content="Open application" IsEnabled="False" VerticalAlignment="Stretch" Click="DashboardOpenApplicationButton_OnClick" />
                  </Grid>

                  <ListBox
                      Grid.Row="2"
                      x:Name="DashboardApplicationList"
                      Classes="dataList"
                      SelectionChanged="DashboardApplicationList_OnSelectionChanged">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Classes="inset" Padding="7,4" Margin="0,0,5,0">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="●" Foreground="{DynamicResource SuccessBrush}" FontSize="8" />
                            <TextBlock Text="{ReflectionBinding Application}" FontWeight="SemiBold" />
                            <TextBlock Text="{ReflectionBinding State}" Classes="dim" FontSize="8.5" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="6">
                <TextBlock Text="Quick modules" Classes="sectionTitle" />
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="6">
                  <Button Tag="IntelligenceNav" HorizontalContentAlignment="Stretch" Click="DashboardQuickModuleButton_OnClick">
                    <StackPanel Spacing="4"><TextBlock Text="Intelligence" FontWeight="SemiBold" /><TextBlock x:Name="DashboardQuickIntelligenceText" Text="--" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="Analyze now" Classes="dim" /></StackPanel>
                  </Button>
                  <Button Grid.Column="1" Tag="LifecycleNav" HorizontalContentAlignment="Stretch" Click="DashboardQuickModuleButton_OnClick">
                    <StackPanel Spacing="4"><TextBlock Text="Lifecycle" FontWeight="SemiBold" /><TextBlock x:Name="DashboardQuickLifecycleText" Text="--" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="Open lifecycle" Classes="dim" /></StackPanel>
                  </Button>
                  <Button Grid.Column="2" Tag="MediaHubNav" HorizontalContentAlignment="Stretch" Click="DashboardQuickModuleButton_OnClick">
                    <StackPanel Spacing="4"><TextBlock Text="Media Hub" FontWeight="SemiBold" /><TextBlock x:Name="DashboardQuickMediaText" Text="--" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="Open hub" Classes="dim" /></StackPanel>
                  </Button>
                  <Button Grid.Column="3" Tag="StorageNav" HorizontalContentAlignment="Stretch" Click="DashboardQuickModuleButton_OnClick">
                    <StackPanel Spacing="4"><TextBlock Text="Storage" FontWeight="SemiBold" /><TextBlock x:Name="DashboardQuickStorageText" Text="--" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="View storage" Classes="dim" /></StackPanel>
                  </Button>
                  <Button Grid.Column="4" Tag="BackupsNav" HorizontalContentAlignment="Stretch" Click="DashboardQuickModuleButton_OnClick">
                    <StackPanel Spacing="4"><TextBlock Text="Backups" FontWeight="SemiBold" /><TextBlock x:Name="DashboardQuickBackupsText" Text="--" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="Open backups" Classes="dim" /></StackPanel>
                  </Button>
                  <Button Grid.Column="5" Tag="HistoryNav" HorizontalContentAlignment="Stretch" Click="DashboardQuickModuleButton_OnClick">
                    <StackPanel Spacing="4"><TextBlock Text="Activity" FontWeight="SemiBold" /><TextBlock x:Name="DashboardQuickHistoryText" Text="--" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="View activity" Classes="dim" /></StackPanel>
                  </Button>
                </Grid>
              </Grid>

              <Border Grid.Row="4" IsVisible="False">
                <StackPanel>
                  <TextBlock x:Name="DashboardFindingsSummaryText" />
                  <TextBlock x:Name="DashboardPolicySummaryText" />
                  <ListBox x:Name="DashboardAttentionList" SelectionChanged="DashboardAttentionList_OnSelectionChanged" />
                  <Button x:Name="AcknowledgeFindingButton" Click="AcknowledgeFindingButton_OnClick" />
                  <Button x:Name="SnoozeFindingButton" Click="SnoozeFindingButton_OnClick" />
                  <Button x:Name="IgnoreFindingButton" Click="IgnoreFindingButton_OnClick" />
                  <Button x:Name="FindingThresholdButton" Click="FindingThresholdButton_OnClick" />
                  <TextBlock x:Name="DashboardPolicyStatusText" />
                  <Border x:Name="MutedFindingsPanel">
                    <StackPanel>
                      <TextBlock x:Name="MutedFindingsSummaryText" />
                      <ListBox x:Name="MutedFindingsList" SelectionChanged="MutedFindingsList_OnSelectionChanged" />
                      <Button x:Name="RestoreMutedFindingButton" Click="RestoreMutedFindingButton_OnClick" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </Grid>
            <!-- Servers -->
            <Grid
                x:Name="ServersPage"
                IsVisible="False"
                ColumnDefinitions="230,520,*"
                ColumnSpacing="8">

              <Border Classes="module">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="7">
                  <StackPanel>
                    <TextBlock Text="Saved hosts" Classes="sectionTitle" />
                    <TextBlock Text="Local and remote host profiles. Secrets remain in the Linux Secret Service." Classes="pageSubtitle" TextWrapping="Wrap" />
                    <TextBlock x:Name="ServerProfilesSummaryText" Text="0 profiles" Classes="dim" Margin="0,4,0,0" />
                  </StackPanel>

                  <ListBox
                      Grid.Row="1"
                      x:Name="ServerProfilesList"
                      Classes="dataList"
                      SelectionChanged="ServerProfilesList_OnSelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{ReflectionBinding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{ReflectionBinding ConnectionSummary}" Classes="dim" FontSize="8.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <WrapPanel Grid.Row="2">
                    <Button Content="Add server" Classes="primary" Margin="0,0,5,0" Click="NewServerButton_OnClick" />
                    <Button x:Name="DeleteServerButton" Content="Delete" Classes="danger" Margin="0,0,5,0" Click="DeleteServerButton_OnClick" />
                    <Button Content="Discover LAN" Click="DiscoverLanButton_OnClick" />
                  </WrapPanel>
                </Grid>
              </Border>

              <Border Grid.Column="1" Classes="module">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="6">
                  <StackPanel>
                    <TextBlock Text="Host profile" Classes="sectionTitle" />
                    <TextBlock Text="Remote Linux uses SSH with pinned host keys. Local hosts need no credentials." Classes="pageSubtitle" TextWrapping="Wrap" />
                  </StackPanel>

                  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <StackPanel>
                      <TextBlock Text="Friendly name" Classes="eyebrow" Margin="0,0,0,3" />
                      <TextBox x:Name="ServerNameTextBox" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="ServerEditingIdText" Text="New profile" Classes="dim" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                  </Grid>

                  <Grid Grid.Row="2" ColumnDefinitions="*,160" ColumnSpacing="6">
                    <StackPanel>
                      <TextBlock Text="Connection type" Classes="eyebrow" Margin="0,0,0,3" />
                      <ComboBox x:Name="ServerConnectionTypeComboBox" SelectionChanged="ServerConnectionTypeComboBox_OnSelectionChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Role" Classes="eyebrow" Margin="0,0,0,3" />
                      <TextBox x:Name="ServerRoleTextBox" />
                    </StackPanel>
                  </Grid>

                  <Grid Grid.Row="3" ColumnDefinitions="*,90" ColumnSpacing="6">
                    <StackPanel>
                      <TextBlock Text="Host / IP" Classes="eyebrow" Margin="0,0,0,3" />
                      <TextBox x:Name="ServerHostTextBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="SSH port" Classes="eyebrow" Margin="0,0,0,3" />
                      <TextBox x:Name="ServerPortTextBox" />
                    </StackPanel>
                  </Grid>

                  <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="6">
                    <StackPanel>
                      <TextBlock Text="Username" Classes="eyebrow" Margin="0,0,0,3" />
                      <TextBox x:Name="ServerUsernameTextBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Authentication" Classes="eyebrow" Margin="0,0,0,3" />
                      <ComboBox x:Name="ServerAuthenticationComboBox" SelectionChanged="ServerAuthenticationComboBox_OnSelectionChanged" />
                    </StackPanel>
                  </Grid>

                  <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <StackPanel>
                      <TextBlock Text="Private key path" Classes="eyebrow" Margin="0,0,0,3" />
                      <TextBox x:Name="ServerPrivateKeyPathTextBox" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BrowsePrivateKeyButton" Content="Browse" VerticalAlignment="Bottom" Click="BrowsePrivateKeyButton_OnClick" />
                  </Grid>

                  <Grid Grid.Row="6" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <StackPanel>
                      <TextBlock Text="Pinned host-key SHA-256 fingerprint" Classes="eyebrow" Margin="0,0,0,3" />
                      <TextBox x:Name="ServerFingerprintTextBox" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="ScanFingerprintButton" Content="Scan" VerticalAlignment="Bottom" Click="ScanFingerprintButton_OnClick" />
                  </Grid>

                  <Grid Grid.Row="7" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <StackPanel>
                      <TextBlock Text="Password / passphrase" Classes="eyebrow" Margin="0,0,0,3" />
                      <TextBox x:Name="ServerSecretTextBox" PasswordChar="●" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="ServerSaveSecretCheckBox" Content="Save securely" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                  </Grid>

                  <WrapPanel Grid.Row="8">
                    <Button Content="Save profile" Classes="primary" Margin="0,0,5,0" Click="SaveServerButton_OnClick" />
                    <Button Content="Test connection" Margin="0,0,5,0" Click="TestServerButton_OnClick" />
                    <Button Content="Detect integrations" Click="DetectServerButton_OnClick" />
                  </WrapPanel>

                  <TextBlock Grid.Row="9" x:Name="ServerProfileStatusText" Text="Select a host or add a new profile." Classes="dim" TextWrapping="Wrap" />

                  <Grid Grid.Row="10" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Bottom">
                    <TextBlock x:Name="ServerKeyringStatusText" Text="Secret Service status pending." Classes="dim" TextWrapping="Wrap" />
                    <Button Grid.Column="1" x:Name="SetActiveServerButton" Content="Set active" Click="SetActiveServerButton_OnClick" />
                  </Grid>
                </Grid>
              </Border>

              <Border Grid.Column="2" Classes="module">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
                  <StackPanel>
                    <TextBlock Text="Detected context" Classes="sectionTitle" />
                    <TextBlock Text="Linux-specific runtime and integration evidence stays visible without changing the Windows page structure." Classes="pageSubtitle" TextWrapping="Wrap" />
                  </StackPanel>

                  <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Border Classes="inset"><StackPanel><TextBlock Text="IDENTITY" Classes="eyebrow" /><TextBlock x:Name="ServerIdentityText" Text="--" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
                    <Border Grid.Column="1" Classes="inset"><StackPanel><TextBlock Text="OPERATING SYSTEM" Classes="eyebrow" /><TextBlock x:Name="ServerOperatingSystemText" Text="--" TextWrapping="Wrap" /></StackPanel></Border>
                  </Grid>
                  <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Border Classes="inset"><StackPanel><TextBlock Text="KERNEL" Classes="eyebrow" /><TextBlock x:Name="ServerKernelText" Text="--" /></StackPanel></Border>
                    <Border Grid.Column="1" Classes="inset"><StackPanel><TextBlock Text="UPTIME" Classes="eyebrow" /><TextBlock x:Name="ServerUptimeText" Text="--" /></StackPanel></Border>
                  </Grid>
                  <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Border Classes="inset"><StackPanel><TextBlock Text="CPU" Classes="eyebrow" /><TextBlock x:Name="ServerCpuText" Text="--" TextWrapping="Wrap" /></StackPanel></Border>
                    <Border Grid.Column="1" Classes="inset"><StackPanel><TextBlock Text="MEMORY" Classes="eyebrow" /><TextBlock x:Name="ServerMemoryText" Text="--" TextWrapping="Wrap" /></StackPanel></Border>
                  </Grid>

                  <ListBox Grid.Row="4" x:Name="ServerDetectedIntegrationsList" Classes="dataList" />
                  <TextBlock Grid.Row="5" x:Name="ServerNetworkText" Text="--" Classes="dim" TextWrapping="Wrap" />

                  <ListBox x:Name="ServerLanCandidatesList" IsVisible="False" SelectionChanged="ServerLanCandidatesList_OnSelectionChanged" />
                </Grid>
              </Border>
            </Grid>
            <!-- Media Hub -->
            <Grid
                x:Name="MediaHubPage"
                IsVisible="False"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="10">

              <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <StackPanel>
                  <TextBlock Text="Media operations" Classes="sectionTitle" />
                  <TextBlock Text="Live application health, launch ownership and media-stack context from one surface." Classes="pageSubtitle" />
                </StackPanel>
                <TextBox Grid.Column="1" x:Name="MediaFilterText" Classes="filter" Width="210" Watermark="Filter applications" TextChanged="MediaFilterText_OnTextChanged" />
                <TextBlock Grid.Column="2" x:Name="MediaHubSummaryText" Text="0 detected" Classes="dim" VerticalAlignment="Center" />
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Classes="metric">
                  <StackPanel Spacing="3"><TextBlock Text="HEALTHY" Classes="eyebrow" /><TextBlock x:Name="MediaHealthyMetricText" Text="0" Classes="metricValue" Foreground="{DynamicResource SuccessBrush}" /><TextBlock Text="Applications operating normally" Classes="dim" FontSize="8.5" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="metric">
                  <StackPanel Spacing="3"><TextBlock Text="DEGRADED / BUSY" Classes="eyebrow" /><TextBlock x:Name="MediaAttentionMetricText" Text="0" Classes="metricValue" Foreground="{DynamicResource WarnBrush}" /><TextBlock Text="Reachable but needs attention" Classes="dim" FontSize="8.5" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="metric">
                  <StackPanel Spacing="3"><TextBlock Text="OFFLINE" Classes="eyebrow" /><TextBlock x:Name="MediaOfflineMetricText" Text="0" Classes="metricValue" Foreground="{DynamicResource DangerBrush}" /><TextBlock Text="No verified application response" Classes="dim" FontSize="8.5" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="metric">
                  <StackPanel Spacing="3"><TextBlock Text="TARGET" Classes="eyebrow" /><TextBlock x:Name="MediaTargetMetricText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="Uses active control-plane context" Classes="dim" FontSize="8.5" /></StackPanel>
                </Border>
              </Grid>

              <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
                <TextBlock Text="Application health" Classes="sectionTitle" />
                <ListBox
                    Grid.Row="1"
                    x:Name="IntegrationsList"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    SelectionChanged="IntegrationsList_OnSelectionChanged">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <Border Classes="module" Width="205" Height="160" Margin="0,0,7,7">
                        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                              <TextBlock Text="{ReflectionBinding Name}" FontWeight="SemiBold" FontSize="13" />
                              <TextBlock Text="{ReflectionBinding Kind}" Classes="dim" FontSize="8.5" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Severity}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                          </Grid>
                          <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="6">
                            <StackPanel><TextBlock Text="STATE" Classes="eyebrow" /><TextBlock Text="{ReflectionBinding State}" TextTrimming="CharacterEllipsis" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="ENDPOINT" Classes="eyebrow" /><TextBlock Text="{ReflectionBinding Endpoint}" TextTrimming="CharacterEllipsis" /></StackPanel>
                          </Grid>
                          <TextBlock Grid.Row="2" Text="{ReflectionBinding Evidence}" Classes="muted" TextWrapping="Wrap" MaxHeight="46" />
                          <TextBlock Grid.Row="3" Text="Open" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <Border IsVisible="False">
                  <StackPanel>
                    <TextBlock x:Name="IntegrationNameText" />
                    <TextBlock x:Name="IntegrationRuntimeText" />
                    <Border x:Name="IntegrationStateBorder"><TextBlock x:Name="IntegrationStateText" /></Border>
                    <TextBlock x:Name="IntegrationKindText" />
                    <TextBlock x:Name="IntegrationEndpointText" />
                    <TextBlock x:Name="IntegrationRoleText" />
                    <TextBlock x:Name="IntegrationFindingsSummaryText" />
                    <TextBlock x:Name="IntegrationEvidenceText" />
                    <TextBlock x:Name="IntegrationFindingsText" />
                    <Button x:Name="OpenIntegrationButton" Click="OpenIntegrationButton_OnClick" />
                    <Button x:Name="IntegrationFindingsButton" Click="IntegrationFindingsButton_OnClick" />
                    <TextBlock x:Name="IntegrationActionStatusText" />
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>

            <!-- Dedicated direct application workspace -->
            <Grid
                x:Name="ApplicationWorkspacePage"
                IsVisible="False"
                RowDefinitions="Auto,Auto,Auto,Auto,*"
                RowSpacing="9">

              <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="DirectIntegrationNameText" Text="Application" Classes="sectionTitle" FontSize="18" />
                  <TextBlock x:Name="DirectIntegrationSubtitleText" Text="Verified application state and operational ownership." Classes="pageSubtitle" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="LIVE CONTEXT" Classes="eyebrow" VerticalAlignment="Center" />
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Classes="metric">
                  <StackPanel Spacing="3"><TextBlock Text="STATE" Classes="eyebrow" /><Border x:Name="DirectIntegrationStateBorder" Classes="badge" HorizontalAlignment="Left"><TextBlock x:Name="DirectIntegrationStateText" Text="WAITING" FontWeight="SemiBold" /></Border></StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="metric">
                  <StackPanel Spacing="3"><TextBlock Text="RUNTIME" Classes="eyebrow" /><TextBlock x:Name="DirectIntegrationRuntimeText" Text="--" FontSize="14" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="metric">
                  <StackPanel Spacing="3"><TextBlock Text="ROLE" Classes="eyebrow" /><TextBlock x:Name="DirectIntegrationRoleText" Text="--" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="metric">
                  <StackPanel Spacing="3"><TextBlock Text="ACTIVE FINDINGS" Classes="eyebrow" /><TextBlock x:Name="DirectIntegrationFindingsText" Text="0" Classes="metricValue" /></StackPanel>
                </Border>
              </Grid>

              <Border Grid.Row="2" Classes="module">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                  <StackPanel>
                    <TextBlock Text="Operations" Classes="sectionTitle" />
                    <TextBlock Text="Common work stays on this page; Docker, logs and Intelligence remain one click away." Classes="pageSubtitle" />
                  </StackPanel>
                  <WrapPanel Grid.Row="1">
                    <Button x:Name="DirectIntegrationOpenButton" Content="Open application" Classes="primary" Margin="0,0,5,0" Click="DirectIntegrationOpenButton_OnClick" />
                    <Button Content="Docker / dependencies" Margin="0,0,5,0" Click="DirectIntegrationDockerButton_OnClick" />
                    <Button Content="Logs" Margin="0,0,5,0" Click="DirectIntegrationLogsButton_OnClick" />
                    <Button x:Name="DirectIntegrationIntelligenceButton" Content="Intelligence" Click="DirectIntegrationIntelligenceButton_OnClick" />
                  </WrapPanel>
                </Grid>
              </Border>

              <Border Grid.Row="3" Classes="module">
                <Grid ColumnDefinitions="1.1*,1.1*,1.3*,Auto" ColumnSpacing="10">
                  <StackPanel><TextBlock Text="APPLICATION" Classes="eyebrow" /><TextBlock x:Name="DirectIntegrationPrimaryTitleText" Text="Application readiness" FontWeight="SemiBold" /></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="ENDPOINT" Classes="eyebrow" /><TextBlock x:Name="DirectIntegrationEndpointText" Text="--" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="OWNERSHIP" Classes="eyebrow" /><TextBlock x:Name="DirectIntegrationSecondaryTitleText" Text="Dependencies" FontWeight="SemiBold" /><TextBlock x:Name="DirectIntegrationOwnerText" Text="--" Classes="dim" TextTrimming="CharacterEllipsis" /></StackPanel>
                  <TextBlock Grid.Column="3" Text="Verified" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Grid Grid.Row="4" ColumnDefinitions="1.25*,0.75*" ColumnSpacing="8">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="6">
                    <StackPanel>
                      <TextBlock Text="Evidence" Classes="sectionTitle" />
                      <TextBlock Text="Runtime, endpoint and provider evidence for the selected application." Classes="pageSubtitle" />
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="DirectIntegrationEvidenceText" Classes="console" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
                  </Grid>
                </Border>
                <Border Grid.Column="1" Classes="module">
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                    <StackPanel>
                      <TextBlock Text="Related context" Classes="sectionTitle" />
                      <TextBlock Text="Findings and safe next-page handoff." Classes="pageSubtitle" />
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="DirectIntegrationRelatedText" Classes="console" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" x:Name="DirectIntegrationOperationsText" Text="Waiting for application selection." Classes="dim" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </Grid>
            </Grid>
            <!-- First-class Arr application page -->
            <Grid
                x:Name="ArrWorkspacePage"
                IsVisible="False"
                RowDefinitions="Auto,Auto,Auto,Auto,*"
                RowSpacing="9">

              <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                <StackPanel>
                  <TextBlock x:Name="ArrApplicationTitleText" Text="Arr application" Classes="sectionTitle" FontSize="18" />
                  <TextBlock x:Name="ArrApplicationSubtitleText" Text="Application health, queue and operational tools." Classes="pageSubtitle" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="ArrLiveUpdatedText" Text="Waiting for live telemetry" Classes="dim" VerticalAlignment="Center" />
                <Button Grid.Column="2" x:Name="ArrCustomizeButton" Content="Customize" Click="ArrCustomizeButton_OnClick" />
                <Button Grid.Column="3" x:Name="ArrRefreshTelemetryButton" Content="Refresh" Classes="primary" Click="ArrRefreshTelemetryButton_OnClick" />
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Classes="metric"><StackPanel Spacing="3"><TextBlock Text="STATE" Classes="eyebrow" /><TextBlock x:Name="ArrStateMetricText" Text="WAITING" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="1" Classes="metric"><StackPanel Spacing="3"><TextBlock Text="VERSION" Classes="eyebrow" /><TextBlock x:Name="ArrVersionMetricText" Text="--" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="2" Classes="metric"><StackPanel Spacing="3"><TextBlock x:Name="ArrWorkMetricLabelText" Text="QUEUE" Classes="eyebrow" /><TextBlock x:Name="ArrWorkMetricText" Text="--" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="3" Classes="metric"><StackPanel Spacing="3"><TextBlock Text="HEALTH ISSUES" Classes="eyebrow" /><TextBlock x:Name="ArrHealthMetricText" Text="--" Classes="metricValue" /></StackPanel></Border>
              </Grid>

              <Border Grid.Row="2" Classes="module">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                  <StackPanel>
                    <TextBlock Text="Operations" Classes="sectionTitle" />
                    <TextBlock x:Name="ArrOperationsSubtitleText" Text="Application and stack tools stay together." Classes="pageSubtitle" />
                  </StackPanel>
                  <WrapPanel Grid.Row="1">
                    <WrapPanel x:Name="ArrOpenButtonsPanel" />
                    <Button Content="Full queue drill-down" Margin="0,0,5,0" Click="ArrOpenNativeDetailButton_OnClick" />
                    <Button Content="Docker / stack" Margin="0,0,5,0" Click="ArrDockerButton_OnClick" />
                    <Button Content="Logs" Margin="0,0,5,0" Click="ArrLogsButton_OnClick" />
                    <Button Content="Intelligence" Click="ArrWorkspaceIntelligenceButton_OnClick" />
                  </WrapPanel>
                </Grid>
              </Border>

              <Border Grid.Row="3" Classes="module">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="Service telemetry" Classes="sectionTitle" />
                      <TextBlock Text="Current endpoint state, version, queue and health information." Classes="pageSubtitle" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="ArrInstanceCountText" Text="0 instances" Classes="dim" VerticalAlignment="Center" />
                  </Grid>
                  <ListBox Grid.Row="1" x:Name="ArrInstanceTelemetryList" Classes="dataList" Height="74">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Grid ColumnDefinitions="170,180,110,110,110,*,90" ColumnSpacing="8">
                          <TextBlock Text="{ReflectionBinding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="1" Text="{ReflectionBinding Endpoint}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{ReflectionBinding Version}" />
                          <TextBlock Grid.Column="3" Text="{ReflectionBinding Work}" />
                          <TextBlock Grid.Column="4" Text="{ReflectionBinding Health}" />
                          <TextBlock Grid.Column="5" Text="{ReflectionBinding Detail}" Classes="dim" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="6" Text="{ReflectionBinding State}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Grid Grid.Row="4">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock x:Name="ArrWorkSectionTitleText" Text="Queue &amp; health" Classes="sectionTitle" />
                        <TextBlock x:Name="ArrWorkSectionSubtitleText" Text="Item-level work and health messages." Classes="pageSubtitle" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Open full detail" Click="ArrOpenNativeDetailButton_OnClick" />
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="ArrQueueHealthList" Classes="dataList">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="120,105,1.2*,110,90,90,1.1*" ColumnSpacing="8">
                            <TextBlock Text="{ReflectionBinding Service}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Type}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding ItemIssue}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding State}" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Progress}" />
                            <TextBlock Grid.Column="5" Text="{ReflectionBinding Remaining}" />
                            <TextBlock Grid.Column="6" Text="{ReflectionBinding Detail}" Classes="dim" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" x:Name="ArrQueueFooterText" Text="Waiting for live telemetry." Classes="dim" />
                  </Grid>
                </Border>

                <Border
                    x:Name="ArrCustomizationPanel"
                    Classes="module"
                    Width="430"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource Surface2Brush}"
                    IsVisible="False">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="Customize workspace" Classes="sectionTitle" />
                        <TextBlock Text="Instance name, role, config path and enabled modules." Classes="pageSubtitle" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Close" Classes="ghost" Click="ArrCustomizeCloseButton_OnClick" />
                    </Grid>

                    <ComboBox Grid.Row="1" x:Name="ArrCustomizeInstanceComboBox" SelectionChanged="ArrCustomizeInstanceComboBox_OnSelectionChanged" />

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="6">
                      <StackPanel><TextBlock Text="Friendly name" Classes="eyebrow" /><TextBox x:Name="ArrFriendlyNameTextBox" /></StackPanel>
                      <StackPanel Grid.Column="1"><TextBlock Text="Role" Classes="eyebrow" /><TextBox x:Name="ArrRoleTextBox" /></StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3">
                      <TextBlock Text="Config path" Classes="eyebrow" />
                      <TextBox x:Name="ArrConfigPathTextBox" />
                    </StackPanel>

                    <CheckBox Grid.Row="4" x:Name="ArrPrivacyModeCheckBox" Content="Privacy mode" />

                    <StackPanel Grid.Row="5" x:Name="ArrWorkspaceModulesPanel" />

                    <WrapPanel Grid.Row="6">
                      <Button Content="Enable all" Margin="0,0,5,0" Click="EnableAllArrModulesButton_OnClick" />
                      <Button Content="Disable all" Margin="0,0,5,0" Click="DisableAllArrModulesButton_OnClick" />
                    </WrapPanel>

                    <Grid Grid.Row="7" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="5">
                      <Button x:Name="SaveArrWorkspaceButton" Content="Save" Classes="primary" Click="SaveArrWorkspaceButton_OnClick" />
                      <Button Grid.Column="1" x:Name="ResetArrWorkspaceButton" Content="Reset" Click="ResetArrWorkspaceButton_OnClick" />
                      <StackPanel Grid.Column="2">
                        <TextBlock x:Name="ArrWorkspaceProfileStatusText" Text="No instance selected." Classes="dim" TextWrapping="Wrap" />
                        <TextBlock x:Name="ArrWorkspaceConfigPathText" Text="--" Classes="dim" FontSize="8.5" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
            <!-- Services -->
            <Grid
                x:Name="ServicesPage"
                IsVisible="False"
                RowDefinitions="Auto,*"
                RowSpacing="8">

              <Grid Grid.Row="0" ColumnDefinitions="*,210,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <StackPanel>
                  <TextBlock Text="Operations &amp; troubleshooting" Classes="sectionTitle" FontSize="18" />
                  <TextBlock Text="Native services, guarded actions and selected-state comparison." Classes="pageSubtitle" />
                </StackPanel>
                <TextBox Grid.Column="1" x:Name="ServicesFilterText" Classes="filter" Watermark="Filter services" TextChanged="ServicesFilterText_OnTextChanged" />
                <Button Grid.Column="2" x:Name="ServiceStartButton" Content="Start" Click="ServiceStartButton_OnClick" />
                <Button Grid.Column="3" x:Name="ServiceStopButton" Content="Stop" Classes="danger" Click="ServiceStopButton_OnClick" />
                <Button Grid.Column="4" x:Name="ServiceRestartButton" Content="Restart" Classes="primary" Click="ServiceRestartButton_OnClick" />
                <CheckBox Grid.Column="5" x:Name="SafeModeCheckBox" Content="Safe Mode" VerticalAlignment="Center" Click="SafeModeCheckBox_OnClick" />
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="260,*" ColumnSpacing="8">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                    <StackPanel>
                      <TextBlock Text="Action library" Classes="sectionTitle" />
                      <TextBlock x:Name="ServicesSummaryText" Text="0 services" Classes="dim" />
                    </StackPanel>
                    <Border Grid.Row="1" Classes="inset">
                      <StackPanel><TextBlock Text="HOST SUMMARY" Classes="eyebrow" /><TextBlock Text="Read-only inventory and health-aware service actions." Classes="muted" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                    <ListBox Grid.Row="2" x:Name="ServicesList" Classes="dataList" SelectionChanged="ServicesList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{ReflectionBinding Unit}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{ReflectionBinding Description}" Classes="dim" FontSize="8.5" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Classes="module">
                  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock x:Name="ServiceSelectedNameText" Text="Select an action" Classes="sectionTitle" />
                        <TextBlock x:Name="ServiceSelectedDescriptionText" Text="Select a service to review state, policy and guarded controls." Classes="pageSubtitle" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" x:Name="ServiceSelectedStateText" Text="--" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    </Grid>

                    <Border Grid.Row="1" Classes="inset">
                      <TextBlock x:Name="ServiceSelectedPolicyText" Text="No service selected." Classes="muted" TextWrapping="Wrap" />
                    </Border>

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                      <TextBlock Text="Result / before &amp; after" Classes="eyebrow" />
                      <TextBlock Grid.Column="1" x:Name="ServiceActionStatusText" Text="No action run." Classes="dim" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBox Grid.Row="3" Classes="console" IsReadOnly="True" AcceptsReturn="True" Text="Select a service from the action library to review its state and safe controls." TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </Grid>
            </Grid>

            <!-- Docker -->
            <Grid
                x:Name="DockerPage"
                IsVisible="False"
                RowDefinitions="Auto,*,128"
                RowSpacing="8">

              <Grid Grid.Row="0" ColumnDefinitions="*,220,Auto,Auto" ColumnSpacing="6">
                <StackPanel>
                  <TextBlock Text="Docker" Classes="sectionTitle" FontSize="18" />
                  <TextBlock Text="Container state, images, ports, guarded actions and recent context." Classes="pageSubtitle" />
                </StackPanel>
                <TextBox Grid.Column="1" x:Name="DockerFilterText" Classes="filter" Watermark="Filter containers" TextChanged="DockerFilterText_OnTextChanged" />
                <CheckBox Grid.Column="2" x:Name="ShowInformationalContainersCheckBox" Content="Show exited" VerticalAlignment="Center" Click="ShowInformationalContainersCheckBox_OnClick" />
                <TextBlock Grid.Column="3" x:Name="DockerSummaryText" Text="0 containers" Classes="dim" VerticalAlignment="Center" />
              </Grid>

              <Border Grid.Row="1" Classes="module">
                <ListBox Grid.Row="1" x:Name="DockerList" Classes="dataList" SelectionChanged="DockerList_OnSelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <Grid ColumnDefinitions="170,1.2*,160,1.3*" ColumnSpacing="8">
                        <TextBlock Text="{ReflectionBinding Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{ReflectionBinding Image}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{ReflectionBinding Status}" />
                        <TextBlock Grid.Column="3" Text="{ReflectionBinding Ports}" Classes="dim" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>

              <Border Grid.Row="2" Classes="module">
                <Grid ColumnDefinitions="125,*" ColumnSpacing="8">
                  <StackPanel Spacing="5">
                    <Button Content="Recent logs" Tag="LogsNav" Click="DashboardQuickModuleButton_OnClick" />
                    <Button x:Name="DockerStartButton" Content="Start" Click="DockerStartButton_OnClick" />
                    <Button x:Name="DockerRestartButton" Content="Restart" Classes="primary" Click="DockerRestartButton_OnClick" />
                    <Button x:Name="DockerStopButton" Content="Stop" Classes="danger" Click="DockerStopButton_OnClick" />
                  </StackPanel>
                  <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock x:Name="DockerSelectedNameText" Text="Select a container" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" x:Name="DockerSelectedStateText" Text="--" Foreground="{DynamicResource AccentBrush}" />
                    </Grid>
                    <Border Grid.Row="1" Classes="inset">
                      <StackPanel Spacing="4">
                        <TextBlock x:Name="DockerActionStatusText" Text="No container action run." TextWrapping="Wrap" />
                        <TextBlock x:Name="DockerSelectedImageText" Text="Image · --" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock x:Name="DockerSelectedPortsText" Text="Ports · --" Classes="muted" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </Grid>

            <!-- Storage -->
            <Grid
                x:Name="StoragePage"
                IsVisible="False"
                RowDefinitions="Auto,Auto,*,110"
                RowSpacing="8">

              <Grid Grid.Row="0" ColumnDefinitions="*,220,Auto,Auto" ColumnSpacing="6">
                <StackPanel>
                  <TextBlock Text="Storage &amp; capacity" Classes="sectionTitle" FontSize="18" />
                  <TextBlock Text="Mount identity, free space, capacity policy and dependency ownership." Classes="pageSubtitle" />
                </StackPanel>
                <TextBox Grid.Column="1" x:Name="StorageFilterText" Classes="filter" Watermark="Filter mounts" TextChanged="StorageFilterText_OnTextChanged" />
                <Button Grid.Column="2" x:Name="StorageThresholdButton" Content="Thresholds..." Click="StorageThresholdButton_OnClick" />
                <Button Grid.Column="3" x:Name="RestoreStorageThresholdButton" Content="Restore defaults" Click="RestoreStorageThresholdButton_OnClick" />
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Classes="metric"><StackPanel><TextBlock Text="STORAGE ROOTS" Classes="eyebrow" /><TextBlock x:Name="StorageSummaryText" Text="0 mounts" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Grid.Column="1" Classes="metric"><StackPanel><TextBlock Text="SMART HEALTH" Classes="eyebrow" /><TextBlock Text="ON DEMAND" FontSize="14" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Column="2" Classes="metric"><StackPanel><TextBlock Text="HOTTEST DRIVE" Classes="eyebrow" /><TextBlock Text="ON DEMAND" FontSize="14" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Column="3" Classes="metric"><StackPanel><TextBlock Text="POLICY" Classes="eyebrow" /><TextBlock x:Name="StorageSelectedPolicyTitleText" Text="Select a mount" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
              </Grid>

              <ListBox
                  Grid.Row="2"
                  x:Name="StorageList"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="0"
                  SelectionChanged="StorageList_OnSelectionChanged">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <Border Classes="module" Width="345" Height="155" Margin="0,0,7,7">
                      <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="{ReflectionBinding Source}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{ReflectionBinding MountPoint}" Classes="dim" FontSize="8.5" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{ReflectionBinding StatusLabel}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                          <TextBlock Text="CAPACITY" Classes="eyebrow" />
                          <TextBlock Grid.Column="1" Text="{ReflectionBinding PercentUsed}" FontSize="16" FontWeight="SemiBold" />
                        </Grid>
                        <Border Grid.Row="2" Height="5" Background="{DynamicResource Surface3Brush}" CornerRadius="3" />
                        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                          <StackPanel><TextBlock Text="USED" Classes="eyebrow" /><TextBlock Text="{ReflectionBinding Used}" /></StackPanel>
                          <StackPanel Grid.Column="1"><TextBlock Text="FREE" Classes="eyebrow" /><TextBlock Text="{ReflectionBinding Available}" /></StackPanel>
                          <StackPanel Grid.Column="2"><TextBlock Text="FILESYSTEM" Classes="eyebrow" /><TextBlock Text="{ReflectionBinding FileSystem}" /></StackPanel>
                          <StackPanel Grid.Row="1"><TextBlock Text="POLICY" Classes="eyebrow" /><TextBlock Text="{ReflectionBinding PolicyLabel}" /></StackPanel>
                          <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"><TextBlock Text="SIZE" Classes="eyebrow" /><TextBlock Text="{ReflectionBinding Size}" /></StackPanel>
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Grid Grid.Row="3" ColumnDefinitions="1.3*,0.7*" ColumnSpacing="8">
                <Border Classes="module">
                  <StackPanel>
                    <TextBlock Text="Capacity policy" Classes="sectionTitle" />
                    <TextBlock x:Name="StoragePolicyStatusText" Text="Select a mount to inspect its policy." Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="module">
                  <StackPanel>
                    <TextBlock Text="Dependency map" Classes="sectionTitle" />
                    <TextBlock Text="Host → storage roots&#10;Storage → Docker / container data&#10;Storage → media applications&#10;Applications → workflow / library availability" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>

            <!-- Logs -->
            <Grid
                x:Name="LogsPage"
                IsVisible="False"
                RowDefinitions="Auto,1.3*,0.7*"
                RowSpacing="8">

              <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel>
                  <TextBlock Text="Log Center" Classes="sectionTitle" FontSize="18" />
                  <TextBlock Text="Grouped journal evidence, severity filtering and selected-event detail." Classes="pageSubtitle" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="LogsSummaryText" Text="0 active" Classes="dim" VerticalAlignment="Center" />
                <CheckBox Grid.Column="2" x:Name="ShowInformationalLogsCheckBox" Content="Show informational observations" VerticalAlignment="Center" Click="ShowInformationalLogsCheckBox_OnClick" />
              </Grid>

              <Border Grid.Row="1" Classes="module">
                <ListBox Grid.Row="1" x:Name="LogsList" Classes="dataList" SelectionChanged="LogsList_OnSelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <Grid ColumnDefinitions="80,130,125,70,*" ColumnSpacing="8">
                        <TextBlock Text="{ReflectionBinding Severity}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Grid.Column="1" Text="{ReflectionBinding Source}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{ReflectionBinding LastSeen}" Classes="dim" />
                        <TextBlock Grid.Column="3" Text="{ReflectionBinding Count}" />
                        <TextBlock Grid.Column="4" Text="{ReflectionBinding Message}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>

              <Border Grid.Row="2" Classes="module">
                <Grid RowDefinitions="Auto,*" RowSpacing="5">
                  <TextBlock Text="Selected event detail" Classes="sectionTitle" />
                  <TextBox Grid.Row="1" x:Name="LogDetailText" Classes="console" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
                </Grid>
              </Border>
            </Grid>
            <!-- Intelligence -->
            <Grid
                x:Name="IntelligencePage"
                IsVisible="False"
                RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                RowSpacing="8">

              <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                <StackPanel>
                  <TextBlock Text="Control plane intelligence" Classes="sectionTitle" FontSize="18" />
                  <TextBlock Text="Root cause, dependency impact and the safest next control from live GraveOps telemetry." Classes="pageSubtitle" />
                </StackPanel>
                <Button Grid.Column="1" Content="State history" Margin="0,0,5,0" Click="IntelligenceOpenHistoryButton_OnClick" />
                <Button Grid.Column="2" Content="Analyze now" Classes="primary" Click="IntelligenceCopyReportButton_OnClick" />
              </Grid>

              <Border Grid.Row="1" Classes="module" Height="92">
                <Grid RowDefinitions="Auto,*" RowSpacing="5">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="Environment context" Classes="sectionTitle" />
                      <TextBlock Text="Fleet-wide impact before selected-host root-cause analysis." Classes="pageSubtitle" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Environment dashboard" Tag="DashboardNav" Click="DashboardQuickModuleButton_OnClick" />
                  </Grid>
                  <Grid Grid.Row="1" ColumnDefinitions="170,*,Auto" ColumnSpacing="8">
                    <Border Classes="inset">
                      <StackPanel><TextBlock Text="ENVIRONMENT" Classes="eyebrow" /><Border x:Name="IntelligenceSeverityBorder" Classes="badge" HorizontalAlignment="Left"><TextBlock x:Name="IntelligenceSeverityText" Text="WAITING" FontWeight="SemiBold" /></Border></StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Name="IntelligenceHeadlineText" Text="Refresh the environment to run analysis." FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock x:Name="IntelligenceCopyStatusText" Text="No report copied." Classes="dim" FontSize="8.5" />
                    </StackPanel>
                    <ListBox Grid.Column="2" x:Name="IntelligenceImpactList" Width="320" Height="44" Classes="dataList" SelectionChanged="IntelligenceImpactList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="100,100,*" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding HostName}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Component}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Issue}" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Grid>
              </Border>

              <Border Grid.Row="2" Classes="module" Height="68">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Guided remediation" Classes="sectionTitle" />
                    <TextBlock Text="Upstream-first troubleshooting from environment ownership and live telemetry." Classes="pageSubtitle" />
                    <ListBox x:Name="IntelligenceRemediationList" Height="28" Classes="dataList" SelectionChanged="IntelligenceRemediationList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="32,90,135,*,*" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding Step}" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding SeverityLabel}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Component}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Why}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding NextStep}" Classes="dim" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="IntelligenceStageActionButton" Content="Open selected" IsEnabled="False" Click="IntelligenceStageActionButton_OnClick" />
                </Grid>
              </Border>

              <Grid Grid.Row="3" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Classes="metric"><StackPanel><TextBlock Text="OVERALL" Classes="eyebrow" /><TextBlock x:Name="IntelligenceOverallMetricText" Text="WAITING" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="1" Classes="metric"><StackPanel><TextBlock Text="BLOCKERS" Classes="eyebrow" /><TextBlock x:Name="IntelligenceBlockersMetricText" Text="0" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="2" Classes="metric"><StackPanel><TextBlock Text="WARNINGS" Classes="eyebrow" /><TextBlock x:Name="IntelligenceWarningsMetricText" Text="0" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="3" Classes="metric"><StackPanel><TextBlock Text="ROOT CAUSE" Classes="eyebrow" /><TextBlock x:Name="IntelligenceRootCauseMetricText" Text="--" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
              </Grid>

              <Grid Grid.Row="4" ColumnDefinitions="0.9*,1.1*" ColumnSpacing="8">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <StackPanel><TextBlock Text="Dependency state" Classes="sectionTitle" /><TextBlock Text="Read upstream to downstream. A higher fault can explain several lower-level symptoms." Classes="pageSubtitle" /></StackPanel>
                    <ListBox Grid.Row="1" x:Name="IntelligenceDependencyList" Classes="dataList" SelectionChanged="IntelligenceDependencyList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="34,120,90,90,*" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding Order}" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Component}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding State}" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding SeverityLabel}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Evidence}" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel><TextBlock Text="Priority findings" Classes="sectionTitle" /><TextBlock Text="Ranked by impact. Healthy context stays compact." Classes="pageSubtitle" /></StackPanel>
                      <TextBlock Grid.Column="1" x:Name="IntelligenceCountText" Text="0 findings" Classes="dim" />
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="IntelligenceFindingsList" Classes="dataList" SelectionChanged="IntelligenceFindingsList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="90,130,*,*" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding Severity}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Component}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Problem}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Impact}" Classes="dim" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </Grid>

              <Border Grid.Row="5" Classes="module" Height="64">
                <Grid ColumnDefinitions="180,*,Auto,Auto" ColumnSpacing="8">
                  <StackPanel>
                    <TextBlock x:Name="IntelligenceSelectedTitleText" Text="No finding selected" FontWeight="SemiBold" />
                    <TextBlock x:Name="IntelligenceRootCauseText" Text="No active fault detected" Classes="dim" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBox Grid.Column="1" x:Name="IntelligenceSelectedDetailText" Classes="console" IsReadOnly="True" TextWrapping="Wrap" />
                  <Button Grid.Column="2" x:Name="IntelligenceOpenRelatedButton" Content="Open related" IsEnabled="False" Click="IntelligenceOpenRelatedButton_OnClick" />
                  <Button Grid.Column="3" Content="Copy report" Click="IntelligenceCopyReportButton_OnClick" />
                </Grid>
              </Border>
            </Grid>
            <!-- Lifecycle -->
            <Grid
                x:Name="LifecyclePage"
                IsVisible="False"
                RowDefinitions="Auto,Auto,Auto,*"
                RowSpacing="8">

              <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Classes="metric"><StackPanel><TextBlock Text="ACTIVE ITEMS" Classes="eyebrow" /><TextBlock x:Name="LifecycleActiveMetricText" Text="0" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="1" Classes="metric"><StackPanel><TextBlock Text="NEEDS ATTENTION" Classes="eyebrow" /><TextBlock x:Name="LifecycleAttentionMetricText" Text="0" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="2" Classes="metric"><StackPanel><TextBlock Text="DOWNLOADING" Classes="eyebrow" /><TextBlock x:Name="LifecycleDownloadingMetricText" Text="0" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="3" Classes="metric"><StackPanel><TextBlock Text="IMPORT / RECONCILE" Classes="eyebrow" /><TextBlock x:Name="LifecycleImportMetricText" Text="0" Classes="metricValue" /></StackPanel></Border>
              </Grid>

              <Border Grid.Row="1" Classes="module" Height="112">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="Workflow" Classes="sectionTitle" />
                      <TextBlock Text="Request → Discovery → Arr → Download → Import → Processing → Library" Classes="pageSubtitle" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="LifecycleSummaryText" Text="Waiting for capture" Classes="dim" VerticalAlignment="Center" />
                  </Grid>
                  <ListBox
                      Grid.Row="1"
                      x:Name="LifecycleStagesList"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Classes="inset" Width="155" Height="60" Margin="0,0,5,0">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{ReflectionBinding Stage}" Classes="eyebrow" />
                            <TextBlock Text="{ReflectionBinding State}" FontWeight="SemiBold" />
                            <TextBlock Text="{ReflectionBinding Evidence}" Classes="dim" FontSize="8" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Grid Grid.Row="2" ColumnDefinitions="1.25*,0.75*" ColumnSpacing="8" Height="300">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <StackPanel>
                      <TextBlock Text="Active lifecycle items" Classes="sectionTitle" />
                      <TextBlock Text="Correlated Arr and downloader work. Select an item to open its owner." Classes="pageSubtitle" />
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="LifecycleItemsList" Classes="dataList" SelectionChanged="LifecycleItemsList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="1.2*,110,90,100,80,80" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding Item}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Owner}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Stage}" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding State}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Progress}" />
                            <TextBlock Grid.Column="5" Text="{ReflectionBinding Remaining}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Classes="module">
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="5">
                    <StackPanel>
                      <TextBlock Text="Guided remediation" Classes="sectionTitle" />
                      <TextBlock Text="Upstream-first next steps. GraveOps avoids downstream restarts when an earlier dependency explains the symptom." Classes="pageSubtitle" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="LifecycleRemediationList" Classes="dataList" SelectionChanged="LifecycleRemediationList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <StackPanel Spacing="3">
                            <Grid ColumnDefinitions="32,*,Auto">
                              <TextBlock Text="{ReflectionBinding Step}" />
                              <TextBlock Grid.Column="1" Text="{ReflectionBinding Component}" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="2" Text="{ReflectionBinding SeverityLabel}" Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                            <TextBlock Text="{ReflectionBinding Why}" TextWrapping="Wrap" />
                            <TextBlock Text="{ReflectionBinding NextStep}" Classes="dim" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" x:Name="LifecycleOpenOwnerButton" Content="Open selected step" IsEnabled="False" Click="LifecycleOpenOwnerButton_OnClick" />
                  </Grid>
                </Border>
              </Grid>

              <Border Grid.Row="3" Classes="module" Height="62">
                <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="8">
                  <StackPanel>
                    <TextBlock x:Name="LifecycleSelectedTitleText" Text="No lifecycle item selected" FontWeight="SemiBold" />
                    <TextBlock Text="Selected item" Classes="dim" />
                  </StackPanel>
                  <TextBox Grid.Column="1" x:Name="LifecycleSelectedDetailText" Classes="console" IsReadOnly="True" TextWrapping="Wrap" />
                  <Button Grid.Column="2" Content="Intelligence" Click="LifecycleOpenIntelligenceButton_OnClick" />
                </Grid>
              </Border>
            </Grid>
            <!-- History -->
            <Grid
                x:Name="HistoryPage"
                IsVisible="False"
                RowDefinitions="Auto,*,150,Auto"
                RowSpacing="8">

              <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                <StackPanel>
                  <TextBlock Text="History &amp; incidents" Classes="sectionTitle" FontSize="18" />
                  <TextBlock Text="Meaningful health transitions and GraveOps actions, recorded without another polling loop." Classes="pageSubtitle" />
                </StackPanel>
                <Button Grid.Column="1" Content="Replay selected" Margin="0,0,5,0" Click="HistoryReplaySelectedButton_OnClick" />
                <Button Grid.Column="2" x:Name="HistoryCopyReplayButton" Content="Copy replay" IsEnabled="False" Click="HistoryCopyReplayButton_OnClick" />
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="1.05*,0.95*" ColumnSpacing="8">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <StackPanel>
                      <TextBlock Text="Health transitions" Classes="sectionTitle" />
                      <TextBlock Text="Only changes are stored; identical refresh samples do not create noise." Classes="pageSubtitle" />
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="HistoryTransitionsList" Classes="dataList" SelectionChanged="HistoryTransitionsList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="115,100,130,*,*" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding DisplayTime}" Classes="dim" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Target}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Component}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Transition}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding Detail}" Classes="dim" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <StackPanel>
                      <TextBlock Text="GraveOps activity" Classes="sectionTitle" />
                      <TextBlock Text="Actions, discoveries and control-plane events." Classes="pageSubtitle" />
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="HistoryActivityList" Classes="dataList" SelectionChanged="HistoryActivityList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="105,125,130,*" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding DisplayTime}" Classes="dim" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Stream}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding Target}" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Transition}" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </Grid>

              <Border Grid.Row="2" Classes="module">
                <Grid RowDefinitions="Auto,*" RowSpacing="5">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="Incident replay" Classes="sectionTitle" />
                      <TextBlock x:Name="HistorySelectedTitleText" Text="Select a transition or activity row." Classes="pageSubtitle" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="HistoryOpenRelatedButton" Content="Open related" IsEnabled="False" Click="HistoryOpenRelatedButton_OnClick" />
                  </Grid>
                  <Grid Grid.Row="1" ColumnDefinitions="0.8*,1.2*" ColumnSpacing="6">
                    <TextBox x:Name="HistorySelectedDetailText" Classes="console" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
                    <TextBox Grid.Column="1" x:Name="HistoryReplayText" Classes="console" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
                  </Grid>
                </Grid>
              </Border>

              <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <TextBlock x:Name="HistoryTransitionMetricText" Text="0" Classes="dim" />
                <TextBlock Grid.Column="1" Text=" transitions · " Classes="dim" />
                <TextBlock Grid.Column="2" x:Name="HistoryActivityMetricText" Text="0" Classes="dim" />
                <TextBlock Grid.Column="3" Text=" activities" Classes="dim" />
                <TextBlock Grid.Column="4" x:Name="HistoryCopyStatusText" Text="No replay copied." Classes="dim" HorizontalAlignment="Center" />
                <Button Grid.Column="5" Content="Clear history" Classes="danger" Click="HistoryClearAllButton_OnClick" />

                <TextBlock x:Name="HistoryIncidentMetricText" IsVisible="False" />
                <TextBlock x:Name="HistoryRetentionMetricText" IsVisible="False" />
                <ListBox x:Name="HistoryIncidentList" IsVisible="False" SelectionChanged="HistoryIncidentList_OnSelectionChanged" />
                <TextBlock x:Name="HistoryCachePathText" IsVisible="False" />
              </Grid>
            </Grid>
            <!-- Backups -->
            <Grid
                x:Name="BackupsPage"
                IsVisible="False"
                RowDefinitions="Auto,Auto,*,Auto"
                RowSpacing="8">

              <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Classes="metric">
                  <StackPanel Spacing="3"><TextBlock Text="READINESS" Classes="eyebrow" /><Border x:Name="BackupStateBorder" Classes="badge" HorizontalAlignment="Left"><TextBlock x:Name="BackupStateText" Text="WAITING" FontWeight="SemiBold" /></Border></StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="metric"><StackPanel Spacing="3"><TextBlock Text="PROVIDER" Classes="eyebrow" /><TextBlock x:Name="BackupProviderText" Text="--" Classes="metricValue" /></StackPanel></Border>
                <Border Grid.Column="2" Classes="metric"><StackPanel Spacing="3"><TextBlock Text="SUMMARY" Classes="eyebrow" /><TextBlock x:Name="BackupSummaryText" Text="Waiting for capture" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Grid.Column="3" Classes="metric"><StackPanel Spacing="3"><TextBlock Text="OPERATIONS" Classes="eyebrow" /><TextBlock Text="PROTECTED" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Mutations remain guarded" Classes="dim" FontSize="8.5" /></StackPanel></Border>
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="1.5*,0.5*" ColumnSpacing="8" Height="170">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <StackPanel>
                      <TextBlock Text="Backup inventory" Classes="sectionTitle" />
                      <TextBlock Text="Schedule, recovery work and provider evidence reported by the active host." Classes="pageSubtitle" />
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="BackupEvidenceList" Classes="dataList" />
                  </Grid>
                </Border>
                <Border Grid.Column="1" Classes="module">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Operations" Classes="sectionTitle" />
                    <TextBlock Text="Backup mutations belong in protected actions or the provider integration." Classes="pageSubtitle" TextWrapping="Wrap" />
                    <Button Content="Services &amp; Actions" Tag="ServicesNav" Click="DashboardQuickModuleButton_OnClick" />
                    <Button Content="Open terminal" Tag="ToolsNav" Click="DashboardQuickModuleButton_OnClick" />
                  </StackPanel>
                </Border>
              </Grid>

              <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <TextBlock Text="Schedules &amp; units" Classes="sectionTitle" />
                    <ListBox Grid.Row="1" x:Name="BackupUnitsList" Classes="dataList">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="170,100,100,*" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding Unit}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Active}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding SubState}" />
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding Enabled}" Classes="dim" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
                <Border Grid.Column="1" Classes="module">
                  <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <TextBlock Text="Recent artifacts" Classes="sectionTitle" />
                    <ListBox Grid.Row="1" x:Name="BackupArtifactsList" Classes="dataList">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="*,110,130" ColumnSpacing="6">
                            <TextBlock Text="{ReflectionBinding Path}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding Size}" />
                            <TextBlock Grid.Column="2" Text="{ReflectionBinding LocalModifiedAt}" Classes="dim" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </Grid>

              <Border Grid.Row="3" Classes="module">
                <StackPanel>
                  <TextBlock Text="Shareable by design" Classes="sectionTitle" />
                  <TextBlock Text="No repository path, password, host mount or backup schedule is hard-coded into GraveOps. This page reports what the active provider can safely observe." Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- Settings -->
            <Grid
                x:Name="SettingsPage"
                IsVisible="False"
                ColumnDefinitions="1.05*,0.95*"
                RowDefinitions="Auto,*"
                ColumnSpacing="8"
                RowSpacing="8">

              <StackPanel Grid.ColumnSpan="2">
                <TextBlock Text="Settings" Classes="sectionTitle" FontSize="18" />
                <TextBlock Text="Linux paths, operator defaults, policies and version state in the shared GraveOps visual system." Classes="pageSubtitle" />
              </StackPanel>

              <Border Grid.Row="1" Classes="module">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="7">
                  <StackPanel>
                    <TextBlock Text="Operator defaults" Classes="sectionTitle" />
                    <TextBlock Text="Stored in operator-settings.json and applied when GraveOps starts." Classes="pageSubtitle" />
                  </StackPanel>
                  <CheckBox Grid.Row="1" x:Name="SettingsSafeModeCheckBox" Content="Start in Safe Mode" />
                  <CheckBox Grid.Row="2" x:Name="SettingsInformationalLogsCheckBox" Content="Show informational log observations by default" />
                  <CheckBox Grid.Row="3" x:Name="SettingsInformationalContainersCheckBox" Content="Show informational exited containers by default" />
                  <CheckBox Grid.Row="4" x:Name="SettingsOpenOverviewCheckBox" Content="Open Overview after startup" />
                  <CheckBox Grid.Row="5" x:Name="SettingsDesktopNotificationsCheckBox" Content="Show desktop notifications for new error-level incidents" />
                  <Grid Grid.Row="6" ColumnDefinitions="220,100,*" ColumnSpacing="6">
                    <TextBlock Text="Background refresh seconds" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" x:Name="SettingsBackgroundRefreshSecondsTextBox" />
                    <WrapPanel Grid.Column="2">
                      <Button Content="Save settings" Classes="primary" Margin="0,0,5,0" Click="SaveOperatorSettingsButton_OnClick" />
                      <Button Content="Restore defaults" Click="ResetOperatorSettingsButton_OnClick" />
                    </WrapPanel>
                  </Grid>
                  <TextBlock Grid.Row="7" x:Name="SettingsSaveStatusText" Text="Settings loaded." Classes="dim" />
                </Grid>
              </Border>

              <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                    <TextBlock Text="Policy management" Classes="sectionTitle" />
                    <TextBlock Grid.Row="1" x:Name="SettingsPolicySummaryText" Text="0 active policies" FontWeight="SemiBold" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                      <TextBlock x:Name="SettingsPolicyPathText" Text="--" Classes="dim" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1" Content="Dashboard policies" Tag="DashboardNav" Click="SettingsNavigateButton_OnClick" />
                      <Button Grid.Column="2" Content="Storage thresholds" Tag="StorageNav" Click="SettingsNavigateButton_OnClick" />
                    </Grid>
                  </Grid>
                </Border>

                <Border Grid.Row="1" Classes="module">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                    <TextBlock Text="Application paths" Classes="sectionTitle" />
                    <Grid Grid.Row="1" ColumnDefinitions="115,*,Auto,Auto" ColumnSpacing="5"><TextBlock Text="Config" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsConfigPathText" Text="--" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="Open" Tag="config" Click="OpenOperatorPathButton_OnClick" /><Button Grid.Column="3" Content="Terminal" Tag="config" Click="OpenOperatorTerminalButton_OnClick" /></Grid>
                    <Grid Grid.Row="2" ColumnDefinitions="115,*,Auto,Auto" ColumnSpacing="5"><TextBlock Text="Data" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsDataPathText" Text="--" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="Open" Tag="data" Click="OpenOperatorPathButton_OnClick" /><Button Grid.Column="3" Content="Terminal" Tag="data" Click="OpenOperatorTerminalButton_OnClick" /></Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="115,*,Auto,Auto" ColumnSpacing="5"><TextBlock Text="Repository" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsRepositoryPathText" Text="--" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="Open" Tag="repository" Click="OpenOperatorPathButton_OnClick" /><Button Grid.Column="3" Content="Terminal" Tag="repository" Click="OpenOperatorTerminalButton_OnClick" /></Grid>
                    <Grid Grid.Row="4" ColumnDefinitions="115,*,Auto,Auto" ColumnSpacing="5"><TextBlock Text="Diagnostics" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsDiagnosticsPathText" Text="--" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="Open" Tag="diagnostics" Click="OpenOperatorPathButton_OnClick" /><Button Grid.Column="3" Content="Terminal" Tag="diagnostics" Click="OpenOperatorTerminalButton_OnClick" /></Grid>
                    <TextBlock Grid.Row="5" x:Name="SettingsPathStatusText" Text="No path action run." Classes="dim" />
                    <TextBlock x:Name="SettingsPolicyFileText" IsVisible="False" />
                    <TextBlock x:Name="SettingsHistoryFileText" IsVisible="False" />
                  </Grid>
                </Border>

                <Border Grid.Row="2" Classes="module">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Version and update state" Classes="sectionTitle" /><Button Grid.Column="1" Content="Refresh version info" Click="RefreshVersionInfoButton_OnClick" /></Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="120,*"><TextBlock Text="Branch" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsBranchText" Text="--" /></Grid>
                    <Grid Grid.Row="2" ColumnDefinitions="120,*"><TextBlock Text="Commit" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsCommitText" Text="--" /></Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="120,*"><TextBlock Text="Worktree" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsWorktreeText" Text="--" /></Grid>
                    <Grid Grid.Row="4" ColumnDefinitions="120,*"><TextBlock Text="Origin" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsOriginText" Text="--" /></Grid>
                    <Grid Grid.Row="5" ColumnDefinitions="120,*"><TextBlock Text=".NET SDK" Classes="eyebrow" /><TextBlock Grid.Column="1" x:Name="SettingsDotnetText" Text="--" /></Grid>
                  </Grid>
                </Border>
              </Grid>
            </Grid>

            <!-- Operator Tools -->
            <Grid
                x:Name="ToolsPage"
                IsVisible="False"
                RowDefinitions="Auto,*"
                RowSpacing="8">

              <StackPanel>
                <TextBlock Text="Operator tools" Classes="sectionTitle" FontSize="18" />
                <TextBlock Text="Redacted diagnostics, read-only validation and safe terminal handoff." Classes="pageSubtitle" />
              </StackPanel>

              <Grid Grid.Row="1" ColumnDefinitions="1.05*,0.95*" ColumnSpacing="8">
                <Border Classes="module">
                  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="7">
                    <StackPanel>
                      <TextBlock Text="Diagnostics export" Classes="sectionTitle" />
                      <TextBlock Text="Creates a redacted local ZIP without configuration contents, API keys or passwords." Classes="pageSubtitle" />
                    </StackPanel>
                    <Border Grid.Row="1" Classes="inset"><TextBlock Text="Home paths, IP addresses and common secret patterns are redacted. Browser data and media files are excluded." Classes="muted" TextWrapping="Wrap" /></Border>
                    <WrapPanel Grid.Row="2">
                      <Button x:Name="CreateDiagnosticsButton" Content="Create diagnostics bundle" Classes="primary" Margin="0,0,5,0" Click="CreateDiagnosticsButton_OnClick" />
                      <Button Content="Open diagnostics folder" Tag="diagnostics" Click="OpenOperatorPathButton_OnClick" />
                    </WrapPanel>
                    <TextBlock Grid.Row="3" x:Name="DiagnosticsStatusText" Text="Ready to export." Classes="dim" />
                  </Grid>
                </Border>

                <Border Grid.Column="1" Classes="module">
                  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="7">
                    <StackPanel>
                      <TextBlock Text="Read-only validation" Classes="sectionTitle" />
                      <TextBlock Text="Checks paths, JSON stores, repository state and required launchers without changing services or policies." Classes="pageSubtitle" />
                    </StackPanel>
                    <Button Grid.Row="1" x:Name="RunValidationButton" Content="Run validation" HorizontalAlignment="Left" Click="RunValidationButton_OnClick" />
                    <TextBox Grid.Row="2" Grid.RowSpan="2" x:Name="ValidationOutputText" Classes="console" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
                  </Grid>
                </Border>

                <Border Grid.ColumnSpan="2" IsVisible="False">
                  <TextBlock x:Name="TerminalStatusText" />
                </Border>
              </Grid>
            </Grid>



          </Grid>

          <Border
              Grid.Row="3"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="14,0">

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Spacing="7">

                <TextBlock
                    Text="●"
                    FontSize="9"
                    Foreground="{DynamicResource SuccessBrush}" />

                <TextBlock
                    x:Name="FooterTargetText"
                    Text="No target"
                    Classes="muted"
                    FontSize="10" />

                <TextBlock Text="/" Classes="dim" FontSize="10" />

                <TextBlock
                    x:Name="FooterConnectionText"
                    Text="WAITING"
                    Classes="muted"
                    FontSize="10" />
              </StackPanel>

              <StackPanel
                  Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Spacing="7">

                <TextBlock
                    x:Name="FooterModeText"
                    Text="SAFE MODE"
                    Classes="muted"
                    FontSize="10" />

                <TextBlock Text="/" Classes="dim" FontSize="10" />

                <TextBlock
                    x:Name="FooterFindingsText"
                    Text="0 active"
                    Classes="muted"
                    FontSize="10" />

                <TextBlock Text="/" Classes="dim" FontSize="10" />

                <TextBlock
                    x:Name="FooterFreshnessText"
                    Text="waiting"
                    Classes="dim"
                    FontSize="10" />
              </StackPanel>
            </Grid>
          </Border>


          <Border
              x:Name="JobsDrawer"
              Grid.RowSpan="4"
              ZIndex="92"
              Width="500"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1,0,0,0"
              IsVisible="False">

            <Grid
                RowDefinitions="Auto,Auto,*,Auto"
                Margin="18">

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock
                      Text="Background Jobs"
                      FontSize="20"
                      FontWeight="SemiBold" />
                  <TextBlock
                      Text="Long-running and background control-plane work survives page navigation."
                      Classes="muted"
                      FontSize="10"
                      Margin="0,3,0,0"
                      TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="×"
                    Width="36"
                    Height="32"
                    Click="JobsCloseButton_OnClick" />
              </Grid>

              <TextBlock
                  Grid.Row="1"
                  x:Name="JobsSummaryText"
                  Text="0 running"
                  Classes="muted"
                  Margin="0,14,0,8" />

              <ListBox
                  Grid.Row="2"
                  x:Name="JobsList"
                  Classes="dataList passive">
                <ListBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Text="{ReflectionBinding Name}"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{ReflectionBinding State}"
                            Foreground="{DynamicResource AccentBrush}"
                            FontWeight="SemiBold" />
                      </Grid>

                      <TextBlock
                          Text="{ReflectionBinding Target}"
                          Classes="muted"
                          FontSize="10"
                          TextWrapping="Wrap" />

                      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="9">
                        <TextBlock
                            Text="{ReflectionBinding ProgressText}"
                            Classes="dim"
                            FontSize="9" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{ReflectionBinding DurationText}"
                            Classes="dim"
                            FontSize="9" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{ReflectionBinding DisplayTime}"
                            Classes="dim"
                            FontSize="9"
                            HorizontalAlignment="Right" />
                      </Grid>

                      <TextBlock
                          Text="{ReflectionBinding Detail}"
                          Classes="muted"
                          FontSize="10"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Button
                  Grid.Row="3"
                  Content="Clear completed"
                  HorizontalAlignment="Left"
                  Margin="0,12,0,0"
                  Click="ClearCompletedJobsButton_OnClick" />
            </Grid>
          </Border>

          <Border
              x:Name="ActivityDrawer"
              Grid.RowSpan="4"
              ZIndex="93"
              Width="560"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1,0,0,0"
              IsVisible="False">

            <Grid
                RowDefinitions="Auto,Auto,*,Auto"
                Margin="18">

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock
                      Text="Activity &amp; Notifications"
                      FontSize="20"
                      FontWeight="SemiBold" />
                  <TextBlock
                      Text="Targets, actions, failures, notifications and operator decisions."
                      Classes="muted"
                      FontSize="10"
                      Margin="0,3,0,0"
                      TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="×"
                    Width="36"
                    Height="32"
                    Click="ActivityCloseButton_OnClick" />
              </Grid>

              <Grid
                  Grid.Row="1"
                  ColumnDefinitions="220,*,Auto"
                  ColumnSpacing="8"
                  Margin="0,14,0,8">
                <ComboBox
                    x:Name="ActivityFilterComboBox"
                    SelectionChanged="ActivityFilterComboBox_OnSelectionChanged" />
                <TextBlock
                    Grid.Column="1"
                    x:Name="ActivitySummaryText"
                    Text="0 retained"
                    Classes="muted"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="2"
                    Content="Mark read"
                    Click="MarkActivityReadButton_OnClick" />
              </Grid>

              <ListBox
                  Grid.Row="2"
                  x:Name="ActivityList"
                  Classes="dataList"
                  DoubleTapped="ActivityList_OnDoubleTapped">
                <ListBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock
                            Text="{ReflectionBinding ReadState}"
                            Foreground="{DynamicResource AccentBrush}"
                            FontSize="9"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{ReflectionBinding Title}"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{ReflectionBinding Kind}"
                            Classes="dim"
                            FontSize="9" />
                      </Grid>

                      <TextBlock
                          Text="{ReflectionBinding Target}"
                          Classes="muted"
                          FontSize="10"
                          TextWrapping="Wrap" />

                      <TextBlock
                          Text="{ReflectionBinding Detail}"
                          Classes="muted"
                          FontSize="10"
                          TextWrapping="Wrap" />

                      <TextBlock
                          Text="{ReflectionBinding DisplayTime}"
                          Classes="dim"
                          FontSize="9" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Button
                  Grid.Row="3"
                  Content="Clear activity"
                  HorizontalAlignment="Left"
                  Margin="0,12,0,0"
                  Click="ClearActivityButton_OnClick" />
            </Grid>
          </Border>


          <Border
              x:Name="OverviewDrawer"
              Grid.RowSpan="4"
              ZIndex="90"
              Width="430"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1,0,0,0"
              IsVisible="False">

            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto,*"
                Margin="18">

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock
                      Text="Overview"
                      FontSize="20"
                      FontWeight="SemiBold" />

                  <TextBlock
                      Text="Current target, control-plane state and concise environment context."
                      Classes="muted"
                      FontSize="10"
                      Margin="0,3,0,0"
                      TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="×"
                    Width="36"
                    Height="32"
                    Click="OverviewCloseButton_OnClick" />
              </Grid>

              <Grid
                  Grid.Row="1"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="10"
                  Margin="0,16,0,0">

                <Border Classes="inset">
                  <StackPanel Spacing="5">
                    <TextBlock Text="TARGET" Classes="eyebrow" />
                    <TextBlock
                        x:Name="OverviewTargetText"
                        Text="--"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="OverviewOsText"
                        Text="--"
                        Classes="dim"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="inset">
                  <StackPanel Spacing="5">
                    <TextBlock Text="CONTROL PLANE" Classes="eyebrow" />
                    <TextBlock
                        x:Name="OverviewControlPlaneText"
                        Text="WAITING"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="OverviewCapturedText"
                        Text="No capture"
                        Classes="dim"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border
                  Grid.Row="2"
                  Classes="inset"
                  Margin="0,10,0,0">

                <StackPanel Spacing="6">
                  <TextBlock Text="ENVIRONMENT" Classes="eyebrow" />
                  <TextBlock
                      x:Name="OverviewFindingsText"
                      Text="No findings captured"
                      FontWeight="SemiBold"
                      TextWrapping="Wrap" />
                  <TextBlock
                      x:Name="OverviewPolicyText"
                      Text="Default monitoring"
                      Classes="dim"
                      TextWrapping="Wrap" />
                  <TextBlock
                      x:Name="OverviewHighestPriorityText"
                      Text="No active operational finding."
                      Classes="muted"
                      TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border
                  Grid.Row="3"
                  Classes="inset"
                  Margin="0,10,0,0">

                <StackPanel Spacing="5">
                  <TextBlock Text="BACKUPS" Classes="eyebrow" />
                  <TextBlock
                      x:Name="OverviewBackupText"
                      Text="Waiting for backup capture"
                      FontWeight="SemiBold"
                      TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <StackPanel
                  Grid.Row="4"
                  Margin="0,14,0,0"
                  Spacing="8">

                <TextBlock Text="QUICK NAVIGATION" Classes="eyebrow" />

                <WrapPanel>
                  <Button Content="Dashboard" Tag="DashboardNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                  <Button Content="Intelligence" Tag="IntelligenceNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                  <Button Content="Storage" Tag="StorageNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                  <Button Content="Media Hub" Tag="MediaHubNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                  <Button Content="Backups" Tag="BackupsNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                  <Button Content="History" Tag="HistoryNav" Margin="0,0,7,7" Click="OverviewNavigateButton_OnClick" />
                </WrapPanel>

                <TextBlock
                    Text="Detailed findings, logs, actions and history remain on their owner pages."
                    Classes="dim"
                    FontSize="10"
                    TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid
              x:Name="CommandPaletteOverlay"
              Grid.RowSpan="4"
              ZIndex="100"
              Background="#B2090A0C"
              IsVisible="False">

            <Border
                Width="720"
                MaxHeight="620"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,88,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">

              <Grid RowDefinitions="Auto,*,Auto">
                <TextBox
                    x:Name="CommandPaletteTextBox"
                    FontSize="17"
                    Padding="14,10"
                    PlaceholderText="Search pages and detected applications"
                    TextChanged="CommandPaletteTextBox_OnTextChanged"
                    KeyDown="CommandPaletteTextBox_OnKeyDown" />

                <ListBox
                    x:Name="CommandPaletteList"
                    Grid.Row="1"
                    Classes="dataList"
                    MinHeight="260"
                    MaxHeight="470"
                    Margin="0,10,0,0"
                    DoubleTapped="CommandPaletteList_OnDoubleTapped">

                  <ListBox.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="3">
                          <TextBlock
                              Text="{ReflectionBinding Title}"
                              FontWeight="SemiBold" />
                          <TextBlock
                              Text="{ReflectionBinding Subtitle}"
                              Classes="muted"
                              FontSize="10"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            Text="{ReflectionBinding Kind}"
                            Classes="dim"
                            FontSize="9"
                            VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock
                    Grid.Row="2"
                    Text="Enter opens · Up/Down selects · Esc closes · Ctrl+K toggles"
                    Classes="dim"
                    FontSize="10"
                    Margin="4,10,0,0" />
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
