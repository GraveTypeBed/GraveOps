* text=auto

# Windows source and tooling
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# Cross-platform and repository metadata
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.exe binary

# Linux-specific source trees use native LF endings.
src/GraveOps.Desktop.Linux/*.cs text eol=lf
src/GraveOps.Desktop.Linux/*.axaml text eol=lf
src/GraveOps.Desktop.Linux/*.csproj text eol=lf
src/GraveOps.Desktop.Linux/*.xml text eol=lf
src/GraveOps.Platform.Linux/*.cs text eol=lf
src/GraveOps.Platform.Linux/*.csproj text eol=lf
src/GraveOps.Platform.Linux/*.xml text eol=lf
